__pycache__/
*.pyc
ppt-chunker.zip
ppt-chunker/ppt-chunker/output_muc/
ppt-chunker/ppt-chunker/output_muc_fit/
ppt-chunker/ppt-chunker/output_*/

# Local presentation source decks and heavy research/video bundles.
presentations/*.pptx
/alpCHI/

# Rebuildable PPTX-to-HTML staging outputs. Public scene players live in
# presentations/MuC, presentations/alpCHI, and presentations/BBD26.
presentations/MuC-scene/
presentations/alpCHI-scene/
presentations/BBD26-scene-new/

# Visual QA screenshots and candidate sweeps are local artifacts; keep direct
# QA JSON overrides/reports available for reproducible presenter builds.
presentations/BBD26-scene/qa/**
!presentations/BBD26-scene/qa/
!presentations/BBD26-scene/qa/*.json

# PowerPoint-oracle QA emits large reproducible frame sets. Keep reports and
# contact sheets in Git, but leave raw frames and temporary MP4 references local.
presentations/*/qa/html/**
presentations/*/qa/reference/**
presentations/*/qa/diff/**
presentations/*/qa/side-by-side/**
presentations/*/qa/oracle/**
presentations/*/qa/visual-audit/html/**
presentations/*/qa/morph-progress/html/**
presentations/*/qa/morph-progress/reference/**
presentations/*/qa/morph-progress/diff/**
presentations/*/qa/morph-progress/side-by-side/**
presentations/*/qa/morph-progress/candidate-samples.json
presentations/*/qa/*powerpoint-reference*.mp4
