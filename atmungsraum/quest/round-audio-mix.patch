+++ b/apps/native-renderer-android/panel-modules/condition-audio/src/main/java/io/github/mesmerprism/rustyquest/native_renderer/RoundAudioMix.java
@@ -0,0 +1,91 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.AssetFileDescriptor;
+import android.media.MediaPlayer;
+import java.io.IOException;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import org.json.JSONObject;
+
+/** App-owned volume preferences. The system media stream remains under Android control. */
+final class RoundAudioMix {
+    static final String TRACK = "atmungsraum-music/backgroundmusic.mp3";
+    private static final int DEFAULT_MUSIC = 30;
+    private static final int DEFAULT_INSTRUCTIONS = 90;
+    private static final Map<MediaPlayer, Boolean> players = new IdentityHashMap<>();
+    private static SharedPreferences preferences;
+    private static int music = DEFAULT_MUSIC;
+    private static int instructions = DEFAULT_INSTRUCTIONS;
+    private static long revision;
+
+    private RoundAudioMix() { }
+
+    static synchronized void install(Context context) {
+        if (enabled()) return;
+        try (AssetFileDescriptor track = context.getAssets().openFd(TRACK)) {
+            if (track.getLength() <= 0) return;
+        } catch (IOException absent) {
+            return;
+        }
+        preferences = context.getSharedPreferences("atmungsraum-round-audio", Context.MODE_PRIVATE);
+        music = checkedPreference("music", DEFAULT_MUSIC);
+        instructions = checkedPreference("instructions", DEFAULT_INSTRUCTIONS);
+        BreathingSetupAudio.setSpeechGain(instructions / 100f);
+    }
+
+    private static int checkedPreference(String key, int fallback) {
+        Object value = preferences.getAll().get(key);
+        return valid(value) ? (Integer) value : fallback;
+    }
+
+    private static boolean valid(Object value) {
+        return value instanceof Integer && (Integer) value >= 0 && (Integer) value <= 100;
+    }
+
+    static synchronized boolean enabled() { return preferences != null; }
+
+    static synchronized JSONObject status() throws Exception {
+        return new JSONObject().put("v", 1).put("music", music).put("instructions", instructions)
+            .put("revision", revision);
+    }
+
+    static synchronized JSONObject apply(JSONObject request) throws Exception {
+        if (!Integer.valueOf(1).equals(request.opt("v")) || request.length() != 3
+                || !valid(request.opt("music")) || !valid(request.opt("instructions"))) {
+            throw new IllegalArgumentException("closed-round-audio-mix-required");
+        }
+        int nextMusic = request.getInt("music");
+        int nextInstructions = request.getInt("instructions");
+        if (music != nextMusic || instructions != nextInstructions) {
+            if (!preferences.edit().putInt("music", nextMusic).putInt("instructions", nextInstructions).commit()) {
+                throw new IOException("round-audio-mix-not-saved");
+            }
+            music = nextMusic;
+            instructions = nextInstructions;
+            BreathingSetupAudio.setSpeechGain(instructions / 100f);
+            revision++;
+            for (Map.Entry<MediaPlayer, Boolean> entry : players.entrySet()) {
+                try { applyGain(entry.getKey(), entry.getValue()); }
+                catch (IllegalStateException retiring) { }
+            }
+        }
+        return status();
+    }
+
+    static synchronized void attach(MediaPlayer player, boolean isMusic) {
+        if (!enabled()) return;
+        applyGain(player, isMusic);
+        players.put(player, isMusic);
+    }
+
+    static synchronized void detach(MediaPlayer player) { players.remove(player); }
+
+    static synchronized float speechGain() { return enabled() ? instructions / 100f : 1f; }
+
+    private static void applyGain(MediaPlayer player, boolean isMusic) {
+        float gain = isMusic ? music / 100f : speechGain();
+        player.setVolume(gain, gain);
+    }
+}
