+        let runtime = runtime(&root);
+        runtime.apply_command_json(&start_command(&root, "overflow-arm"));
+        wait_for(&runtime, "\"phase\":\"active\"");
+        let (entered_tx, entered_rx) = mpsc::sync_channel(1);
+        let (resume_tx, resume_rx) = mpsc::sync_channel(1);
+        runtime
+            .command_sender
+            .send(WorkerMessage::PauseForTest {
+                entered: entered_tx,
+                resume: resume_rx,
+            })
+            .unwrap();
+        entered_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+
+        let submit = |ordinal: usize| {
+            runtime.record_polar_ecg_sample(
+                1 + (ordinal / 73) as u64,
+                (ordinal % 73) as u32,
+                1_000_000 + ordinal as u64,
+                2_000_000 + ordinal as u64,
+                1_001_000,
+                0,
+            )
+        };
+        // Force one deferred record, then submit with an available writer.
+        // The prior retry still owns the raw lane.
+        let first = {
+            let _held = runtime.writer_slot.lock().unwrap();
+            submit(0)
+        };
+        let deferred: Vec<_> = (1..RETRY_QUEUE_CAPACITY).map(submit).collect();
+        let overflow = submit(RETRY_QUEUE_CAPACITY);
+        let cutoff = runtime.apply_command_json(&command(
+            "save-and-exit",
+            "overflow-save",
+            1,
+            1_000_000_000,
+        ));
+        let after_cutoff = submit(RETRY_QUEUE_CAPACITY + 1);
+        resume_tx.send(()).unwrap();
+        let status = wait_for(&runtime, "\"shutdown_status\":\"complete\"");
+        runtime.shutdown_for_test().unwrap();
+
+        let directory = root.join("utc-ns-01725000000000000000");
+        let final_record: Value =
+            serde_json::from_slice(&fs::read(directory.join("final.json")).unwrap()).unwrap();
+        let rows = fs::read_to_string(directory.join("polar-ecg.jsonl")).unwrap();
+        fs::remove_dir_all(root.parent().unwrap()).unwrap();
+        assert_eq!(first, OfferOutcome::AdmissionBusy);
+        assert!(deferred.iter().all(|outcome| *outcome == OfferOutcome::AdmissionBusy));
+        assert_eq!(overflow, OfferOutcome::QueueFull);
+        assert!(cutoff.contains("\"command_status\":\"queued\""));
+        assert_eq!(after_cutoff, OfferOutcome::NotAccepting);
+        assert_eq!(rows.lines().count(), RETRY_QUEUE_CAPACITY);
+        assert_eq!(final_record["dropped_records"], 1);
+        assert_eq!(final_record["saved"], false);
+        assert!(status.contains("\"status\":\"unsaved\""));
+    }
