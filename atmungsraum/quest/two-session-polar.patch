+    for (replacement, generation, same_source) in
+        [(41, 9, true), (41, 11, true), (42, 11, false), (0, 11, false)]
+    {
+        let _ingress = scoped_packet_ingress::install();
+        let frame = |sequence, sensor_last_ns, receipt_ns| SensorFrame {
+            sequence, sensor_last_ns, receipt_ns, rate_hz: 200, count: 40,
+        };
+        for sequence in 1..=4 {
+            let _ = observe_setup_sensor_frame_for_transport(binding, Some(original),
+                frame(sequence, 100_000_000_000 + sequence * 200_000_000, 1_000_000_000 + sequence * 200_000_000));
+        }
+        let (mut runtime, first_frame, first_at) = calibrated_inhale_runtime_with_binding(binding);
+        assert_eq!(command(&mut runtime, 50, "begin-main", first_at)["accepted"], true);
+        for tick in 1..=800 {
+            let at = first_at + tick * 20_000_000;
+            runtime.observe_clock(7, first_frame + tick * 882, at, true);
+            runtime.observe_host_aligned_acc(100_000_000_000 + at, at, vector(0.5));
+        }
+        let playback_frame = first_frame + 800 * 882;
+        let pause_at = first_at + 16_020_000_000;
+        runtime.observe_clock(7, playback_frame, pause_at, false);
+        assert_eq!(runtime.core.snapshot(pause_at).experiment, ExperimentState::Running);
+        let model = |r: &Runtime| r.core.model().map(|m| (m.source_owner, m.generation, m.axis, m.low, m.high));
+        let original_model = model(&runtime).unwrap();
+        let frozen = runtime.core.snapshot(pause_at).experiment_completed_frames;
+        let _setup = test_support::install_runtime_for_usable_test(runtime);
+        let next = SetupSensorTransport {
+            source_token: replacement,
+            connection_generation: generation,
+        };
+
+        // First reconnect packet rewinds the PMD timestamp. The old anchor
+        // must not survive, even for the positively identified same strap.
+        let reconnect_at = pause_at + 6_000_000_000;
+        let initial = observe_setup_sensor_frame_for_transport(binding, Some(next),
+            frame(5, 90_000_000_000, reconnect_at));
+        assert!(matches!(initial, Err(ClockFault::Warming | ClockFault::Retired)));
+        if same_source && generation != original.connection_generation {
+            assert_eq!(observe_setup_sensor_frame_for_transport(binding, Some(original),
+                frame(99, 110_000_000_000, reconnect_at + 1)), Err(ClockFault::Retired));
+        }
+        refresh_source_projection(binding);
+        assert!(!crate::polar_input_health::status(true, true).0.usable_fresh);
+        let initial_setup = {
+            let guard = state().lock().unwrap();
+            let current = guard.as_ref().unwrap();
+            let cached_phase = current.personal_tilt_classifier.is_primed()
+                || current.classified_model.is_some()
+                || current.classified_at.is_some()
+                || current.last_confirmed_phase.is_some()
+                || current.phase != CommonBreathPhase::Unknown;
+            (model(current), current.projection_ready, cached_phase)
+        };
+        assert_eq!(initial_setup.0, same_source.then_some(original_model), "only the proven original strap can retain its fit during re-anchoring");
+        assert!(!initial_setup.1);
+        assert!(!initial_setup.2, "the saved fit must not preserve previously qualified phase evidence");
+        for step in 1_u64..=4 {
+            let source_end = 90_000_000_000 + step * 200_000_000;
+            let at = reconnect_at + step * 200_000_000;
+            observe_source_clock_pair(at, at);
+            observe_clock(7, playback_frame, at, false);
+            let sequence = 5 + step;
+            let _ = observe_setup_sensor_frame_for_transport(binding, Some(next), frame(sequence, source_end, at));
+            refresh_source_projection(binding);
+            for index in 0..40 {
+                let delay = u64::from(39 - index) * 5_000_000;
+                assert!(submit_setup_sensor_packet(Instant::now(), at - delay, source_end - delay,
+                    sequence, index, 40, vector(0.5)));
+            }
+            let current = state().lock().unwrap().as_ref().unwrap().core.snapshot(at);
+            assert!(!current.playing);
+            if same_source {
+                assert_eq!(current.experiment_completed_frames, frozen);
+            }
+        }
+        assert_eq!(crate::polar_input_health::status(true, true).0.usable_fresh, same_source);
+        let at = reconnect_at + 800_000_000;
+        let retained_model = model(state().lock().unwrap().as_ref().unwrap());
+        assert_eq!(retained_model, same_source.then_some(original_model));
+        if same_source {
+            // A genuine composition/selection replacement still fails closed.
+            let (model, status) = {
+                let mut guard = state().lock().unwrap();
+                let current = guard.as_mut().unwrap();
+                current.bind_source((binding.0, binding.1 + 1));
+                (model(current), current.status(at))
+            };
+            assert!(model.is_none());
+            assert_eq!(status["failure"], "source_replaced");
+        }
+    }
+}
