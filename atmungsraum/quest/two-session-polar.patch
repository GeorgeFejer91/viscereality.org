+#[test]
+fn personal_tilt_filter_uses_source_elapsed_time_and_tuned_hold_exit() {
+    for step in [5_000, 40_000] {
+        let mut runtime = runtime();
+        for sample_us in (0_u64..=1_080_000).step_by(step) {
+            // A quarter-unit/s inhale for 400ms, then a flat normalized signal.
+            let value = 0.2 + 0.25 * sample_us.min(400_000) as f64 / 1_000_000.0;
+            let received_us = (sample_us / 50_000 + 1) * 50_000;
+            let observation = runtime.personal_tilt_classifier.observe(
+                BreathTimestampMicros::new(received_us),
+                CommonPhaseInput::Sample {
+                    sequence_id: sample_us / step as u64 + 1,
+                    sampled_at: BreathTimestampMicros::new(sample_us),
+                    value01: (value + 0.25) / PERSONAL_TILT_PHASE_SCALE,
+                },
+            );
+            if sample_us == 800_000 {
+                let expected = 0.25 * f64::exp(-400_000.0 / 300_000.0) / PERSONAL_TILT_PHASE_SCALE;
+                assert!(
+                    (observation.filtered_derivative_per_second.unwrap() - expected).abs() < 1e-10,
+                    "decay must depend on source elapsed time, not observation count or receipt cadence"
+                );
+                assert_eq!(observation.candidate, CommonBreathPhase::Inhale);
+            }
+            if sample_us == 880_000 {
+                assert_eq!(observation.candidate, CommonBreathPhase::Hold);
+                assert_eq!(observation.phase, CommonBreathPhase::Inhale);
+            }
+        }
+        assert_eq!(runtime.personal_tilt_classifier.phase(), CommonBreathPhase::Hold);
+    }
+}
