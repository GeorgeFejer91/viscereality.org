+        JSONObject apply(JSONObject request, LocalEnrollmentGuard admission) throws Exception {
+            Object playing = request.opt("playing");
+            Object level = request.opt("volume");
+            if (request.length() != 2 || !Integer.valueOf(1).equals(request.opt("v"))
+                    || !(playing instanceof Boolean || level instanceof Integer
+                        && (Integer) level >= 0 && (Integer) level <= 100)) {
+                throw new IllegalArgumentException("closed-background-music-request-required");
+            }
+            if (Boolean.TRUE.equals(playing)) {
+                if (player == null) start(admission);
+            } else if (Boolean.FALSE.equals(playing)) {
+                stop();
+            } else if (volume != (Integer) level) {
+                if ("playing".equals(state)) {
+                    try {
+                        setGain(player, (Integer) level);
+                    } catch (RuntimeException unavailable) {
+                        release("failed");
+                        throw unavailable;
+                    }
+                }
+                volume = (Integer) level;
+                revision++;
+            }
+            return status();
+        }
+
+        private void start(LocalEnrollmentGuard admission) {
+            try {
+                player = new MediaPlayer();
+                state = "starting";
+                revision++;
+                try (AssetFileDescriptor track = assets.openFd(TRACK)) {
+                    player.setDataSource(track.getFileDescriptor(), track.getStartOffset(), track.getLength());
+                }
+                player.setLooping(true);
+                player.setOnPreparedListener(ready -> {
+                    if (player != ready) return;
+                    main.removeCallbacks(preparationTimeout);
+                    try {
+                        admission.check();
+                        setGain(ready, volume);
+                        ready.start();
+                        state = "playing";
+                        revision++;
+                    } catch (Exception unavailable) {
+                        release("failed");
+                    }
+                });
+                player.setOnErrorListener((failed, reason, detail) -> {
+                    if (player == failed) release("failed");
+                    return true;
+                });
+                main.postDelayed(preparationTimeout, 10_000L);
+                player.prepareAsync();
+            } catch (IOException | RuntimeException unavailable) {
+                release("failed");
+            }
+        }
+
+        private static void setGain(MediaPlayer player, int volume) {
