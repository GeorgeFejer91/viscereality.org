+#[test]
+fn rejected_main_cancellation_preserves_the_calibrated_input_and_allows_fresh_retry() {
+    let (mut r, frame, now) = calibrated_inhale_runtime();
+    let prepared = r.status(now);
+    let model = r.core.model().map(|m| (m.generation, m.source_owner, m.axis, m.low, m.high));
+    assert_eq!(command(&mut r, 20, "begin-main", now)["accepted"], true);
+    let queued = r.status(now);
+    let mut cancel = json!({"v":1,"id":"0000000000000015","g":queued["g"],
+        "r":queued["r"],"op":"cancel-main","main_start_frame":queued["main_start_frame"]});
+    assert_eq!(r.command(&cancel, now)["accepted"], true);
+    let restored = r.status(now);
+    assert_eq!(restored["input"], prepared["input"]);
+    assert_eq!(restored["calibration"], "ready");
+    assert_eq!(restored["attempt"], prepared["attempt"]);
+    assert_eq!(restored["position_frames"], frame);
+    assert_eq!(restored["playing"], true);
+    assert_eq!(restored["ready"], true);
+    assert_eq!(restored["main_start_frame"], Value::Null);
+    assert_eq!(r.core.model().map(|m| (m.generation, m.source_owner, m.axis, m.low, m.high)), model);
+    assert_eq!(command(&mut r, 22, "begin-main", now)["accepted"], true);
+    // A different cancellation cannot retire the new reservation.
+    cancel["id"] = json!("0000000000000017");
+    cancel["r"] = r.status(now)["r"].clone();
+    cancel["main_start_frame"] = json!(123);
+    assert_eq!(r.command(&cancel, now)["reason"], "main-frame-mismatch");
+    assert_eq!(r.status(now)["stage"], "main-pending");
+}
