+#[test]
+fn a_missed_official_start_rearms_a_future_cycle_without_consuming_main_duration() {
+    let (mut r, frame, now) = calibrated_inhale_runtime();
+    assert_eq!(command(&mut r, 20, "begin-main", now)["accepted"], true);
+    for tick in 1..=800 {
+        let at = now + tick * 20_000_000;
+        r.observe_clock(7, frame + tick * 882, at, true);
+        r.observe_host_aligned_acc(100_000_000_000 + at, at, vector(0.2));
+    }
+    let at = now + 16_000_000_000;
+    let old = r.status(at);
+    assert_eq!(old["stage"], "main");
+    let deferred = json!({"v":1,"id":"0000000000000015","g":old["g"],"r":old["r"],
+        "op":"defer-main","main_start_frame":old["main_start_frame"]});
+    assert_eq!(r.command(&deferred, at)["accepted"], true);
+    let next = r.status(at);
+    assert_eq!(next["stage"], "main-pending");
+    assert_eq!(next["experiment_elapsed_ms"], 0);
+    assert!(next["main_start_frame"].as_u64().unwrap() > old["position_frames"].as_u64().unwrap());
+    assert_eq!(next["calibration"], "ready");
+    assert_eq!(r.command(&deferred, at)["accepted"], true);
+    assert_eq!(r.status(at)["main_start_frame"], next["main_start_frame"], "same operation is never replayed");
+}
