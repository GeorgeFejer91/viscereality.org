+#[test]
+fn queued_polar_start_waits_through_one_delayed_batch_without_admitting_stale_input() {
+    let (mut r, frame, now) = calibrated_inhale_runtime();
+    assert_eq!(command(&mut r, 20, "begin-main", now)["accepted"], true);
+    // A 36-sample/200 Hz H10 packet spans 180 ms. One delayed packet can
+    // exceed the 250 ms audio history while still inside acquisition's 1 s
+    // liveness window. It supplies neither fresh samples nor Start readiness.
+    for tick in 1..=20 {
+        let at = now + tick * 20_000_000;
+        r.observe_clock(7, frame + tick * 882, at, true);
+    }
+    let waiting = r.status(now + 400_000_000);
+    assert_eq!(waiting["stage"], "main-pending");
+    assert_eq!(waiting["ready"], false);
+    assert_eq!(waiting["main_started"], false);
+    assert!(r.core.model().is_some());
+    for tick in 21..=850 {
+        let at = now + tick * 20_000_000;
+        r.observe_clock(7, frame + tick * 882, at, true);
+        r.observe_host_aligned_acc(100_000_000_000 + at, at, vector(0.2));
+    }
+    let started = r.status(now + 17_000_000_000);
+    assert_eq!(started["stage"], "main");
+    assert_eq!(started["main_started"], true);
+    assert_eq!(started["ready"], true);
+}
