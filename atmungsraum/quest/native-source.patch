+#[test]
+fn recovery_timeout_source_retirement_and_cas_never_grant_late_effects() {
+    let (mut r, request, now) = stalled_recovery_runtime();
+    let id = request["id"].as_str().unwrap();
+    assert_eq!(r.recovery_effect(id, 7, 8, "claim", now)["effect"], true);
