+        String[] previous=requests.get(requestKey);
+        if(previous!=null){if(!canonical.equals(previous[0]))throw new SecurityException("controller-access-id-reused");return new JSONObject(previous[1]);}
+        if(requests.size()>=256)throw new SecurityException("controller-access-request-capacity");
+        expire(now);
+        if(((Number)expected).longValue()!=revision)throw new SecurityException("controller-access-revision-stale");
+        if("claim".equals(op)){
+            if(!active.isEmpty()&&!active.equals(controller))throw new SecurityException("controller-access-busy");
+            if(active.isEmpty())changeOwner(controller,now+LEASE_MS);
+        }else{
+            if(!active.equals(controller))throw new SecurityException("controller-access-release-not-owner");
