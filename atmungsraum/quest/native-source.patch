+    interface Checked { void run() throws Exception; }
+    static void check(boolean value,String why) { checks++;if(!value)throw new AssertionError(why); }
+    static void deny(Checked action) throws Exception { checks++;try{action.run();}catch(Exception expected){return;}throw new AssertionError("unexpected admission"); }
+    static final class Store implements ExperimentTrustedPhones.Store {
