+fn explicit_method_and_runtime_owner_changes_discard_retired_visual_diagnosis() {
+    use crate::breath_composition_driver::{
+        tests::{settings, setup_frame_with_lineage},
+        BreathCompositionDriver,
+    };
+    for transition in ["method", "controller", "owner", "reset"] {
+        let (mut r, frame, now) =
+            polar_diagnosis_runtime(SetupInput::PolarTiltFixed, CommonBreathPhase::Inhale);
+        let mut driver = BreathCompositionDriver::new(settings());
+        setup_frame_with_lineage(
+            &mut driver,
+            r.output(now),
+            r.renderer_lineage(now),
+            now,
+            0.2,
+        );
+        r.observe_clock(7, frame + 13230, now + 300_000_000, true);
+        let at = now + 300_000_000;
+        setup_frame_with_lineage(&mut driver, r.output(at), r.renderer_lineage(at), at, 0.1);
+        let retained = driver.value01();
+        match transition {
+            "method" => {
+                assert_eq!(command(&mut r, 2, "polar-adaptive", at)["accepted"], true);
+            }
+            "controller" => {
+                assert_eq!(command(&mut r, 2, "controller", at)["accepted"], true);
+            }
+            "owner" => {
+                r = runtime();
+                r.observe_clock(7, 0, at, false);
+                r.bind_source((5, 1));
+                r.projection_ready = true;
+                assert_eq!(command(&mut r, 1, "polar-fixed", at)["accepted"], true);
+                r.observe_clock(7, 0, at, true);
+            }
+            _ => {
+                r.core.reset_preparation();
+                r.refresh(at);
+            }
+        }
+        setup_frame_with_lineage(&mut driver, r.output(at), r.renderer_lineage(at), at, 0.1);
+        let expected = if transition == "reset" {
+            r.core.snapshot(at).automatic_volume as f32
+        } else {
+            retained
+        };
+        assert!(
+            (driver.value01() - expected).abs() < 0.000001,
+            "{transition} must discard the old ramp"
+        );
+        if transition != "reset" {
+            setup_frame_with_lineage(
+                &mut driver,
+                SetupDriverOutput::Waiting,
+                r.renderer_lineage(at),
+                at + 20_000_000,
+                0.1,
+            );
+            assert_eq!(
+                driver.value01(),
+                retained,
+                "{transition}: no inherited diagnosis"
+            );
+        }
+    }
