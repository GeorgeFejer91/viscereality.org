@@ -0,0 +1,68 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public final class ScenarioAudioPackageTest {
+    private static void check(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+
+    private static final class Receipt extends OutputStream {
+        long bytes;
+        boolean nonzeroPcm;
+
+        @Override public void write(int value) {
+            if (bytes >= 44 && (value & 255) != 0) nonzeroPcm = true;
+            bytes++;
+        }
+
+        @Override public void write(byte[] data, int offset, int size) {
+            for (int index = offset; index < offset + size; index++) write(data[index]);
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        Path root = Path.of(args[0]).toAbsolutePath();
+        String catalogHash = args[1];
+        ScenarioAudioPackage catalog = ScenarioAudioPackage.open(
+            path -> Files.newInputStream(root.resolve(path)), catalogHash
+        );
+        catalog.verifyAll();
+        String[] ids = { "probe-anleitung", "probe-5", "probe-10", "probe-15", "haupt-15", "box-20" };
+        int[] seconds = { 68, 300, 600, 900, 900, 1200 };
+        for (int i = 0; i < ids.length; i++) {
+            Receipt output = new Receipt();
+            long frames = catalog.writeWave(ids[i], output);
+            check(frames == 44100L * seconds[i], "frame length for " + ids[i]);
+            check(output.bytes == 44 + 2 * frames, "WAV byte length for " + ids[i]);
+            check(!output.nonzeroPcm, "placeholder PCM for " + ids[i]);
+        }
+        try {
+            ScenarioAudioPackage.open(path -> Files.newInputStream(root.resolve(path)), "0".repeat(64));
+            throw new AssertionError("accepted wrong catalog digest");
+        } catch (IOException expected) { }
+
+        ScenarioAudioPackage damaged = ScenarioAudioPackage.open(path -> {
+            if (!path.endsWith("_instruction-1.wav")) return Files.newInputStream(root.resolve(path));
+            byte[] bytes = Files.readAllBytes(root.resolve(path));
+            bytes[44] ^= 1;
+            return new ByteArrayInputStream(bytes);
+        }, catalogHash);
+        Receipt output = new Receipt();
+        try {
+            damaged.verifyAll();
+            throw new AssertionError("accepted a damaged authored cue in preflight");
+        } catch (IOException expected) { }
+        try {
+            damaged.writeWave("haupt-15", output);
+            throw new AssertionError("accepted a damaged authored cue");
+        } catch (IOException expected) {
+            check(output.bytes == 0, "wrote playback bytes before verifying all inputs");
+        }
+        System.out.println("PASS: six native WAV renders, exact frames, silent placeholders, catalog and cue integrity.");
+    }
+}
