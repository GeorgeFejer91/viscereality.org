diff --git a/apps/native-renderer-android/meta-platform/meta_platform_jni.cpp b/apps/native-renderer-android/meta-platform/meta_platform_jni.cpp
new file mode 100644
index 00000000..bb6000fd
--- /dev/null
+++ b/apps/native-renderer-android/meta-platform/meta_platform_jni.cpp
@@ -0,0 +1,44 @@
+#include "meta_platform_transport.hpp"
+#include <OVR_Platform.h>
+#include <jni.h>
+
+static rusty_quest_meta::Queue queue;
+#define JNI_METHOD(name) Java_io_github_mesmerprism_rustyquest_native_1renderer_NativeRendererMetaPlatformTransport_##name
+extern "C" JNIEXPORT jboolean JNICALL JNI_METHOD(nativeBeginAttempt)(JNIEnv*,jclass,jlong attempt){return attempt>0&&queue.begin_attempt(static_cast<std::uint64_t>(attempt));}
+extern "C" JNIEXPORT void JNICALL JNI_METHOD(nativeRetireAttempt)(JNIEnv*,jclass,jlong attempt){if(attempt>0)queue.retire_attempt(static_cast<std::uint64_t>(attempt));}
+extern "C" JNIEXPORT jlong JNICALL JNI_METHOD(nativeRequest)(JNIEnv* env,jclass,jlong attempt,jint operation,jobject activity,jstring app_id) {
+    if(attempt<=0||!queue.admit(static_cast<std::uint64_t>(attempt),operation))return 0;
+    ovrRequest id=0;
+    switch(operation) {
+        case rusty_quest_meta::Initialize: {
+            if(!app_id || !activity)return 0;
+            const char* value=env->GetStringUTFChars(app_id,nullptr);
+            if(!value)return 0;
+            id=ovr_PlatformInitializeAndroidAsynchronous(value,activity,env);
+            env->ReleaseStringUTFChars(app_id,value);break;
+        }
+        case rusty_quest_meta::Version:id=ovr_Application_GetVersion();break;
+        case rusty_quest_meta::Download:id=ovr_Application_StartAppDownload();break;
+        case rusty_quest_meta::Progress:id=ovr_Application_CheckAppDownloadProgress();break;
+        case rusty_quest_meta::Install:id=ovr_Application_InstallAppUpdateAndRelaunch(nullptr);break;
+        case rusty_quest_meta::Cancel:id=ovr_Application_CancelAppDownload();break;
+        default:return 0;
+    }
+    return queue.track(id,operation) ? static_cast<jlong>(id) : 0;
+}
+extern "C" JNIEXPORT jobject JNICALL JNI_METHOD(nativePoll)(JNIEnv* env,jclass) {
+    rusty_quest_meta::Message message;
+    if(!queue.poll(message))return nullptr;
+    jclass type=env->FindClass("io/github/mesmerprism/rustyquest/native_renderer/NativeRendererMetaPlatformTransport$Message");
+    if(!type)return nullptr;
+    jmethodID constructor=env->GetMethodID(type,"<init>","(JIIILjava/lang/String;Ljava/lang/String;Ljava/lang/String;JJIIILjava/lang/String;)V");
+    if(!constructor)return nullptr;
+    jstring error=env->NewStringUTF(message.error_message.c_str());
+    jstring current=env->NewStringUTF(message.current_code.c_str());
+    jstring available=env->NewStringUTF(message.available_code.c_str());
+    jstring result=env->NewStringUTF(message.install_result.c_str());
+    if(!error || !current || !available || !result)return nullptr;
+    return env->NewObject(type,constructor,static_cast<jlong>(message.request_id),message.type,message.sdk_type,message.error_code,
+        error,current,available,static_cast<jlong>(message.downloaded_bytes),static_cast<jlong>(message.total_bytes),message.result_code,message.progress_status,message.http_code,result);
+}
+extern "C" JNIEXPORT void JNICALL JNI_METHOD(nativeClose)(JNIEnv*,jclass){queue.close();}
diff --git a/apps/native-renderer-android/meta-platform/meta_platform_transport.cpp b/apps/native-renderer-android/meta-platform/meta_platform_transport.cpp
new file mode 100644
index 00000000..4f88c0b7
--- /dev/null
+++ b/apps/native-renderer-android/meta-platform/meta_platform_transport.cpp
@@ -0,0 +1,106 @@
+#include "meta_platform_transport.hpp"
+#include <OVR_Platform.h>
+#include <memory>
+
+namespace rusty_quest_meta {
+bool Queue::begin_attempt(std::uint64_t attempt) {
+    if(closed_||!attempt||attempt_)return false;
+    attempt_=attempt;return true;
+}
+void Queue::retire_attempt(std::uint64_t attempt) {
+    if(!attempt||attempt!=attempt_)return;
+    attempt_=0;
+    for(auto it=pending_.begin();it!=pending_.end();) {
+        // Initialization belongs to the process, including a late completion.
+        if(it->second.operation!=Initialize)it=pending_.erase(it);else ++it;
+    }
+}
+bool Queue::admit(std::uint64_t attempt,int operation) {
+    if(closed_||!attempt||attempt!=attempt_||pending_.size()>=16||operation<Initialize||operation>Cancel)return false;
+    if(operation==Initialize){if(initialization_started_)return false;initialization_started_=true;}
+    return true;
+}
+bool Queue::track(std::uint64_t id, int operation) {
+    return !closed_ && attempt_ && id != 0 && operation >= Initialize && operation <= Cancel &&
+        pending_.size() < 16 && pending_.emplace(id, Pending{operation,operation==Initialize?0:attempt_}).second;
+}
+static int operation(ovrMessageType type) {
+    switch(type) {
+        case ovrMessage_PlatformInitializeAndroidAsynchronous:return Initialize;
+        case ovrMessage_Application_GetVersion:return Version;
+        case ovrMessage_Application_StartAppDownload:return Download;
+        case ovrMessage_Application_CheckAppDownloadProgress:return Progress;
+        case ovrMessage_Application_InstallAppUpdateAndRelaunch:return Install;
+        case ovrMessage_Application_CancelAppDownload:return Cancel;
+        default:return 0;
+    }
+}
+static std::string install_result(const char* source) {
+    if(!source)return "UNKNOWN";
+    std::string token,found;
+    for(int i=0;i<=256;++i) {
+        const unsigned char c=static_cast<unsigned char>(source[i]);
+        // Truncated messages cannot supply recovery authority, including a token in their prefix.
+        if(i==256&&c)return "UNKNOWN";
+        if((c>='A'&&c<='Z')||(c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='_')token.push_back(static_cast<char>(c));
+        else {
+            for(const char* known:{"UNKNOWN","LOW_STORAGE","NETWORK_ERROR","DUPLICATE_REQUEST","INSTALLER_ERROR","USER_CANCELLED","AUTHORIZATION_ERROR","SUCCESS"}) {
+                if(token==known){if(!found.empty()&&found!=token)return "UNKNOWN";found=token;}
+            }
+            token.clear();
+        }
+        if(!c)break;
+    }
+    return found.empty()?"UNKNOWN":found;
+}
+bool Queue::poll(Message& out) {
+    if(closed_)return false;
+    // Bound each tick, including unrelated notifications. Free every popped
+    // message, even stale IDs and malformed/error replies.
+    for(int i=0;i<32;++i) {
+        std::unique_ptr<ovrMessage, decltype(&ovr_FreeMessage)> message(ovr_PopMessage(),ovr_FreeMessage);
+        if(!message)return false;
+        auto id=ovr_Message_GetRequestID(message.get());
+        auto found=pending_.find(id);
+        if(found==pending_.end())continue;
+        int expected=found->second.operation;
+        if(found->second.attempt&&found->second.attempt!=attempt_){pending_.erase(found);continue;}
+        pending_.erase(found);
+        out=Message{};
+        out.request_id=id;out.sdk_type=static_cast<int>(ovr_Message_GetType(message.get()));out.type=expected;
+        if(operation(static_cast<ovrMessageType>(out.sdk_type))!=expected) {out.error_code=-1003;out.error_message="response_type_mismatch";return true;}
+        if(ovr_Message_IsError(message.get())) {
+            auto error=ovr_Message_GetError(message.get());
+            out.error_code=error?ovr_Error_GetCode(error):-1001;
+            if(!out.error_code)out.error_code=-1001;
+            const int http=error?ovr_Error_GetHttpCode(error):0;
+            out.http_code=http>=100&&http<=599?http:0;
+            out.install_result=error?install_result(ovr_Error_GetMessage(error)):"UNKNOWN";
+            // Never retain or return the raw technical message (it may contain identities/tokens).
+            out.error_message=out.install_result;
+            return true;
+        }
+        if(expected==Version) {
+            auto payload=ovr_Message_GetApplicationVersion(message.get());
+            if(!payload)out.error_code=-1002;
+            else {out.current_code=std::to_string(ovr_ApplicationVersion_GetCurrentCode(payload));out.available_code=std::to_string(ovr_ApplicationVersion_GetLatestCode(payload));}
+        } else if(expected==Progress) {
+            auto payload=ovr_Message_GetAppDownloadProgressResult(message.get());
+            if(!payload)out.error_code=-1002;
+            else {out.downloaded_bytes=ovr_AppDownloadProgressResult_GetDownloadedBytes(payload);out.total_bytes=ovr_AppDownloadProgressResult_GetDownloadBytes(payload);out.progress_status=ovr_AppDownloadProgressResult_GetStatusCode(payload);}
+        } else if(expected==Initialize) {
+            auto payload=ovr_Message_GetPlatformInitialize(message.get());
+            if(!payload)out.error_code=-1002;
+            else out.result_code=ovr_PlatformInitialize_GetResult(payload);
+        } else {
+            auto payload=ovr_Message_GetAppDownloadResult(message.get());
+            if(!payload)out.error_code=-1002;
+            else out.result_code=ovr_AppDownloadResult_GetAppInstallResult(payload);
+        }
+        if(out.error_code)out.error_message="missing_sdk_payload";
+        return true;
+    }
+    return false;
+}
+void Queue::close(){closed_=true;pending_.clear();}
+}
diff --git a/apps/native-renderer-android/meta-platform/meta_platform_transport.hpp b/apps/native-renderer-android/meta-platform/meta_platform_transport.hpp
new file mode 100644
index 00000000..99c0d5b7
--- /dev/null
+++ b/apps/native-renderer-android/meta-platform/meta_platform_transport.hpp
@@ -0,0 +1,31 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+
+// One process-owned SDK message queue. Its Java owner serializes calls on one
+// worker. No callbacks, render-thread waits, install policy or lifecycle trust.
+namespace rusty_quest_meta {
+enum Operation { Initialize=1, Version=2, Download=3, Progress=4, Install=5, Cancel=6 };
+struct Message {
+    std::uint64_t request_id=0;
+    int type=0, sdk_type=0, error_code=0, result_code=0, progress_status=0, http_code=0;
+    std::string install_result="UNKNOWN";
+    std::string error_message, current_code, available_code;
+    std::int64_t downloaded_bytes=0, total_bytes=-1;
+};
+class Queue {
+public:
+    bool begin_attempt(std::uint64_t attempt);
+    void retire_attempt(std::uint64_t attempt);
+    bool admit(std::uint64_t attempt,int operation);
+    bool track(std::uint64_t id, int operation);
+    bool poll(Message& out);
+    void close();
+private:
+    struct Pending {int operation;std::uint64_t attempt;};
+    std::unordered_map<std::uint64_t, Pending> pending_;
+    std::uint64_t attempt_=0;
+    bool closed_=false, initialization_started_=false;
+};
+}
