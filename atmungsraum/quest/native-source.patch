+/** One explicitly selected process-owned PCM player. Native owns all setup/model decisions. */
+final class BreathingSetupAudio implements AutoCloseable {
+    private static final String ENABLED = "rusty.quest.experiment.breathing_setup.enabled";
+    private static final String ROOT = "atmungsraum-audio/";
