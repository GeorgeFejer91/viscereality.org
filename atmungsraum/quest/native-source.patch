@@ -0,0 +1,134 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference='Stop'
+$script:Checker=Join-Path $PSScriptRoot 'meta_platform_packaging.py'
+function Invoke-MetaPlatformChecker([string[]]$Arguments) {
+    $value=@(& python $script:Checker @Arguments)
+    if($LASTEXITCODE -ne 0){throw 'Meta Platform artifact/closure verification failed.'}
+    ($value -join "`n") | ConvertFrom-Json
+}
+function Get-NativeRendererMetaPlatformUpdateSelection {
+    param([AllowNull()]$FeatureLock,[string]$AndroidManifestPath,[switch]$Enable,
+        [string]$SdkRoot='', [string]$HeadersSha256='', [string]$LoaderSha256='', [string]$ArchiveSha256='')
+    $selected=$null -ne $FeatureLock -and $null -ne $FeatureLock.android_manifest.PSObject.Properties['experiment_meta_update_enabled'] -and
+        $FeatureLock.android_manifest.experiment_meta_update_enabled -ceq $true
+    $appId='';$policyUrl='';$helper=$false
+    if($selected){
+        if($null -eq $FeatureLock.android_manifest.PSObject.Properties['meta_platform_app_id']){throw 'Meta updater selected without locked App ID.'}
+        $appId=[string]$FeatureLock.android_manifest.meta_platform_app_id
+        $policyUrl=[string]$FeatureLock.android_manifest.meta_required_version_manifest_url
+        $helper=$FeatureLock.android_manifest.experiment_meta_update_helper_enabled
+        if($helper -isnot [bool]){throw 'Meta helper selection must be Boolean.'}
+    }
+    if($selected -ne [bool]$Enable){throw 'Meta updater requires matching app composition and explicit build opt-in.'}
+    if($selected -and (@($FeatureLock.selected_feature_ids) -cnotcontains 'ui.experiment_session_command_gateway' -or
+        @($FeatureLock.selected_feature_ids) -cnotcontains 'ui.breath_composition_control_panel' -or
+        (@($FeatureLock.selected_feature_ids) -cnotcontains 'ui.native_mesh_panel.original_product' -and @($FeatureLock.selected_feature_ids) -cnotcontains 'ui.native_mesh_panel'))){
+        throw 'Meta updater requires original native panel and experiment gateway.'
+    }
+    $arguments=@('select','--app-id',$appId,'--sdk-root',$SdkRoot,'--headers-sha256',$HeadersSha256,'--loader-sha256',$LoaderSha256,'--archive-sha256',$ArchiveSha256,'--policy-url',$policyUrl)
+    if($selected){$arguments+='--enabled'}
+    if($helper){$arguments+='--helper'}
+    $selection=Invoke-MetaPlatformChecker $arguments
+    [xml]$manifest=[IO.File]::ReadAllText($AndroidManifestPath)
+    $ns=[Xml.XmlNamespaceManager]::new($manifest.NameTable);$ns.AddNamespace('a','http://schemas.android.com/apk/res/android')
+    $metadata=@($manifest.SelectNodes('/manifest/application/meta-data[starts-with(@a:name,"rusty.quest.meta_update.") or @a:name="com.oculus.sdk.appid" or @a:name="org.viscereality.atmungsraum.boot_protocol"]',$ns))
+    if($selected){
+        if($metadata.Count -ne $(if($helper){6}else{5})){throw 'Meta updater manifest metadata closure differs.'}
+        foreach($pair in @(@('rusty.quest.meta_update.enabled','true'),@('rusty.quest.meta_update.app_id',$appId),@('com.oculus.sdk.appid',$appId),@('rusty.quest.meta_update.required_manifest_url',$policyUrl),@('rusty.quest.meta_update.helper_enabled',$helper.ToString().ToLowerInvariant()))){
+            $rows=@($metadata | Where-Object {$_.GetAttribute('name',$ns.LookupNamespace('a')) -ceq $pair[0]})
+            if($rows.Count -ne 1 -or $rows[0].GetAttribute('value',$ns.LookupNamespace('a')) -cne $pair[1]){throw 'Meta updater manifest metadata value differs.'}
+        }
+        $permission=@($manifest.SelectNodes('/manifest/uses-permission[@a:name="org.viscereality.atmungsraum.boot.permission.UPDATE_HANDOFF"]',$ns))
+        if($permission.Count -ne $(if($helper){1}else{0})){throw 'Helper signature permission closure differs.'}
+        $helperQueries=@($manifest.SelectNodes('/manifest/queries/package[@a:name="org.viscereality.atmungsraum.boot"]',$ns))
+        if($helperQueries.Count -ne $(if($helper){1}else{0})){throw 'Helper exact package visibility closure differs.'}
+        if($helper){$protocol=@($metadata|Where-Object {$_.GetAttribute('name',$ns.LookupNamespace('a')) -ceq 'org.viscereality.atmungsraum.boot_protocol'});if($protocol.Count -ne 1 -or $protocol[0].GetAttribute('value',$ns.LookupNamespace('a')) -cne '3'){throw 'Helper monitor3 protocol metadata invalid.'}}
+    }elseif($metadata.Count){throw 'Unselected Meta updater metadata.'}
+    return $selection
+}
+function Build-NativeRendererMetaPlatformUpdate {
+    param([Parameter(Mandatory)]$Selection,[string]$RepoRoot,[string]$SdkRoot,[string]$NdkHome,[string]$OutputRoot,[string]$NativeStageRoot)
+    if(-not $Selection.enabled){return $Selection}
+    # Re-observe all external/compiler bytes immediately before use, and compare
+    # to the original in-memory closure rather than a mutable evidence file.
+    $selectionArguments=@('select','--enabled','--app-id',$Selection.app_id,'--sdk-root',$SdkRoot,
+        '--headers-sha256',$Selection.headers_sha256,'--loader-sha256',$Selection.loader.sha256,'--archive-sha256',$Selection.archive_sha256,'--policy-url',$Selection.policy_url)
+    if($Selection.helper_enabled){$selectionArguments+='--helper'}
+    $current=Invoke-MetaPlatformChecker $selectionArguments
+    if($current.fingerprint -cne $Selection.fingerprint){throw 'Meta updater selection drifted before compile.'}
+    $ndkProperties=[IO.File]::ReadAllText((Join-Path $NdkHome 'source.properties'))
+    if($ndkProperties -notmatch '(?m)^Pkg\.Revision\s*=\s*27\.2\.12479018\s*$'){throw 'Meta JNI requires explicit NDK27.2.12479018.'}
+    foreach($row in $Selection.sources){
+        $path=Join-Path $RepoRoot $row.path
+        if((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() -cne $row.sha256){throw 'Meta transport source drifted.'}
+    }
+    $directory=Join-Path $NativeStageRoot 'lib/arm64-v8a'
+    [void][IO.Directory]::CreateDirectory($directory)
+    $loader=Join-Path $directory 'libovrplatformloader.so'
+    [IO.File]::Copy($Selection.loader.source_path,$loader,$false)
+    if((Get-FileHash -LiteralPath $loader -Algorithm SHA256).Hash.ToLowerInvariant() -cne $Selection.loader.sha256){throw 'Meta loader staging hash mismatch.'}
+    foreach($notice in $Selection.notices){
+        $target=Join-Path $OutputRoot $notice.apk_path
+        [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target))
+        [IO.File]::Copy($notice.source_path,$target,$false)
+        if((Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash.ToLowerInvariant() -cne $notice.sha256){throw 'Meta notice staging hash mismatch.'}
+    }
+    $jni=Join-Path $directory 'librusty_quest_meta_platform.so'
+    $clang=Join-Path $NdkHome 'toolchains/llvm/prebuilt/windows-x86_64/bin/aarch64-linux-android29-clang++.cmd'
+    $source=Join-Path $RepoRoot 'apps/native-renderer-android/meta-platform'
+    & $clang -std=c++17 -O2 -shared -fPIC -fvisibility=hidden -fno-exceptions -fno-rtti -static-libstdc++ `
+        '-Wl,-z,max-page-size=16384' '-Wl,-z,common-page-size=16384' '-Wl,--no-undefined' '-Wl,-soname,librusty_quest_meta_platform.so' `
+        '-I' (Join-Path $SdkRoot 'Include') (Join-Path $source 'meta_platform_transport.cpp') (Join-Path $source 'meta_platform_jni.cpp') $loader -o $jni
+    if($LASTEXITCODE -ne 0){throw 'Meta Platform JNI compilation failed.'}
+    $after=Invoke-MetaPlatformChecker $selectionArguments
+    if($after.fingerprint -cne $Selection.fingerprint){throw 'Meta updater source/artifact drifted during compile.'}
+    $elf=Invoke-MetaPlatformChecker @('elf-jni','--library',$jni)
+    $Selection | Add-Member -NotePropertyName jni -NotePropertyValue ([pscustomobject]@{
+        apk_path='lib/arm64-v8a/librusty_quest_meta_platform.so';sha256=(Get-FileHash -LiteralPath $jni -Algorithm SHA256).Hash.ToLowerInvariant();bytes=(Get-Item -LiteralPath $jni).Length;elf=$elf
+    })
+    $Selection
+}
+function Assert-NativeRendererMetaPlatformHelperProtocol {
+    param([string[]]$Lines,[bool]$Enabled)
+    $names=@($Lines|Select-String -SimpleMatch '"org.viscereality.atmungsraum.boot_protocol"')
+    $permissions=@($Lines|Select-String -SimpleMatch '"org.viscereality.atmungsraum.boot.permission.UPDATE_HANDOFF"')
+    $queries=@($Lines|Select-String -SimpleMatch '"org.viscereality.atmungsraum.boot"')
+    if($names.Count -ne $(if($Enabled){1}else{0}) -or $permissions.Count -ne $(if($Enabled){1}else{0})){throw 'Final APK helper protocol/permission closure differs.'}
+    if($queries.Count -ne $(if($Enabled){1}else{0})){throw 'Final APK helper exact package visibility closure differs.'}
+    if($Enabled){
+        $index=0;while($index -lt $Lines.Count -and -not $Lines[$index].Contains('"org.viscereality.atmungsraum.boot_protocol"')){$index++}
+        if($index+1 -ge $Lines.Count -or $Lines[$index+1] -cnotmatch ':value\(0x[0-9a-f]+\)=3$'){throw 'Final APK helper monitor protocol must be3.'}
+    }
+}
+function Assert-NativeRendererMetaPlatformUpdateApk {
+    param([Parameter(Mandatory)]$Selection,[string]$ApkPath,[string]$EvidenceRoot,[string]$Aapt2)
+    $selectionFile=Join-Path $EvidenceRoot 'meta-platform-selection.json'
+    $Selection | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $selectionFile -Encoding utf8NoBOM
+    $receipt=Invoke-MetaPlatformChecker @('verify-apk','--selection',$selectionFile,'--apk',$ApkPath)
+    $lines=@(& $Aapt2 dump xmltree $ApkPath --file AndroidManifest.xml 2>&1 | ForEach-Object ToString)
+    if($LASTEXITCODE -ne 0){throw 'Cannot inspect final Meta updater manifest.'}
+    $text=$lines -join "`n"
+    $keys=@('com.oculus.sdk.appid','rusty.quest.meta_update.enabled','rusty.quest.meta_update.app_id','rusty.quest.meta_update.required_manifest_url','rusty.quest.meta_update.helper_enabled')
+    foreach($key in $keys){
+        $count=@($lines | Select-String -SimpleMatch ('"'+$key+'"')).Count
+        if($count -ne $(if($Selection.enabled){1}else{0})){throw 'Final APK Meta metadata closure differs.'}
+    }
+    if($Selection.enabled){
+        # AAPT output has each metadata element followed by a name and value.
+        foreach($key in @('com.oculus.sdk.appid','rusty.quest.meta_update.app_id')){
+            $index=0;while($index -lt $lines.Count -and -not $lines[$index].Contains('"'+$key+'"')){$index++}
+            $id=[regex]::Escape($Selection.app_id)
+            if($index+1 -ge $lines.Count -or $lines[$index+1] -cnotmatch (':value\(0x[0-9a-f]+\)=(?:'+$id+'|"'+$id+'" \(Raw: "'+$id+'"\))$')){throw 'Final APK Meta App ID differs.'}
+        }
+        $index=0;while($index -lt $lines.Count -and -not $lines[$index].Contains('"rusty.quest.meta_update.enabled"')){$index++}
+        if($index+1 -ge $lines.Count -or $lines[$index+1] -cnotmatch ':value\(0x[0-9a-f]+\)=true$'){throw 'Final APK Meta enable flag differs.'}
+        foreach($pair in @(@('rusty.quest.meta_update.required_manifest_url',$Selection.policy_url),@('rusty.quest.meta_update.helper_enabled',$Selection.helper_enabled.ToString().ToLowerInvariant()))){
+            $index=0;while($index -lt $lines.Count -and -not $lines[$index].Contains('"'+$pair[0]+'"')){$index++}
+            if($index+1 -ge $lines.Count -or -not ($lines[$index+1].EndsWith('='+$pair[1]) -or $lines[$index+1].Contains('Raw: "'+$pair[1]+'"'))){throw 'Final APK required policy/helper metadata differs.'}
+        }
+        Assert-NativeRendererMetaPlatformHelperProtocol -Lines $lines -Enabled $Selection.helper_enabled
+    }
+    $receipt | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $EvidenceRoot 'meta-platform-apk-closure.json') -Encoding utf8NoBOM
+    $receipt
+}
+Export-ModuleMember -Function Get-NativeRendererMetaPlatformUpdateSelection,Build-NativeRendererMetaPlatformUpdate,Assert-NativeRendererMetaPlatformUpdateApk,Assert-NativeRendererMetaPlatformHelperProtocol
