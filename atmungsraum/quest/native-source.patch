+package io.github.mesmerprism.rustyquest.native_renderer;
+
+/** Owns the two one-shot cues for a calibration started from the visible menu. */
+final class CalibrationPromptSequence {
+    private static final long INHALE_WINDOW_MS = 4_000;
+
+    interface Host {
+        boolean play(String cue);
+        void stopAudio();
+        boolean isCollecting(long generation);
+        void schedule(Runnable cue, long delayMs);
+        void cancel(Runnable cue);
+    }
+
+    private final Host host;
+    private long generation;
+    private Runnable exhale;
+
+    CalibrationPromptSequence(Host host) {
+        this.host = host;
+    }
+
+    void start(long nextGeneration) {
+        if (nextGeneration <= 0 || nextGeneration == generation || !host.isCollecting(nextGeneration)) {
+            return;
+        }
+        stop();
+        if (!host.play("inhale")) return;
+        generation = nextGeneration;
+        exhale = new Runnable() {
+            @Override public void run() {
+                if (exhale != this) return;
+                exhale = null;
+                if (host.isCollecting(nextGeneration)) {
+                    host.play("exhale");
+                } else {
+                    stop();
+                }
+            }
+        };
+        host.schedule(exhale, INHALE_WINDOW_MS);
+    }
+
+    void stop() {
+        if (exhale != null) host.cancel(exhale);
+        exhale = null;
+        generation = 0;
+        host.stopAudio();
+    }
+}
