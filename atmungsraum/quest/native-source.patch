+ $appBuildLockObject=if($case-ceq'off'){$off|ConvertTo-Json -Depth 100|ConvertFrom-Json -Depth 100}else{$on|ConvertTo-Json -Depth 100|ConvertFrom-Json -Depth 100}
+ $repoRoot=$repo;$script:BuildUsesLock=$true
+ switch($case){
+  'missing-sources' {$appBuildLockObject.PSObject.Properties.Remove('phone_pairing_sources')}
+  'wrong-hash' {$appBuildLockObject.phone_pairing_sources[0].sha256='0'*64}
+  'wrong-path' {$appBuildLockObject.phone_pairing_sources[0].path='unexpected.java'}
+  'disabled' {$appBuildLockObject.android_manifest.experiment_phone_pairing_enabled=$false}
