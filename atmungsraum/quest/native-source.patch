+            Self::InvalidSchedule => "invalid_schedule",
+            Self::InputNotReady => "input_not_ready",
+            Self::ExperimentActive => "experiment_active",
+            Self::ReorderedSample => "reordered_sample",
+            Self::ClockStale => "clock_stale",
+            Self::SourceReplaced => "source_replaced",
+            Self::ClockRetired => "clock_retired",
+            Self::ClockReversed => "clock_reversed",
+            Self::SignalGap => "signal_gap",
+            Self::InvalidSample => "invalid_sample",
+            Self::ExcessiveMotion => "excessive_motion",
+            Self::InsufficientCoverage => "insufficient_coverage",
+            Self::InsufficientRange => "insufficient_range",
+            Self::ClockStalled => "clock_stalled",
