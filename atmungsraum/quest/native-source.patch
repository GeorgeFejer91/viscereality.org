+    let now = base_ns + 800_000_000;
+    r.observe_clock(
+        7,
+        base_frame + (now - base_ns) * 44100 / 1_000_000_000,
+        now,
+        true,
+    );
+    setup_frame(&mut driver, r.output(now), now, 0.1);
+    assert_eq!(
+        driver.value01(),
+        held,
+        "newly confirmed Hold must freeze progress"
+    );
+}
