+fn stalled_recovery_runtime() -> (Runtime, Value, u64) {
+    let mut r = runtime();
+    r.observe_clock(7, 0, 1_000_000_000, false);
+    r.bind_source((5, 1));
+    r.projection_ready = true;
+    assert_eq!(
+        command(&mut r, 1, "calibrate", 1_000_000_000)["accepted"],
+        true
+    );
+    r.observe_clock(7, 0, 1_020_000_000, true);
+    r.observe_clock(7, 882, 1_040_000_000, true);
+    for tick in 1..=14 {
+        r.observe_clock(7, 882, 1_040_000_000 + tick * 20_000_000, true);
+    }
+    let now = 1_320_000_000;
+    let status = r.status(now);
+    let request =
+        json!({"v":1,"id":"0000000000000002","g":status["g"],"r":status["r"],"op":"calibrate"});
+    assert_eq!(r.command(&request, now)["state"], "pending");
+    (r, request, now)
+}
