+  h=queued();h.handoff=false;h.reply(4,0,0,null,null,0,0,5);h.state("restart_required",false);check(!h.queuedExitSeen&&h.pending!=null&&h.nativeInstall,"helper ARM/kiosk failure preserves sticky pending and never exits");
