+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ParticipantId {
+    name: String,
+    age: u64,
+    gender: char,
+}
+
+impl ParticipantId {
+    fn parse(input: &str) -> Result<Self, &'static str> {
+        let mut fields = input.split('_');
+        let name = fields.next().ok_or("participant-id-invalid")?;
+        let age = fields.next().ok_or("participant-id-invalid")?;
+        let gender = match fields.next() {
+            Some("M") => 'M',
+            Some("F") => 'F',
+            Some("O") => 'O',
+            Some("N") => 'N',
+            _ => return Err("participant-id-invalid"),
+        };
+        if fields.next().is_some()
+            || name.chars().count() != 3
+            || !is_nfc(name)
+            || !name.chars().all(|ch| {
+                matches!(
+                    get_general_category(ch),
+                    GeneralCategory::UppercaseLetter
+                        | GeneralCategory::LowercaseLetter
+                        | GeneralCategory::TitlecaseLetter
+                        | GeneralCategory::ModifierLetter
+                        | GeneralCategory::OtherLetter
+                )
+            })
+            || age.is_empty()
+            || !age.bytes().all(|byte| byte.is_ascii_digit())
+            || age.len() > 1 && age.starts_with('0')
+        {
+            return Err("participant-id-invalid");
+        }
+        let age = age
+            .parse::<u64>()
+            .ok()
+            .filter(|value| *value <= 9_007_199_254_740_991)
+            .ok_or("participant-id-invalid")?;
+        Ok(Self {
+            name: name.to_owned(),
+            age,
+            gender,
+        })
+    }
+
+    fn as_text(&self) -> String {
+        format!("{}_{}_{}", self.name, self.age, self.gender)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ParticipantPlan {
+    participant: ParticipantId,
+    scenario: String,
+    sha256: String,
+    seconds: u64,
+    phases: Vec<(u64, String)>,
+}
+
+impl ParticipantPlan {
+    pub(crate) fn parse(value: &Value) -> Result<Self, &'static str> {
+        const BAD: &str = "participant-plan-invalid";
+        value
+            .as_object()
+            .filter(|object| object.len() == 6)
+            .ok_or(BAD)?;
+        let participant = ParticipantId::parse(value["participant_id"].as_str().ok_or(BAD)?)?;
+        let scenario = value["scenario_id"].as_str().ok_or(BAD)?;
+        let seconds = scenario_seconds(scenario).ok_or(BAD)?;
+        let sha256 = value["scenario_sha256"]
+            .as_str()
+            .filter(|value| valid_hash(value))
+            .ok_or(BAD)?;
+        let rate = value["sample_rate"]
+            .as_u64()
+            .filter(|rate| (8000..=48000).contains(rate))
+            .ok_or(BAD)?;
+        let frames = value["total_frames"]
+            .as_u64()
+            .filter(|frames| *frames == seconds * rate)
+            .ok_or(BAD)?;
+        let input = value["phases"]
+            .as_array()
+            .filter(|input| (1..=256).contains(&input.len()))
+            .ok_or(BAD)?;
+        let mut phases = Vec::with_capacity(input.len());
+        for raw in input {
+            let pair = raw.as_array().filter(|pair| pair.len() == 2).ok_or(BAD)?;
+            let offset = pair[0]
+                .as_u64()
+                .filter(|offset| *offset < frames)
+                .ok_or(BAD)?;
+            let name = pair[1]
+                .as_str()
+                .filter(|name| valid_phase(name))
+                .ok_or(BAD)?;
+            let nanos = (offset * 1_000_000_000).div_ceil(rate);
+            if phases
+                .last()
+                .is_some_and(|(previous, _)| *previous >= nanos)
+            {
+                return Err(BAD);
+            }
+            phases.push((nanos, name.to_owned()));
+        }
+        if phases[0].0 != 0 {
+            return Err(BAD);
+        }
+        Ok(Self {
+            participant,
+            scenario: scenario.to_owned(),
+            sha256: sha256.to_owned(),
+            seconds,
+            phases,
+        })
+    }
+
+    fn condition(&self) -> &'static str {
+        if self.scenario == "haupt-15" {
+            "main"
+        } else {
+            "probe"
+        }
+    }
+
+    pub(crate) fn completion_threshold_ns(&self) -> u64 {
+        if self.scenario == "probe-anleitung" {
+            u64::MAX
+        } else {
+            self.seconds * 1_000_000_000
+        }
+    }
+
+    fn phase_at(&self, elapsed_ns: u64) -> &str {
+        let phase = self
+            .phases
+            .partition_point(|(offset, _)| *offset <= elapsed_ns);
+        phase
+            .checked_sub(1)
+            .map_or("unknown", |index| self.phases[index].1.as_str())
+    }
+}
+
+fn scenario_seconds(scenario: &str) -> Option<u64> {
+    match scenario {
+        "probe-anleitung" => Some(68),
+        "probe-5" => Some(300),
+        "probe-10" => Some(600),
+        "probe-15" | "haupt-15" => Some(900),
+        _ => None,
+    }
+}
+
+fn valid_phase(name: &str) -> bool {
+    (1..=32).contains(&name.len())
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')
+}
+
+#[derive(Debug)]
+pub(crate) struct ParticipantRun {
+    plan: ParticipantPlan,
+    index: u64,
+    uuid: String,
+}
+
+impl ParticipantRun {
+    pub(crate) fn reserve(root: &Path, plan: ParticipantPlan) -> Result<Self, String> {
+        let participant = plan.participant.as_text();
+        let group = Sha256::digest(format!("{participant}|{}", plan.condition()).as_bytes());
+        let prefix = format!("participant-{group:x}-");
+        let mut last = 0;
+        for entry in fs::read_dir(root).map_err(io_error)? {
+            let entry = entry.map_err(io_error)?;
+            let name = entry.file_name();
+            if let Some(index) = name
+                .to_str()
+                .and_then(|name| name.strip_prefix(&prefix))
+                .and_then(|value| value.strip_suffix(".reserve"))
+                .and_then(|value| value.parse::<u64>().ok())
+            {
+                last = last.max(index);
+            }
+        }
+        let uuid = new_session_id()?;
+        loop {
+            let index = last
+                .checked_add(1)
+                .ok_or("participant-run-index-exhausted")?;
+            let marker = root.join(format!("{prefix}{index}.reserve"));
+            match OpenOptions::new().write(true).create_new(true).open(marker) {
+                Ok(mut file) => {
+                    writeln!(file, "{uuid}").map_err(io_error)?;
+                    file.sync_all().map_err(io_error)?;
+                    sync_directory(root)?;
+                    return Ok(Self { plan, index, uuid });
+                }
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => last = index,
+                Err(error) => return Err(io_error(error)),
+            }
+        }
+    }
+
+    pub(crate) fn restore(value: &Value) -> Result<Self, &'static str> {
+        const BAD: &str = "participant-recovery-metadata-invalid";
+        let participant = ParticipantId::parse(value["participant_id"].as_str().ok_or(BAD)?)?;
+        let scenario = value["scenario_id"].as_str().ok_or(BAD)?;
+        let seconds = scenario_seconds(scenario).ok_or(BAD)?;
+        let sha256 = value["scenario_sha256"]
+            .as_str()
+            .filter(|hash| valid_hash(hash))
+            .ok_or(BAD)?;
+        let index = value["run_index"]
+            .as_u64()
+            .filter(|index| (1..10_000_000_000_000_000).contains(index))
+            .ok_or(BAD)?;
+        let uuid = value["session_id"]
+            .as_str()
+            .filter(|uuid| valid_uuid(uuid))
+            .ok_or(BAD)?;
+        let mut phases = Vec::new();
+        if let Some(offsets) = value.get("phase_offsets_ns") {
+            let offsets = offsets
+                .as_array()
+                .filter(|offsets| (1..=256).contains(&offsets.len()))
+                .ok_or(BAD)?;
+            for phase in offsets {
+                let pair = phase.as_array().filter(|pair| pair.len() == 2).ok_or(BAD)?;
+                let offset = pair[0]
+                    .as_u64()
+                    .filter(|offset| *offset < seconds * 1_000_000_000)
+                    .ok_or(BAD)?;
+                let name = pair[1]
+                    .as_str()
+                    .filter(|name| valid_phase(name))
+                    .ok_or(BAD)?;
+                if phases
+                    .last()
+                    .map_or(offset != 0, |(previous, _)| *previous >= offset)
+                {
+                    return Err(BAD);
+                }
+                phases.push((offset, name.to_owned()));
+            }
+        }
+        let run = Self {
+            plan: ParticipantPlan {
+                participant,
+                scenario: scenario.to_owned(),
+                sha256: sha256.to_owned(),
+                seconds,
+                phases,
+            },
+            index,
+            uuid: uuid.to_owned(),
+        };
+        if &run.metadata() != value {
+            return Err(BAD);
+        }
+        Ok(run)
+    }
+
+    pub(crate) fn metadata(&self) -> Value {
+        let mut metadata = json!({
+            "participant_id": self.plan.participant.as_text(),
+            "name_prefix": self.plan.participant.name,
+            "age_years": self.plan.participant.age,
+            "gender_code": self.plan.participant.gender,
+            "condition": self.plan.condition(),
+            "run_index": self.index,
+            "session_id": self.uuid,
+            "scenario_id": self.plan.scenario,
+            "scenario_sha256": self.plan.sha256,
+            "planned_duration_seconds": self.plan.seconds,
+        });
+        if !self.plan.phases.is_empty() {
+            metadata["phase_offsets_ns"] = json!(self.plan.phases);
+        }
+        metadata
+    }
+
+    pub(crate) fn filename(&self) -> String {
+        format!(
+            "{}_{}{}.csv",
+            self.plan.participant.as_text(),
+            self.plan.condition(),
+            self.index
+        )
+    }
+
+    pub(crate) fn finalize_csv(
+        &self,
+        directory: &Path,
+        anchor: ClockAnchor,
+        ended_at: MonotonicNanos,
+        complete: bool,
+        reason: &str,
+    ) -> Result<Option<Value>, String> {
+        let events = File::open(directory.join("events.jsonl")).map_err(io_error)?;
+        let Some(clock) = PlaybackClock::read(BufReader::new(events), Some(ended_at.get()))? else {
+            return Ok(None);
+        };
+        let source = directory.join("polar-ecg.jsonl");
+        let signal_sha = file_hash(&source)?;
+        let ecg = File::open(source).map_err(io_error)?;
+        let name = self.filename();
+        let (descriptor, _) = self.write_csv(CsvProjection {
+            destination: directory.join(name),
+            anchor,
+            cutoff: Some(ended_at.get()),
+            clock,
+            signal_sha: &signal_sha,
+            ecg: BufReader::new(ecg),
+            complete,
+            reason,
+        })?;
+        Ok(Some(descriptor))
+    }
+
+    pub(crate) fn recover_csv(
+        &self,
+        directory: &Path,
+        anchor: ClockAnchor,
+        events_bytes: u64,
+        ecg_bytes: u64,
+        signal_sha: &str,
+    ) -> Result<Option<(Value, u64)>, String> {
+        let events = open_regular_recording_file(&directory.join("events.jsonl"))?;
+        let Some(clock) = PlaybackClock::read(BufReader::new(events.take(events_bytes)), None)?
+        else {
+            return Ok(None);
+        };
+        let ecg = open_regular_recording_file(&directory.join("polar-ecg.jsonl"))?;
+        let destination = directory.join(format!("{RECOVERED_CSV_PREFIX}{}", self.filename()));
+        discard_recovery_csv(&destination)?;
+        discard_recovery_csv(&partial_file(&destination))?;
+        self.write_csv(CsvProjection {
+            destination,
+            anchor,
+            cutoff: None,
+            clock,
+            signal_sha,
+            ecg: BufReader::new(ecg.take(ecg_bytes)),
+            complete: false,
+            reason: "interrupted-recovery",
+        })
+        .map(Some)
+    }
+
+    fn write_csv(&self, projection: CsvProjection<impl BufRead>) -> Result<(Value, u64), String> {
+        let CsvProjection {
+            destination,
+            anchor,
+            cutoff,
+            clock,
+            signal_sha,
+            ecg,
+            complete,
+            reason,
+        } = projection;
+        let partial = partial_file(&destination);
+        let mut output = BufWriter::new(
+            OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&partial)
+                .map_err(io_error)?,
+        );
+        output.write_all(HEADER.as_bytes()).map_err(io_error)?;
+        let start = clock.start();
+        let start_utc = utc(anchor, start)?;
+        let metadata = [
+            "1".to_owned(),
+            self.plan.participant.as_text(),
+            self.plan.participant.name.clone(),
+            self.plan.participant.age.to_string(),
+            self.plan.participant.gender.to_string(),
+            self.plan.condition().to_owned(),
+            self.index.to_string(),
+            self.uuid.clone(),
+            self.plan.scenario.clone(),
+            self.plan.sha256.clone(),
+            self.plan.seconds.to_string(),
+            start_utc,
+        ]
+        .join(",");
+        let mut index = 0;
+        let mut previous = None::<u64>;
+        let mut row = |at: u64, sample: Option<Sample>| -> Result<(), String> {
+            let (audio, state) = clock.at(at, self.plan.seconds * 1_000_000_000);
+            let phase = match state {
+                "waiting" | "ended" => state,
+                _ => self.plan.phase_at(audio),
+            };
+            let (value, source_index, signal) = sample.map_or_else(
+                || (String::new(), String::new(), "missing"),
+                |sample| {
+                    (
+                        sample.value.to_string(),
+                        sample.source_index.to_string(),
+                        "ecg",
+                    )
+                },
+            );
+            writeln!(output, "{metadata},{index},{},{},{},{state},{phase},{value},uV,polar-h10,{signal},{signal_sha},130,{source_index},,{},{reason}\r",
+                millis(at - start), utc(anchor, at)?, millis(audio), if complete { "completed" } else { "aborted" }
+            ).map_err(io_error)?;
+            index += 1;
+            Ok(())
+        };
+        for line in ecg.lines() {
+            let sample = Sample::parse(&line.map_err(io_error)?)?;
+            if sample.at < start || cutoff.is_some_and(|cutoff| sample.at > cutoff) {
+                continue;
+            }
+            let prior = previous.unwrap_or(start);
+            if sample.at > prior.saturating_add(SAMPLE_GAP_NS) {
+                row(prior + 1_000_000_000 / 130, None)?;
+            }
+            row(sample.at, Some(sample))?;
+            previous = Some(prior.max(sample.at));
+        }
+        let ended_at = cutoff.unwrap_or_else(|| clock.last_event.max(previous.unwrap_or(start)));
+        if previous.is_none_or(|prior| ended_at > prior.saturating_add(SAMPLE_GAP_NS)) {
+            row(ended_at, None)?;
+        }
+        output.flush().map_err(io_error)?;
+        output.get_ref().sync_all().map_err(io_error)?;
+        let size = output.get_ref().metadata().map_err(io_error)?.len();
+        drop(output);
+        if destination.exists() {
+            return Err("participant-csv-already-exists".to_owned());
+        }
+        let sha256 = file_hash(&partial)?;
+        fs::rename(&partial, &destination).map_err(io_error)?;
+        sync_directory(
+            destination
+                .parent()
+                .expect("recording destination has parent"),
+        )?;
+        Ok((
+            json!({ "name": self.filename(), "size": size, "sha256": sha256, "session_id": self.uuid }),
+            ended_at,
+        ))
+    }
+}
+
+struct CsvProjection<'a, R> {
+    destination: std::path::PathBuf,
+    anchor: ClockAnchor,
+    cutoff: Option<u64>,
+    clock: PlaybackClock,
+    signal_sha: &'a str,
+    ecg: R,
+    complete: bool,
+    reason: &'a str,
+}
+
+fn partial_file(destination: &Path) -> std::path::PathBuf {
+    let mut name = std::ffi::OsString::from(".");
+    name.push(
+        destination
+            .file_name()
+            .expect("recording destination has filename"),
+    );
+    name.push(".partial");
+    destination.with_file_name(name)
+}
+
+pub(crate) fn discard_recovery_csv(path: &Path) -> Result<(), String> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.is_file() && !metadata.file_type().is_symlink() => {
+            fs::remove_file(path).map_err(io_error)
+        }
+        Ok(_) => Err("participant-recovery-path-invalid".into()),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(io_error(error)),
+    }
+}
+
+pub(crate) fn valid_csv_filename(name: &str) -> bool {
+    let Some((id, tail)) = name
+        .strip_suffix(".csv")
+        .and_then(|stem| stem.rsplit_once('_'))
+    else {
+        return false;
+    };
+    let Some(index) = tail
+        .strip_prefix("main")
+        .or_else(|| tail.strip_prefix("probe"))
+    else {
+        return false;
+    };
+    ParticipantId::parse(id).is_ok()
+        && (1..=16).contains(&index.len())
+        && !index.starts_with('0')
+        && index.bytes().all(|byte| byte.is_ascii_digit())
+}
+
+pub(crate) fn csv_descriptor<'a>(
+    manifest: &Value,
+    terminal: &'a Value,
+) -> Result<Option<&'a Value>, &'static str> {
+    let Some(csv) = terminal.get("participant_csv") else {
+        return Ok(None);
+    };
+    const BAD: &str = "participant-csv-descriptor-invalid";
+    let participant = &terminal["participant"];
+    if participant != &manifest["participant"] {
+        return Err(BAD);
+    }
+    let id = participant["participant_id"].as_str().ok_or(BAD)?;
+    let condition = participant["condition"]
+        .as_str()
+        .filter(|condition| matches!(*condition, "main" | "probe"))
+        .ok_or(BAD)?;
+    let index = participant["run_index"].as_u64().ok_or(BAD)?;
+    let name = csv["name"]
+        .as_str()
+        .filter(|name| valid_csv_filename(name))
+        .ok_or(BAD)?;
+    let uuid = csv["session_id"].as_str().ok_or(BAD)?;
+    if csv.as_object().is_none_or(|object| object.len() != 4)
+        || name != format!("{id}_{condition}{index}.csv")
+        || participant["session_id"].as_str() != Some(uuid)
+        || !valid_uuid(uuid)
+        || csv["size"].as_u64().is_none_or(|size| size == 0)
+        || csv["sha256"].as_str().is_none_or(|hash| !valid_hash(hash))
+    {
+        return Err(BAD);
+    }
+    Ok(Some(csv))
+}
+
+fn valid_uuid(uuid: &str) -> bool {
+    let bytes = uuid.as_bytes();
+    bytes.len() == 36
+        && bytes[14] == b'4'
+        && matches!(bytes[19], b'8' | b'9' | b'a' | b'b')
+        && bytes.iter().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                *byte == b'-'
+            } else {
+                byte.is_ascii_digit() || (b'a'..=b'f').contains(byte)
+            }
+        })
+}
+
+fn new_session_id() -> Result<String, String> {
+    let mut bytes = [0u8; 16];
+    getrandom::fill(&mut bytes).map_err(|_| "participant-uuid-entropy".to_owned())?;
+    bytes[6] = (bytes[6] & 0x0f) | 0x40;
+    bytes[8] = (bytes[8] & 0x3f) | 0x80;
+    let hex: String = bytes.iter().map(|byte| format!("{byte:02x}")).collect();
+    Ok(format!(
+        "{}-{}-{}-{}-{}",
+        &hex[..8],
+        &hex[8..12],
+        &hex[12..16],
+        &hex[16..20],
+        &hex[20..]
+    ))
+}
+
+fn valid_hash(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn file_hash(path: &Path) -> Result<String, String> {
+    let mut file = File::open(path).map_err(io_error)?;
+    let mut hash = Sha256::new();
+    io::copy(&mut file, &mut hash).map_err(io_error)?;
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn io_error(error: io::Error) -> String {
+    format!("participant-recording-io:{:?}", error.kind())
+}
+
+fn millis(ns: u64) -> String {
+    format!("{}.{:03}", ns / 1_000_000, (ns / 1000) % 1000)
+}
+
+fn utc(anchor: ClockAnchor, at: u64) -> Result<String, String> {
+    let utc = anchor
+        .utc_at(MonotonicNanos::new(at))
+        .ok_or("participant-recording-time-overflow")?
+        .get();
+    Ok(
+        DateTime::<Utc>::from_timestamp((utc / 1_000_000_000) as i64, (utc % 1_000_000_000) as u32)
+            .ok_or("participant-recording-time-invalid")?
+            .to_rfc3339_opts(SecondsFormat::Millis, true),
+    )
+}
+
+#[derive(Clone, Copy)]
+struct Sample {
+    at: u64,
+    source_index: u64,
+    value: i64,
+}
+
+impl Sample {
+    fn parse(line: &str) -> Result<Self, String> {
+        let row: Value = serde_json::from_str(line).map_err(|_| "participant-ecg-json-invalid")?;
+        if row["kind"] != "polar-ecg" {
+            return Err("participant-ecg-kind-invalid".into());
+        }
+        Ok(Self {
+            at: row["observed_monotonic_ns"]
+                .as_u64()
+                .ok_or("participant-ecg-clock-invalid")?,
+            source_index: row["source_sequence"]
+                .as_u64()
+                .ok_or("participant-ecg-index-invalid")?,
+            value: row["microvolts"]
+                .as_i64()
+                .ok_or("participant-ecg-value-invalid")?,
+        })
+    }
+}
+
+struct ClockMark {
+    at: u64,
+    elapsed: u64,
+    state: &'static str,
+}
+
+struct PlaybackClock {
+    marks: Vec<ClockMark>,
+    last_event: u64,
+}
+
+impl PlaybackClock {
+    fn read(source: impl BufRead, ended_at: Option<u64>) -> Result<Option<Self>, String> {
+        let mut marks = Vec::<ClockMark>::new();
+        let mut media_started = false;
+        let mut last_event = 0;
+        for line in source.lines() {
+            let row: Value = serde_json::from_str(&line.map_err(io_error)?)
+                .map_err(|_| "participant-event-json-invalid")?;
+            if let Some(at) = row["observed_monotonic_ns"].as_u64() {
+                last_event = last_event.max(at);
+            }
+            let state = match row["event"].as_str() {
+                Some("official-start") if marks.is_empty() => "waiting",
+                Some("audio-started") if !marks.is_empty() && !media_started => {
+                    media_started = true;
+                    if marks.last().is_some_and(|mark| mark.state == "paused") {
+                        "paused"
+                    } else {
+                        "playing"
+                    }
+                }
+                Some("experiment-paused") if !marks.is_empty() => "paused",
+                Some("experiment-resumed") if !marks.is_empty() => {
+                    if media_started {
+                        "playing"
+                    } else {
+                        "waiting"
+                    }
+                }
+                Some("audio-ended" | "audio-error") if !marks.is_empty() => "ended",
+                _ => continue,
+            };
+            let at = row["observed_monotonic_ns"]
+                .as_u64()
+                .ok_or("participant-event-time-invalid")?;
+            if ended_at.is_some_and(|end| at > end)
+                || marks.last().is_some_and(|previous| previous.at > at)
+            {
+                return Err("participant-event-order-invalid".into());
+            }
+            let elapsed = marks.last().map_or(0, |previous| {
+                previous.elapsed
+                    + if previous.state == "playing" {
+                        at - previous.at
+                    } else {
+                        0
+                    }
+            });
+            if marks
+                .last()
+                .is_some_and(|previous| previous.state == "ended")
+            {
+                continue;
+            }
+            marks.push(ClockMark { at, elapsed, state });
+        }
+        Ok((!marks.is_empty()).then_some(Self { marks, last_event }))
+    }
+
+    fn start(&self) -> u64 {
+        self.marks[0].at
+    }
+
+    fn at(&self, at: u64, audio_end: u64) -> (u64, &'static str) {
+        let offset = self.marks.partition_point(|mark| mark.at <= at);
+        let mark = &self.marks[offset - 1];
+        let elapsed = mark.elapsed
+            + if mark.state == "playing" {
+                at - mark.at
+            } else {
+                0
+            };
+        (
+            elapsed.min(audio_end),
+            if elapsed >= audio_end {
+                "ended"
+            } else {
+                mark.state
+            },
+        )
+    }
+}
+
+#[cfg(test)]
