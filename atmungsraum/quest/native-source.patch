+/** Explicitly selected release bootstrap. No general session, sensor or UI operator. */
+public final class ExperimentSessionHeadsetSetupProvider extends ContentProvider {
+    @Override public boolean onCreate(){return true;}
+    static void validateCaller(int uid,boolean dump,boolean selected){
+        if(uid!=2000||!dump||!selected)throw new SecurityException("headset-setup-shell-dump-selection-required");
+    }
+    @Override public Bundle call(String method,String arg,Bundle extras){
+        // Synchronous Binder identity and DUMP are checked before any decode or dispatch.
+        validateCaller(Binder.getCallingUid(),getContext()!=null&&getContext().checkCallingPermission("android.permission.DUMP")==PackageManager.PERMISSION_GRANTED,
+            getContext()!=null&&ExperimentSessionHeadsetSetup.featureSelected(getContext()));
+        if(!"headset-setup".equals(method)||arg==null||arg.length()>8192||(extras!=null&&!extras.isEmpty()))
+            throw new IllegalArgumentException("closed-headset-setup-call-required");
+        try{
+            byte[] bytes=android.util.Base64.decode(arg,android.util.Base64.NO_WRAP|android.util.Base64.NO_PADDING);
+            if(bytes.length==0||bytes.length>4096)throw new IllegalArgumentException("bounded-headset-setup-required");
+            JSONObject request=new JSONObject(new String(bytes,java.nio.charset.StandardCharsets.UTF_8));
+            Bundle result=new Bundle();result.putString("receipt_b64",android.util.Base64.encodeToString(
+                ExperimentSessionHeadsetSetup.execute(getContext(),request).getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                android.util.Base64.NO_WRAP|android.util.Base64.NO_PADDING));return result;
+        }catch(SecurityException denied){throw denied;}
+        catch(Exception unavailable){throw new IllegalArgumentException("headset-setup-result-unavailable-no-replay",unavailable);}
+    }
