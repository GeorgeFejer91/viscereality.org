+pub(crate) fn live_query(root: &Path, active_id: &str, request: &Value, check: &dyn Fn() -> bool)
+    -> Result<Value, String> {
+    check_owner(check)?;
+    SessionTimestampKey::parse(active_id).map_err(|_| denied())?;
+    let invalid = || "recording-live-query-invalid".to_owned();
+    let fields = request.as_object().ok_or_else(invalid)?;
+    let range = match request["query"].as_str() {
+        Some("live-describe") if fields.len() == 1 => None,
+        Some("live-read") if fields.len() == 5 && request["id"] == active_id => {
+            let uuid = request["session_id"].as_str().filter(|uuid| valid_uuid(uuid)).ok_or_else(invalid)?;
+            let offset = request["offset"].as_u64().filter(|offset| *offset < MAX_EXPORT_BYTES).ok_or_else(invalid)?;
+            let length = request["length"].as_u64().filter(|length| (1..=MAX_LIVE_CHUNK).contains(length)).ok_or_else(invalid)?;
+            Some((uuid, offset, length))
+        }
+        _ => return Err(invalid()),
+    };
+    let (parent, directory) = Custody::root(root)?;
+    let session = directory.directory(active_id)?;
+    let path = session.path.join(live_csv::LIVE_PREFIX);
+    match fs::symlink_metadata(&path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound && range.is_none() => {
+            check_owner(check)?;
+            return Ok(json!({"v":1,"state":"preparing"}));
+        }
+        _ => {}
+    }
+    let (receipt, _) = session.child(live_csv::LIVE_PREFIX, true)?;
+    let prefix: Value = serde_json::from_reader(receipt.take(1024)).map_err(|_| denied())?;
+    let size = prefix["size"].as_u64().filter(|size| (1..=MAX_EXPORT_BYTES).contains(size)).ok_or_else(denied)?;
+    let name = prefix["name"].as_str().filter(|name| valid_csv_filename(name)).ok_or_else(denied)?;
+    let session_id = prefix["session_id"].as_str().filter(|uuid| valid_uuid(uuid)).ok_or_else(denied)?;
+    let checkpoint = prefix["checkpoint"].as_u64().filter(|value| *value > 0).ok_or_else(denied)?;
+    let sha = prefix["sha256"].as_str().filter(|value| value.len() == 64
+        && value.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))).ok_or_else(denied)?;
+    if prefix["schema_version"] != live_csv::SCHEMA_VERSION {
+        return Err(denied());
+    }
+    let (mut file, original) = session.child(live_csv::LIVE_CSV, true)?;
+    if original.len < size {
+        return Err(denied());
+    }
+    let result = match range {
+        None => json!({"v":1,"state":"live","id":active_id,"schema_version":live_csv::SCHEMA_VERSION,
+            "session_id":session_id,"name":name,"size":size,"sha256":sha,"checkpoint":checkpoint}),
+        Some((uuid, offset, length)) => {
+            if uuid != session_id || offset >= size || length > size - offset {
+                return Err(invalid());
+            }
+            let mut bytes = vec![0; length as usize];
+            file.seek(SeekFrom::Start(offset)).and_then(|_| file.read_exact(&mut bytes)).map_err(|_| denied())?;
+            json!({"v":1,"state":"live-chunk","id":active_id,"session_id":session_id,"offset":offset,
+                "length":length,"data":base64(&bytes),"sha256":format!("{:x}",Sha256::digest(&bytes))})
+        }
+    };
+    Custody::root_current(&parent, &directory)?;
+    if directory.directory(active_id)?.stamp.identity != session.stamp.identity
+        || session.child(live_csv::LIVE_CSV, true)?.1.identity != original.identity {
+        return Err(denied());
+    }
+    check_owner(check)?;
+    Ok(result)
+}
