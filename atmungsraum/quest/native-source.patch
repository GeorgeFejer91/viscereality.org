+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.res.AssetManager;
+import android.media.MediaPlayer;
+import android.util.Log;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.List;
+
+/** Prepares a verified packaged timeline on the condition-audio worker. */
+final class ScenarioAudioAndroidTracks
+        implements ConditionAudioAndroidMediaBackendFactory.ScenarioTracks {
+    private static final String TAG = "RustyQuestNativeRenderer";
+    private final AssetManager assets;
+    private final File cache;
+    private final String digest;
+    private volatile ScenarioAudioPackage catalog;
+
+    ScenarioAudioAndroidTracks(AssetManager assets, File cache, String digest) {
+        this.assets = assets;
+        this.cache = cache;
+        this.digest = digest;
+    }
+
+    @Override public void verify() throws Exception {
+        try {
+            ScenarioAudioPackage selected = ScenarioAudioPackage.open(new ScenarioAudioPackage.AssetSource() {
+                @Override public InputStream open(String path) throws IOException {
+                    return assets.open("atmungsraum-audio/" + path, AssetManager.ACCESS_STREAMING);
+                }
+            }, digest);
+            selected.verifyAll();
+            catalog = selected;
+            Log.i(TAG, "channel=scenario-audio event=verified");
+        } catch (Exception error) {
+            Log.e(TAG, "channel=scenario-audio event=rejected", error);
+            throw error;
+        }
+    }
+
+    @Override public List<String> ids() {
+        ScenarioAudioPackage selected = catalog;
+        return selected == null ? Collections.<String>emptyList() : selected.ids();
+    }
+
+    @Override public String recordingPlan(String id) {
+        ScenarioAudioPackage selected = catalog;
+        return selected == null ? null : selected.recordingPlan(id);
+    }
+
+    @Override public MediaPlayer prepare(String id) throws Exception {
+        ScenarioAudioPackage selected = catalog;
+        if (selected == null) throw new IllegalStateException("scenario-audio-not-verified");
+        File wave = File.createTempFile("scenario-", ".wav", cache);
+        try {
+            long frames;
+            try (FileOutputStream output = new FileOutputStream(wave)) {
+                frames = selected.writeWave(id, output);
+            }
+            MediaPlayer player = new MediaPlayer();
+            try (FileInputStream input = new FileInputStream(wave)) {
+                player.setDataSource(input.getFD(), 0, wave.length());
+                player.prepare();
+                Log.i(TAG, "channel=scenario-audio event=prepared scenario=" + id
+                    + " frames=" + frames + " catalog_sha256=" + digest);
+                return player;
+            } catch (Exception failure) {
+                player.release();
+                throw failure;
+            }
+        } finally {
+            if (!wave.delete()) Log.w(TAG, "channel=scenario-audio event=cache-cleanup-failed");
+        }
+    }
+}
