+"""Host-only controls for the selected SDK207 artifact/ELF closure."""
+import hashlib
+import importlib.util
+import pathlib
+import struct
+import sys
+import tempfile
+import unittest
+
+sys.dont_write_bytecode = True
+LIB = pathlib.Path(__file__).resolve().parents[1] / 'lib'
+sys.path.insert(0, str(LIB))
+
+
+class PackagingTests(unittest.TestCase):
+    @staticmethod
+    def fake_elf(alignment=16384, needed='libc.so', soname='libtest.so'):
+        value = bytearray(512)
+        value[:7] = b'\x7fELF\x02\x01\x01'
+        struct.pack_into('<HHI', value, 16, 3, 183, 1)
+        struct.pack_into('<Q', value, 32, 64)
+        struct.pack_into('<HHH', value, 52, 64, 56, 2)
+        struct.pack_into('<IIQQQQQQ', value, 64, 1, 5, 0, 0, 0, 512, 512, alignment)
+        struct.pack_into('<IIQQQQQQ', value, 120, 2, 6, 200, 200, 0, 80, 80, 8)
+        strings = b'\0' + soname.encode() + b'\0' + needed.encode() + b'\0'
+        value[320:320+len(strings)] = strings
+        for index, row in enumerate([(5, 320), (10, len(strings)), (14, 1), (1, len(soname)+2), (0, 0)]):
+            struct.pack_into('<QQ', value, 200+16*index, *row)
+        return bytes(value)
+
+    def test_disabled_has_no_inputs(self):
+        import meta_platform_packaging as p
+        self.assertEqual(p.select(False, '', '', '', '', ''), {'enabled': False, 'fingerprint': 'disabled'})
+        for args in [('1', '', '', '', ''), ('', 'sdk', '', '', '')]:
+            with self.assertRaises(ValueError):
+                p.select(False, *args)
+
+    def test_enabled_rejects_missing_and_noncanonical_id(self):
+        import meta_platform_packaging as p
+        for app_id in ['', '0', '01', '+1', ' 1', '1\n', '1' * 21]:
+            with self.assertRaises(ValueError):
+                p.select(True, app_id, '', '', '', '')
+
+    def test_hash_input_rejects_tamper(self):
+        import meta_platform_packaging as p
+        with tempfile.TemporaryDirectory() as tmp:
+            file = pathlib.Path(tmp) / 'input'
+            file.write_bytes(b'first')
+            digest = hashlib.sha256(file.read_bytes()).hexdigest()
+            self.assertEqual(p.bound_bytes(file, digest, 100), b'first')
+            file.write_bytes(b'other')
+            with self.assertRaisesRegex(ValueError, 'hash'):
+                p.bound_bytes(file, digest, 100)
+            with self.assertRaises(ValueError):
+                p.bound_bytes(file, digest.upper(), 100)
+
+    def test_reject_invalid_elf(self):
+        import meta_platform_packaging as p
+        for data in [b'', b'ELF', b'\x7fELF' + bytes(100)]:
+            with self.assertRaises(ValueError):
+                p.elf(data, 'libtest.so', [])
+
+    def test_elf_alignment_soname_and_dependency_closure(self):
+        import meta_platform_packaging as p
+        self.assertEqual(p.elf(self.fake_elf(), 'libtest.so', ['libc.so'])['load_alignments_bytes'], [16384])
+        for data in [self.fake_elf(alignment=4096), self.fake_elf(needed='libunexpected.so'), self.fake_elf(soname='libother.so')]:
+            with self.assertRaises(ValueError):
+                p.elf(data, 'libtest.so', ['libc.so'])
+
+    def test_header_inventory_binds_names_and_bytes(self):
+        import meta_platform_packaging as p
+        with tempfile.TemporaryDirectory() as tmp:
+            headers = pathlib.Path(tmp) / 'Include'
+            headers.mkdir()
+            file = headers / 'first.h'
+            file.write_bytes(b'first')
+            records, original = p.header_inventory(tmp)
+            file.rename(headers / 'second.h')
+            self.assertNotEqual(original, p.header_inventory(tmp)[1])
+            (headers / 'second.h').write_bytes(b'other')
+            self.assertNotEqual(original, p.header_inventory(tmp)[1])
+            (headers / 'unexpected.jar').write_bytes(b'other')
+            with self.assertRaises(ValueError):
+                p.header_inventory(tmp)
+
+    def test_actual_message_constructor_preserves_error_provenance_abi(self):
+        import meta_platform_packaging as p
+        signature = '<init>(JIIILjava/lang/String;Ljava/lang/String;Ljava/lang/String;JJIIILjava/lang/String;)V'
+        p.verify_message_abi({p.PREFIX+'$Message': {'methods': {signature: 1}}})
+        with self.assertRaisesRegex(ValueError, 'message constructor'):
+            p.verify_message_abi({p.PREFIX+'$Message': {'methods': {}}})
+
+    def test_selected_helper_requires_actual_queued_exit_definition(self):
+        import meta_platform_packaging as p
+        owner = 'io.github.mesmerprism.rustyquest.native_renderer.NativeRendererSelfKioskApplication'
+        p.verify_queued_exit_abi({owner: {'methods': {'handoffForMetaInstall(Landroid/app/Activity;J)Z': 1, 'exitForQueuedMetaUpdate(Landroid/app/Activity;JJJJ)Z': 1}}})
+        with self.assertRaisesRegex(ValueError, 'queued exit'):
+            p.verify_queued_exit_abi({owner: {'methods': {}}})
+
+
+if __name__ == '__main__':
+    unittest.main()
