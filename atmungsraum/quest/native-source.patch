+fn cycle_state() -> String {
+    let owner = crate::experiment_session_runtime::maintenance_owner();
+    let gate = state().lock().unwrap_or_else(|e| e.into_inner());
+    let reason = match gate.phase {
+        0 => "not-selected",
+        1 => "checking",
+        3 => "install-uncertain",
+        5 => "setup-park-pending",
+        6 => "writer-or-owner-uncertain",
+        _ if gate.session_seen => "session-active",
+        _ if gate.queued > 0 => "preparation-queued",
+        _ if owner.is_none() => "owner-not-parked",
+        _ => "",
+    };
+    serde_json::json!({"v":1,"cycle":gate.cycle.max(1).to_string(),"revision":gate.revision.max(1).to_string(),
+        "attempt":(gate.attempt>0 && gate.attempt_cycle==gate.cycle).then(||gate.attempt.to_string()),"can_check":matches!(gate.phase,2|4)&&!gate.session_seen&&gate.queued==0&&owner.is_some(),
+        "session_allowed":matches!(gate.phase,0|2),"busy_reason":reason}).to_string()
+}
+#[cfg(all(target_os = "android", feature = "showcase"))]
