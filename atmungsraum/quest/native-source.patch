+    for frame in (707_364..=1_411_200).step_by(1_764) {
+        setup.observe_clock(1, frame, time(frame) + 4_000_000_000, true);
+    }
+    let running = setup.snapshot(time(1_411_200) + 4_000_000_000);
+    assert_eq!(running.experiment, ExperimentState::Running);
