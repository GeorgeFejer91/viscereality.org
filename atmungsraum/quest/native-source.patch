+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ParticipantId {
+    name: String,
+    age: u64,
+    gender: char,
+}
+
+impl ParticipantId {
+    fn parse(input: &str) -> Result<Self, &'static str> {
+        let mut fields = input.split('_');
+        let name = fields.next().ok_or("participant-id-invalid")?;
+        let age = fields.next().ok_or("participant-id-invalid")?;
+        let gender = match fields.next() {
+            Some("M") => 'M',
+            Some("F") => 'F',
+            Some("O") => 'O',
+            Some("N") => 'N',
+            _ => return Err("participant-id-invalid"),
+        };
+        if fields.next().is_some()
+            || name.chars().count() != 3
+            || !is_nfc(name)
+            || !name.chars().all(|ch| {
+                matches!(
+                    get_general_category(ch),
+                    GeneralCategory::UppercaseLetter
+                        | GeneralCategory::LowercaseLetter
+                        | GeneralCategory::TitlecaseLetter
+                        | GeneralCategory::ModifierLetter
+                        | GeneralCategory::OtherLetter
+                )
+            })
+            || age.is_empty()
+            || !age.bytes().all(|byte| byte.is_ascii_digit())
+            || age.len() > 1 && age.starts_with('0')
+        {
+            return Err("participant-id-invalid");
+        }
+        let age = age
+            .parse::<u64>()
+            .ok()
+            .filter(|value| *value <= 9_007_199_254_740_991)
+            .ok_or("participant-id-invalid")?;
+        Ok(Self {
+            name: name.to_owned(),
+            age,
+            gender,
+        })
+    }
+
+    fn as_text(&self) -> String {
+        format!("{}_{}_{}", self.name, self.age, self.gender)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ParticipantPlan {
+    participant: ParticipantId,
+    scenario: String,
+    sha256: String,
+    seconds: u64,
+    phases: Vec<(u64, String)>,
+}
+
+impl ParticipantPlan {
+    pub(crate) fn parse(value: &Value) -> Result<Self, &'static str> {
+        const BAD: &str = "participant-plan-invalid";
+        value
+            .as_object()
+            .filter(|object| object.len() == 6)
+            .ok_or(BAD)?;
+        let participant = ParticipantId::parse(value["participant_id"].as_str().ok_or(BAD)?)?;
+        let scenario = value["scenario_id"].as_str().ok_or(BAD)?;
+        let seconds = scenario_seconds(scenario).ok_or(BAD)?;
+        let sha256 = value["scenario_sha256"]
+            .as_str()
+            .filter(|value| valid_hash(value))
+            .ok_or(BAD)?;
+        let rate = value["sample_rate"]
+            .as_u64()
+            .filter(|rate| (8000..=48000).contains(rate))
+            .ok_or(BAD)?;
+        let frames = value["total_frames"]
+            .as_u64()
+            .filter(|frames| *frames == seconds * rate)
+            .ok_or(BAD)?;
+        let input = value["phases"]
+            .as_array()
+            .filter(|input| (1..=256).contains(&input.len()))
+            .ok_or(BAD)?;
+        let mut phases = Vec::with_capacity(input.len());
+        for raw in input {
+            let pair = raw.as_array().filter(|pair| pair.len() == 2).ok_or(BAD)?;
+            let offset = pair[0]
+                .as_u64()
+                .filter(|offset| *offset < frames)
+                .ok_or(BAD)?;
+            let name = pair[1]
+                .as_str()
+                .filter(|name| valid_phase(name))
+                .ok_or(BAD)?;
+            let nanos = (offset * 1_000_000_000).div_ceil(rate);
+            if phases
+                .last()
+                .is_some_and(|(previous, _)| *previous >= nanos)
+            {
+                return Err(BAD);
+            }
+            phases.push((nanos, name.to_owned()));
+        }
+        if phases[0].0 != 0 {
+            return Err(BAD);
+        }
+        Ok(Self {
+            participant,
+            scenario: scenario.to_owned(),
+            sha256: sha256.to_owned(),
+            seconds,
+            phases,
+        })
+    }
+
+    fn condition(&self) -> &'static str {
+        if self.scenario == "haupt-15" {
+            "main"
+        } else {
+            "probe"
+        }
+    }
+
+    pub(crate) fn completion_threshold_ns(&self) -> u64 {
+        if self.scenario == "probe-anleitung" {
+            u64::MAX
+        } else {
+            self.seconds * 1_000_000_000
+        }
+    }
+
+    fn phase_at(&self, elapsed_ns: u64) -> &str {
+        let phase = self
+            .phases
+            .partition_point(|(offset, _)| *offset <= elapsed_ns);
+        phase
+            .checked_sub(1)
+            .map_or("unknown", |index| self.phases[index].1.as_str())
+    }
+}
+
+fn scenario_seconds(scenario: &str) -> Option<u64> {
+    match scenario {
+        "probe-anleitung" => Some(68),
+        "probe-5" => Some(300),
+        "probe-10" => Some(600),
+        "probe-15" | "haupt-15" => Some(900),
+        _ => None,
+    }
+}
+
+fn valid_phase(name: &str) -> bool {
+    (1..=32).contains(&name.len())
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct ParticipantRun {
+    plan: ParticipantPlan,
+    index: u64,
+    uuid: String,
+}
+
+impl ParticipantRun {
+    pub(crate) fn reserve(root: &Path, plan: ParticipantPlan) -> Result<Self, String> {
+        let participant = plan.participant.as_text();
+        let group = Sha256::digest(format!("{participant}|{}", plan.condition()).as_bytes());
+        let prefix = format!("participant-{group:x}-");
+        let mut last = 0;
+        for entry in fs::read_dir(root).map_err(io_error)? {
+            let entry = entry.map_err(io_error)?;
+            let name = entry.file_name();
+            if let Some(index) = name
+                .to_str()
+                .and_then(|name| name.strip_prefix(&prefix))
+                .and_then(|value| value.strip_suffix(".reserve"))
+                .and_then(|value| value.parse::<u64>().ok())
+            {
+                last = last.max(index);
+            }
+        }
+        let uuid = new_session_id()?;
+        loop {
+            let index = last
+                .checked_add(1)
+                .ok_or("participant-run-index-exhausted")?;
+            let marker = root.join(format!("{prefix}{index}.reserve"));
+            match OpenOptions::new().write(true).create_new(true).open(marker) {
+                Ok(mut file) => {
+                    writeln!(file, "{uuid}").map_err(io_error)?;
+                    file.sync_all().map_err(io_error)?;
+                    sync_directory(root)?;
+                    return Ok(Self { plan, index, uuid });
+                }
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => last = index,
+                Err(error) => return Err(io_error(error)),
+            }
+        }
+    }
+
+    pub(crate) fn restore(value: &Value) -> Result<Self, &'static str> {
+        const BAD: &str = "participant-recovery-metadata-invalid";
+        let participant = ParticipantId::parse(value["participant_id"].as_str().ok_or(BAD)?)?;
+        let scenario = value["scenario_id"].as_str().ok_or(BAD)?;
+        let seconds = scenario_seconds(scenario).ok_or(BAD)?;
+        let sha256 = value["scenario_sha256"]
+            .as_str()
+            .filter(|hash| valid_hash(hash))
+            .ok_or(BAD)?;
+        let index = value["run_index"]
+            .as_u64()
+            .filter(|index| (1..10_000_000_000_000_000).contains(index))
+            .ok_or(BAD)?;
+        let uuid = value["session_id"]
+            .as_str()
+            .filter(|uuid| valid_uuid(uuid))
+            .ok_or(BAD)?;
+        let mut phases = Vec::new();
+        if let Some(offsets) = value.get("phase_offsets_ns") {
+            let offsets = offsets
+                .as_array()
+                .filter(|offsets| (1..=256).contains(&offsets.len()))
+                .ok_or(BAD)?;
+            for phase in offsets {
+                let pair = phase.as_array().filter(|pair| pair.len() == 2).ok_or(BAD)?;
+                let offset = pair[0]
+                    .as_u64()
+                    .filter(|offset| *offset < seconds * 1_000_000_000)
+                    .ok_or(BAD)?;
+                let name = pair[1]
+                    .as_str()
+                    .filter(|name| valid_phase(name))
+                    .ok_or(BAD)?;
+                if phases
+                    .last()
+                    .map_or(offset != 0, |(previous, _)| *previous >= offset)
+                {
+                    return Err(BAD);
+                }
+                phases.push((offset, name.to_owned()));
+            }
+        }
+        let run = Self {
+            plan: ParticipantPlan {
+                participant,
+                scenario: scenario.to_owned(),
+                sha256: sha256.to_owned(),
+                seconds,
+                phases,
+            },
+            index,
+            uuid: uuid.to_owned(),
+        };
+        if &run.metadata() != value {
+            return Err(BAD);
+        }
+        Ok(run)
+    }
+
+    pub(crate) fn metadata(&self) -> Value {
+        let mut metadata = json!({
+            "participant_id": self.plan.participant.as_text(),
+            "name_prefix": self.plan.participant.name,
+            "age_years": self.plan.participant.age,
+            "gender_code": self.plan.participant.gender,
+            "condition": self.plan.condition(),
+            "run_index": self.index,
+            "session_id": self.uuid,
+            "scenario_id": self.plan.scenario,
+            "scenario_sha256": self.plan.sha256,
+            "planned_duration_seconds": self.plan.seconds,
+        });
+        if !self.plan.phases.is_empty() {
+            metadata["phase_offsets_ns"] = json!(self.plan.phases);
+        }
+        metadata
+    }
+
+    fn filename(&self, started_utc: &str) -> String {
+        participant_csv_filename(
+            &self.plan.participant.as_text(),
+            &started_utc[..10],
+            &self.plan.scenario,
+            self.index,
+        )
+    }
+
+    pub(crate) fn finalize_csv(
+        &self,
+        directory: &Path,
+        anchor: ClockAnchor,
+        ended_at: MonotonicNanos,
+        complete: bool,
+        reason: &str,
+    ) -> Result<Option<Value>, String> {
+        let events = File::open(directory.join("events.jsonl")).map_err(io_error)?;
+        let Some(clock) = PlaybackClock::read(BufReader::new(events), Some(ended_at.get()))? else {
+            return Ok(None);
+        };
+        let start_utc = utc(anchor, clock.start())?;
+        let name = self.filename(&start_utc);
+        let (descriptor, _) = self.write_csv(CsvProjection {
+            destination: directory.join(&name),
+            name,
+            start_utc,
+            anchor,
+            cutoff: Some(ended_at.get()),
+            clock,
+            sources: open_sample_streams(directory, None)?,
+            complete,
+            reason,
+        })?;
+        Ok(Some(descriptor))
+    }
+
+    pub(crate) fn recover_csv(
+        &self,
+        directory: &Path,
+        anchor: ClockAnchor,
+        events_bytes: u64,
+        stream_lengths: &Value,
+    ) -> Result<Option<(Value, u64)>, String> {
+        let events = open_regular_recording_file(&directory.join("events.jsonl"))?;
+        let Some(clock) = PlaybackClock::read(BufReader::new(events.take(events_bytes)), None)?
+        else {
+            return Ok(None);
+        };
+        let start_utc = utc(anchor, clock.start())?;
+        let name = self.filename(&start_utc);
+        let destination = directory.join(format!("{RECOVERED_CSV_PREFIX}{name}"));
+        discard_recovery_csv(&destination)?;
+        discard_recovery_csv(&partial_file(&destination))?;
+        self.write_csv(CsvProjection {
+            destination,
+            name,
+            start_utc,
+            anchor,
+            cutoff: None,
+            clock,
+            sources: open_sample_streams(directory, Some(stream_lengths))?,
+            complete: false,
+            reason: "interrupted-recovery",
+        })
+        .map(Some)
+    }
+
+    fn write_csv(&self, projection: CsvProjection) -> Result<(Value, u64), String> {
+        let CsvProjection {
+            destination,
+            name,
+            start_utc,
+            anchor,
+            cutoff,
+            clock,
+            mut sources,
+            complete,
+            reason,
+        } = projection;
+        let partial = partial_file(&destination);
+        let mut output = BufWriter::new(
+            OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&partial)
+                .map_err(io_error)?,
+        );
+        output.write_all(HEADER.as_bytes()).map_err(io_error)?;
+        let start = clock.start();
+        let metadata = format!(
+            "{CSV_SCHEMA_VERSION},{},{},{},{}",
+            self.plan.participant.as_text(), self.uuid, self.index, self.plan.scenario,
+        );
+        let mut write_row = |row: &Observation, outcome: &str, reason: &str| -> Result<(), String> {
+            let (audio, state) = clock.at(row.at, self.plan.seconds * 1_000_000_000);
+            let phase = match state {
+                "waiting" | "ended" => state,
+                _ => self.plan.phase_at(audio),
+            };
+            write!(
+                output, "{metadata},{},{},{},{},{state},{phase}",
+                row.kind, utc(anchor, row.at)?, (row.at - start) / 1000, audio / 1000,
+            ).map_err(io_error)?;
+            for value in &row.values {
+                write!(output, ",{value}").map_err(io_error)?;
+            }
+            if reason.contains([',', '"', '\r', '\n']) {
+                return writeln!(output, ",{outcome},\"{}\",{}\r", reason.replace('"', "\"\""), row.signal_reason)
+                    .map_err(io_error);
+            }
+            writeln!(output, ",{outcome},{reason},{}\r", row.signal_reason).map_err(io_error)
+        };
+        let mut ended_at = clock.last_event.max(start);
+        for source in &mut sources {
+            source.advance(start, cutoff)?;
+        }
+        while let Some(source) = sources.iter_mut()
+            .filter(|source| source.next.is_some())
+            .min_by_key(|source| source.next.as_ref().expect("selected row").at)
+        {
+            let row = source.next.take().expect("selected row");
+            write_row(&row, "", "")?;
+            ended_at = ended_at.max(row.at);
+            source.advance(start, cutoff)?;
+        }
+        let ended_at = cutoff.unwrap_or(ended_at);
+        write_row(
+            &Observation { at: ended_at, kind: "end", values: Default::default(), signal_reason: "" },
+            if complete { "completed" } else { "aborted" },
+            reason,
+        )?;
+        output.flush().map_err(io_error)?;
+        output.get_ref().sync_all().map_err(io_error)?;
+        let size = output.get_ref().metadata().map_err(io_error)?.len();
+        drop(output);
+        if destination.exists() {
+            return Err("participant-csv-already-exists".to_owned());
+        }
+        let sha256 = file_hash(&partial)?;
+        fs::rename(&partial, &destination).map_err(io_error)?;
+        sync_directory(
+            destination
+                .parent()
+                .expect("recording destination has parent"),
+        )?;
+        Ok((
+            json!({ "name": name, "size": size, "sha256": sha256, "session_id": self.uuid, "schema_version": CSV_SCHEMA_VERSION }),
+            ended_at,
+        ))
+    }
+}
+
+struct CsvProjection<'a> {
+    destination: std::path::PathBuf,
+    name: String,
+    start_utc: String,
+    anchor: ClockAnchor,
+    cutoff: Option<u64>,
+    clock: PlaybackClock,
+    sources: Vec<ObservationStream>,
+    complete: bool,
+    reason: &'a str,
+}
+
+fn partial_file(destination: &Path) -> std::path::PathBuf {
+    let mut name = std::ffi::OsString::from(".");
+    name.push(
+        destination
+            .file_name()
+            .expect("recording destination has filename"),
+    );
+    name.push(".partial");
+    destination.with_file_name(name)
+}
+
+pub(crate) fn discard_recovery_csv(path: &Path) -> Result<(), String> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.is_file() && !metadata.file_type().is_symlink() => {
+            fs::remove_file(path).map_err(io_error)
+        }
+        Ok(_) => Err("participant-recovery-path-invalid".into()),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(io_error(error)),
+    }
+}
+
+fn participant_csv_filename(id: &str, date: &str, scenario: &str, index: u64) -> String {
+    format!("{id}_{date}_{scenario}_r{index}.csv")
+}
+
+fn dated_csv_parts(stem: &str) -> Option<(&str, &str, &str, &str)> {
+    let (rest, run) = stem.rsplit_once("_r")?;
+    let (rest, scenario) = rest.rsplit_once('_')?;
+    let (id, date) = rest.rsplit_once('_')?;
+    if date.len() != 10
+        || !NaiveDate::parse_from_str(date, "%Y-%m-%d")
+            .is_ok_and(|value| value.format("%Y-%m-%d").to_string() == date)
+        || scenario_seconds(scenario).is_none()
+    {
+        return None;
+    }
+    Some((id, date, scenario, run))
+}
+
+fn valid_run_index(index: &str) -> bool {
+    (1..=16).contains(&index.len())
+        && !index.starts_with('0')
+        && index.bytes().all(|byte| byte.is_ascii_digit())
+}
+
+pub(crate) fn valid_csv_filename(name: &str) -> bool {
+    if let Some((id, _, _, run)) = name.strip_suffix(".csv").and_then(dated_csv_parts) {
+        return ParticipantId::parse(id).is_ok() && valid_run_index(run);
+    }
+    let Some((id, tail)) = name
+        .strip_suffix(".csv")
+        .and_then(|stem| stem.rsplit_once('_'))
+    else {
+        return false;
+    };
+    let Some(index) = tail
+        .strip_prefix("main")
+        .or_else(|| tail.strip_prefix("probe"))
+    else {
+        return false;
+    };
+    ParticipantId::parse(id).is_ok() && valid_run_index(index)
+}
+
+pub(crate) fn csv_descriptor<'a>(
+    manifest: &Value,
+    terminal: &'a Value,
+) -> Result<Option<&'a Value>, &'static str> {
+    let Some(csv) = terminal.get("participant_csv") else {
+        return Ok(None);
+    };
+    const BAD: &str = "participant-csv-descriptor-invalid";
+    let participant = &terminal["participant"];
+    if participant != &manifest["participant"] {
+        return Err(BAD);
+    }
+    let id = participant["participant_id"].as_str().ok_or(BAD)?;
+    let condition = participant["condition"]
+        .as_str()
+        .filter(|condition| matches!(*condition, "main" | "probe"))
+        .ok_or(BAD)?;
+    let index = participant["run_index"].as_u64().ok_or(BAD)?;
+    let name = csv["name"]
+        .as_str()
+        .filter(|name| valid_csv_filename(name))
+        .ok_or(BAD)?;
+    let uuid = csv["session_id"].as_str().ok_or(BAD)?;
+    let matches_identity = match name.strip_suffix(".csv").and_then(dated_csv_parts) {
+        Some((_, date, scenario, _)) => {
+            participant["scenario_id"].as_str() == Some(scenario)
+                && (scenario == "haupt-15") == (condition == "main")
+                && name == participant_csv_filename(id, date, scenario, index)
+        }
+        None => name == format!("{id}_{condition}{index}.csv"),
+    };
+    let valid_schema = match csv.get("schema_version") {
+        None => csv.as_object().is_some_and(|object| object.len() == 4),
+        Some(version) => matches!(version.as_u64(), Some(2 | CSV_SCHEMA_VERSION | live_csv::SCHEMA_VERSION))
+            && csv.as_object().is_some_and(|object| object.len() == 5),
+    };
+    if !valid_schema
+        || !matches_identity
+        || participant["session_id"].as_str() != Some(uuid)
+        || !valid_uuid(uuid)
+        || csv["size"].as_u64().is_none_or(|size| size == 0)
+        || csv["sha256"].as_str().is_none_or(|hash| !valid_hash(hash))
+    {
+        return Err(BAD);
+    }
+    Ok(Some(csv))
+}
+
+pub(crate) fn valid_uuid(uuid: &str) -> bool {
+    let bytes = uuid.as_bytes();
+    bytes.len() == 36
+        && bytes[14] == b'4'
+        && matches!(bytes[19], b'8' | b'9' | b'a' | b'b')
+        && bytes.iter().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                *byte == b'-'
+            } else {
+                byte.is_ascii_digit() || (b'a'..=b'f').contains(byte)
+            }
+        })
+}
+
+fn new_session_id() -> Result<String, String> {
+    let mut bytes = [0u8; 16];
+    getrandom::fill(&mut bytes).map_err(|_| "participant-uuid-entropy".to_owned())?;
+    bytes[6] = (bytes[6] & 0x0f) | 0x40;
+    bytes[8] = (bytes[8] & 0x3f) | 0x80;
+    let hex: String = bytes.iter().map(|byte| format!("{byte:02x}")).collect();
+    Ok(format!(
+        "{}-{}-{}-{}-{}",
+        &hex[..8],
+        &hex[8..12],
+        &hex[12..16],
+        &hex[16..20],
+        &hex[20..]
+    ))
+}
+
+fn valid_hash(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn file_hash(path: &Path) -> Result<String, String> {
+    let mut file = File::open(path).map_err(io_error)?;
+    let mut hash = Sha256::new();
+    io::copy(&mut file, &mut hash).map_err(io_error)?;
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn io_error(error: io::Error) -> String {
+    format!("participant-recording-io:{:?}", error.kind())
+}
+
+fn utc(anchor: ClockAnchor, at: u64) -> Result<String, String> {
+    let utc = anchor
+        .utc_at(MonotonicNanos::new(at))
+        .ok_or("participant-recording-time-overflow")?
+        .get();
+    Ok(
+        DateTime::<Utc>::from_timestamp((utc / 1_000_000_000) as i64, (utc % 1_000_000_000) as u32)
+            .ok_or("participant-recording-time-invalid")?
+            .to_rfc3339_opts(SecondsFormat::Micros, true),
+    )
+}
+
+struct Observation {
+    at: u64,
+    kind: &'static str,
+    values: [String; 10],
+    signal_reason: &'static str,
+}
+
+struct ObservationStream {
+    kind: &'static str,
+    lines: io::Lines<BufReader<io::Take<File>>>,
+    next: Option<Observation>,
+}
+
+fn open_sample_streams(directory: &Path, lengths: Option<&Value>) -> Result<Vec<ObservationStream>, String> {
+    [
+        ("polar-ecg.jsonl", "ecg"),
+        ("polar-acc.jsonl", "accelerometer"),
+        ("radius.jsonl", "radius"),
+        ("breath.jsonl", "breath"),
+        ("events.jsonl", "event"),
+    ].into_iter().map(|(name, kind)| {
+        let length = match lengths {
+            Some(lengths) => lengths[name].as_u64().ok_or("participant-stream-length-invalid")?,
+            None => u64::MAX,
+        };
+        let file = open_regular_recording_file(&directory.join(name))?;
+        Ok(ObservationStream {
+            kind,
+            lines: BufReader::new(file.take(length)).lines(),
+            next: None,
+        })
+    }).collect()
+}
+
+impl ObservationStream {
+    fn advance(&mut self, start: u64, cutoff: Option<u64>) -> Result<(), String> {
+        for line in self.lines.by_ref() {
+            let row: Value = serde_json::from_str(&line.map_err(io_error)?)
+                .map_err(|_| "participant-stream-json-invalid")?;
+            let at = row["observed_monotonic_ns"].as_u64()
+                .ok_or("participant-stream-clock-invalid")?;
+            if at < start || cutoff.is_some_and(|end| at > end) {
+                continue;
+            }
+            self.next = if self.kind == "event" {
+                row["event"].as_str().and_then(SessionEventKind::parse).and_then(|event| {
+                    let signal_reason = event.signal_reason()?;
+                    Some(Observation { at, kind: event.as_str(), values: Default::default(), signal_reason })
+                })
+            } else {
+                observation_values(self.kind, &row)?.map(|values| Observation {
+                    at, kind: self.kind, values, signal_reason: "",
+                })
+            };
+            if self.next.is_none() {
+                continue;
+            }
+            break;
+        }
+        Ok(())
+    }
+}
+
+fn observation_values(kind: &str, row: &Value) -> Result<Option<[String; 10]>, &'static str> {
+    const BAD: &str = "participant-stream-value-invalid";
+    let mut values: [String; 10] = Default::default();
+    let integer = |key: &str| row[key].as_u64().map(|value| value.to_string()).ok_or(BAD);
+    match (kind, row["kind"].as_str()) {
+        ("ecg", Some("polar-ecg")) | ("accelerometer", Some("polar-acc")) => {
+            values[0] = integer("source_time_ns")?;
+            values[1] = integer("source_sequence")?;
+            values[2] = integer("sample_index")?;
+            if kind == "ecg" {
+                values[3] = row["microvolts"].as_i64().ok_or(BAD)?.to_string();
+            } else {
+                let axes = row["xyz_mg"].as_array().filter(|axes| axes.len() == 3).ok_or(BAD)?;
+                for (cell, axis) in values[4..7].iter_mut().zip(axes) {
+                    *cell = axis.as_number().ok_or(BAD)?.to_string();
+                }
+            }
+        }
+        ("radius", Some("effective-radius-snapshot")) => {
+            values[7] = integer("source_frame")?;
+            values[8] = row["resulting_radius_m"].as_number().ok_or(BAD)?.to_string();
+        }
+        ("breath", Some("breath")) => {
+            if row["assessment_source"].as_str() != Some("polar-acc") {
+                return Ok(None);
+            }
+            values[9] = row["unbiased_phase"].as_str()
+                .filter(|phase| matches!(*phase, "inhale" | "exhale" | "hold" | "unknown"))
+                .ok_or(BAD)?.to_owned();
+        }
+        _ => return Err(BAD),
+    }
+    Ok(Some(values))
+}
+
+struct ClockMark {
+    at: u64,
+    elapsed: u64,
+    state: &'static str,
+}
+
+#[derive(Default)]
+struct PlaybackClock {
+    marks: Vec<ClockMark>,
+    last_event: u64,
+    media_started: bool,
+}
+
+impl PlaybackClock {
+    fn read(source: impl BufRead, ended_at: Option<u64>) -> Result<Option<Self>, String> {
+        let mut clock = Self::default();
+        for line in source.lines() {
+            let row: Value = serde_json::from_str(&line.map_err(io_error)?)
+                .map_err(|_| "participant-event-json-invalid")?;
+            clock.observe(&row, ended_at)?;
+        }
+        Ok((!clock.marks.is_empty()).then_some(clock))
+    }
+
+    fn observe(&mut self, row: &Value, ended_at: Option<u64>) -> Result<Option<SessionEventKind>, String> {
+        if let Some(at) = row["observed_monotonic_ns"].as_u64() {
+            self.last_event = self.last_event.max(at);
+        }
+        let kind = row["event"].as_str().and_then(SessionEventKind::parse);
+        use SessionEventKind::*;
+        let previous = self.marks.last();
+        let state = match kind {
+            Some(OfficialStart) if previous.is_none() => "waiting",
+            Some(AudioStarted) if previous.is_some() && !self.media_started => {
+                self.media_started = true;
+                if previous.is_some_and(|mark| mark.state == "paused") { "paused" } else { "playing" }
+            }
+            Some(ExperimentPaused) if previous.is_some() => "paused",
+            Some(ExperimentResumed) if previous.is_some() => {
+                if self.media_started { "playing" } else { "waiting" }
+            }
+            Some(AudioEnded | AudioError) if previous.is_some() => "ended",
+            _ => return Ok(None),
+        };
+        let at = row["observed_monotonic_ns"].as_u64().ok_or("participant-event-time-invalid")?;
+        if ended_at.is_some_and(|end| at > end) || previous.is_some_and(|mark| mark.at > at) {
+            return Err("participant-event-order-invalid".into());
+        }
+        if previous.is_some_and(|mark| mark.state == "ended") {
+            return Ok(None);
+        }
+        let elapsed = previous.map_or(0, |mark| {
+            mark.elapsed + if mark.state == "playing" { at - mark.at } else { 0 }
+        });
+        self.marks.push(ClockMark { at, elapsed, state });
+        Ok(kind)
+    }
+
+    fn start(&self) -> u64 {
+        self.marks[0].at
+    }
+
+    fn at(&self, at: u64, audio_end: u64) -> (u64, &'static str) {
+        let offset = self.marks.partition_point(|mark| mark.at <= at);
+        let mark = &self.marks[offset - 1];
+        let elapsed = mark.elapsed
+            + if mark.state == "playing" {
+                at - mark.at
+            } else {
+                0
+            };
+        (
+            elapsed.min(audio_end),
+            if elapsed >= audio_end {
+                "ended"
+            } else {
+                mark.state
+            },
+        )
+    }
+}
