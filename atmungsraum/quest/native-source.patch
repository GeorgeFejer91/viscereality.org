+#[test]
+fn accepted_retry_never_joins_previous_phase_or_raw_timestamp_to_the_new_model() {
+    // Keep raw/derived timestamps in JavaNanoTime, distinct from the core's
+    // Android elapsed-realtime alignment epoch throughout both attempts.
+    let elapsed = |frame| sample_time(frame) + 900_000_000_000;
+    let mut r = runtime();
+    r.observe_clock(7, 0, elapsed(0), true);
+    r.bind_source((5, 1));
+    assert_eq!(
+        command(&mut r, 1, "calibrate", elapsed(0))["accepted"],
+        true
+    );
+    for frame in (1764..=2_293_200).step_by(1764) {
+        let seconds = (frame % 705600) as f64 / 44100.0;
+        let volume = if seconds < 4.0 {
+            seconds / 4.0
+        } else if seconds < 8.0 {
+            1.0
+        } else if seconds < 12.0 {
+            (12.0 - seconds) / 4.0
+        } else {
+            0.0
+        };
+        r.observe_clock(7, frame, elapsed(frame), true);
+        r.observe_acc_with_source(
+            100_000_000_000 + sample_time(frame),
+            elapsed(frame),
+            sample_time(frame),
+            vector(volume),
+        );
+    }
+    for i in 1..=40 {
+        let frame = 2_293_200 + i * 1764;
+        r.observe_clock(7, frame, elapsed(frame), true);
+        r.observe_acc_with_source(
+            100_000_000_000 + sample_time(frame),
+            elapsed(frame),
+            sample_time(frame),
+            vector(1.0 - i as f64 / 50.0),
+        );
+    }
+    let retry_frame = 2_363_760;
+    assert_eq!(r.phase, CommonBreathPhase::Exhale);
+    let previous = r.tilt_assessment(elapsed(retry_frame)).unwrap();
+    assert_eq!(previous.generation.get(), 1);
+    assert_eq!(previous.phase, CommonBreathPhase::Exhale);
+    assert_eq!(previous.sampled_at.get(), sample_time(retry_frame) / 1000);
+
+    // A rejected calibration must preserve the existing working projection.
+    let status = r.status(elapsed(retry_frame));
+    let rejected = r.command(
+        &json!({"v":1,"id":"0000000000000002","g":6,"r":status["r"],"op":"calibrate"}),
+        elapsed(retry_frame),
+    );
+    assert_eq!(rejected["accepted"], false);
+    assert_eq!(r.phase, CommonBreathPhase::Exhale);
+    assert_eq!(r.classified_model, Some(1));
+    assert_eq!(r.classified_at, Some(sample_time(retry_frame)));
+
+    assert_eq!(
+        command(&mut r, 3, "calibrate", elapsed(retry_frame))["accepted"],
+        true
+    );
+    for frame in (2_365_524..=4_231_836).step_by(1764) {
+        let seconds = (frame % 705600) as f64 / 44100.0;
+        let volume = if seconds < 4.0 {
+            seconds / 4.0
+        } else if seconds < 8.0 {
+            1.0
+        } else if seconds < 12.0 {
+            (12.0 - seconds) / 4.0
+        } else {
+            0.0
+        };
+        r.observe_clock(7, frame, elapsed(frame), true);
+        r.observe_acc_with_source(
+            100_000_000_000 + sample_time(frame),
+            elapsed(frame),
+            sample_time(frame),
+            vector(volume),
+        );
+    }
+    // The clock activates model 2 before the first ACC observation classified
+    // under that model. Old measured Exhale must not become model 2 evidence.
+    let final_frame = 4_233_600;
+    r.observe_clock(7, final_frame, elapsed(final_frame), true);
+    assert_eq!(
+        r.core.snapshot(elapsed(final_frame)).model_generation,
+        Some(2)
+    );
+    assert_eq!(r.output(elapsed(final_frame)), SetupDriverOutput::Waiting);
+    assert!(r.tilt_assessment(elapsed(final_frame)).is_none());
+    assert_eq!(r.classified_model, None);
+    assert_eq!(r.classified_at, None);
+    assert_eq!(r.phase, CommonBreathPhase::Unknown);
+
+    r.observe_acc_with_source(
+        100_000_000_000 + sample_time(final_frame),
+        elapsed(final_frame),
+        sample_time(final_frame),
+        vector(0.0),
+    );
+    assert!(matches!(
+        r.output(elapsed(final_frame)),
+        SetupDriverOutput::PolarTilt {
+            model_generation: 2,
+            ..
+        }
+    ));
+    let current = r.tilt_assessment(elapsed(final_frame)).unwrap();
+    assert_eq!(current.generation.get(), 2);
+    assert_eq!(current.sampled_at.get(), sample_time(final_frame) / 1000);
+    assert_eq!(current.observed_at.get(), sample_time(final_frame) / 1000);
+    assert_ne!(current.phase, CommonBreathPhase::Exhale);
+}
