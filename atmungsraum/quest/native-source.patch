+#[cfg(not(feature = "showcase"))]
+pub(crate) fn recording_sample_admitted(
+    record: &crate::session_recording_contract::SessionRecord,
+) -> bool {
+    use crate::{session_recording_contract::SessionRecord, source_clock::SourceClock};
+    if !selected() {
+        return true;
+    }
+    if matches!(
+        record,
+        SessionRecord::Event(_) | SessionRecord::BiasChange(_)
+    ) {
+        return true;
+    }
+    let guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    let Some(r) = guard.as_ref() else {
+        return false;
+    };
+    let s = r.core.snapshot(r.now_ns());
+    if !matches!(
+        s.experiment,
+        ExperimentState::Running | ExperimentState::Finished
+    ) || r.controller_lost
+    {
+        return false;
+    }
+    let Some(start) = s.experiment_start_frame else {
+        return false;
+    };
+    let Some((_, clock_frame, clock_ns, playing)) = r.last_clock else {
+        return false;
+    };
+    if !playing {
+        return false;
+    }
+    let contains = |elapsed: u64| {
+        let delta = i128::from(elapsed) - i128::from(clock_ns);
+        if delta.unsigned_abs() > 250_000_000 {
+            return false;
+        }
+        let frame =
+            i128::from(clock_frame) + delta * i128::from(r.schedule.sample_rate) / 1_000_000_000;
+        frame >= i128::from(start) && frame < i128::from(start + s.experiment_target_frames)
+    };
+    let source_contains = |clock: SourceClock, time: u64| match clock {
+        SourceClock::AndroidElapsedRealtime => contains(time),
+        SourceClock::JavaNanoTime => r.map_raw_host(time).is_some_and(contains),
+        _ => false,
+    };
+    match record {
+        SessionRecord::PolarAcc(batch) => batch.samples.iter().all(|sample| {
+            source_contains(
+                sample.received_source.clock,
+                sample.received_source.value_ns,
+            )
+        }),
+        SessionRecord::PolarEcg(batch) => batch.samples.iter().all(|sample| {
+            source_contains(
+                sample.received_source.clock,
+                sample.received_source.value_ns,
+            )
+        }),
+        SessionRecord::PolarHeartRate(sample) => {
+            source_contains(sample.source_time.clock, sample.source_time.value_ns)
+        }
+        SessionRecord::Breath(sample)
+            if matches!(
+                sample.sampled_at.clock,
+                SourceClock::AndroidElapsedRealtime | SourceClock::JavaNanoTime
+            ) =>
+        {
+            source_contains(sample.sampled_at.clock, sample.sampled_at.value_ns)
+        }
+        _ => contains(record.observed_at().get()),
+    }
+}
