+    fn select_pretrained(&mut self, operation: &str, now: u64) -> Result<(), &'static str> {
+        if !self.projection_ready {
+            return Err("source-clock-warming");
+        }
+        if self.source_binding.is_none_or(|b| b.0 == 0) {
+            return Err("polar-source-unavailable");
+        }
+        let input = if operation == "polar-fixed" {
+            SetupInput::PolarTiltFixed
+        } else {
+            SetupInput::PolarTiltAdaptive
+        };
+        self.core
+            .select_pretrained(input, self.source_reference, now)
+            .map_err(|f| f.as_str())
+    }
+    fn store_receipt(&mut self, command: Value, result: Value) {
+        if let Some((_, prior)) = self
+            .ledger
+            .iter_mut()
+            .find(|(prior, _)| prior["id"] == command["id"])
+        {
+            *prior = result;
+        } else {
+            if self.ledger.len() == 64 {
+                self.ledger.pop_front();
+            }
+            self.ledger.push_back((command, result));
+        }
+    }
+    fn finish_recovery(&mut self, accepted: bool, reason: &'static str) {
+        let Some(recovery) = self.recovery.take() else {
+            return;
+        };
+        if !accepted {
+            self.core.retire_audio_evidence();
+        }
+        let mut result = receipt(&recovery.command, accepted, reason);
+        result["recovery_generation"] = json!(recovery.target_generation);
+        self.store_receipt(recovery.command, result);
+        self.revision = self.revision.saturating_add(1);
+    }
+    fn expire_recovery(&mut self, now: u64) {
