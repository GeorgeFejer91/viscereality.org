+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.res.AssetFileDescriptor;
+import android.content.res.AssetManager;
+import android.media.MediaPlayer;
+import android.util.Log;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.List;
+
+/** Prepares a verified packaged timeline on the condition-audio worker. */
+final class ScenarioAudioAndroidTracks
+        implements ConditionAudioAndroidMediaBackendFactory.ScenarioTracks {
+    private static final String TAG = "RustyQuestNativeRenderer";
+    private final AssetManager assets;
+    private final File cache;
+    private final String digest;
+    private volatile ScenarioAudioPackage catalog;
+
+    ScenarioAudioAndroidTracks(AssetManager assets, File cache, String digest) {
+        this.assets = assets;
+        this.cache = cache;
+        this.digest = digest;
+    }
+
+    @Override public void verify() throws Exception {
+        try {
+            ScenarioAudioPackage selected = ScenarioAudioPackage.open(new ScenarioAudioPackage.AssetSource() {
+                @Override public InputStream open(String path) throws IOException {
+                    return assets.open("atmungsraum-audio/" + path, AssetManager.ACCESS_STREAMING);
+                }
+            }, digest);
+            selected.verifyAll();
+            catalog = selected;
+            Log.i(TAG, "channel=scenario-audio event=verified");
+        } catch (Exception error) {
+            Log.e(TAG, "channel=scenario-audio event=rejected", error);
+            throw error;
+        }
+    }
+
+    @Override public List<String> ids() {
+        ScenarioAudioPackage selected = catalog;
+        return selected == null ? Collections.<String>emptyList() : selected.ids();
+    }
+
+    @Override public String recordingPlan(String id) {
+        ScenarioAudioPackage selected = catalog;
+        return selected == null ? null : selected.recordingPlan(id);
+    }
+
+    @Override public boolean hasCalibrationInstruction() throws IOException {
+        ScenarioAudioPackage selected = catalog;
+        if (selected == null) throw new IOException("scenario-audio-not-verified");
+        return selected.hasCalibrationInstruction();
+    }
+
+    @Override public Runnable playCalibrationInstruction(Runnable completed, Runnable failed) throws Exception {
+        if (!hasCalibrationInstruction()) throw new IOException("calibration-instruction-unavailable");
+        MediaPlayer player = new MediaPlayer();
+        try (AssetFileDescriptor input = assets.openFd("atmungsraum-audio/assets/audio/playground/calibration-prelude.mp3")) {
+            player.setDataSource(input.getFileDescriptor(), input.getStartOffset(), input.getLength());
+            player.setLooping(false);
+            player.setOnPreparedListener(ready -> {
+                try { ready.start(); }
+                catch (RuntimeException unavailable) { failed.run(); }
+            });
+            player.setOnErrorListener((source, reason, extended) -> { failed.run(); return true; });
+            player.setOnCompletionListener(source -> completed.run());
+            player.prepareAsync();
+            return player::release;
+        } catch (Exception unavailable) {
+            player.release();
+            throw unavailable;
+        }
+    }
+
+    @Override public MediaPlayer prepare(String id) throws Exception {
+        ScenarioAudioPackage selected = catalog;
+        if (selected == null) throw new IllegalStateException("scenario-audio-not-verified");
+        boolean encoded = selected.hasEncodedTrack(id);
+        File playback = File.createTempFile("scenario-", encoded ? ".mp3" : ".wav", cache);
+        try {
+            long frames;
+            try (FileOutputStream output = new FileOutputStream(playback)) {
+                frames = encoded ? selected.writeEncodedTrack(id, output) : selected.writeWave(id, output);
+            }
+            MediaPlayer player = new MediaPlayer();
+            try (FileInputStream input = new FileInputStream(playback)) {
+                player.setDataSource(input.getFD(), 0, playback.length());
+                player.prepare();
+                Log.i(TAG, "channel=scenario-audio event=prepared scenario=" + id
+                    + " frames=" + frames + " catalog_sha256=" + digest);
+                return player;
+            } catch (Exception failure) {
+                player.release();
+                throw failure;
+            }
+        } finally {
+            if (!playback.delete()) Log.w(TAG, "channel=scenario-audio event=cache-cleanup-failed");
+        }
+    }
+}
