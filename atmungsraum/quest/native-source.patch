+        match self {
+            Self::Inhale => "inhale",
+            Self::HoldIn => "hold_in",
+            Self::Exhale => "exhale",
+            Self::HoldOut => "hold_out",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
