+pub(crate) fn observe_controller(
+    snapshot: rusty_quest_breath_contract::composition::BreathCompositionSnapshot,
+    assessment: rusty_quest_breath_contract::assessment::BreathAssessmentObservation,
+) {
+    if !selected() {
+        return;
+    }
+    use rusty_quest_breath_contract::{
+        assessment::BreathTrackingState,
+        calibration::CalibrationLifecycle,
+        composition::{
+            BreathCompositionMapping, BreathCompositionSource, BreathCompositionStatus,
+            ControllerProjectionSelection,
+        },
+    };
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    let Some(r) = guard.as_mut() else {
+        return;
+    };
+    let valid = snapshot.status == BreathCompositionStatus::Running
+        && snapshot.rejection.is_none()
+        && snapshot.latest_assessment == Some(assessment)
+        && snapshot.generation == Some(assessment.generation)
+        && snapshot.effective.is_some_and(|s| {
+            s.source == BreathCompositionSource::Controller
+                && s.mapping == BreathCompositionMapping::State
+                && s.controller_projection == ControllerProjectionSelection::FixedOrientation
+        })
+        && assessment.calibration == CalibrationLifecycle::Ready
+        && assessment.tracking == BreathTrackingState::Valid
+        && matches!(
+            assessment.phase,
+            CommonBreathPhase::Inhale | CommonBreathPhase::Exhale | CommonBreathPhase::Hold
+        );
+    let now = r.now_ns();
+    if valid
+        && r.core.snapshot(now).input == SetupInput::Controller
+        && r.controller_generation.is_none()
+    {
+        r.controller_generation = Some(assessment.generation.get());
+    }
+    r.observe_controller(assessment.generation.get(), valid, now);
+    if valid
+        && r.core.snapshot(now).input == SetupInput::Controller
+        && r.controller_generation == Some(assessment.generation.get())
+    {
+        r.phase = assessment.phase;
+        r.controller_volume01 = assessment.volume01;
+    }
+}
