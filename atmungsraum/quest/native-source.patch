index 00000000..020e7617
--- /dev/null
+++ b/apps/native-renderer-android/src/phone-pairing/java/io/github/mesmerprism/rustyquest/native_renderer/ExperimentPhonePairingUiPolicy.java
@@ -0,0 +1,52 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import org.json.JSONObject;
+
+/** Presentation ownership only. The gateway remains the pairing and membership authority. */
+final class ExperimentPhonePairingUiPolicy {
+    static final class Token {
+        final Object owner;
+        final String id,code,phoneName;
+        final long generation,openingRevision;
+        final boolean openedPanel;
+        Token(Object owner,JSONObject prompt,long generation,long revision,boolean openedPanel)throws Exception{
+            this.owner=owner;id=prompt.getString("pairing_id");code=prompt.getString("code");phoneName=prompt.getString("phone_name");
+            this.generation=generation;openingRevision=revision;this.openedPanel=openedPanel;
+        }
+    }
+    private Token current;
+    static boolean valid(JSONObject prompt){
+        if(prompt==null)return false;
+        Object id=prompt.opt("pairing_id"),code=prompt.opt("code"),name=prompt.opt("phone_name"),expiry=prompt.opt("expires_in_ms");
+        return id instanceof String&&((String)id).matches("[0-9a-f]{32}")
+            &&code instanceof String&&((String)code).matches("[0-9]{6}")
+            &&name instanceof String&&!((String)name).trim().isEmpty()&&((String)name).length()<=64&&!((String)name).matches("(?s).*\\p{Cntrl}.*")
+            &&integer(expiry)&&((Number)expiry).longValue()>0&&((Number)expiry).longValue()<=120000;
+    }
+    static boolean visibilityKnown(JSONObject value){
+        return value!=null&&integer(value.opt("generation"))&&((Number)value.opt("generation")).longValue()>0
+            &&integer(value.opt("request_revision"))&&((Number)value.opt("request_revision")).longValue()>=0
+            &&value.opt("requested_visible") instanceof Boolean;
+    }
+    private static boolean integer(Object value){return value instanceof Integer||value instanceof Long;}
+    Token begin(Object owner,JSONObject prompt,JSONObject before,JSONObject opening)throws Exception{
+        if(current!=null||owner==null||!valid(prompt))return null;
+        boolean opened=visibilityKnown(before)&&Boolean.FALSE.equals(before.opt("requested_visible"));
+        if(opened&&(!visibilityKnown(opening)||!Boolean.TRUE.equals(opening.opt("requested_visible"))
+                ||before.getLong("generation")!=opening.getLong("generation")))return null;
+        current=new Token(owner,prompt,opened?opening.getLong("generation"):visibilityKnown(before)?before.getLong("generation"):0,
+            opened?opening.getLong("request_revision"):0,opened);
+        return current;
+    }
+    boolean decisionCurrent(Token token,Object owner,JSONObject prompt){
+        return token!=null&&token==current&&token.owner==owner&&valid(prompt)
+            &&token.id.equals(prompt.opt("pairing_id"))&&token.code.equals(prompt.opt("code"))&&token.phoneName.equals(prompt.opt("phone_name"));
+    }
+    boolean restoreVisibility(Token token,Object owner,JSONObject visibility){
+        return token!=null&&token==current&&token.owner==owner&&token.openedPanel&&visibilityKnown(visibility)
+            &&((Number)visibility.opt("generation")).longValue()==token.generation
+            &&((Number)visibility.opt("request_revision")).longValue()==token.openingRevision
+            &&Boolean.TRUE.equals(visibility.opt("requested_visible"));
+    }
+    void finish(Token token){if(current==token)current=null;}
+}
diff --git a/apps/native-renderer-android/src/phone-pairing/java/io/github/mesmerprism/rustyquest/native_renderer/ExperimentStartupPermissions.java b/apps/native-renderer-android/src/phone-pairing/java/io/github/mesmerprism/rustyquest/native_renderer/ExperimentStartupPermissions.java
new file mode 100644
index 00000000..64e97dc3
--- /dev/null
+++ b/apps/native-renderer-android/src/phone-pairing/java/io/github/mesmerprism/rustyquest/native_renderer/ExperimentStartupPermissions.java
@@ -0,0 +1,190 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.app.Activity;
+import android.content.pm.PackageManager;
+import android.content.Intent;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/** One attended platform request for the selected native product's declared startup closure.
+ * Permission intent grants no session, sensor, pairing or presentation authority. */
+final class ExperimentStartupPermissions {
+    static final int REQUEST=9410;
+    private static final int LOCATION_SETTINGS=9411;
+    private static final Handler main=new Handler(Looper.getMainLooper());
+    private static WeakReference<Activity> owner=new WeakReference<Activity>(null);
+    private static long generation;
+    private static boolean resumed,pending,settled,awaitResume,deliveryPending,deliveryPosted,promptOwned;
+    private static boolean locationAsked,locationPending,locationPaused;
+    private static int attempts;
+    private static String[] resultPermissions=new String[0];
+    private static int[] resultGrants=new int[0];
+    // Observations never select a route or grant authority. Weak keys retain no Activity.
+    private static final Map<Activity,Set<String>> observations=new WeakHashMap<Activity,Set<String>>();
+    private ExperimentStartupPermissions(){}
+    private static void observe(Activity host,String event,String fields){
+        if(host==null)return;
+        try{
+            Set<String> seen=observations.get(host);
+            if(seen==null){seen=new HashSet<String>();observations.put(host,seen);}
+            if(seen.add(event))android.util.Log.i("RQStartupPermissions","event="+event+(fields.isEmpty()?"":" "+fields));
+        }catch(RuntimeException unavailable){/* A diagnostic sink cannot change platform effects. */}
+    }
+    private static String locationObservation(Activity host){
+        try{return locationObservation(PolarBleRuntimeSupport.locationServicesState(host));}
+        catch(RuntimeException unavailable){return "unknown";}
+    }
+    private static String locationObservation(String state){
+        return Arrays.asList("enabled","disabled","unavailable","legacy-unobserved","permission-blocked","unknown").contains(state)?state:"unknown";
+    }
+    private static void observeLocationIntent(Activity host,Intent intent){
+        try{
+            android.content.ComponentName resolved=intent.resolveActivity(host.getPackageManager());
+            observe(host,"location-resolved","component="+(resolved==null?"none":resolved.flattenToShortString()));
+        }catch(RuntimeException unavailable){observe(host,"location-resolve-exception","exception="+unavailable.getClass().getSimpleName());}
+    }
+    private static void requireMain(){if(Looper.myLooper()!=Looper.getMainLooper())throw new IllegalStateException("startup-permissions-main-owner-required");}
+    private static boolean selected(Activity host){
+        if(host==null||!NativeRendererActivityComponents.isNative(host))return false;
+        try{return Boolean.TRUE.equals(host.getPackageManager().getApplicationInfo(host.getPackageName(),PackageManager.GET_META_DATA)
+            .metaData.get("rusty.quest.experiment.phone_pairing.enabled"));}catch(Exception unavailable){return false;}
+    }
+    private static boolean current(Activity host){
+        return selected(host)&&!host.isFinishing()&&!host.isDestroyed()&&BreathCompositionPanelModule.controllerFor(host)!=null;
+    }
+    private static void bind(Activity host){
+        if(owner.get()==host)return;
+        Activity previous=owner.get();if(previous!=null)finishPrompt(previous);
+        owner=new WeakReference<Activity>(host);generation++;resumed=false;pending=false;settled=false;awaitResume=false;
+        deliveryPending=false;deliveryPosted=false;attempts=0;resultPermissions=new String[0];resultGrants=new int[0];
+        locationAsked=false;locationPending=false;locationPaused=false;
+        observe(host,"bound","previousOwnerPresent="+(previous!=null));
+    }
+    /** True consumes the selected route even when it must await the actual host's resume. */
+    public static boolean request(Activity host){
+        requireMain();if(!selected(host))return false;if(!current(host)){
+            observe(host,"request-rejected","controllerPresent="+(BreathCompositionPanelModule.controllerFor(host)!=null)
+                +" finishing="+host.isFinishing()+" destroyed="+host.isDestroyed());return true;
+        }
+        bind(host);drive(host);return true;
+    }
+    public static void resumed(Activity host){
+        requireMain();if(!current(host)){
+            if(selected(host))observe(host,"resume-rejected","controllerPresent="+(BreathCompositionPanelModule.controllerFor(host)!=null)
+                +" finishing="+host.isFinishing()+" destroyed="+host.isDestroyed());return;
+        }
+        observe(host,"resume-admitted","bound="+(owner.get()==host));bind(host);resumed=true;
+        observe(host,"resumed","pending="+pending+" settled="+settled+" locationPending="+locationPending);
+        if(locationPending&&locationPaused){observe(host,"location-resumed","location="+locationObservation(host));finishLocation(host);}
+        if(awaitResume){awaitResume=false;if(attempts>=2)settled=true;}
+        drive(host);postDelivery(host);
+    }
+    public static void paused(Activity host){requireMain();if(owner.get()==host){
+        observe(host,"paused","pending="+pending+" locationPending="+locationPending);
+        resumed=false;if(locationPending){locationPaused=true;observe(host,"location-paused","");}
+    }}
+    public static void retired(Activity host){
+        requireMain();if(owner.get()!=host)return;observe(host,"retired","pending="+pending+" locationPending="+locationPending);
+        finishPrompt(host);owner.clear();generation++;
+        resumed=false;pending=false;settled=false;awaitResume=false;deliveryPending=false;deliveryPosted=false;
+        locationPending=false;locationPaused=false;
+    }
+    /** Discovery may proceed with its own granted subset after the single attended request settles. */
+    public static boolean busy(Activity host){
+        requireMain();return !current(host)||owner.get()!=host||!resumed||pending||locationPending||!settled||deliveryPending||deliveryPosted;
+    }
+    private static List<String> missing(Activity host)throws Exception{
+        Set<String> declared=new HashSet<String>();
+        String[] permissions=host.getPackageManager().getPackageInfo(host.getPackageName(),PackageManager.GET_PERMISSIONS).requestedPermissions;
+        if(permissions!=null)declared.addAll(Arrays.asList(permissions));
+        List<String> missing=new ArrayList<String>();if(Build.VERSION.SDK_INT<23)return missing;
+        for(String permission:new String[]{"android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_ADVERTISE",
+                "android.permission.ACCESS_FINE_LOCATION","android.permission.ACCESS_COARSE_LOCATION","android.permission.NEARBY_WIFI_DEVICES"}){
+            if(permission.startsWith("android.permission.BLUETOOTH_")&&Build.VERSION.SDK_INT<31)continue;
+            if(permission.equals("android.permission.NEARBY_WIFI_DEVICES")&&Build.VERSION.SDK_INT<33)continue;
+            if(declared.contains(permission)&&host.checkSelfPermission(permission)!=PackageManager.PERMISSION_GRANTED)missing.add(permission);
+        }
+        return missing;
+    }
+    private static void drive(Activity host){
+        if(!resumed||pending||settled||awaitResume||owner.get()!=host||!current(host))return;
+        try{
+            List<String> missing=missing(host);
+            observe(host,"runtime-state","missingCount="+missing.size());
+            if(missing.isEmpty()){observe(host,"runtime-ready","missingCount=0");settled=true;deliveryPending=true;postDelivery(host);return;}
+            if(attempts>=2){settled=true;deliveryPending=true;postDelivery(host);return;}
+            attempts++;pending=true;promptOwned=true;NativeRendererSelfKioskApplication.beginSystemPrompt(host);
+            android.util.Log.i("RQStartupPermissions","event=runtime-request attempt="+attempts+" count="+missing.size()+" panelRequested=false");
+            host.requestPermissions(missing.toArray(new String[0]),REQUEST);
+        }catch(RuntimeException unavailable){
+            observe(host,"runtime-exception","exception="+unavailable.getClass().getSimpleName());
+            pending=false;settled=true;deliveryPending=true;finishPrompt(host);postDelivery(host);
+        }catch(Exception unavailable){observe(host,"runtime-exception","exception="+unavailable.getClass().getSimpleName());settled=true;deliveryPending=true;postDelivery(host);}
+    }
+    public static boolean result(Activity host,int code,String[] permissions,int[] grants){
+        requireMain();if(code!=REQUEST||!selected(host))return false;
+        if(owner.get()!=host||!current(host)||!pending)return true;
+        pending=false;finishPrompt(host);
+        resultPermissions=permissions==null?new String[0]:permissions.clone();resultGrants=grants==null?new int[0]:grants.clone();
+        boolean cancelled=resultPermissions.length==0||resultGrants.length==0||resultPermissions.length!=resultGrants.length;
+        observe(host,"runtime-result-"+attempts,"count="+resultPermissions.length+" cancelled="+cancelled);
+        if(cancelled&&attempts<2){awaitResume=true;return true;}
+        // A denial is final for this actual owner. Only one cancellation can retry on a later resume.
+        settled=true;deliveryPending=true;postDelivery(host);return true;
+    }
+    public static boolean activityResult(Activity host,int code){
+        requireMain();if(code!=LOCATION_SETTINGS||!selected(host))return false;
+        boolean currentOwner=owner.get()==host&&current(host);
+        observe(host,"location-result","request=9411 current="+currentOwner+" pending="+locationPending
+            +" location="+(currentOwner?locationObservation(host):"not-observed"));
+        if(currentOwner&&locationPending){finishLocation(host);postDelivery(host);}return true;
+    }
+    private static void finishLocation(Activity host){
+        locationPending=false;locationPaused=false;finishPrompt(host);deliveryPending=true;
+    }
+    private static boolean presentLocationPrerequisite(Activity host){
+        if(locationPending)return true;if(locationAsked)return false;
+        try{
+            String[] declared=host.getPackageManager().getPackageInfo(host.getPackageName(),PackageManager.GET_PERMISSIONS).requestedPermissions;
+            boolean scanDeclared=declared!=null&&Arrays.asList(declared).contains("android.permission.BLUETOOTH_SCAN");
+            int missingCount=scanDeclared?missing(host).size():-1;
+            String location=scanDeclared&&missingCount==0?PolarBleRuntimeSupport.locationServicesState(host):"not-observed";
+            observe(host,"location-check","declaredScan="+scanDeclared+" missingCount="+missingCount
+                +" location="+("not-observed".equals(location)?location:locationObservation(location)));
+            if(!scanDeclared||missingCount!=0||!"disabled".equals(location))return false;
+            // A normal attended OS surface, never a Settings write or app approval panel.
+            locationAsked=true;locationPending=true;promptOwned=true;NativeRendererSelfKioskApplication.beginSystemPrompt(host);
+            Intent intent=new Intent(android.provider.Settings.ACTION_LOCATION_SOURCE_SETTINGS);
+            observeLocationIntent(host,intent);observe(host,"location-launch","request=9411 panelRequested=false");
+            host.startActivityForResult(intent,LOCATION_SETTINGS);observe(host,"location-launch-returned","request=9411");
+            return true;
+        }catch(Exception unavailable){observe(host,"location-exception","exception="+unavailable.getClass().getSimpleName());locationPending=false;locationAsked=true;finishPrompt(host);return false;}
+    }
+    private static void finishPrompt(Activity host){
+        if(!promptOwned)return;promptOwned=false;NativeRendererSelfKioskApplication.endSystemPrompt(host);
+    }
+    private static void postDelivery(final Activity host){
+        if(!resumed||!settled||!deliveryPending||deliveryPosted||owner.get()!=host)return;
+        final long captured=generation;deliveryPosted=true;
+        observe(host,"delivery-posted","");
+        main.post(new Runnable(){public void run(){
+            if(captured!=generation||owner.get()!=host){observe(host,"delivery-dropped-owner","");return;}deliveryPosted=false;
+            if(!resumed||!settled||!deliveryPending||!current(host)){
+                observe(host,"delivery-deferred","resumed="+resumed+" settled="+settled+" pending="+deliveryPending+" current="+current(host));return;
+            }
+            observe(host,"delivery-dispatch","");
+            if(presentLocationPrerequisite(host))return;
+            deliveryPending=false;
+            BreathCompositionPanelModule.onSelectedStartupPermissionsSettled(host,resultPermissions.clone(),resultGrants.clone());
+        }});
+    }
+}
