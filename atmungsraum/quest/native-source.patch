+foreach($name in @('Resolve-RepoPath','Get-FileSha256','Assert-HashMatches')){
+ $f=@($ast.FindAll({param($n)$n-is[Management.Automation.Language.FunctionDefinitionAst]-and$n.Name-ceq$name},$true));. ([scriptblock]::Create($f[0].Extent.Text))
