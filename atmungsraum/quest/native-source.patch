+        for phase in [
+            CommonBreathPhase::Inhale,
+            CommonBreathPhase::Exhale,
+            CommonBreathPhase::Hold,
+        ] {
+            for barrier in [
+                "poll-gap",
+                "head-stall",
+                "source-binding",
+                "audio-generation",
+                "generation-regression",
+                "minimum-no-assessments",
+            ] {
+                let (mut r, mut frame, mut now) = polar_diagnosis_runtime(input, phase);
+                let mut driver = BreathCompositionDriver::new(settings());
+                setup_frame_with_lineage(
+                    &mut driver,
+                    r.output(now),
+                    r.renderer_lineage(now),
+                    now,
+                    0.2,
+                );
+                let before = driver.value01();
+                let old_lineage = r.renderer_lineage(now);
+                assert!(r.last_confirmed_phase.is_some());
+                if barrier == "minimum-no-assessments" {
+                    // Keep actual clock observations advancing into hold-out without
+                    // inventing sensor assessments for the missing interval.
+                    let target = ((frame / 705600) + 1) * 705600 + 573300;
+                    while frame < target {
+                        frame += (target - frame).min(882);
+                        now = sample_time(frame);
+                        r.observe_clock(7, frame, now, true);
+                    }
+                    assert_eq!(r.core.snapshot(now).automatic_volume, 0.0);
+                }
+                let at = now + 300_000_000;
+                match barrier {
+                    "poll-gap" | "minimum-no-assessments" => {
+                        r.observe_clock(7, frame + 13230, at, true)
+                    }
+                    "head-stall" => {
+                        for tick in 1..=15 {
+                            r.observe_clock(7, frame, now + tick * 20_000_000, true);
+                        }
+                    }
+                    "source-binding" => r.bind_source((5, 2)),
+                    "audio-generation" => r.observe_clock(8, 0, at, true),
+                    _ => r.observe_clock(6, 0, at, true),
+                }
+                let s = r.status(at);
+                assert_eq!(s["input"], input.as_str(), "{input:?}/{phase:?}/{barrier}");
+                assert_eq!(s["ready"], false);
+                assert_eq!(s["input_phase"], "unknown");
+                assert!(s["input_volume01"].is_null());
+                assert!(
+                    r.last_confirmed_phase.is_none(),
+                    "retire callback confirmation: {barrier}"
+                );
+                assert!(r.tilt_assessment(at).is_none());
+                assert_eq!(
+                    r.tracking_configuration(1, "test-main"),
+                    Err("setup-input-not-ready")
+                );
+                assert_ne!(
+                    r.renderer_lineage(at),
+                    old_lineage,
+                    "data lineage must retire"
+                );
+                assert!(r.renderer_lineage(at).continues_visual_input(old_lineage));
+                setup_frame_with_lineage(
+                    &mut driver,
+                    r.output(at),
+                    r.renderer_lineage(at),
+                    at,
+                    0.1,
+                );
+                let expected = before
+                    + match phase {
+                        CommonBreathPhase::Inhale => 0.05,
+                        CommonBreathPhase::Exhale => -0.025,
+                        _ => 0.0,
+                    };
+                assert!(
+                    (driver.value01() - expected).abs() < 0.000001,
+                    "{input:?}/{phase:?}/{barrier}: {} expected {expected}, {}",
+                    driver.value01(),
+                    driver.marker_fields()
+                );
+                let epoch = r.driver_epoch;
+                for _ in 0..3 {
+                    assert_eq!(r.status(at)["ready"], false);
+                    assert!(
+                        r.last_confirmed_phase.is_none(),
+                        "read-only status cannot revive confirmation"
+                    );
+                }
+                assert_eq!(r.driver_epoch, epoch, "status must not repeat retirement");
+                if input == SetupInput::PolarTilt {
+                    assert!(r.core.model().is_none());
+                    assert!(r.core.snapshot(at).model_generation.is_none());
+                    assert_eq!(r.status(at)["calibration"], "failed");
+                }
+            }
+        }
+    }
