+fn calibrate_labelled_participant_shape(pattern: u8) {
+    let mut setup = BreathingSetup::new(schedule());
+    setup.observe_clock(1, 0, time(0), false);
+    setup.start_calibration(7, time(0)).unwrap();
+    setup.observe_clock(1, 0, time(0), true);
+    run(&mut setup, 1764, 1_422_666, |frame| {
+        let angle = labelled_participant_shape(pattern, frame as f64 / 44100.0);
+        Some([angle.sin(), 0.0, angle.cos()])
+    });
+    let status = setup.snapshot(time(1_422_666));
+    assert_eq!(
+        status.calibration,
+        CalibrationState::Succeeded,
+        "pattern={pattern}, failure={:?}",
+        status.failure
+    );
+    assert_eq!(status.calibration_completed_frames, 1_411_200);
+    assert!(status.accepted_samples >= 790);
+    assert_eq!(status.quality.masked, 0);
+    assert_eq!(status.input, SetupInput::PolarTilt);
+    let model = setup.model().unwrap();
+    assert!(model.project([0.0, 0.0, 1.0]).unwrap() < 0.15);
+    let high = 0.10_f64;
+    assert!(model.project([high.sin(), 0.0, high.cos()]).unwrap() > 0.85);
+    assert_eq!(
+        setup.driver_sample(time(1_422_666)).unwrap().input,
+        SetupInput::PolarTilt
+    );
+}
