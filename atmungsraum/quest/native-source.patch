+fn run<F: Fn(u64) -> Option<[f64; 3]>>(
+    setup: &mut BreathingSetup,
+    first: u64,
+    last: u64,
+    vector: F,
+) {
+    for frame in (first..=last).step_by(1_764) {
+        setup.observe_clock(1, frame, time(frame), true);
+        if let Some(raw) = vector(frame) {
+            setup.observe_acc(7, 100_000_000_000 + time(frame), time(frame), raw);
+        }
+    }
+}
