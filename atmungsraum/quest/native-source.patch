+    }
+    let observation = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return;
+        };
+        r.bind_source(binding);
+        let Some(mapped_host) = r.map_raw_host(host) else {
+            return;
+        };
+        r.observe_acc_with_source(sensor, mapped_host, host, mg);
+        let now = r.now_ns().max(mapped_host);
+        r.tilt_assessment(now).map(|assessment| {
+            (
+                assessment,
+                r.revision,
+                r.core.snapshot(now).experiment == ExperimentState::Running,
+            )
+        })
+    };
+    if let Some((assessment, revision, main_running)) = observation {
+        crate::breath_composition_runtime::record_setup_assessment(
+            assessment,
+            revision,
+            main_running,
+        );
+    }
+}
+pub(crate) fn observe_rejected_acc(binding: (u64, u64), mg: [f32; 3]) {
+    if !selected() || binding != crate::polar_input_health::source_binding() {
+        return;
+    }
+    let required = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return;
+        };
+        if r.source_binding != Some(binding) {
+            return;
+        }
+        let reason = if mg.iter().all(|v| v.is_finite()) {
+            crate::experiment_breathing_setup::SetupFailure::ReorderedSample
+        } else {
+            crate::experiment_breathing_setup::SetupFailure::InvalidSample
+        };
+        r.core.reject_acc(r.source_reference, reason);
+        r.refresh_classifier_continuity(r.classified_at.unwrap_or(0));
+        r.refresh(r.now_ns());
+        r.core.snapshot(r.now_ns()).input.is_polar()
+    };
+    crate::polar_input_health::set_setup_required(Some(required));
+}
+pub(crate) fn current_tilt_assessment(
+) -> Option<rusty_quest_breath_contract::assessment::BreathAssessmentObservation> {
+    if !selected() {
+        return None;
+    }
+    let binding = crate::polar_input_health::source_binding();
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    let r = guard.as_mut()?;
+    r.bind_source(binding);
+    r.tilt_assessment(r.now_ns())
+}
+fn controller_state_calibration_ready(
+    calibration: rusty_quest_breath_contract::calibration::CalibrationLifecycle,
+    volume01: Option<f64>,
+) -> bool {
+    use rusty_quest_breath_contract::calibration::CalibrationLifecycle;
+    // The selected fixed-axis state classifier needs no fitted volume range.
+    // Keep its Configured/no-volume provenance; never label it calibrated.
+    calibration == CalibrationLifecycle::Ready
+        || calibration == CalibrationLifecycle::Configured && volume01.is_none()
+}
+
+pub(crate) fn observe_controller(
+    snapshot: rusty_quest_breath_contract::composition::BreathCompositionSnapshot,
+    assessment: rusty_quest_breath_contract::assessment::BreathAssessmentObservation,
+) {
+    if !selected() {
+        return;
+    }
+    use rusty_quest_breath_contract::{
+        assessment::BreathTrackingState,
+        composition::{
+            BreathCompositionMapping, BreathCompositionSource, BreathCompositionStatus,
+            ControllerProjectionSelection,
+        },
+    };
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    let Some(r) = guard.as_mut() else {
+        return;
+    };
+    let valid = snapshot.status == BreathCompositionStatus::Running
+        && snapshot.rejection.is_none()
+        && snapshot.latest_assessment == Some(assessment)
+        && snapshot.generation == Some(assessment.generation)
+        && snapshot.effective.is_some_and(|s| {
+            s.source == BreathCompositionSource::Controller
+                && s.mapping == BreathCompositionMapping::State
+                && s.controller_projection == ControllerProjectionSelection::FixedOrientation
+        })
+        && controller_state_calibration_ready(assessment.calibration, assessment.volume01)
+        && assessment.tracking == BreathTrackingState::Valid
+        && matches!(
+            assessment.phase,
+            CommonBreathPhase::Inhale | CommonBreathPhase::Exhale | CommonBreathPhase::Hold
+        );
+    let now = r.now_ns();
+    if valid
+        && r.core.snapshot(now).input == SetupInput::Controller
+        && r.controller_generation.is_none()
+    {
+        r.controller_generation = Some(assessment.generation.get());
+    }
+    r.observe_controller(assessment.generation.get(), valid, now);
+    if valid
+        && r.core.snapshot(now).input == SetupInput::Controller
+        && r.controller_generation == Some(assessment.generation.get())
+    {
+        r.phase = assessment.phase;
+        r.controller_volume01 = assessment.volume01;
+    }
+}
