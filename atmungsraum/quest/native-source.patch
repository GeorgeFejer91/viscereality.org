+    assert!(!directory.join(RECOVERY_RECEIPT).exists());
+    assert!(prepare(&root, directory.file_name().unwrap().to_str().unwrap(), &|| true).is_err());
+    fs::remove_dir_all(root.parent().unwrap()).unwrap();
+}
