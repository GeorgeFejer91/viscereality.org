+#[test]
+fn startup_maintenance_fences_setup_under_idle_and_recovery_effects() {
+    let _binding = crate::breath_composition_runtime::scoped_test_binding::install();
+    let _setup = GlobalSetupGuard::install();
+    observe_clock(7, 0, 1_000_000_000, false);
+    assert!(maintenance_parked());
+    let maintenance = crate::meta_update_admission::test_maintenance();
+    for (id, operation) in [
+        "start",
+        "controller",
+        "calibrate",
+        "polar-fixed",
+        "polar-adaptive",
+        "begin-main",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let before = status_json(1_000_000_000);
+        let value = json!({"v":1,"id":format!("{:016x}",id+1),"g":before["g"],"r":before["r"],"op":operation});
+        let result = command_json(&value.to_string(), 1_000_000_000);
+        assert_eq!(result["accepted"], false, "{operation}: {result}");
+        assert!(!status_json(1_000_000_000)["playing"].as_bool().unwrap());
+        assert_eq!(status_json(1_000_000_000)["calibration"], "idle");
+    }
+    assert_eq!(
+        recovery_effect("0000000000000001", 7, 8, "claim", 1_000_000_000)["reason"],
+        "startup-update-maintenance"
+    );
+    assert!(maintenance_parked());
+    drop(maintenance);
+    assert_eq!(
+        global_command(50, "controller", 1_000_000_000)["accepted"],
+        true
+    );
+    assert!(!maintenance_parked());
