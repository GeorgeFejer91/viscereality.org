+        wait_for(&runtime, "\"phase\":\"active\"");
+        assert_eq!(crate::meta_update_admission::session_cycle(), 2);
+        runtime.shutdown_for_test().unwrap();
+        fs::remove_dir_all(root.parent().unwrap()).unwrap();
+    }
+
+    #[test]
+    fn failed_actual_writer_finalization_keeps_cycle_blocked_without_park_authority() {
+        let root = temp_root("failed-cycle-finalization");
+        let runtime = ExperimentSessionRuntime::spawn(
+            root.clone(),
+            Some(trusted_inventory()),
+            |slot, loss| {
+                let backend = DamageBackend::new(slot, loss);
+                backend.fail_finalize_once.store(true, Ordering::Release);
+                Box::new(backend)
+            },
+        )
+        .unwrap();
+        wait_for(&runtime, "\"initialization_status\":\"ready\"");
+        let _cycle = crate::meta_update_admission::test_granted_cycle();
+        runtime.apply_command_json(&start_command(&root, "failed-cycle-start"));
+        wait_for(&runtime, "\"phase\":\"active\"");
+        runtime.apply_command_json(&command(
+            "restart-to-experimenter",
+            "failed-cycle-terminal",
+            1,
+            2000,
+        ));
+        wait_for(&runtime, "\"status\":\"unsaved\"");
+        assert_eq!(crate::meta_update_admission::session_cycle(), 1);
+        assert_eq!(crate::meta_update_admission::pending_park_cycle(), None);
+        assert!(!crate::meta_update_admission::acknowledge_park(1));
+        assert!(!crate::meta_update_admission::admit_session());
+        runtime.shutdown_for_test().unwrap();
+        fs::remove_dir_all(root.parent().unwrap()).unwrap();
+    }
+
+    #[test]
+    fn startup_maintenance_fences_direct_commands_and_actual_worker_writer_dispatch() {
+        let root = temp_root("startup-maintenance-fence");
+        let runtime =
+            ExperimentSessionRuntime::spawn_actual(root.clone(), Some(trusted_inventory()))
+                .unwrap();
+        wait_for(&runtime, "\"initialization_status\":\"ready\"");
+        let maintenance = crate::meta_update_admission::test_maintenance();
+        for operation in [
+            "arm",
+            "start",
+            "official-start",
+            "operator-official-start",
+            "resume",
+            "operator-resume",
+        ] {
+            let mut body: Value =
+                serde_json::from_str(&start_command(&root, "blocked-direct")).unwrap();
+            body["operation"] = json!(operation);
+            let result = runtime.apply_command_json(&body.to_string());
+            assert!(
+                result.contains("startup-update-maintenance"),
+                "{operation}: {result}"
+            );
+        }
+        // Exercise the real worker independently of the public queue admission.
+        runtime
+            .command_sender
+            .try_send(WorkerMessage::Command {
+                preparation_cycle: crate::meta_update_admission::session_cycle(),
+                preparation_reservation: None,
+                raw: start_command(&root, "blocked-worker"),
+                received_at: Instant::now(),
+                polar_ready_at_receipt: runtime.polar_ready_at_receipt(),
+                terminal_claim: None,
+                local_terminal_fence: None,
+            })
+            .unwrap();
+        let result: Value = serde_json::from_str(&wait_for(
+            &runtime,
+            "\"last_reason\":\"startup-update-maintenance\"",
+        ))
+        .unwrap();
+        assert_eq!(result["readback"]["phase"], "idle");
+        assert!(result["readback"]["session_key"].is_null());
+        drop(maintenance);
+        runtime.shutdown_for_test().unwrap();
+        assert!(
+            !root.exists(),
+            "maintenance must not prepare a recording writer"
+        );
+    }
 }
