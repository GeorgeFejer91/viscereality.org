+    }
+    private static long processStartTicks()throws Exception{
+        byte[] raw=new byte[4096];int size;
+        try(java.io.FileInputStream input=new java.io.FileInputStream("/proc/self/stat")){size=input.read(raw);}
+        if(size<=0||size==raw.length)throw new SecurityException("headset-setup-stat-invalid");
+        String stat=new String(raw,0,size,java.nio.charset.StandardCharsets.UTF_8);int close=stat.lastIndexOf(')');
+        if(close<0)throw new SecurityException("headset-setup-stat-invalid");String[] fields=stat.substring(close+1).trim().split("\\s+");
+        if(fields.length<20)throw new SecurityException("headset-setup-stat-invalid");long ticks=Long.parseLong(fields[19]);
+        if(ticks<=0)throw new SecurityException("headset-setup-stat-invalid");return ticks;
+    }
+    private static String installedApkSha256(Context context)throws Exception{
+        java.security.MessageDigest digest=java.security.MessageDigest.getInstance("SHA-256");
+        try(java.io.FileInputStream input=new java.io.FileInputStream(context.getApplicationInfo().sourceDir)){
+            byte[] block=new byte[65536];long total=0;int read;while((read=input.read(block))!=-1){total+=read;
+                if(total>64L*1024L*1024L)throw new SecurityException("headset-setup-apk-too-large");digest.update(block,0,read);}}
+        StringBuilder hex=new StringBuilder();for(byte value:digest.digest())hex.append(String.format(java.util.Locale.ROOT,"%02x",value&255));return hex.toString();
+    }
+}
