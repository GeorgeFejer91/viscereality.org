+fn calibrated() -> BreathingSetup {
+    let mut setup = fresh_setup();
+    setup.start_calibration(7, time(0)).unwrap();
+    run(&mut setup, 1_764, 2_116_800, |f| Some(guided_vector(f)));
+    assert_eq!(
+        setup.snapshot(time(2_116_800)).calibration,
+        CalibrationState::Succeeded
+    );
+    setup
+}
