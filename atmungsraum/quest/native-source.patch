+        if (!selected(context)) return;
+        synchronized (BreathingSetupAudio.class) {
+            selected = true;
+            if (appLifetime != null || !"breathing-loop-not-initialized".equals(installError)) return;
+            // Startup is a bounded worker operation, never an OpenXR/UI asset read.
+            installError = "breathing-loop-loading";
+            final Context app = context.getApplicationContext();
+            Thread loader = new Thread(new Runnable() { @Override public void run() {
+                try {
+                    byte[] bytes;
+                    try (InputStream in = app.getAssets().open(ROOT + "audio/box-loop.json")) {
+                        bytes = BreathingSetupAudioContract.readBounded(in, 32768);
+                    }
+                    String json = new String(bytes, StandardCharsets.UTF_8);
+                    BreathingSetupAudioContract contract = BreathingSetupAudioContract.parse(json);
+                    byte[] cycle = contract.loadCycle(new BreathingSetupAudioContract.Assets() {
+                        public InputStream open(String path) throws Exception { return app.getAssets().open(ROOT + path); }
+                    });
