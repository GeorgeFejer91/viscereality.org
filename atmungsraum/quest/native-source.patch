diff --git a/tools/checks/meta_platform_transport_test.cpp b/tools/checks/meta_platform_transport_test.cpp
new file mode 100644
index 00000000..1b80571f
--- /dev/null
+++ b/tools/checks/meta_platform_transport_test.cpp
@@ -0,0 +1,99 @@
+#include "meta_platform_transport.hpp"
+#include <OVR_Platform.h>
+#include <cassert>
+#include <deque>
+#include <iostream>
+
+// Compile the real queue against real SDK207 headers with fake SDK leaves.
+struct ovrMessage { ovrRequest id; ovrMessageType type; bool error; bool payload; };
+struct ovrApplicationVersion {};
+struct ovrAppDownloadProgressResult {};
+struct ovrAppDownloadResult {};
+struct ovrPlatformInitialize {};
+struct ovrError {};
+static std::deque<ovrMessage*> messages;
+static int freed=0;
+static ovrApplicationVersion version;
+static ovrAppDownloadProgressResult progress;
+static ovrAppDownloadResult download;
+static ovrPlatformInitialize init;
+static ovrError error;
+static std::string error_text="offline\nserver";
+static int http_code=409;
+static bool missing_error=false;
+extern "C" {
+ovrMessageHandle ovr_PopMessage() { if(messages.empty())return nullptr; auto v=messages.front(); messages.pop_front(); return v; }
+void ovr_FreeMessage(ovrMessageHandle m){++freed;delete m;}
+ovrRequest ovr_Message_GetRequestID(const ovrMessageHandle m){return m->id;}
+ovrMessageType ovr_Message_GetType(const ovrMessageHandle m){return m->type;}
+bool ovr_Message_IsError(const ovrMessageHandle m){return m->error;}
+ovrErrorHandle ovr_Message_GetError(const ovrMessageHandle){return missing_error?nullptr:&error;}
+int ovr_Error_GetCode(const ovrErrorHandle){return 42;}
+int ovr_Error_GetHttpCode(const ovrErrorHandle){return http_code;}
+const char* ovr_Error_GetMessage(const ovrErrorHandle){return error_text.c_str();}
+ovrApplicationVersionHandle ovr_Message_GetApplicationVersion(const ovrMessageHandle m){return m->payload?&version:nullptr;}
+int ovr_ApplicationVersion_GetCurrentCode(const ovrApplicationVersionHandle){return 15;}
+int ovr_ApplicationVersion_GetLatestCode(const ovrApplicationVersionHandle){return 16;}
+ovrAppDownloadProgressResultHandle ovr_Message_GetAppDownloadProgressResult(const ovrMessageHandle m){return m->payload?&progress:nullptr;}
+long long ovr_AppDownloadProgressResult_GetDownloadedBytes(const ovrAppDownloadProgressResultHandle){return 100;}
+long long ovr_AppDownloadProgressResult_GetDownloadBytes(const ovrAppDownloadProgressResultHandle){return 200;}
+ovrAppStatus ovr_AppDownloadProgressResult_GetStatusCode(const ovrAppDownloadProgressResultHandle){return ovrAppStatus_Downloading;}
+ovrAppDownloadResultHandle ovr_Message_GetAppDownloadResult(const ovrMessageHandle m){return m->payload?&download:nullptr;}
+ovrAppInstallResult ovr_AppDownloadResult_GetAppInstallResult(const ovrAppDownloadResultHandle){return ovrAppInstallResult_Success;}
+ovrPlatformInitializeHandle ovr_Message_GetPlatformInitialize(const ovrMessageHandle m){return m->payload?&init:nullptr;}
+ovrPlatformInitializeResult ovr_PlatformInitialize_GetResult(const ovrPlatformInitializeHandle){return ovrPlatformInitialize_Success;}
+}
+int main(){
+    using namespace rusty_quest_meta;
+    Queue queue; Message value;assert(queue.begin_attempt(42));
+    Queue capacity;assert(capacity.begin_attempt(41));for(int id=100;id<116;++id)assert(capacity.track(id,Version));assert(!capacity.track(116,Version));capacity.close();
+    assert(!queue.track(0,Version)); assert(queue.track(1,Version)); assert(!queue.track(1,Version));
+    messages.push_back(new ovrMessage{999,ovrMessage_Application_GetVersion,false,true});
+    messages.push_back(new ovrMessage{1,ovrMessage_Application_GetVersion,false,true});
+    assert(queue.poll(value)); assert(freed==2 && value.request_id==1 && value.current_code=="15" && value.available_code=="16");
+    assert(!queue.poll(value));
+    queue.track(2,Progress); messages.push_back(new ovrMessage{2,ovrMessage_Application_CheckAppDownloadProgress,false,true});
+    assert(queue.poll(value) && value.downloaded_bytes==100 && value.total_bytes==200 && value.progress_status==3);
+    queue.track(3,Install); messages.push_back(new ovrMessage{3,ovrMessage_Application_InstallAppUpdateAndRelaunch,false,true});
+    assert(queue.poll(value) && value.result_code==7 && value.progress_status==0);
+    queue.track(4,Initialize); messages.push_back(new ovrMessage{4,ovrMessage_PlatformInitializeAndroidAsynchronous,false,true});
+    assert(queue.poll(value) && value.result_code==0);
+    queue.track(5,Download); messages.push_back(new ovrMessage{5,ovrMessage_Application_StartAppDownload,true,true});
+    assert(queue.poll(value) && value.error_code==42 && value.error_message=="UNKNOWN");
+    assert(value.http_code==409 && value.install_result=="UNKNOWN");
+    for(const char* token:{"UNKNOWN","LOW_STORAGE","NETWORK_ERROR","DUPLICATE_REQUEST","INSTALLER_ERROR","USER_CANCELLED","AUTHORIZATION_ERROR","SUCCESS"}) {
+        error_text=std::string("Installer reported: ")+token+".";
+        assert(queue.track(50,Download));messages.push_back(new ovrMessage{50,ovrMessage_Application_StartAppDownload,true,true});
+        assert(queue.poll(value)&&value.install_result==token&&value.error_code==42&&value.http_code==409);
+    }
+    for(const std::string& text:{std::string("xDUPLICATE_REQUEST"),std::string("DUPLICATE_REQUEST_suffix"),std::string("DUPLICATE_REQUEST NETWORK_ERROR"),std::string(256,'x')+"DUPLICATE_REQUEST",std::string("DUPLICATE_REQUEST ")+std::string(256,'x')}) {
+        error_text=text;assert(queue.track(50,Download));messages.push_back(new ovrMessage{50,ovrMessage_Application_StartAppDownload,true,true});
+        assert(queue.poll(value)&&value.install_result=="UNKNOWN"&&value.error_message.size()<=256);
+    }
+    http_code=999;error_text="DUPLICATE_REQUEST";
+    assert(queue.track(50,Download));messages.push_back(new ovrMessage{50,ovrMessage_Application_StartAppDownload,true,true});
+    assert(queue.poll(value)&&value.http_code==0&&value.error_message=="DUPLICATE_REQUEST");
+    missing_error=true;assert(queue.track(50,Download));messages.push_back(new ovrMessage{50,ovrMessage_Application_StartAppDownload,true,true});
+    assert(queue.poll(value)&&value.error_code==-1001&&value.http_code==0&&value.install_result=="UNKNOWN");missing_error=false;
+    queue.track(6,Version); messages.push_back(new ovrMessage{6,ovrMessage_Application_StartAppDownload,false,true});
+    assert(queue.poll(value) && value.error_code!=0);
+    queue.track(7,Version); messages.push_back(new ovrMessage{7,ovrMessage_Application_GetVersion,false,false});
+    assert(queue.poll(value) && value.error_code!=0);
+    queue.track(8,Version); queue.close(); messages.push_back(new ovrMessage{8,ovrMessage_Application_GetVersion,false,true});
+    assert(!queue.poll(value) && !queue.track(9,Version));
