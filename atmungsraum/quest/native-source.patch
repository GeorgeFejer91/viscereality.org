+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioTrack;
+import android.os.SystemClock;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.Future;
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.json.JSONObject;
+
+/** One explicitly selected process-owned PCM player. Native owns all setup/model decisions. */
+final class BreathingSetupAudio implements AutoCloseable {
+    private static final String ENABLED = "rusty.quest.experiment.breathing_setup.enabled";
+    private static final String ROOT = "atmungsraum-audio/";
+    private static final AtomicLong GENERATIONS = new AtomicLong();
+    private static volatile BreathingSetupAudio appLifetime;
+    private static volatile boolean selected;
+    private static volatile String installError = "breathing-loop-not-initialized";
+
+    interface Clock { long nowNs(); }
+    interface Player {
+        void prepare(byte[] pcm, int sampleRate, int cycleFrames) throws Exception;
+        void play();
+        void pause();
+        boolean playing();
+        int head();
+        void release();
+    }
+    interface NativeBridge {
+        String configure(String json, String sha256);
+        default void observeSourceClockPair(long javaNanoNs, long elapsedNs) { }
+        void observe(long generation, long frame, long monotonicNs, boolean playing);
+        String status(long nowNs);
+        String command(String json, long nowNs);
+    }
+
+    private static native String nativeConfigure(String loopJson, String sha256);
+    private static native void nativeObserveClock(long generation, long frame, long monotonicNs, boolean playing);
+    private static native void nativeObserveSourceClockPair(long javaNanoNs, long elapsedNs);
+    private static native String nativeStatus(long nowNs);
+    private static native String nativeCommand(String json, long nowNs);
+
+    static boolean selected(Context context) {
+        if (context == null) return false;
+        try {
+            ApplicationInfo app = context.getPackageManager().getApplicationInfo(context.getPackageName(), PackageManager.GET_META_DATA);
+            return app.metaData != null && app.metaData.getBoolean(ENABLED, false);
+        } catch (Exception unavailable) { return false; }
+    }
+
+    static void installAppLifetime(final Context context) {
+        if (!selected(context)) return;
+        synchronized (BreathingSetupAudio.class) {
+            selected = true;
+            if (appLifetime != null || !"breathing-loop-not-initialized".equals(installError)) return;
+            // Startup is a bounded worker operation, never an OpenXR/UI asset read.
+            installError = "breathing-loop-loading";
+            final Context app = context.getApplicationContext();
+            Thread loader = new Thread(new Runnable() { @Override public void run() {
+                try {
+                    byte[] bytes;
+                    try (InputStream in = app.getAssets().open(ROOT + "audio/box-loop.json")) {
+                        bytes = BreathingSetupAudioContract.readBounded(in, 32768);
+                    }
+                    String json = new String(bytes, StandardCharsets.UTF_8);
+                    BreathingSetupAudioContract contract = BreathingSetupAudioContract.parse(json);
+                    byte[] cycle = contract.loadCycle(new BreathingSetupAudioContract.Assets() {
+                        public InputStream open(String path) throws Exception { return app.getAssets().open(ROOT + path); }
+                    });
+                    final BreathingSetupAudio owner = new BreathingSetupAudio(contract, json,
+                        BreathingSetupAudioContract.sha256(bytes), cycle, new StaticPlayer(), JNI,
+                        new Clock() { public long nowNs() { return SystemClock.elapsedRealtimeNanos(); } });
+                    synchronized (BreathingSetupAudio.class) { appLifetime = owner; }
+                    owner.worker.execute(new Runnable() { @Override public void run() {
+                        try {
+                            owner.initialize();
+                            owner.worker.scheduleWithFixedDelay(new Runnable() { public void run() { owner.observe(); } },
+                                0L, 20L, TimeUnit.MILLISECONDS);
+                        } catch (Throwable error) { owner.fail("breathing-loop-initialization-failed"); }
+                    } });
+                } catch (Throwable error) { installError = "breathing-loop-assets-invalid"; }
+            } }, "rq-breathing-loop-loader");
+            loader.start();
+        }
+    }
+
+    static JSONObject status() {
+        BreathingSetupAudio owner = appLifetime;
+        if (owner == null) return unavailable(selected ? installError : "breathing-setup-disabled");
+        try {
+            JSONObject status = new JSONObject(owner.nativeBridge.status(owner.clock.nowNs()));
+            synchronized (owner) {
+                status.put("audio_state", owner.closed ? "retired" : owner.active ? "playing" : "paused");
+                status.put("audio_generation", owner.generation);
+                if (!owner.failure.isEmpty()) status.put("audio_error", owner.failure);
+            }
+            return status;
+        } catch (Throwable error) { return unavailable("breathing-native-status-unavailable"); }
+    }
+
+    static JSONObject command(JSONObject command) {
+        BreathingSetupAudio owner = appLifetime;
+        if (owner == null || command == null) return unavailable("breathing-setup-unavailable");
+        synchronized (owner) { if (owner.closed) return unavailable(owner.failure); }
+        try { return new JSONObject(owner.nativeBridge.command(command.toString(), owner.clock.nowNs())); }
+        catch (Throwable error) { return unavailable("breathing-native-command-failed"); }
+    }
+
+    static boolean deferExperimentStart(Runnable callback) { return deferExperimentStart(callback, null); }
+    static boolean deferExperimentStart(final Runnable callback, final Runnable onRetired) {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner == null) return false;
+        try { return owner.call(new Callable<Boolean>() { public Boolean call() { return owner.defer(callback, onRetired); } }); }
+        catch (OutcomeUncertainException uncertain) { throw uncertain; }
+        catch (Exception unavailable) { return false; }
+    }
+    static void cancelDeferredExperimentStart() {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner != null) {
+            try { owner.worker.execute(new Runnable() { public void run() { owner.cancel(); } }); }
+            catch (java.util.concurrent.RejectedExecutionException retired) { owner.cancel(); }
+        }
+    }
+    static boolean continuousMain(String scenarioId) { return selected && "haupt-15".equals(scenarioId); }
+    static String mainRecordingPlan(String scenarioId) {
+        BreathingSetupAudio owner = appLifetime;
+        if (!continuousMain(scenarioId) || owner == null) return null;
+        synchronized (owner) { return owner.initialized && !owner.closed ? owner.recordingPlan : null; }
+    }
+    static long mainPlaybackPositionMs() {
+        BreathingSetupAudio owner = appLifetime;
+        return owner == null ? -1 : owner.positionMs();
+    }
+    static long mainAdmissionFrame() {
+        BreathingSetupAudio owner = appLifetime;
+        if (owner == null) return -1;
+        synchronized (owner) { return owner.closed ? -1 : owner.mainStartFrame; }
+    }
+    static void endMain(final long admittedFrame) {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner == null || admittedFrame < 0) return;
+        try { owner.call(new Callable<Boolean>() { public Boolean call() throws Exception { return owner.endMainIfCurrent(admittedFrame); } }); }
+        catch (OutcomeUncertainException uncertain) { throw uncertain; }
+        catch (Exception error) { throw new IllegalStateException("breathing-main-end-failed", error); }
+    }
+    static void pauseLoop() { control(false); }
+    static void resumeLoop() { control(true); }
+    private static void control(final boolean resume) {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner == null) throw new IllegalStateException("breathing-loop-unavailable");
+        try { owner.call(new Callable<Boolean>() { public Boolean call() { if (resume) owner.resume(); else owner.pause(); return true; } }); }
+        catch (OutcomeUncertainException uncertain) { throw uncertain; }
+        catch (Exception error) { throw new IllegalStateException("breathing-loop-control-failed", error); }
+    }
+
+    private static JSONObject unavailable(String reason) {
+        JSONObject result = new JSONObject();
+        try { result.put("available", false).put("accepted", false).put("reason", reason); }
+        catch (Exception ignored) { }
+        return result;
+    }
+
+    private final BreathingSetupAudioContract contract;
+    private final String loopJson, loopHash, recordingPlan;
+    private byte[] pcm;
+    private final Player player;
+    private final NativeBridge nativeBridge;
+    private final Clock clock;
+    private final long generation = GENERATIONS.incrementAndGet();
+    private final BreathingSetupAudioContract.PlaybackHead head;
+    private final BreathingSetupAudioContract.BoundaryGate boundary = new BreathingSetupAudioContract.BoundaryGate();
+    private final ScheduledThreadPoolExecutor worker;
+    private volatile Thread workerThread;
+    private long frame, mainStartFrame = -1;
+    private boolean initialized, active, closed;
+    private String failure = "";
+    private Runnable pending, pendingRetired;
+
+    BreathingSetupAudio(BreathingSetupAudioContract contract, String json, String hash, byte[] pcm,
+            Player player, NativeBridge bridge, Clock clock) throws Exception {
+        this.contract = contract; this.loopJson = json; this.loopHash = hash; this.pcm = pcm;
+        this.player = player; this.nativeBridge = bridge; this.clock = clock;
+        this.head = new BreathingSetupAudioContract.PlaybackHead(contract.sampleRate);
+        this.recordingPlan = contract.recordingPlan(hash);
+        this.worker = new ScheduledThreadPoolExecutor(1, new ThreadFactory() {
+            public Thread newThread(Runnable task) { workerThread = new Thread(task, "rq-breathing-loop-owner"); return workerThread; }
+        });
+        this.worker.setRemoveOnCancelPolicy(true);
+    }
+
+    synchronized void initialize() throws Exception {
+        if (initialized || closed) throw new IllegalStateException("breathing-loop-owner-invalid");
+        JSONObject configured = new JSONObject(nativeBridge.configure(loopJson, loopHash));
+        if (!configured.optBoolean("accepted", false)) throw new IllegalStateException("breathing-native-config-rejected");
+        player.prepare(pcm, contract.sampleRate, contract.cycleFrames); pcm = null;
+        player.play(); initialized = true; active = true;
+    }
+
+    void observe() {
+        Runnable callback = null;
+        Runnable retired = null;
+        try {
+            synchronized (this) {
+                if (closed || !initialized) return;
+                long sourceNano = System.nanoTime();
+                long now = clock.nowNs();
+                nativeBridge.observeSourceClockPair(sourceNano, now);
+                boolean actualPlaying = active && player.playing();
+                frame = head.observe(player.head(), now, actualPlaying);
+                nativeBridge.observe(generation, frame, now, actualPlaying);
+                if (active && !actualPlaying) throw new IllegalStateException("breathing-loop-player-stopped");
+                if (pending != null) {
+                    JSONObject state = new JSONObject(nativeBridge.status(now));
+                    long target = state.optLong("main_start_frame", -1L);
+                    if (!mainState(state) || target < 0) {
+                        boundary.cancel(); mainStartFrame = -1; pending = null;
