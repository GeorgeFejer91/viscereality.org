+        public String status(long n) {
+            return new JSONObject().put("g", generation).put("r", revision).put("input", input)
+                .put("main_start_frame", mainFrame < 0 ? JSONObject.NULL : mainFrame)
+                .put("main_started", mainFrame >= 0 && !invalidated)
+                .put("stage", invalidated ? "waiting" : mainFrame >= 0 ? "main" : "idle").toString();
+        }
+        public String command(String j, long n) {
+            lastEnd = new JSONObject(j); endRequests++;
+            check(lastEnd.length() == 6 && lastEnd.getInt("v") == 1 && "end-main".equals(lastEnd.getString("op")),
+                "closed terminal command envelope");
+            check(lastEnd.getString("id").matches("[a-f0-9]{16}") && lastEnd.getLong("g") == generation,
+                "fresh command identity and audio generation");
+            if (staleRejects > 0) {
+                staleRejects--; revision++;
+                return "{\"accepted\":false,\"reason\":\"stale-revision\"}";
+            }
+            if (lastEnd.getLong("r") != revision || lastEnd.getLong("main_start_frame") != mainFrame) {
+                return "{\"accepted\":false,\"reason\":\"main-frame-mismatch\"}";
+            }
+            acceptedResets++; mainFrame = -1; input = "automatic"; revision++;
+            return "{\"accepted\":true}";
+        }
+    }
+    private static void check(boolean b, String m) { if (!b) throw new AssertionError(m); }
+}
