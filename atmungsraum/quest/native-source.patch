+fn setup_polar_snapshot(
+    mut snapshot: BreathCompositionSnapshot,
+    assessment: BreathAssessmentObservation,
+) -> BreathCompositionSnapshot {
+    let request = BreathCompositionRequest {
+        source: BreathCompositionSource::PolarAcc,
+        mapping: BreathCompositionMapping::State,
+        controller_projection: ControllerProjectionSelection::FixedOrientation,
+        polar_projection: PolarProjectionSelection::Xz,
+        inverted: false,
+    };
+    snapshot.requested = Some(request);
+    snapshot.effective = Some(request);
+    snapshot.status = BreathCompositionStatus::Running;
+    snapshot.generation = Some(assessment.generation);
+    snapshot.latest_assessment = Some(assessment);
+    snapshot.rejection = None;
+    snapshot.output = Some(
+        rusty_quest_breath_contract::composition::BreathCompositionOutput {
+            source: request.source,
+            mapping: request.mapping,
+            sequence_id: assessment.sequence_id,
+            sampled_at: assessment.sampled_at,
+            volume01: None,
+            phase: Some(assessment.phase),
+            quality01: assessment.quality01,
+        },
+    );
+    snapshot
+}
+fn project_setup_snapshot(snapshot: BreathCompositionSnapshot) -> BreathCompositionSnapshot {
+    crate::experiment_breathing_setup_runtime::current_tilt_assessment()
+        .map_or(snapshot, |a| setup_polar_snapshot(snapshot, a))
+}
