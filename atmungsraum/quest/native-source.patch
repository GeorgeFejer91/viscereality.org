+pub(crate) fn recovery_effect(id: &str, old: u64, target: u64, action: &str, now: u64) -> Value {
+    if !selected() {
+        return json!({"accepted":false,"effect":false,"reason":"not-selected"});
+    }
+    let reservation = if matches!(action, "claim" | "check") {
+        match crate::meta_update_admission::reserve_session() {
+            Some(r) => Some(r),
+            None => {
+                return json!({"accepted":false,"effect":false,"reason":"startup-update-maintenance"})
+            }
+        }
+    } else {
+        None
+    };
+    let _gate = command_gate().lock().unwrap_or_else(|e| e.into_inner());
+    let binding = crate::polar_input_health::source_binding();
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    let Some(runtime) = guard.as_mut() else {
+        return json!({"accepted":false,"effect":false,"reason":"not-configured"});
+    };
+    runtime.bind_source(binding);
+    let result = runtime.recovery_effect(id, old, target, action, now);
+    if result["accepted"] == true {
+        if let Some(reservation) = reservation {
+            crate::meta_update_admission::admit_session_cycle(reservation.cycle);
+        }
+    }
+    result
