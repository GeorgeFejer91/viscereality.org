+            "expected_process_start_ticks","expected_apk_sha256","expected_binding_sha256","expected_runtime_epoch","expected_generation",
+            "expected_session_key","expected_condition","expected_profile_sha256","operator_origin","expected_native_owner_identity",
+            "expected_gateway_lifecycle_revision","expected_enrollment_reference",provision?"hardware_serial":"trusted_lan_consent"};
