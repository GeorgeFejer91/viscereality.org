+#[test]
+fn participant_csv_is_bound_to_terminal_identity_and_pinned_for_chunk_reads() {
+    let root = fixture(false);
+    let run = root.join(ID);
+    let name = "Mül_35_F_probe1.csv";
+    let data = b"schema_version,ecg_value\r\n1,37\r\n";
+    let uuid = "01234567-89ab-4def-8abc-0123456789ab";
+    let digest = format!("{:x}", Sha256::digest(data));
+    let identity =
+        json!({"participant_id":"Mül_35_F","condition":"probe","run_index":1,"session_id":uuid});
+    let manifest_path = run.join("manifest.json");
+    let mut manifest: Value = serde_json::from_slice(&fs::read(&manifest_path).unwrap()).unwrap();
+    manifest["participant"] = identity.clone();
+    fs::write(&manifest_path, manifest.to_string()).unwrap();
+    let terminal_path = run.join("final.json");
+    let mut terminal: Value = serde_json::from_slice(&fs::read(&terminal_path).unwrap()).unwrap();
+    terminal["participant"] = identity;
+    terminal["participant_csv"] =
+        json!({"name":name,"size":data.len(),"sha256":digest,"session_id":uuid});
+    fs::write(&terminal_path, terminal.to_string()).unwrap();
+    fs::write(run.join(name), data).unwrap();
+
+    let prepared = prepare(&root, ID, &|| true).unwrap();
+    assert_eq!(prepared.manifest["files"].as_array().unwrap().len(), 8);
+    assert_eq!(
+        prepared.manifest["participant_csv"],
+        terminal["participant_csv"]
+    );
+    let id = prepared.manifest["manifest_id"].as_str().unwrap();
+    let chunk = prepared
+        .read(id, name, 0, data.len() as u64, &|| true)
+        .unwrap();
+    assert_eq!(chunk["data"], base64(data));
+    assert!(
+        prepared
+            .read(id, "Mül_35_F_probe2.csv", 0, 1, &|| true)
+            .is_err()
+    );
+    fs::write(run.join(name), [b'x'; 31]).unwrap();
+    assert!(prepared.read(id, name, 0, 1, &|| true).is_err());
+    drop(prepared);
+    assert!(prepare(&root, ID, &|| true).is_err());
+    fs::write(run.join(name), data).unwrap();
+    terminal["participant_csv"]["name"] = json!("Mül_35_F_probe2.csv");
+    fs::write(&terminal_path, terminal.to_string()).unwrap();
+    assert!(prepare(&root, ID, &|| true).is_err());
+    fs::remove_dir_all(root.parent().unwrap()).unwrap();
+}
