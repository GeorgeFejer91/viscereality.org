+"""Execute the production renderer's reset method with inert GPU/platform adapters."""
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+source = (Path(sys.argv[1]) / 'apps/native-renderer-android/native/src/gpu_private_particles.rs').read_text()
+start = source.index('    fn consume_packaged_defaults_reset_if_requested(')
+end = source.index('    pub(crate) fn confirm_submitted_frame(', start)
+method = source[start:end]
+harness = r'''
+use std::sync::atomic::{AtomicU64,Ordering};
+static RESET:AtomicU64=AtomicU64::new(1);
+fn packaged_defaults_reset_revision()->u64 {RESET.load(Ordering::SeqCst)}
+fn pending_packaged_defaults_reset(last:u64,next:u64)->Option<u64>{(last!=next).then_some(next)}
+fn marker(_: &str,_:String){}
+#[derive(Default)]struct Request{clears:u32}
+impl Request{fn begin_session(&mut self){self.clears+=1;}}
+struct Pulse{value:u32}
+impl Pulse{fn settings(&self)->u32{self.value}fn reconfigure(&mut self,value:u32){self.value=value;}}
+mod particle_visual_profile {
+ pub struct Profile;pub struct Candidate;
+ impl Profile {pub fn candidate(&self)->Candidate{Candidate}}
+ impl Candidate {pub fn panel_settings(&self)->u32{314}}
+ pub fn packaged()->Result<Profile,()>{Ok(Profile)}
+}
+struct Renderer {
+ last_packaged_defaults_reset_revision:u64,panel_settings_override:Option<u32>,settings_revision:u64,
+ visual_scale_request_state:Request,heartbeat_orbit_request_state:Request,material_request_state:Request,
+ render_experiment_request_state:Request,heartbeat_pulse_adapter:Pulse,heartbeat_orbit_packaged_settings:u32,
+ heartbeat_pulse_adapter_connected_marker_emitted:bool,runtime_settings_last_poll_frame:u64,
+ packaged_visual_applied:bool,
+}
+impl Renderer { __PRODUCTION_METHOD__ }
+#[test] fn experiment_restarts_restore_profile_and_clear_mutable_edits(){
+ let mut r=Renderer {last_packaged_defaults_reset_revision:0,panel_settings_override:Some(999),settings_revision:5,
+ visual_scale_request_state:Request::default(),heartbeat_orbit_request_state:Request::default(),
+ material_request_state:Request::default(),render_experiment_request_state:Request::default(),
+ heartbeat_pulse_adapter:Pulse{value:5},heartbeat_orbit_packaged_settings:0,
+ heartbeat_pulse_adapter_connected_marker_emitted:true,runtime_settings_last_poll_frame:10,packaged_visual_applied:true};
+ for revision in [1,2,3] {
+  RESET.store(revision,Ordering::SeqCst);r.consume_packaged_defaults_reset_if_requested();
+  assert_eq!(r.panel_settings_override,Some(314),"experiment reset discarded the packaged visual profile");
+  assert!(r.packaged_visual_applied);assert_eq!(r.runtime_settings_last_poll_frame,u64::MAX);
+  assert_eq!(r.settings_revision,5+revision);
+  r.consume_packaged_defaults_reset_if_requested();assert_eq!(r.settings_revision,5+revision);
+  r.panel_settings_override=Some(999);
+ }
+ // A reset already pending before first render restores the same baseline.
+ r.packaged_visual_applied=false;r.panel_settings_override=None;RESET.store(4,Ordering::SeqCst);
+ r.consume_packaged_defaults_reset_if_requested();
+ assert!(r.packaged_visual_applied);assert_eq!(r.panel_settings_override,Some(314));
+}
+'''.replace('__PRODUCTION_METHOD__', method)
+with tempfile.TemporaryDirectory(prefix='particle-profile-reset-') as directory:
+    root=Path(directory)
+    path=root/'test.rs';path.write_text(harness)
+    binary=root/'reset-test.exe'
+    subprocess.run(['rustc','--edition=2021','--test','--cfg','feature="particle-visual-profile"',str(path),'-o',str(binary)],check=True)
+    subprocess.run([str(binary)],check=True)
+print('PASS production reset method preserves the particle baseline through repeated experiment resets and first-frame pending reset')
