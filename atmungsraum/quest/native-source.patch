+#[test]
+fn writer_restart_exports_an_aborted_csv_and_only_the_verified_checkpoint_prefixes() {
+    use crate::session_recording_writer::{SessionRecordingWriter, tests::{config, interrupted_participant_fixture, temp_root}};
+    use std::{io::Write, time::Duration};
+
+    let root = temp_root("participant-checkpoint-export");
+    let (directory, ordinal) = interrupted_participant_fixture(root.clone(), true);
+    let id = directory.file_name().unwrap().to_str().unwrap();
+    let path = directory.join("polar-ecg.jsonl");
+    let prefix = fs::read(&path).unwrap();
+    fs::OpenOptions::new().append(true).open(&path).unwrap().write_all(b"undurable-tail").unwrap();
+    let original = fs::read(&path).unwrap();
+    let csv_name = "Mül_35_F_main1.csv";
+    fs::write(directory.join(csv_name), b"uncommitted-original").unwrap();
+    assert!(prepare(&root, id, &|| true).is_err());
+
+    let writer = SessionRecordingWriter::spawn(config(root.clone(), 16, 100)).unwrap();
+    let report = writer.recover().unwrap().receive().unwrap();
+    assert!(report.sessions[0].error.is_none());
+    let second = writer.recover().unwrap().receive().unwrap();
+    assert!(second.sessions[0].error.is_none());
+    writer.shutdown(Duration::from_secs(1)).unwrap();
+
+    assert!(!directory.join("final.json").exists());
+    assert_eq!(fs::read(&path).unwrap(), original);
+    assert_eq!(fs::read(directory.join(csv_name)).unwrap(), b"uncommitted-original");
+    let recovered = prepare(&root, id, &|| true).unwrap();
+    let m = &recovered.manifest;
+    assert_eq!(m["file_set_policy"], RECOVERY_POLICY);
+    assert_eq!(m["disposition"], "interrupted-early");
+    assert_eq!(m["participant_csv"]["name"], csv_name);
+    assert_eq!(m["recovery"]["checkpoint_ordinal"], ordinal);
+    assert_eq!(m["files"].as_array().unwrap().len(), 8);
+    let manifest_id = m["manifest_id"].as_str().unwrap();
+    let ecg = recovered.read(manifest_id, "polar-ecg.jsonl", 0, prefix.len() as u64, &|| true).unwrap();
+    assert_eq!(ecg["data"], base64(&prefix));
+    assert!(recovered.read(manifest_id, "polar-ecg.jsonl", prefix.len() as u64, 1, &|| true).is_err());
+    let csv_bytes = fs::read(directory.join(format!("{RECOVERED_CSV_PREFIX}{csv_name}"))).unwrap();
+    let csv = String::from_utf8(csv_bytes.clone()).unwrap();
+    assert!(csv.contains(",26000.000,paused,calibration,37,uV,"));
+    assert!(csv.contains(",aborted,interrupted-recovery\r\n"));
+    let csv_chunk = recovered.read(manifest_id, csv_name, 0, csv_bytes.len() as u64, &|| true).unwrap();
+    assert_eq!(csv_chunk["data"], base64(&csv_bytes));
+    let listing = list(&root, "", 8, &|| true).unwrap();
+    assert_eq!(listing["entries"][0]["participant_csv"], true);
+    assert_eq!(listing["entries"][0]["disposition"], "interrupted-early");
+    drop(recovered);
+
+    let mut changed = original.clone();
+    let offset = changed.windows(b"microvolts\":37".len()).position(|bytes| bytes == b"microvolts\":37").unwrap();
+    changed[offset + b"microvolts\":3".len()] = b'8';
+    fs::write(&path, changed).unwrap();
+    assert!(prepare(&root, id, &|| true).is_err(), "modified valid prefix must fail recovery hash");
+    fs::write(&path, original).unwrap();
+    let checkpoint = directory.join(format!("checkpoint-{ordinal:020}.json"));
+    let mut value: Value = serde_json::from_slice(&fs::read(&checkpoint).unwrap()).unwrap();
+    value["last_accepted_sequence"] = json!(99);
+    fs::write(checkpoint, value.to_string()).unwrap();
+    assert!(prepare(&root, id, &|| true).is_err(), "changed checkpoint must fail the reference");
+    fs::remove_dir_all(root.parent().unwrap()).unwrap();
+}
