diff --git a/apps/native-renderer-android/native/src/polar_sensor_clock.rs b/apps/native-renderer-android/native/src/polar_sensor_clock.rs
new file mode 100644
index 00000000..bbb04e29
--- /dev/null
+++ b/apps/native-renderer-android/native/src/polar_sensor_clock.rs
@@ -0,0 +1,298 @@
+//! Source-bound, receipt-anchored sensor clock estimate. Original observations
+//! remain original; a projection is a separate derived JavaNanoTime value.
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ClockFault {
+    Warming,
+    Malformed,
+    Reordered,
+    OutsideDelivery,
+    Retired,
+}
+impl ClockFault {
+    pub(crate) fn fatal(self) -> bool {
+        self == Self::Retired
+    }
+}
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct SensorFrame {
+    pub(crate) sequence: u64,
+    pub(crate) sensor_last_ns: u64,
+    pub(crate) receipt_ns: u64,
+    pub(crate) rate_hz: u32,
+    pub(crate) count: u32,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct SensorProjection {
+    pub(crate) java_ns: u64,
+    pub(crate) sensor_ns: u64,
+    pub(crate) original_host_ns: u64,
+    pub(crate) receipt_ns: u64,
+    pub(crate) frame_sequence: u64,
+    pub(crate) sample_index: u32,
+    pub(crate) sample_count: u32,
+    pub(crate) generation: u64,
+    pub(crate) anchor_sensor_ns: u64,
+    pub(crate) anchor_java_ns: u64,
+    pub(crate) uncertainty_ns: u64,
+}
+const DELIVERY_BOUND_NS: u64 = 250_000_000;
+const DRIFT_BOUND_NS: i128 = 150_000_000;
+#[derive(Debug, Default)]
+pub(crate) struct SensorClock {
+    binding: Option<(u64, u64)>,
+    generation: u64,
+    frame: Option<SensorFrame>,
+    anchor: Option<(u64, u64)>,
+    warm_count: u32,
+    warm_start: u64,
+    minimum_offset: i128,
+    maximum_offset: i128,
+    last_sample: Option<u64>,
+    frame_fault: Option<ClockFault>,
+}
+impl SensorClock {
+    pub(crate) fn bind(&mut self, binding: (u64, u64)) {
+        if self.binding != Some(binding) {
+            let generation = self.generation.saturating_add(1);
+            *self = Self {
+                binding: Some(binding),
+                generation,
+                ..Self::default()
+            };
+        }
+    }
+    fn begin_warmup(&mut self, frame: SensorFrame) {
+        let offset = i128::from(frame.receipt_ns) - i128::from(frame.sensor_last_ns);
+        self.anchor = None;
+        self.warm_count = 1;
+        self.warm_start = frame.sensor_last_ns;
+        self.minimum_offset = offset;
+        self.maximum_offset = offset;
+    }
+    pub(crate) fn observe_frame(&mut self, frame: SensorFrame) -> Result<(), ClockFault> {
+        if self.binding.is_none_or(|b| b.0 == 0)
+            || frame.sequence == 0
+            || frame.sensor_last_ns == 0
+            || frame.receipt_ns == 0
+            || ![25, 50, 100, 200].contains(&frame.rate_hz)
+            || !(1..=256).contains(&frame.count)
+            || frame.sensor_last_ns
+                < (u64::from(frame.count) - 1) * (1_000_000_000 / u64::from(frame.rate_hz))
+        {
+            return Err(ClockFault::Malformed);
+        }
+        if let Some(previous) = self.frame {
+            if frame.sequence <= previous.sequence || frame.receipt_ns <= previous.receipt_ns {
+                return Err(ClockFault::Reordered);
+            }
+            if frame.sensor_last_ns <= previous.sensor_last_ns {
+                if previous.sensor_last_ns - frame.sensor_last_ns <= 200_000_000 {
+                    return Err(ClockFault::Reordered);
+                }
+                self.generation = self.generation.saturating_add(1);
+                self.last_sample = None;
+                self.begin_warmup(frame);
+                self.frame = Some(frame);
+                self.frame_fault = Some(ClockFault::Warming);
+                return Err(ClockFault::Retired);
+            }
+        }
+        self.frame = Some(frame);
+        self.frame_fault = None;
+        let offset = i128::from(frame.receipt_ns) - i128::from(frame.sensor_last_ns);
+        if let Some((sensor, java)) = self.anchor {
+            let fixed = i128::from(java) - i128::from(sensor);
+            let residual = offset - fixed;
+            if residual < -DRIFT_BOUND_NS {
+                self.generation = self.generation.saturating_add(1);
+                self.last_sample = None;
+                self.begin_warmup(frame);
+                self.frame_fault = Some(ClockFault::Warming);
+                return Err(ClockFault::Retired);
+            }
+            if residual > i128::from(DELIVERY_BOUND_NS) {
+                self.frame_fault = Some(ClockFault::OutsideDelivery);
+                return Err(ClockFault::OutsideDelivery);
+            }
+            return Ok(());
+        }
+        if self.warm_count == 0 {
+            self.begin_warmup(frame);
+        } else {
+            self.minimum_offset = self.minimum_offset.min(offset);
+            self.maximum_offset = self.maximum_offset.max(offset);
+            if self.maximum_offset - self.minimum_offset > DRIFT_BOUND_NS {
+                self.begin_warmup(frame);
+            } else {
+                self.warm_count += 1;
+            }
+        }
+        if self.warm_count >= 4 && frame.sensor_last_ns - self.warm_start >= 500_000_000 {
+            let java = i128::from(frame.sensor_last_ns) + self.minimum_offset;
+            if !(1..=i128::from(u64::MAX)).contains(&java) {
+                return Err(ClockFault::Malformed);
+            }
+            self.anchor = Some((frame.sensor_last_ns, java as u64));
+            return Ok(());
+        }
+        Err(ClockFault::Warming)
+    }
+    pub(crate) fn project(
+        &mut self,
+        sequence: u64,
+        index: u32,
+        count: u32,
+        sensor: u64,
+        host: u64,
+    ) -> Result<SensorProjection, ClockFault> {
+        let frame = self.frame.ok_or(ClockFault::Warming)?;
+        if sequence != frame.sequence || count != frame.count || index >= count || host == 0 {
+            return Err(ClockFault::Malformed);
+        }
+        let expected = frame.sensor_last_ns
+            - (u64::from(count - 1 - index)) * (1_000_000_000 / u64::from(frame.rate_hz));
+        if sensor != expected {
+            return Err(ClockFault::Malformed);
+        }
+        if self.last_sample.is_some_and(|last| sensor <= last) {
+            return Err(ClockFault::Reordered);
+        }
+        self.last_sample = Some(sensor);
+        if let Some(fault) = self.frame_fault {
+            return Err(fault);
+        }
+        let (anchor_sensor, anchor_java) = self.anchor.ok_or(ClockFault::Warming)?;
+        let java = i128::from(anchor_java) + i128::from(sensor) - i128::from(anchor_sensor);
+        if !(1..=i128::from(u64::MAX)).contains(&java) {
+            return Err(ClockFault::Malformed);
+        }
+        Ok(SensorProjection {
+            java_ns: java as u64,
+            sensor_ns: sensor,
+            original_host_ns: host,
+            receipt_ns: frame.receipt_ns,
+            frame_sequence: sequence,
+            sample_index: index,
+            sample_count: count,
+            generation: self.generation,
+            anchor_sensor_ns: anchor_sensor,
+            anchor_java_ns: anchor_java,
+            uncertainty_ns: DELIVERY_BOUND_NS,
+        })
+    }
+    pub(crate) fn ready(&self) -> bool {
+        self.anchor.is_some()
+    }
+    pub(crate) fn generation(&self) -> u64 {
+        self.generation
+    }
+    pub(crate) fn binding(&self) -> Option<(u64, u64)> {
+        self.binding
+    }
+    pub(crate) fn anchor(&self) -> Option<(u64, u64)> {
+        self.anchor
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn frame(index: u64, jitter: u64) -> SensorFrame {
+        SensorFrame {
+            sequence: index,
+            sensor_last_ns: 10_000_000_000 + index * 200_000_000,
+            receipt_ns: 1_000_000_000 + index * 200_000_000 + jitter,
+            rate_hz: 200,
+            count: 40,
+        }
+    }
+    fn warm() -> SensorClock {
+        let mut c = SensorClock::default();
+        c.bind((7, 1));
+        for i in 1..=4 {
+            let _ = c.observe_frame(frame(i, if i % 2 == 1 { 20_000_000 } else { 0 }));
+        }
+        assert!(c.ready());
+        c
+    }
+    #[test]
+    fn jittered_packet_receipts_never_reanchor_or_rewrite_original_times() {
+        let mut c = warm();
+        c.observe_frame(frame(5, 20_000_000)).unwrap();
+        let old = c.project(5, 39, 40, 11_000_000_000, 2_020_000_000).unwrap();
+        c.observe_frame(frame(6, 0)).unwrap();
+        let next = c.project(6, 0, 40, 11_005_000_000, 2_005_000_000).unwrap();
+        assert_eq!(next.java_ns - old.java_ns, 5_000_000);
+        assert_eq!(old.original_host_ns, 2_020_000_000);
+        assert_eq!(next.original_host_ns, 2_005_000_000);
+        assert_eq!(old.anchor_java_ns, next.anchor_java_ns);
+        assert_eq!(old.anchor_sensor_ns, next.anchor_sensor_ns);
+        assert_eq!(next.uncertainty_ns, 250_000_000);
+    }
+    #[test]
+    fn source_epoch_and_sensor_reset_retire_the_old_transform() {
+        let mut c = warm();
+        let generation = c.generation();
+        c.bind((7, 2));
+        assert!(!c.ready());
+        assert!(c.generation() > generation);
+        let mut c = warm();
+        let generation = c.generation();
+        let mut reset = frame(5, 0);
+        reset.sensor_last_ns = 1_000_000_000;
+        assert_eq!(c.observe_frame(reset), Err(ClockFault::Retired));
+        assert!(!c.ready());
+        assert!(c.generation() > generation);
+    }
+    #[test]
+    fn sample_identity_replay_and_large_delivery_residual_are_rejected() {
+        let mut c = warm();
+        c.observe_frame(frame(5, 0)).unwrap();
+        assert_eq!(
+            c.project(5, 0, 40, 10_800_000_001, 1_805_000_000),
+            Err(ClockFault::Malformed)
+        );
+        let first = c.project(5, 0, 40, 10_805_000_000, 1_805_000_000).unwrap();
+        assert_eq!(
+            c.project(5, 0, 40, 10_805_000_000, 1_805_000_000),
+            Err(ClockFault::Reordered)
+        );
+        assert_eq!(first.java_ns, 1_805_000_000);
+        assert_eq!(
+            c.observe_frame(frame(6, 300_000_000)),
+            Err(ClockFault::OutsideDelivery)
+        );
+        assert!(c.ready());
+    }
+    #[test]
+    fn fixed_projection_supports_25hz_and_200hz_packet_grids() {
+        for rate in [25, 200] {
+            let mut c = SensorClock::default();
+            c.bind((7, 1));
+            for sequence in 1..=4 {
+                let mut f = frame(sequence, if sequence % 2 == 1 { 20_000_000 } else { 0 });
+                f.rate_hz = rate;
+                f.count = rate / 5;
+                let _ = c.observe_frame(f);
+            }
+            assert!(c.ready());
+            let mut f = frame(5, 20_000_000);
+            f.rate_hz = rate;
+            f.count = rate / 5;
+            c.observe_frame(f).unwrap();
+            let offset = u64::from(f.count - 1) * (1_000_000_000 / u64::from(rate));
+            let projected = c
+                .project(
+                    5,
+                    0,
+                    f.count,
+                    f.sensor_last_ns - offset,
+                    f.receipt_ns - offset,
+                )
+                .unwrap();
+            assert_eq!(projected.java_ns, 2_000_000_000 - offset);
+            assert_eq!(projected.original_host_ns, 2_020_000_000 - offset);
+        }
+    }
+}
