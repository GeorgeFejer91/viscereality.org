+#[test]
+fn explicit_preparation_retry_reserves_recovery_for_a_playing_stalled_head() {
+    let mut r = runtime();
+    r.observe_clock(7, 0, 1_000_000_000, false);
+    r.bind_source((5, 1));
+    r.projection_ready = true;
+    assert_eq!(
+        command(&mut r, 1, "calibrate", 1_000_000_000)["state"],
+        "confirmed"
+    );
+    r.observe_clock(7, 0, 1_020_000_000, true);
+    r.observe_clock(7, 882, 1_040_000_000, true);
+    for tick in 1..=14 {
+        r.observe_clock(7, 882, 1_040_000_000 + tick * 20_000_000, true);
+    }
+    let failed = r.status(1_320_000_000);
+    assert_eq!(failed["failure"], "clock_stalled");
+    assert_eq!(failed["calibration"], "failed");
+    let request =
+        json!({"v":1,"id":"0000000000000002","g":failed["g"],"r":failed["r"],"op":"calibrate"});
+    let pending = r.command(&request, 1_320_000_000);
+    assert_eq!(pending["state"], "pending", "explicit retry must reach an admitted recovery rather than the permanent clock-stale dead end");
+    assert_eq!(pending["reason"], "audio-recovery-pending");
+    assert_eq!(
+        r.command(&request, 1_320_000_000),
+        pending,
+        "duplicate ID keeps one reservation"
+    );
+    assert_eq!(r.status(1_320_000_000)["stage"], "recovering");
+    assert_eq!(r.status(1_320_000_000)["ready"], false);
+}
