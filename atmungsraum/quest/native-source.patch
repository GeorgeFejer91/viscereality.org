+#[test]
+fn calibrated_batched_tilt_retains_confirmed_phase_between_jittered_packets() {
+    use crate::breath_composition_driver::{tests::setup_frame, BreathCompositionDriver};
+    let (mut r, base_frame, base_ns) = calibrated_inhale_runtime();
+    let mut driver =
+        BreathCompositionDriver::new(crate::breath_composition_driver::tests::settings());
+    setup_frame(&mut driver, r.output(base_ns), base_ns, 0.0);
+    let mut previous = driver.value01();
+    let mut packet = 1_u64;
+    let mut unavailable = 0;
+    for render in 1..=117_u64 {
+        let elapsed = render * 1_000_000_000 / 90;
+        let now = base_ns + elapsed;
+        r.observe_clock(7, base_frame + elapsed * 44100 / 1_000_000_000, now, true);
+        // Continuous 200 Hz source samples in 36-sample / 180 ms batches.
+        // Alternating 45 ms receipt jitter crosses the 200 ms freshness gate.
+        let packet_end = packet * 180_000_000;
+        let receipt = packet_end + if packet % 2 == 1 { 45_000_000 } else { 0 };
+        if elapsed >= receipt {
+            for index in 1..=36 {
+                let offset = (packet - 1) * 180_000_000 + index * 5_000_000;
+                let host = base_ns + offset;
+                r.observe_acc_with_source(
+                    100_000_000_000 + host,
+                    host,
+                    host,
+                    vector(0.2 + offset as f64 / 1_000_000_000.0 * 0.15),
+                );
+            }
+            packet += 1;
+        }
+        if !r.core.snapshot(now).ready {
+            unavailable += 1;
+        }
+        setup_frame(&mut driver, r.output(now), now, 1.0 / 90.0);
+        let delta = driver.value01() - previous;
+        assert!((delta - 0.5 / 90.0).abs() < 0.000_001,
+            "confirmed inhale must advance once per render frame, render={render}, ready={}, previous={previous}, value={}, marker={}",
+            r.core.snapshot(now).ready, driver.value01(), driver.marker_fields());
+        previous = driver.value01();
+    }
+    assert!(
+        unavailable >= 3,
+        "probe must cross actual freshness, count={unavailable}"
+    );
+    assert_eq!(r.phase, CommonBreathPhase::Inhale);
+    assert!((driver.value01() - 0.85).abs() < 0.000_01);
+}
