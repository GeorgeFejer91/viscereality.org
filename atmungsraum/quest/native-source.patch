+    private void persist(Map<String,Member> next)throws Exception {
+        checkOwner();JSONArray saved=new JSONArray();
+        for(Member member:next.values())saved.put(new JSONObject().put("controller",member.controller).put("key",member.key).put("name",member.name));
+        storing=true;
+        try{if(!store.save(new JSONObject().put("v",1).put("members",saved).toString()))throw new IllegalStateException("phone-membership-not-persisted");}
+        finally{storing=false;}
+        members=next;
+    }
+    private void checkOwner(){if(Thread.currentThread()!=owner||storing)throw new IllegalStateException("phone-main-owner-required");}
+    static String label(String input){
+        if(input==null)throw new IllegalArgumentException("phone-name-required");
+        String name=java.text.Normalizer.normalize(input.trim(),java.text.Normalizer.Form.NFC);
+        if(name.isEmpty()||name.length()>64||name.matches("(?s).*[\\p{Cntrl}\\p{Cf}].*"))throw new IllegalArgumentException("phone-name-invalid");
+        return name;
+    }
+    private static boolean hex(String value,int length){return value!=null&&value.matches("[0-9a-f]{"+length+"}");}
+    private static String random(int count){byte[] bytes=new byte[count];RANDOM.nextBytes(bytes);StringBuilder out=new StringBuilder();for(byte b:bytes)out.append(String.format(java.util.Locale.ROOT,"%02x",b&255));return out.toString();}
+}
