+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.security.SecureRandom;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Main-owner confined membership storage and a separate, process-local controller lease. */
+public final class ExperimentTrustedPhones {
+    public interface Store { String load(); boolean save(String value); }
+    public static final class Member {
+        public final String controller,key,name;
+        Member(String controller,String key,String name){this.controller=controller;this.key=key;this.name=name;}
+    }
+    private static final SecureRandom RANDOM=new SecureRandom();
+    private static final long LEASE_MS=15000,MAX_REVISION=9007199254740991L;
+    private final Thread owner=Thread.currentThread();
+    private final Store store;
+    private Map<String,Member> members=new LinkedHashMap<>();
+    private final Map<String,String[]> requests=new LinkedHashMap<>();
+    private String active="";
+    private long deadline,revision;
+    private boolean storing;
+
+    public ExperimentTrustedPhones(Store store) throws Exception {
+        if(store==null)throw new IllegalArgumentException("phone-store-required");
+        this.store=store;String encoded=store.load();
+        if(encoded==null||encoded.isEmpty())return;
+        JSONObject value=new JSONObject(encoded);JSONArray saved=value.getJSONArray("members");
+        if(value.length()!=2||!Integer.valueOf(1).equals(value.opt("v"))||saved.length()>8)
+            throw new IllegalArgumentException("phone-store-invalid");
+        for(int i=0;i<saved.length();i++){
+            JSONObject item=saved.getJSONObject(i);
+            String controller=item.getString("controller"),key=item.getString("key"),name=item.getString("name");
+            if(item.length()!=3||!hex(controller,32)||!hex(key,64)||!name.equals(label(name))||members.containsKey(controller))
+                throw new IllegalArgumentException("phone-store-invalid");
+            members.put(controller,new Member(controller,key,name));
+        }
+    }
+    public int size(){checkOwner();return members.size();}
+    public Member member(String controller){checkOwner();return members.get(controller);}
+    public long revision(){checkOwner();return revision;}
+    public void migrateLegacy(String controller,String key)throws Exception {
+        checkOwner();if(!members.isEmpty()||!hex(controller,32)||!hex(key,64))return;
+        Map<String,Member> next=new LinkedHashMap<>(members);next.put(controller,new Member(controller,key,"Saved phone"));persist(next);
+    }
+    public JSONObject add(String name)throws Exception {
+        checkOwner();if(members.size()>=8)throw new IllegalStateException("phone-capacity");
+        String controller;do{controller=random(16);}while(members.containsKey(controller));
+        Member member=new Member(controller,random(32),uniqueLabel(label(name)));
+        Map<String,Member> next=new LinkedHashMap<>(members);next.put(controller,member);persist(next);
+        return new JSONObject().put("controller",controller).put("key",member.key);
+    }
+    public boolean remove(String controller)throws Exception {
+        checkOwner();if(!members.containsKey(controller))return false;
+        Map<String,Member> next=new LinkedHashMap<>(members);next.remove(controller);persist(next);
+        if(active.equals(controller))changeOwner("",0);
+        return true;
+    }
+    public void clear()throws Exception {
+        checkOwner();persist(new LinkedHashMap<String,Member>());if(!active.isEmpty())changeOwner("",0);
+    }
+    /** No transport/session instance survives an owner lifetime, but memberships do. */
+    public void retireOwner(){checkOwner();requests.clear();if(!active.isEmpty())changeOwner("",0);}
+    public JSONObject list(long now)throws Exception {
+        checkOwner();expire(now);JSONArray list=new JSONArray();
+        for(Member member:members.values())list.put(new JSONObject().put("controller",member.controller)
+            .put("name",member.name).put("active",active.equals(member.controller)));
+        return new JSONObject().put("v",1).put("members",list).put("active_phone",activeLabel()).put("revision",revision);
+    }
+    public JSONObject status(String controller,long now)throws Exception {
+        checkOwner();requireMember(controller);expire(now);
+        if(active.equals(controller))deadline=now+LEASE_MS;
+        return access(controller);
+    }
+    public void requireActive(String controller,long expectedRevision,long now) {
+        checkOwner();requireMember(controller);expire(now);
+        if(!active.equals(controller)||expectedRevision!=revision)throw new SecurityException("controller-access-waiting");
+    }
+    public boolean releaseActive(long now) {
+        checkOwner();expire(now);if(active.isEmpty())return false;changeOwner("",0);return true;
+    }
+    public JSONObject control(String controller,JSONObject body,long now)throws Exception {
+        checkOwner();requireMember(controller);
+        Object expected=body.opt("expected_control_revision");String id=body.optString("id"),op=body.optString("op");
+        if(body.length()!=4||!Integer.valueOf(1).equals(body.opt("v"))||!hex(id,16)
+                ||!("claim".equals(op)||"release".equals(op))||!(expected instanceof Integer||expected instanceof Long)
+                ||((Number)expected).longValue()<0||((Number)expected).longValue()>MAX_REVISION)
+            throw new IllegalArgumentException("closed-controller-access-required");
