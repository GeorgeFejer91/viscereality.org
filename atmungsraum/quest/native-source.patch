+impl RendererRadius {
+    fn json(self, lineage: SetupRendererLineage, now: u64) -> Value {
+        const SAFE: u64 = 9_007_199_254_740_991;
+        if self.lineage != lineage
+            || !self.progress01.is_finite()
+            || !(0.0..=1.0).contains(&self.progress01)
+            || !self.radius_m.is_finite()
+            || self.radius_m <= 0.0
+            || self.observed_ns == 0
+            || now < self.observed_ns
+            || now - self.observed_ns > 500_000_000
+            || self.frame > SAFE
+            || self.render_generation == 0
+            || self.render_generation > SAFE
+            || self.settings_revision > SAFE
+        {
+            return Value::Null;
+        }
+        json!({"v":1,"progress01":self.progress01,"radius_m":self.radius_m,
+            "frame":self.frame,"render_generation":self.render_generation,
+            "settings_revision":self.settings_revision,"observed_ns":self.observed_ns.to_string(),
