@@ -0,0 +1,59 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public final class CalibrationPromptSequenceTest implements CalibrationPromptSequence.Host {
+    private final List<String> played = new ArrayList<>();
+    private Runnable pending;
+    private long activeGeneration;
+
+    @Override public boolean play(String cue) {
+        played.add(cue);
+        return true;
+    }
+    @Override public void stopAudio() {}
+    @Override public boolean isCollecting(long generation) {
+        return activeGeneration == generation;
+    }
+    @Override public void schedule(Runnable cue, long delayMs) {
+        if (delayMs != 4000L) throw new AssertionError("inhale window must be four seconds");
+        pending = cue;
+    }
+    @Override public void cancel(Runnable cue) {
+        if (pending == cue) pending = null;
+    }
+    private void requirePlayed(String... expected) {
+        if (!played.equals(Arrays.asList(expected))) throw new AssertionError(played);
+    }
+    public static void main(String[] args) {
+        CalibrationPromptSequenceTest host = new CalibrationPromptSequenceTest();
+        CalibrationPromptSequence sequence = new CalibrationPromptSequence(host);
+        sequence.start(1);
+        host.requirePlayed();
+
+        host.activeGeneration = 1;
+        sequence.start(1);
+        host.requirePlayed("inhale");
+        Runnable firstExhale = host.pending;
+        sequence.start(1);
+        firstExhale.run();
+        firstExhale.run();
+        host.requirePlayed("inhale", "exhale");
+
+        host.activeGeneration = 2;
+        sequence.start(2);
+        Runnable cancelled = host.pending;
+        sequence.stop();
+        if (host.pending != null) throw new AssertionError("cancel must remove the pending cue");
+        cancelled.run();
+        host.requirePlayed("inhale", "exhale", "inhale");
+
+        sequence.start(2);
+        host.activeGeneration = 3;
+        host.pending.run();
+        host.requirePlayed("inhale", "exhale", "inhale", "inhale");
+        System.out.println("Calibration prompt sequence passed");
+    }
+}
