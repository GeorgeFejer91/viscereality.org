+            .to_string()
+        };
+        for name in ["polar-acc.jsonl", "radius.jsonl", "breath.jsonl"] {
+            fs::write(directory.join(name), "").unwrap();
+        }
+        fs::write(
+            directory.join("polar-ecg.jsonl"),
+            [
+                sample(start - 1, 499, 0),
+                sample(start, 500, -12),
+                sample(start + 27_000_000_000, 501, 230),
+                sample(start + 45_010_000_000, 502, -31),
+            ]
+            .join("\n"),
+        )
+        .unwrap();
+        let end = MonotonicNanos::new(start + 45_010_000_000);
+        let descriptor = run
+            .finalize_csv(directory, anchor, end, false, "save-and-exit")
+            .unwrap()
+            .unwrap();
+        assert_eq!(descriptor["name"], "Tes_30_N_2023-11-14_haupt-15_r1.csv");
+        assert_eq!(descriptor["session_id"], run.uuid);
+        let csv = fs::read_to_string(directory.join("Tes_30_N_2023-11-14_haupt-15_r1.csv")).unwrap();
+        assert_eq!(descriptor["size"], csv.len());
+        assert_eq!(
+            descriptor["sha256"],
+            format!("{:x}", Sha256::digest(csv.as_bytes()))
+        );
+        assert!(csv.starts_with(HEADER));
+        let rows: Vec<Vec<&str>> = csv
+            .split_terminator("\r\n")
+            .skip(1)
+            .map(|row| row.split(',').collect())
+            .collect();
+        assert_eq!(rows.len(), 4);
+        assert!(rows.iter().all(|row| row.len() == HEADER.trim_end().split(',').count()));
+        assert_eq!(&rows[0][5..15], ["ecg", "2023-11-14T22:13:20.000000Z", "0", "0",
+            "waiting", "waiting", "1000000000", "500", "0", "-12"]);
+        assert_eq!(&rows[1][8..11], ["26000000", "paused", "calibration"]);
+        assert_eq!(&rows[2][8..11], ["41000000", "playing", "instruction_2"]);
+        assert_eq!(rows[3][5], "end");
+        assert_eq!(&rows[3][21..], ["aborted", "save-and-exit", ""]);
+        assert!(
+            run.finalize_csv(directory, anchor, end, false, "save-and-exit")
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn an_arm_without_official_start_reserves_an_index_without_a_csv() {
+        let scratch = Scratch::new();
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "probe-5")).unwrap();
+        let run = ParticipantRun::reserve(&scratch.0, plan.clone()).unwrap();
+        fs::write(
+            scratch.0.join("events.jsonl"),
+            r#"{"event":"started","observed_monotonic_ns":1}"#,
+        )
+        .unwrap();
+        let anchor = ClockAnchor::new(MonotonicNanos::new(1), UtcEpochNanos::new(0));
+        assert!(
+            run.finalize_csv(&scratch.0, anchor, MonotonicNanos::new(2), false, "restart")
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(ParticipantRun::reserve(&scratch.0, plan).unwrap().index, 2);
+    }
+}
diff --git a/apps/native-renderer-android/native/src/session_recording_participant/live_csv.rs b/apps/native-renderer-android/native/src/session_recording_participant/live_csv.rs
