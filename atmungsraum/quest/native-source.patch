+                self.retire_driver_phase();
+                self.classified_model = None;
+                self.classified_at = None;
+                self.phase = CommonBreathPhase::Unknown;
+                self.finish_recovery(false, "audio-recovery-failed");
+                self.refresh(now);
+                return json!({"accepted":true,"effect":false,"reason":"audio-owner-fault"});
+            }
+            return json!({"accepted":false,"effect":false,"reason":"stale-generation"});
+        }
+        let Some(recovery) = &mut self.recovery else {
+            return json!({"accepted":false,"effect":false,"reason":"audio-recovery-retired"});
+        };
+        if recovery.command["id"] != id || recovery.old_generation != old || target <= old {
+            return json!({"accepted":false,"effect":false,"reason":"audio-recovery-mismatch"});
+        }
+        match action {
+            "claim" if recovery.target_generation.is_none() && self.generation == old => {
+                recovery.target_generation = Some(target);
+                recovery.claimed_ns = Some(now);
+                // Claims can skip a target that failed before its first clock
