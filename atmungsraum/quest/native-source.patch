+fn window_quality_fixture(rate: u64, pattern: u8) -> (BreathingSetup, u64) {
+    let mut setup = BreathingSetup::new(schedule());
+    setup.observe_clock(1, 0, time(0), false);
+    setup.start_calibration(7, time(0)).unwrap();
+    setup.observe_clock(1, 0, time(0), true);
+    let period = 1_000_000_000 / rate;
+    let mut next = period;
+    for tick in 1..=1_613_u64 {
+        let now = time(0) + tick * 20_000_000;
+        setup.observe_clock(1, tick * 882, now, true);
+        let end = tick * 20_000_000;
+        while next <= end {
+            let at = next;
+            next += period;
+            if pattern == 2 && (4_000_000_000..8_000_000_000).contains(&at) {
+                continue;
+            }
+            let frame = at * 44100 / 1_000_000_000;
+            let mut raw = guided_vector(frame);
+            if pattern == 1 || pattern == 3 {
+                let t = at as f64 / 1_000_000_000.0;
+                if pattern == 3 || (1.2..1.5).contains(&t) {
+                    let angle = if pattern == 3 {
+                        0.35 * (t * 8.0 * std::f64::consts::PI).sin()
+                    } else {
+                        0.35
+                    };
+                    raw = [
+                        raw[0] * angle.cos() + raw[2] * angle.sin(),
+                        0.0,
+                        raw[2] * angle.cos() - raw[0] * angle.sin(),
+                    ];
+                }
+            }
+            if pattern == 0 || pattern == 1 {
+                raw[0] += if (at / period) % 2 == 0 {
+                    0.004
+                } else {
+                    -0.004
+                };
+            }
+            setup.observe_acc(7, 100_000_000_000 + time(0) + at, time(0) + at, raw);
+        }
+        if tick < 1_600 {
+            assert!(
+                setup.snapshot(now).calibration != CalibrationState::Failed,
+                "must assess full window: tick={tick},pattern={pattern}"
+            );
+        }
+    }
+    let now = time(0) + 1_613 * 20_000_000;
+    (setup, now)
+}
