+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.Context;
+import org.json.JSONObject;
+
+/** One-use, idle-only hardware identity and trusted LAN enrollment bootstrap. */
+final class ExperimentSessionHeadsetSetup {
+    private static String reference="";
+    private static long observed;
+    private static final java.util.Set<String> ids=new java.util.HashSet<String>();
+    static boolean featureSelected(Context context){
+        try{return Boolean.TRUE.equals(context.getPackageManager().getApplicationInfo(context.getPackageName(),
+            android.content.pm.PackageManager.GET_META_DATA).metaData.get("rusty.quest.experiment.headset_setup.enabled"));}
+        catch(Exception unavailable){return false;}
+    }
+    private static JSONObject snapshot()throws Exception{
+        JSONObject value=new JSONObject(ControlPanelActivity.nativeReadBreathCompositionStatus()).getJSONObject("snapshot");
+        if(!Boolean.TRUE.equals(value.opt("feature_lock_active"))||!Boolean.TRUE.equals(value.opt("activation_binding_matches")))
+            throw new SecurityException("headset-setup-feature-inactive");
+        return value;
+    }
+    private static JSONObject session()throws Exception{
+        JSONObject value=new JSONObject(ControlPanelActivity.applyExperimentSessionCommand(new JSONObject()
+            .put("schema","rusty.quest.experiment_session.command.v1").put("operation","status").toString()));
+        if(!"accepted".equals(value.opt("command_status")))throw new SecurityException("headset-setup-readback-unavailable");
+        return value;
+    }
+    static synchronized String execute(final Context context,JSONObject input)throws Exception{
+        if(!featureSelected(context))throw new SecurityException("headset-setup-not-selected");
+        final JSONObject request=new JSONObject(input.toString());validateShape(request);
+        String operation=request.getString("operation");JSONObject breath=snapshot();
+        final ExperimentSessionCommandGateway gateway=ExperimentSessionCommandGateway.existing();
+        if(gateway==null)throw new SecurityException("headset-setup-owner-unavailable");
+        JSONObject envelope=new JSONObject().put("schema","rusty.quest.experiment_session.operator_receipt.v1").put("operation",operation);
+        if("status".equals(operation)){
+            reference="";
+            JSONObject nativeResponse=session(),offer=gateway.localOperatorEnrollmentStatus();
+            if(Boolean.TRUE.equals(offer.opt("available"))){reference=offer.getString("reference");observed=android.os.SystemClock.elapsedRealtime();}
+            return envelope.put("pid",android.os.Process.myPid()).put("uid",android.os.Process.myUid()).put("process_start_ticks",processStartTicks())
+                .put("apk_sha256",installedApkSha256(context)).put("snapshot",breath).put("native_response",nativeResponse)
+                .put("headset_setup",gateway.localOperatorSetupReadback()).put("local_enrollment",offer).toString();
+        }
+        final long deadline=observed+5000;
+        if(reference.isEmpty()||!reference.equals(request.getString("expected_enrollment_reference"))
+                ||android.os.SystemClock.elapsedRealtime()<observed||android.os.SystemClock.elapsedRealtime()>deadline)
+            throw new SecurityException("headset-setup-offer-stale");
+        // Admission consumes the offer and operation ID before any possibly unknown effect.
+        if(ids.size()>=128||!ids.add(request.getString("operation_id")))throw new SecurityException("headset-setup-no-replay");
+        reference="";
+        ExperimentSessionCommandGateway.LocalEnrollmentGuard guard=new ExperimentSessionCommandGateway.LocalEnrollmentGuard(){
+            @Override public void check()throws Exception{
+                if(!featureSelected(context)||android.os.SystemClock.elapsedRealtime()>deadline)throw new SecurityException("headset-setup-offer-expired");
+                validateActorFacts(request,android.os.Process.myPid(),android.os.Process.myUid(),processStartTicks(),installedApkSha256(context));
