+"""Execute the production worker-to-main shared-handoff dispatch with inert main IPC."""
+from pathlib import Path
+import subprocess
+import tempfile
+from test_experiment_gateway_dedupe import method
+ROOT = Path(__file__).resolve().parents[2]
+PKG = 'io/github/mesmerprism/rustyquest/native_renderer'
+TEST = r'''package io.github.mesmerprism.rustyquest.native_renderer;
+import android.os.SystemClock;
+class Activity {ClassLoader getClassLoader(){return getClass().getClassLoader();}}
+class Binding {Activity activity=new Activity();long epoch=42;}
+class Helper {boolean enabled=true;boolean selected(){return enabled;}boolean arm(long a,long t){return t>15;}boolean acknowledge(String m){return true;}}
+class Handler extends android.os.Handler {Handler(android.os.Looper l){super(l);}}
+class NativeRendererSelfKioskApplication {static int calls;static boolean handoffForMetaInstall(Activity a,long e,long deadline){calls++;return true;}static boolean handoffForMetaInstall(Activity a,long e){calls++;return true;}}
+class Owner {static final Object HELPER_LOCK=new Object();Helper helper=new Helper();long loadedCode=15;Binding binding=new Binding();boolean valid=true,fence=true,slowValidation;int validations;
+ boolean ownerValid(){if(slowValidation&&++validations>2)SystemClock.now=6000;return valid;}
+ boolean nativeFence(int op,long a,long c,long r){return fence;}
+ __DISPATCH__
+}
+public class HandoffDispatchTest {
+ static int checks;static void check(boolean b,String s){checks++;if(!b)throw new AssertionError(s);}
+ static Owner fresh(){SystemClock.now=0;android.os.Handler.immediate=true;android.os.Handler.pending=null;android.os.Handler.before=null;NativeRendererSelfKioskApplication.calls=0;return new Owner();}
+ public static void main(String[] args)throws Exception {
+  Owner o=fresh();check(o.handoff(7,16)&&NativeRendererSelfKioskApplication.calls==1,"trusted helper/owner/nativephase3 dispatch invokes exact main exit seam");
+  
+  o=fresh();check(!o.handoff(7,15)&&android.os.Handler.pending==null,"non-new target never queues exit");
+  o=fresh();o.valid=false;check(!o.handoff(7,16)&&android.os.Handler.pending==null,"invalid initial owner never queues exit");
+  
+  final Owner replaced=fresh();android.os.Handler.before=new Runnable(){public void run(){replaced.binding=new Binding();}};
+  check(!replaced.handoff(7,16)&&NativeRendererSelfKioskApplication.calls==0,"binding replacement before main execution never exits");
+  o=fresh();o.slowValidation=true;check(!o.handoff(7,16)&&NativeRendererSelfKioskApplication.calls==0,"deadline is repeated after possibly slow owner/native lookup");
+  o=fresh();android.os.Handler.before=new Runnable(){public void run(){SystemClock.now=6000;}};
+  check(!o.handoff(7,16)&&NativeRendererSelfKioskApplication.calls==0,"late main execution beyond monotonic deadline never exits");
+  o=fresh();android.os.Handler.immediate=false;check(!o.handoff(7,16)&&NativeRendererSelfKioskApplication.calls==0,"worker times out rather than waiting indefinitely for main");
+  SystemClock.now=100;android.os.Handler.pending.run();check(NativeRendererSelfKioskApplication.calls==0,"already timed-out runnable remains expired even when invoked later");
+  System.out.println("PASS "+checks+" production shared-handoff main-dispatch deadline/owner checks");
+ }
+}'''
+def main():
+    source=ROOT/'apps/native-renderer-android/src/main/java'/PKG/'NativeRendererMetaUpdate.java'
+    body=method(source.read_text(),'        public boolean handoff(long attempt,long target)')
+    with tempfile.TemporaryDirectory(prefix='rq-queued-main-') as tmp:
+        out=Path(tmp);os=out/'android/os';os.mkdir(parents=True)
+        (os/'Looper.java').write_text('package android.os;public class Looper{static final Looper M=new Looper();public static Looper myLooper(){return null;}public static Looper getMainLooper(){return M;}}')
+        (os/'SystemClock.java').write_text('package android.os;public class SystemClock{public static long now;public static long elapsedRealtime(){return now;}}')
+        (os/'Handler.java').write_text('package android.os;public class Handler{public static boolean immediate=true;public static Runnable pending,before;public Handler(Looper l){}public boolean post(Runnable r){pending=r;if(before!=null)before.run();if(immediate)r.run();return true;}}')
+        test=out/'HandoffDispatchTest.java';test.write_text(TEST.replace('__DISPATCH__',body))
+        subprocess.run(['javac','--release','8','-d',tmp,*map(str,os.glob('*.java')),str(test)],check=True)
+        subprocess.run(['java','-cp',tmp,PKG.replace('/','.')+'.HandoffDispatchTest'],check=True)
+if __name__=='__main__':main()
