+#[test]
+fn technical_retirement_keeps_each_polar_selection_but_retires_model_and_main() {
+    for input in [
+        SetupInput::PolarTilt,
+        SetupInput::PolarTiltFixed,
+        SetupInput::PolarTiltAdaptive,
+    ] {
+        for barrier in [
+            "poll-gap",
+            "head-stall",
+            "source-replaced",
+            "source-retired",
+            "audio-generation",
+            "generation-regression",
+        ] {
+            let mut setup = calibrated();
+            let frame = 2_116_800;
+            let now = time(frame);
+            if input.pretrained() {
+                setup.select_pretrained(input, 7, now).unwrap();
+                for tick in 1..=20 {
+                    let ns = now + tick * 40_000_000;
+                    setup.observe_clock(1, frame + tick * 1764, ns, true);
+                    setup.observe_acc(7, 100_000_000_000 + ns, ns, [0.0, 0.0, 1.0]);
+                }
+            }
+            let before = setup.snapshot(now + if input.pretrained() { 800_000_000 } else { 0 });
+            let now = time(before.absolute_frame);
+            assert!(before.ready, "fixture {input:?}");
+            setup.request_experiment(now).unwrap();
+            let at = now + 300_000_000;
+            match barrier {
+                "poll-gap" => setup.observe_clock(1, before.absolute_frame + 13230, at, true),
+                "head-stall" => {
+                    for tick in 1..=15 {
+                        setup.observe_clock(
+                            1,
+                            before.absolute_frame,
+                            now + tick * 20_000_000,
+                            true,
+                        );
+                    }
+                }
+                "source-replaced" => setup.observe_source_owner(8),
+                "source-retired" => setup.observe_source_owner(0),
+                "audio-generation" => setup.observe_clock(2, 0, at, true),
+                _ => setup.observe_clock(0, 0, at, true),
+            }
+            let after = setup.snapshot(at);
+            assert_eq!(after.input, input, "{input:?}: {barrier}");
+            assert!(!after.ready, "{input:?}: {barrier}");
+            assert!(setup.model().is_none());
+            assert!(setup.driver_sample(at).is_none());
+            assert_eq!(after.experiment, ExperimentState::Invalidated);
+            assert_eq!(
+                setup.request_experiment(at),
+                Err(SetupFailure::InputNotReady)
+            );
+            if input == SetupInput::PolarTilt {
+                assert_eq!(after.calibration, CalibrationState::Failed);
+                assert_eq!(after.model_generation, None);
+            }
+        }
+    }
+}
