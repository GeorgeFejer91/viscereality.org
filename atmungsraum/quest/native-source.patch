+$ErrorActionPreference='Stop';Set-StrictMode -Version Latest
+$repo=(Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$classes=(Resolve-Path -LiteralPath $PriorClassesDirectory).Path;$android=(Resolve-Path -LiteralPath $AndroidJar).Path
+if(Test-Path -LiteralPath $OutputDirectory){throw 'Fresh compile output required'}
+$null=New-Item -ItemType Directory -Path $OutputDirectory
+$package='io/github/mesmerprism/rustyquest/native_renderer'
+$panel=Join-Path $repo "apps/native-renderer-android/panel-modules/breath-composition/src/main/java/$package"
+$ui=Join-Path $repo "apps/native-renderer-android/src/phone-pairing/java/$package"
+$sources=@('BreathCompositionPanelModule','ExperimentPhonePairing','ExperimentTrustedPhones','ExperimentSessionCommandGateway','ExperimentSessionGatewayProtocol','ExperimentSessionDiscoveryServer','ExperimentSessionBleServer')|ForEach-Object{Join-Path $panel "$_.java"}
