+struct GlobalSetupGuard {
+    previous: Option<Runtime>,
+}
+impl GlobalSetupGuard {
+    fn unconfigured() -> Self {
+        let text = loop_json();
+        let sha = digest(&text);
+        *TEST_SELECTED.lock().unwrap() = Some(sha.clone());
+        let previous = state().lock().unwrap().take();
+        Self { previous }
+    }
+    fn install() -> Self {
+        let guard = Self::unconfigured();
+        let text = loop_json();
+        let sha = digest(&text);
+        assert_eq!(configure(&text, &sha)["accepted"], true);
+        guard
+    }
+}
