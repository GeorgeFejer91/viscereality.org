index 00000000..8c4f7cc7
--- /dev/null
+++ b/apps/native-renderer-android/native/src/session_recording_participant/live_csv.rs
@@ -0,0 +1,459 @@
+//! Append-only projection of committed participant recording streams.
+use super::*;
+use crate::session_recording_contract::SESSION_CHECKPOINT_SCHEMA;
+use std::{
+    collections::BTreeMap,
+    io::{Seek, SeekFrom},
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc, Arc,
+    },
+    thread::{self, JoinHandle},
+};
+
+pub(crate) const SCHEMA_VERSION: u64 = 4;
+pub(crate) const LIVE_CSV: &str = ".participant-live.csv";
+pub(crate) const LIVE_PREFIX: &str = ".participant-live-prefix.json";
+const STREAMS: [(&str, &str); 5] = [
+    ("events.jsonl", "event"),
+    ("polar-ecg.jsonl", "ecg"),
+    ("polar-acc.jsonl", "accelerometer"),
+    ("radius.jsonl", "radius"),
+    ("breath.jsonl", "breath"),
+];
+type Lengths = BTreeMap<String, u64>;
+type FinalCsv = Option<(Value, u64)>;
+
+pub(crate) struct Worker {
+    latest: Arc<AtomicU64>,
+    finish: Option<mpsc::SyncSender<Finish>>,
+    thread: Option<JoinHandle<Result<FinalCsv, String>>>,
+}
+
+struct Finish {
+    lengths: Lengths,
+    ended_at: u64,
+    complete: bool,
+    reason: String,
+}
+
+impl Worker {
+    pub(crate) fn start(
+        run: ParticipantRun,
+        directory: PathBuf,
+        anchor: ClockAnchor,
+    ) -> Result<Self, String> {
+        let latest = Arc::new(AtomicU64::new(0));
+        let pending = Arc::clone(&latest);
+        let (finish, commands) = mpsc::sync_channel::<Finish>(1);
+        let thread = thread::Builder::new()
+            .name("participant-csv".to_owned())
+            .spawn(move || {
+                let mut projection = Projection::new(run, directory, anchor);
+                let mut next = 1;
+                loop {
+                    let finish = match commands.try_recv() {
+                        Ok(finish) => Some(finish),
+                        Err(mpsc::TryRecvError::Disconnected) => return Ok(None),
+                        Err(mpsc::TryRecvError::Empty) => None,
+                    };
+                    while next <= pending.load(Ordering::Acquire) {
+                        let lengths = checkpoint_lengths(&projection.directory, next)?;
+                        if let Some(prefix) = projection.append(&lengths, None)? {
+                            if finish.is_none() {
+                                publish_prefix(&projection.directory, next, &prefix)?;
+                            }
+                        }
+                        next += 1;
+                    }
+                    if let Some(finish) = finish {
+                        projection.append(&finish.lengths, Some(finish.ended_at))?;
+                        return projection.finish(
+                            Some(finish.ended_at),
+                            finish.complete,
+                            &finish.reason,
+                        );
+                    }
+                    thread::park();
+                }
+            })
+            .map_err(io_error)?;
+        Ok(Self {
+            latest,
+            finish: Some(finish),
+            thread: Some(thread),
+        })
+    }
+
+    pub(crate) fn checkpoint(&self, ordinal: u64) {
+        self.latest.store(ordinal, Ordering::Release);
+        if let Some(thread) = &self.thread {
+            thread.thread().unpark();
+        }
+    }
+
+    pub(crate) fn finish(
+        mut self,
+        lengths: Lengths,
+        ended_at: u64,
+        complete: bool,
+        reason: &str,
+    ) -> Result<FinalCsv, String> {
+        if let Some(sender) = self.finish.take() {
+            let _ = sender.send(Finish {
+                lengths,
+                ended_at,
+                complete,
+                reason: reason.to_owned(),
+            });
+        }
+        let thread = self.thread.take().expect("live projection worker");
+        thread.thread().unpark();
+        thread
+            .join()
+            .map_err(|_| "participant-csv-worker-panicked".to_owned())?
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.finish.take();
+        if let Some(thread) = self.thread.take() {
+            thread.thread().unpark();
+            let _ = thread.join();
+        }
+    }
+}
+
+fn checkpoint_lengths(directory: &Path, ordinal: u64) -> Result<Lengths, String> {
+    let file =
+        open_regular_recording_file(&directory.join(format!("checkpoint-{ordinal:020}.json")))?;
+    let mut bytes = Vec::new();
+    file.take(1024 * 1024 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(io_error)?;
+    if bytes.len() > 1024 * 1024 {
+        return Err("participant-checkpoint-too-large".into());
+    }
+    let receipt: Value =
+        serde_json::from_slice(&bytes).map_err(|_| "participant-checkpoint-json-invalid")?;
+    if receipt["schema"] != SESSION_CHECKPOINT_SCHEMA || receipt["checkpoint_ordinal"] != ordinal {
+        return Err("participant-checkpoint-identity-invalid".into());
+    }
+    serde_json::from_value(receipt["durable_stream_lengths"].clone())
+        .map_err(|_| "participant-stream-length-invalid".to_owned())
+}
+
+fn publish_prefix(directory: &Path, ordinal: u64, prefix: &Prefix) -> Result<(), String> {
+    let partial = directory.join(".participant-live-prefix.partial");
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&partial)
+        .map_err(io_error)?;
+    serde_json::to_writer(&mut file, &json!({"schema_version": SCHEMA_VERSION, "checkpoint":ordinal,
+        "name":prefix.name,"session_id":prefix.session_id,"size":prefix.size,"sha256":prefix.sha256}))
+        .map_err(|_| "participant-prefix-json-write".to_owned())?;
+    file.sync_all().map_err(io_error)?;
+    drop(file);
+    fs::rename(partial, directory.join(LIVE_PREFIX)).map_err(io_error)?;
+    sync_directory(directory)
+}
+
+pub(crate) fn replay(
+    run: &ParticipantRun,
+    directory: &Path,
+    anchor: ClockAnchor,
+    checkpoint: u64,
+    lengths: &Lengths,
+    cutoff: Option<u64>,
+    complete: bool,
+    reason: &str,
+) -> Result<FinalCsv, String> {
+    discard_recovery_csv(&directory.join(LIVE_CSV))?;
+    let mut projection = Projection::new(run.clone(), directory.to_owned(), anchor);
+    for ordinal in 1..=checkpoint {
+        let checkpoint = checkpoint_lengths(directory, ordinal)?;
+        if checkpoint
+            .iter()
+            .any(|(file, size)| lengths.get(file).is_none_or(|bound| size > bound))
+        {
+            return Err("participant-checkpoint-beyond-durable-stream".into());
+        }
+        projection.append(&checkpoint, None)?;
+    }
+    projection.append(lengths, cutoff)?;
+    projection.finish(cutoff, complete, reason)
+}
+
+pub(crate) fn publish_final(
+    directory: &Path,
+    descriptor: &Value,
+    recovered: bool,
+) -> Result<(), String> {
+    let name = descriptor["name"]
+        .as_str()
+        .filter(|name| valid_csv_filename(name))
+        .ok_or("participant-csv-name-invalid")?;
+    let destination = if recovered {
+        directory.join(format!("{RECOVERED_CSV_PREFIX}{name}"))
+    } else {
+        directory.join(name)
+    };
+    if recovered {
+        discard_recovery_csv(&destination)?;
+    } else if destination.exists() {
+        return Err("participant-csv-already-exists".into());
+    }
+    fs::rename(directory.join(LIVE_CSV), destination).map_err(io_error)?;
+    sync_directory(directory)
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Prefix {
+    pub(crate) name: String,
+    pub(crate) session_id: String,
+    pub(crate) size: u64,
+    pub(crate) sha256: String,
+}
+
+struct Output {
+    writer: BufWriter<File>,
+    size: u64,
+    hash: Sha256,
+}
+
+impl Write for Output {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let written = self.writer.write(bytes)?;
+        self.hash.update(&bytes[..written]);
+        self.size += written as u64;
+        Ok(written)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.writer.flush()?;
+        self.writer.get_ref().sync_all()
+    }
+}
+
+pub(crate) struct Projection {
+    run: ParticipantRun,
+    directory: PathBuf,
+    anchor: ClockAnchor,
+    identity: String,
+    clock: PlaybackClock,
+    cursors: [u64; STREAMS.len()],
+    latest: u64,
+    output: Option<Output>,
+    name: Option<String>,
+}
+
+impl Projection {
+    pub(crate) fn new(run: ParticipantRun, directory: PathBuf, anchor: ClockAnchor) -> Self {
+        let identity = format!(
+            "{SCHEMA_VERSION},{},{},{},{}",
+            run.plan.participant.as_text(),
+            run.uuid,
+            run.index,
+            run.plan.scenario
+        );
+        Self {
+            run,
+            directory,
+            anchor,
+            identity,
+            clock: PlaybackClock::default(),
+            cursors: [0; STREAMS.len()],
+            latest: 0,
+            output: None,
+            name: None,
+        }
+    }
+
+    pub(crate) fn append(
+        &mut self,
+        lengths: &Lengths,
+        cutoff: Option<u64>,
+    ) -> Result<Option<Prefix>, String> {
+        for (index, (file, kind)) in STREAMS.into_iter().enumerate() {
+            let cursor = self.cursors[index];
+            let length = lengths
+                .get(file)
+                .ok_or("participant-stream-length-invalid")?;
+            let count = length
+                .checked_sub(cursor)
+                .ok_or("participant-stream-length-regressed")?;
+            if count != 0 {
+                let mut input = open_regular_recording_file(&self.directory.join(file))?;
+                input.seek(SeekFrom::Start(cursor)).map_err(io_error)?;
+                let mut input = BufReader::new(input.take(count));
+                let mut line = Vec::new();
+                let mut consumed = 0;
+                while consumed < count {
+                    line.clear();
+                    consumed += input.read_until(b'\n', &mut line).map_err(io_error)? as u64;
+                    if line.last() != Some(&b'\n') {
+                        return Err("participant-stream-incomplete-row".into());
+                    }
+                    let row = serde_json::from_slice(&line)
+                        .map_err(|_| "participant-stream-json-invalid")?;
+                    self.observe(kind, &row, cutoff)?;
+                }
+                self.cursors[index] = *length;
+            }
+            if index == 0 && self.output.is_none() {
+                return Ok(None);
+            }
+        }
+        self.checkpoint()
+    }
+
+    fn observe(&mut self, kind: &str, row: &Value, cutoff: Option<u64>) -> Result<(), String> {
+        let at = row["observed_monotonic_ns"]
+            .as_u64()
+            .ok_or("participant-stream-clock-invalid")?;
+        if cutoff.is_some_and(|end| at > end) {
+            return Ok(());
+        }
+        if kind == "event" {
+            let event = self.clock.observe(row, None)?;
+            if event == Some(SessionEventKind::OfficialStart) {
+                self.start(at)?;
+            }
+            if self.output.is_none() || at < self.clock.start() {
+                return Ok(());
+            }
+            if let Some(event) = event {
+                return self.write_row(at, event.as_str(), None, true, "", "", "");
+            }
+            if let Some(event) = row["event"].as_str().and_then(SessionEventKind::parse) {
+                if let Some(reason) = event.signal_reason() {
+                    return self.write_row(at, event.as_str(), None, false, "", "", reason);
+                }
+            }
+            return Ok(());
+        }
+        if at < self.clock.start() {
+            return Ok(());
+        }
+        if let Some(values) = observation_values(kind, row)? {
+            self.write_row(at, kind, Some(&values), false, "", "", "")?;
+        }
+        Ok(())
+    }
+
+    fn start(&mut self, at: u64) -> Result<(), String> {
+        self.name = Some(self.run.filename(&utc(self.anchor, at)?));
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(self.directory.join(LIVE_CSV))
+            .map_err(io_error)?;
+        let mut output = Output {
+            writer: BufWriter::with_capacity(256 * 1024, file),
+            size: 0,
+            hash: Sha256::new(),
+        };
+        output.write_all(HEADER.as_bytes()).map_err(io_error)?;
+        self.output = Some(output);
+        sync_directory(&self.directory)
+    }
+
+    fn write_row(
+        &mut self,
+        at: u64,
+        kind: &str,
+        values: Option<&[String; 10]>,
+        playback: bool,
+        outcome: &str,
+        end_reason: &str,
+        signal_reason: &str,
+    ) -> Result<(), String> {
+        let output = self
+            .output
+            .as_mut()
+            .ok_or("participant-live-csv-not-started")?;
+        self.latest = self.latest.max(at);
+        write!(
+            output,
+            "{},{kind},{},{}",
+            self.identity,
+            utc(self.anchor, at)?,
+            (at - self.clock.start()) / 1000
+        )
+        .map_err(io_error)?;
+        if playback {
+            let (audio, state) = self.clock.at(at, self.run.plan.seconds * 1_000_000_000);
+            let phase = match state {
+                "waiting" | "ended" => state,
+                _ => self.run.plan.phase_at(audio),
+            };
+            write!(output, ",{},{state},{phase}", audio / 1000).map_err(io_error)?;
+        } else {
+            output.write_all(b",,,").map_err(io_error)?;
+        }
+        if let Some(values) = values {
+            for value in values {
+                write!(output, ",{value}").map_err(io_error)?;
+            }
+        } else {
+            output.write_all(b",,,,,,,,,,").map_err(io_error)?;
+        }
+        if end_reason.contains([',', '"', '\r', '\n']) {
+            writeln!(
+                output,
+                ",{outcome},\"{}\",{signal_reason}\r",
+                end_reason.replace('"', "\"\"")
+            )
+            .map_err(io_error)
+        } else {
+            writeln!(output, ",{outcome},{end_reason},{signal_reason}\r").map_err(io_error)
+        }
+    }
+
+    fn checkpoint(&mut self) -> Result<Option<Prefix>, String> {
+        let Some(output) = self.output.as_mut() else {
+            return Ok(None);
+        };
+        output.flush().map_err(io_error)?;
+        Ok(Some(Prefix {
+            name: self.name.as_ref().expect("opened CSV has a name").clone(),
+            session_id: self.run.uuid.clone(),
+            size: output.size,
+            sha256: format!("{:x}", output.hash.clone().finalize()),
+        }))
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        cutoff: Option<u64>,
+        complete: bool,
+        reason: &str,
+    ) -> Result<Option<(Value, u64)>, String> {
+        if self.output.is_none() {
+            return Ok(None);
+        }
+        let ended_at = cutoff.unwrap_or(self.latest.max(self.clock.last_event));
+        if ended_at < self.clock.start() {
+            return Err("participant-event-order-invalid".into());
+        }
+        self.write_row(
+            ended_at,
+            "end",
+            None,
+            true,
+            if complete { "completed" } else { "aborted" },
+            reason,
+            "",
+        )?;
+        let prefix = self.checkpoint()?.expect("opened CSV has a checkpoint");
+        self.output.take();
+        Ok(Some((
+            json!({"name":prefix.name, "size":prefix.size, "sha256":prefix.sha256,
+            "session_id":prefix.session_id, "schema_version":SCHEMA_VERSION}),
+            ended_at,
+        )))
+    }
+}
diff --git a/apps/native-renderer-android/native/src/session_recording_participant_recovery.rs b/apps/native-renderer-android/native/src/session_recording_participant_recovery.rs
new file mode 100644
index 00000000..b1c43bdb
--- /dev/null
+++ b/apps/native-renderer-android/native/src/session_recording_participant_recovery.rs
@@ -0,0 +1,166 @@
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{self, Read},
+    path::Path,
+};
+
+use crate::{
+    session_recording_clock::{ClockAnchor, MonotonicNanos, SessionTimestampKey, UtcEpochNanos},
+    session_recording_contract::{SESSION_FINAL_SCHEMA, SESSION_STREAM_FILES},
+    session_recording_export::{MAX_PARTICIPANT_CORE_BYTES, open_regular_recording_file},
+    session_recording_participant::{ParticipantRun, RECOVERY_RECEIPT, discard_recovery_csv, live_csv},
+    session_recording_recovery::{RecoveryDisposition, RecoveryReport, participant_checkpoint},
+    session_recording_writer::publish_json_exclusive,
+};
+
+pub(crate) fn publish_recovered(root: &Path, report: &mut RecoveryReport) {
+    for run in &mut report.sessions {
+        if run.error.is_some()
+            || !matches!(
+                run.disposition,
+                RecoveryDisposition::InterruptedEarly | RecoveryDisposition::InterruptedCompleted
+            )
+        {
+            continue;
+        }
+        if let Err(error) = publish_run(&root.join(run.started_at.as_str()), &run.started_at) {
+            run.error = Some(error);
+            report.counts.errors = report.counts.errors.saturating_add(1);
+            if let Some(identity) = &run.experiment_identity {
+                let counts = match identity.condition_id.as_str() {
+                    "condition-a" => Some(&mut report.condition_counts.condition_a),
+                    "condition-b" => Some(&mut report.condition_counts.condition_b),
+                    _ => None,
+                };
+                if let Some(counts) = counts {
+                    counts.errors = counts.errors.saturating_add(1);
+                }
+            }
+        }
+    }
+}
+
+fn absent(path: &Path) -> Result<bool, String> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => Ok(false),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(true),
+        Err(error) => Err(format!("participant-recovery-path:{:?}", error.kind())),
+    }
+}
+
+fn publish_run(directory: &Path, key: &SessionTimestampKey) -> Result<(), String> {
+    let metadata = fs::symlink_metadata(directory)
+        .map_err(|_| "participant-recovery-directory-unavailable")?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err("participant-recovery-directory-invalid".into());
+    }
+    if !absent(&directory.join("final.json"))? || !absent(&directory.join(RECOVERY_RECEIPT))? {
+        return Ok(());
+    }
+    let Some((original, mut terminal)) = participant_checkpoint(directory, key)? else {
+        return Ok(());
+    };
+    let run = ParticipantRun::restore(&original["participant"]).map_err(str::to_owned)?;
+    let clock = &original["clock_anchor"];
+    let utc = UtcEpochNanos::new(
+        clock["utc_epoch_ns"]
+            .as_u64()
+            .ok_or("participant-recovery-utc")?,
+    );
+    if &SessionTimestampKey::from_utc(utc) != key
+        || clock["monotonic_clock"] != "android-elapsed-realtime"
+    {
+        return Err("participant-recovery-clock-binding".into());
+    }
+    let anchor = ClockAnchor::new(
+        MonotonicNanos::new(
+            clock["monotonic_ns"]
+                .as_u64()
+                .ok_or("participant-recovery-clock")?,
+        ),
+        utc,
+    );
+    let ordinal = terminal["checkpoint_ordinal"]
+        .as_u64()
+        .filter(|ordinal| *ordinal > 0)
+        .ok_or("participant-recovery-checkpoint-ordinal")?;
+    let checkpoint_path = directory.join(format!("checkpoint-{ordinal:020}.json"));
+    let checkpoint_file = open_regular_recording_file(&checkpoint_path)?;
