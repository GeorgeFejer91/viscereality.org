+    r.observe_acc_with_source(100_000_000_000 + now, now, now, [f32::NAN, 0.0, 1000.0]);
+    assert!(!r.core.snapshot(now).ready);
+    assert_eq!(
+        r.phase,
+        CommonBreathPhase::Unknown,
+        "invalid evidence re-primes classification"
+    );
+    setup_frame(&mut driver, r.output(now), now, 0.1);
+    assert!(
+        (driver.value01() - 0.35).abs() < 0.000_001,
+        "invalid sample must retain inhale"
+    );
+    // Settling and re-priming after a true source timestamp gap cannot make
+    // Unknown a new motion state; only confirmed valid evidence replaces it.
+    for i in 1..=18 {
+        let now = base_ns + 40_000_000 + i * 40_000_000;
+        r.observe_clock(
+            7,
+            base_frame + (now - base_ns) * 44100 / 1_000_000_000,
