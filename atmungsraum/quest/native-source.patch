+        assert_eq!(rows[0][11], "2023-11-14T22:13:20.000Z");
+        assert_eq!(
+            rows[0][13..19],
+            [
+                "0.000",
+                "2023-11-14T22:13:20.000Z",
+                "0.000",
+                "waiting",
