+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import org.json.JSONObject;
+
+/** Real process owner, bounded player/native doubles. Does not claim Android audio evidence. */
+public final class BreathingSetupAudioOwnerTest {
+    public static void main(String[] args) throws Exception {
+        String json = new String(Files.readAllBytes(Paths.get(args[0])), StandardCharsets.UTF_8);
+        BreathingSetupAudioContract loop = BreathingSetupAudioContract.parse(json);
+        FakePlayer player = new FakePlayer(); FakeNative bridge = new FakeNative();
+        FakeClock clock = new FakeClock();
+        BreathingSetupAudio owner = new BreathingSetupAudio(loop, json,
+            BreathingSetupAudioContract.sha256(json.getBytes(StandardCharsets.UTF_8)),
+            new byte[1411200], player, bridge, clock);
+        try {
+            owner.initialize();
+            check(player.playCount == 1 && player.loopFrames == 705600, "initialization starts the verified static loop once");
+            AtomicInteger starts = new AtomicInteger(); AtomicInteger retired = new AtomicInteger();
+            bridge.startFrame = 705600;
+            check(owner.defer(starts::incrementAndGet, retired::incrementAndGet), "next-cycle effect queued");
+            player.head = 705599; clock.now += 16000000000L; owner.observe();
+            check(bridge.sourceNano > 0 && bridge.elapsedPair == clock.now,
+                "one poll pairs source Java nanoTime with the actual elapsed-realtime audio observation");
+            check(starts.get() == 0, "main does not begin before boundary");
+            owner.pause();
+            player.head = 705600; clock.now += 1000000L; owner.observe();
+            check(starts.get() == 0 && !bridge.playing, "pause cannot dispatch main");
+            owner.resume(); clock.now += 1000000L; owner.observe();
+            check(starts.get() == 1 && retired.get() == 0, "resume admits exact queued boundary once");
+            player.head += 44100; clock.now += 1000000000L; owner.observe();
+            check(owner.positionMs() == 1000, "main position derives from playback frames");
+            check(player.playCount == 2, "main boundary did not replay or replace static AudioTrack");
+            bridge.startFrame = 1411200;
+            owner.defer(starts::incrementAndGet, retired::incrementAndGet);
+            owner.close();
+            check(retired.get() == 1 && player.released, "retirement fails pending effect and releases exact player");
+        } finally { owner.close(); }
+        waitsForRetargetedNativeAdmission(json, loop);
+        timedOutQueuedRequestsCannotRunLater(json, loop);
+        System.out.println("BreathingSetupAudioOwnerTest PASS");
+    }
+    private static void timedOutQueuedRequestsCannotRunLater(String json, BreathingSetupAudioContract loop) throws Exception {
+        FakePlayer player = new FakePlayer(); FakeNative bridge = new FakeNative(); FakeClock clock = new FakeClock();
+        BreathingSetupAudio owner = new BreathingSetupAudio(loop, json,
+            BreathingSetupAudioContract.sha256(json.getBytes(StandardCharsets.UTF_8)), new byte[1411200], player, bridge, clock);
+        java.lang.reflect.Field app = BreathingSetupAudio.class.getDeclaredField("appLifetime"); app.setAccessible(true);
+        Object previousOwner = app.get(null);
+        java.lang.reflect.Field workerField = BreathingSetupAudio.class.getDeclaredField("worker"); workerField.setAccessible(true);
+        ScheduledThreadPoolExecutor worker = (ScheduledThreadPoolExecutor) workerField.get(owner);
+        try {
+            owner.initialize(); app.set(null, owner); bridge.startFrame = 705600;
+            AtomicInteger starts = new AtomicInteger(); AtomicInteger retired = new AtomicInteger();
+            WorkerBlock block = new WorkerBlock(worker);
+            try {
+                check(!BreathingSetupAudio.deferExperimentStart(starts::incrementAndGet, retired::incrementAndGet),
+                    "queued deferral reports definite timeout failure");
+            } finally { block.releaseAndDrain(worker); }
+            player.head = 705600; clock.now += 16000000000L; owner.observe();
+            check(starts.get() == 0 && retired.get() == 0 && owner.positionMs() == -1,
+                "timed-out deferral must neither arm nor dispatch after worker unblocks");
+
+            block = new WorkerBlock(worker);
+            try { expectControlFailure(false); } finally { block.releaseAndDrain(worker); }
+            check(player.playing, "timed-out queued pause cannot pause playback later");
+            owner.pause();
+            block = new WorkerBlock(worker);
+            try { expectControlFailure(true); } finally { block.releaseAndDrain(worker); }
+            check(!player.playing, "timed-out queued resume cannot resume playback later");
+
+            bridge.statusEntered = new CountDownLatch(1); bridge.statusRelease = new CountDownLatch(1);
+            try {
+                try {
+                    boolean accepted = BreathingSetupAudio.deferExperimentStart(starts::incrementAndGet, retired::incrementAndGet);
+                    throw new AssertionError("already-running operation reported definite result " + accepted);
+                } catch (IllegalStateException uncertain) {
+                    check(bridge.statusEntered.getCount() == 0, "native call actually began before timeout");
+                    check("breathing-loop-command-outcome-uncertain".equals(uncertain.getMessage()),
+                        "in-flight effect must report uncertainty rather than false rejection");
+                }
+            } finally { bridge.statusRelease.countDown(); }
+            worker.submit(() -> { }).get(2, TimeUnit.SECONDS);
+            BreathingSetupAudio.cancelDeferredExperimentStart();
+            worker.submit(() -> { }).get(2, TimeUnit.SECONDS);
+            check(owner.positionMs() == -1, "explicit cancellation resolves the uncertain pending effect");
+        } finally { owner.close(); app.set(null, previousOwner); }
+    }
+    private static void expectControlFailure(boolean resume) {
+        try { if (resume) BreathingSetupAudio.resumeLoop(); else BreathingSetupAudio.pauseLoop(); }
+        catch (IllegalStateException expected) { return; }
+        throw new AssertionError("blocked worker control did not report timeout");
+    }
+    private static final class WorkerBlock {
+        private final CountDownLatch release = new CountDownLatch(1);
+        WorkerBlock(ScheduledThreadPoolExecutor worker) throws Exception {
+            final CountDownLatch entered = new CountDownLatch(1);
+            worker.execute(() -> {
+                entered.countDown();
+                try { release.await(); } catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); }
+            });
+            check(entered.await(2, TimeUnit.SECONDS), "worker blocker was admitted");
+        }
+        void releaseAndDrain(ScheduledThreadPoolExecutor worker) throws Exception {
+            release.countDown(); worker.submit(() -> { }).get(2, TimeUnit.SECONDS);
+        }
+    }
+    private static void waitsForRetargetedNativeAdmission(String json, BreathingSetupAudioContract loop) throws Exception {
+        FakePlayer player = new FakePlayer(); FakeNative bridge = new FakeNative(); FakeClock clock = new FakeClock();
+        BreathingSetupAudio owner = new BreathingSetupAudio(loop, json,
+            BreathingSetupAudioContract.sha256(json.getBytes(StandardCharsets.UTF_8)), new byte[1411200], player, bridge, clock);
+        try {
+            owner.initialize(); bridge.startFrame = 705600; bridge.mainStarted = false;
+            AtomicInteger starts = new AtomicInteger(); AtomicInteger retired = new AtomicInteger();
+            owner.defer(starts::incrementAndGet, retired::incrementAndGet);
+            // Native shifts admission when a resume boundary precedes fresh source evidence.
+            bridge.startFrame = 1411200; player.head = 705600; clock.now += 16000000000L; owner.observe();
+            check(starts.get() == 0 && retired.get() == 0, "moved target must not fire cached boundary");
+            player.head = 1411200; clock.now += 16000000000L; owner.observe();
+            check(starts.get() == 0, "frame crossing alone cannot admit native pending state");
+            bridge.mainStarted = true; clock.now += 1000000L; owner.observe();
+            check(starts.get() == 1 && owner.positionMs() == 0, "only native-started state admits at updated boundary");
+            bridge.startFrame = 2116800; bridge.mainStarted = false;
+            owner.defer(starts::incrementAndGet, retired::incrementAndGet);
+            bridge.startFrame = -1; clock.now += 1000000L; owner.observe();
+            check(starts.get() == 1 && retired.get() == 1, "native invalidation cancels pending effect once");
+        } finally { owner.close(); }
+    }
+    private static final class FakeClock implements BreathingSetupAudio.Clock {
+        volatile long now = 1000000000L;
+        public long nowNs() { return now; }
+    }
+    private static final class FakePlayer implements BreathingSetupAudio.Player {
+        volatile int head; int playCount, loopFrames; boolean released, playing;
+        public void prepare(byte[] pcm, int sampleRate, int frames) {
+            check(sampleRate == 44100 && pcm.length == 1411200, "PCM format delivered to player"); loopFrames = frames;
+        }
+        public void play() { playCount++; playing = true; }
+        public void pause() { playing = false; }
+        public boolean playing() { return playing; }
+        public int head() { return head; }
+        public void release() { released = true; playing = false; }
+    }
+    private static final class FakeNative implements BreathingSetupAudio.NativeBridge {
+        long sourceNano, elapsedPair;
+        public void observeSourceClockPair(long nanoNs, long elapsedNs) { sourceNano = nanoNs; elapsedPair = elapsedNs; }
+        long startFrame = -1; boolean mainStarted = true; volatile boolean playing;
+        volatile CountDownLatch statusEntered, statusRelease;
+        public String configure(String json, String hash) { return "{\"accepted\":true}"; }
+        public void observe(long generation, long frame, long now, boolean active) { playing = active; }
+        public String status(long now) {
+            if (statusEntered != null) {
+                statusEntered.countDown();
+                try { statusRelease.await(); }
+                catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); throw new IllegalStateException(interrupted); }
+            }
+            return "{\"main_start_frame\":" + startFrame + ",\"main_started\":" + mainStarted
+                + ",\"stage\":\"" + (mainStarted ? "main" : "main-pending") + "\"}";
+        }
+        public String command(String json, long now) { return "{\"accepted\":true}"; }
+    }
+    private static void check(boolean value, String reason) { if (!value) throw new AssertionError(reason); }
+}
