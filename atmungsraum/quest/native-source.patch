diff --git a/apps/native-renderer-android/native/src/android_elapsed_clock.rs b/apps/native-renderer-android/native/src/android_elapsed_clock.rs
new file mode 100644
index 00000000..75af7cfd
--- /dev/null
+++ b/apps/native-renderer-android/native/src/android_elapsed_clock.rs
@@ -0,0 +1,43 @@
+//! Android elapsed realtime observations for display telemetry only.
+//! CLOCK_BOOTTIME shares Android SystemClock.elapsedRealtimeNanos's suspend-inclusive domain.
+//! This never establishes PCM, experiment, recording, or input authority.
+
+#[cfg(target_os = "android")]
+pub(crate) fn now_ns() -> Option<u64> {
+    let mut observation = std::mem::MaybeUninit::<libc::timespec>::uninit();
+    // SAFETY: clock_gettime writes the complete timespec on success. The pointer is
+    // aligned/writable and the value is read only after a successful return.
+    if unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, observation.as_mut_ptr()) } != 0 {
+        return None;
+    }
+    // SAFETY: successful clock_gettime initialized the complete timespec above.
+    let observation = unsafe { observation.assume_init() };
+    timespec_ns(observation.tv_sec as i64, observation.tv_nsec as i64)
+}
+
+#[cfg(not(target_os = "android"))]
+pub(crate) fn now_ns() -> Option<u64> {
+    None
+}
+
+fn timespec_ns(seconds: i64, nanos: i64) -> Option<u64> {
+    if seconds < 0 || !(0..1_000_000_000).contains(&nanos) {
+        return None;
+    }
+    (seconds as u64)
+        .checked_mul(1_000_000_000)?
+        .checked_add(nanos as u64)
+        .filter(|value| *value > 0)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn actual_elapsed_clock_parts_validate_sign_fraction_and_overflow() {
+        assert_eq!(super::timespec_ns(1, 7), Some(1_000_000_007));
+        assert_eq!(super::timespec_ns(0, 1), Some(1));
+        for (seconds, nanos) in [(0, 0), (-1, 1), (1, -1), (1, 1_000_000_000), (i64::MAX, 0)] {
+            assert_eq!(super::timespec_ns(seconds, nanos), None);
+        }
+    }
+}
