+#[test]
+fn actual_packet_projection_jitter_noise_and_provenance_complete_parked_32s_window() {
+    use crate::polar_composition_adapters::{
+        latest_polar_acc_after, observe_setup_sensor_frame, submit_setup_sensor_packet,
+    };
+    let _binding = crate::breath_composition_runtime::scoped_test_binding::install_polar();
+    let _ingress = crate::polar_composition_adapters::scoped_packet_ingress::install();
+    let _setup = GlobalSetupGuard::install();
+    let binding = crate::polar_input_health::source_binding();
+    let frame = |packet: u64| crate::polar_sensor_clock::SensorFrame {
+        sequence: packet,
+        sensor_last_ns: 10_000_000_000 + packet * 200_000_000,
+        receipt_ns: 1_000_000_000
+            + packet * 200_000_000
+            + if packet % 2 == 1 { 20_000_000 } else { 0 },
+        rate_hz: 200,
+        count: 40,
+    };
+    for packet in 1..=4 {
+        let f = frame(packet);
+        observe_source_clock_pair(f.receipt_ns, f.receipt_ns + 900_000_000_000);
+        observe_clock(7, 0, f.receipt_ns + 900_000_000_000, false);
+        let _ = observe_setup_sensor_frame(binding, f);
+        refresh_source_projection(binding);
+        for index in 0..40 {
+            let after = u64::from(39 - index) * 5_000_000;
+            assert!(submit_setup_sensor_packet(
+                Instant::now(),
+                f.receipt_ns - after,
+                f.sensor_last_ns - after,
+                packet,
+                index,
+                40,
+                vector(0.0)
+            ));
+        }
+    }
+    let start = 1_800_000_000;
+    assert_eq!(
+        status_json(start + 900_000_000_000)["source_clock_ready"],
+        true
+    );
+    assert_eq!(status_json(start + 900_000_000_000)["input_volume01"], 0.0);
+    assert_eq!(
+        global_command(1, "calibrate", start + 900_000_000_000)["accepted"],
+        true
+    );
+    observe_clock(7, 0, start + 900_000_000_000, true);
+    let mut packet = 5;
+    for tick in 1..=1613_u64 {
+        let raw_now = start + tick * 20_000_000;
+        let now = raw_now + 900_000_000_000;
+        observe_source_clock_pair(raw_now, now);
+        observe_clock(7, tick * 882, now, true);
+        let f = frame(packet);
+        if f.receipt_ns <= raw_now {
+            let _ = observe_setup_sensor_frame(binding, f);
+            refresh_source_projection(binding);
+            for index in 0..40 {
+                let after = u64::from(39 - index) * 5_000_000;
+                let sensor = f.sensor_last_ns - after;
+                let at = sensor - 10_800_000_000;
+                let t = (at % 16_000_000_000) as f64 / 1_000_000_000.0;
+                let v = if t < 4.0 {
+                    t / 4.0
+                } else if t < 8.0 {
+                    1.0
+                } else if t < 12.0 {
+                    (12.0 - t) / 4.0
+                } else {
+                    0.0
+                };
+                let mut xyz = vector(v);
+                xyz[0] += if index % 2 == 0 { 4.0 } else { -4.0 };
+                assert!(submit_setup_sensor_packet(
+                    Instant::now(),
+                    f.receipt_ns - after,
+                    sensor,
+                    packet,
+                    index,
+                    40,
+                    xyz
+                ));
+                let sample = latest_polar_acc_after(None).unwrap();
+                let p = sample.sensor_clock_provenance.unwrap();
+                assert_eq!(p.original_host_ns, f.receipt_ns - after);
+                assert_eq!(p.sensor_ns, sensor);
+                assert_eq!(sample.xyz_mg, xyz);
+            }
+            packet += 1;
+        }
+    }
+    let now = start + 32_260_000_000 + 900_000_000_000;
+    let status = status_json(now);
+    assert_eq!(status["calibration"], "ready", "{status}");
+    assert_eq!(status["completed_frames"], 1_411_200);
+    assert_eq!(status["ready"], true);
+    assert_eq!(status["input"], "polar-tilt");
+    let guard = state().lock().unwrap();
+    let receipt = guard
+        .as_ref()
+        .unwrap()
+        .tracking_configuration(9, "packet-clock-proof")
+        .unwrap();
+    assert_eq!(
+        receipt["sensor_clock_projection"]["exact_acquisition_time"],
+        false
+    );
+    assert_eq!(
+        receipt["sensor_clock_projection"]["receipt_uncertainty_bound_ns"],
+        250_000_000
+    );
+    crate::breath_composition_runtime::validate_tracking_configuration(&receipt).unwrap();
+}
