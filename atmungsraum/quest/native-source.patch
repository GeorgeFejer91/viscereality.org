+            ConditionAudioRuntime.MediaBackend old = factory.create(provider, listener(), "haupt-15");
+            old.prepare(false); old.start();
+            // Another session already owns a later native admission before old cleanup arrives.
+            bridge.mainFrame = 2116800; bridge.revision = 23;
+            owner.defer(() -> { }, () -> { }); player.frame = 2116800; now[0] += 16000000000L; owner.observe();
+            old.stop(); old.release();
+            check(bridge.endRequests == 1 && bridge.mainFrame == 2116800 && "controller".equals(bridge.input),
+                "late old backend cleanup cannot reset the newer main admission");
+            ConditionAudioRuntime.MediaBackend current = factory.create(provider, listener(), "haupt-15");
+            current.prepare(false); current.start(); bridge.revision = 55;
+            current.pause(); bridge.staleRejects = 2;
+            try { current.release(); throw new AssertionError("unconfirmed terminal reset reported success"); }
+            catch (IllegalStateException retryRequired) { }
+            current.release();
+            check(bridge.acceptedResets == 2 && bridge.endRequests == 4 && player.playing,
+                "terminal cleanup of paused main resumes the same preparation loop");
+            check(bridge.lastEnd.getLong("main_start_frame") == 2116800 && bridge.lastEnd.getLong("r") == 57,
+                "new backend reset stays bound to its own captured frame");
+
+            MediaPlayer explorationBackground = MediaPlayer.players.get(MediaPlayer.players.size() - 1);
+            ConditionAudioRuntime.MediaBackend exploration = factory.create(provider, listener(), "free-exploration");
+            MediaPlayer explorationTrack = MediaPlayer.players.get(MediaPlayer.players.size() - 1);
+            exploration.prepare(false); exploration.start();
+            check(!player.playing && explorationTrack.playing && !explorationTrack.looping
+                    && explorationBackground.starts == 0, "exploration plays only the authored non-looping track");
+            explorationTrack.position = 22000;
+            check(exploration.currentPlaybackPositionMs() == 22000 && exploration.pause() == 22000
+                    && !explorationTrack.playing, "exploration reports its own media position when paused");
+            exploration.start();
+            check(explorationTrack.playing && !player.playing && explorationBackground.starts == 0,
+                "exploration resumes without preparation cues or a second music track");
+            exploration.stop(); exploration.release();
+            check(explorationTrack.released && explorationBackground.released && bridge.endRequests == 4,
+                "exploration frees the media without ending a different main round");
+
+            owner.close();
+            check(BreathingSetupAudio.mainRecordingPlan("haupt-15") == null, "retired player cannot advertise an executable plan");
+            BreathingSetupAudio.cancelDeferredExperimentStart();
+        } finally {
+            if (factory != null) factory.closePreloads(); owner.close(); app.set(null, null); selected.set(null, false);
+        }
+        System.out.println("BreathingSetupAudioBackendTest PASS");
+    }
+    private static ConditionAudioRuntime.MediaBackend.Listener listener() {
+        return new ConditionAudioRuntime.MediaBackend.Listener() {
+            public void onPrepared() { }
+            public void onActualStart(long position) { }
+            public void onProgress(long position) { }
+            public void onNaturalEnd(long position) { }
+            public void onError(String reason) { throw new AssertionError(reason); }
+        };
+    }
+    private static final class FakeNative implements BreathingSetupAudio.NativeBridge {
+        long mainFrame = 705600, generation = 1, revision = 11; int endRequests, acceptedResets, staleRejects;
+        String input = "polar-tilt"; JSONObject lastEnd;
+        boolean invalidated;
+        public String configure(String j, String h) { return "{\"accepted\":true}"; }
+        public void observe(long g, long f, long n, boolean p) { generation = g; }
+        public String status(long n) {
+            return new JSONObject().put("g", generation).put("r", revision).put("input", input)
+                .put("main_start_frame", mainFrame < 0 ? JSONObject.NULL : mainFrame)
+                .put("main_started", mainFrame >= 0 && !invalidated)
+                .put("stage", invalidated ? "waiting" : mainFrame >= 0 ? "main" : "idle").toString();
+        }
+        public String command(String j, long n) {
+            JSONObject request = new JSONObject(j);
+            if ("controller".equals(request.optString("op"))) {
+                check(request.length() == 5, "closed setup command envelope");
+                return "{\"accepted\":true,\"state\":\"confirmed\"}";
+            }
+            lastEnd = request; endRequests++;
+            check(lastEnd.length() == 6 && lastEnd.getInt("v") == 1 && "end-main".equals(lastEnd.getString("op")),
+                "closed terminal command envelope");
+            check(lastEnd.getString("id").matches("[a-f0-9]{16}") && lastEnd.getLong("g") == generation,
+                "fresh command identity and audio generation");
+            if (staleRejects > 0) {
+                staleRejects--; revision++;
+                return "{\"accepted\":false,\"reason\":\"stale-revision\"}";
+            }
+            if (lastEnd.getLong("r") != revision || lastEnd.getLong("main_start_frame") != mainFrame) {
+                return "{\"accepted\":false,\"reason\":\"main-frame-mismatch\"}";
+            }
+            acceptedResets++; mainFrame = -1; input = "automatic"; revision++;
+            return "{\"accepted\":true}";
+        }
+    }
+    private static void check(boolean b, String m) { if (!b) throw new AssertionError(m); }
+}
