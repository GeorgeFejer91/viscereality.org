+#[test]
+fn latest_confirmed_sensor_phase_survives_a_masked_batch_tail_before_render() {
+    use crate::breath_composition_driver::{tests::setup_frame, BreathCompositionDriver};
+    for replacement in [CommonBreathPhase::Hold, CommonBreathPhase::Exhale] {
+        let (mut r, base_frame, base_ns) = calibrated_inhale_runtime();
+        let mut driver =
+            BreathCompositionDriver::new(crate::breath_composition_driver::tests::settings());
+        setup_frame(&mut driver, r.output(base_ns), base_ns, 0.2);
+        assert!((driver.value01() - 0.3).abs() < 0.000_001);
+        let mut final_tick = 0;
+        let mut final_volume = 0.2;
+        // Several valid sensor callbacks can confirm a new state before the
+        // renderer polls. A rejected final callback must not erase that state.
+        for tick in 1..=30 {
+            let now = base_ns + tick * 40_000_000;
+            let volume = if replacement == CommonBreathPhase::Hold {
+                0.2
+            } else {
+                0.2 - tick as f64 / 200.0
+            };
+            r.observe_clock(7, base_frame + tick * 1764, now, true);
+            r.observe_acc_with_source(100_000_000_000 + now, now, now, vector(volume));
+            if r.phase == replacement {
+                final_tick = tick;
+                final_volume = volume;
+                break;
+            }
+        }
+        assert!(
+            final_tick > 0,
+            "real classifier must confirm {replacement:?}"
+        );
+        let tail_ns = base_ns + final_tick * 40_000_000 + 5_000_000;
+        let tail_frame = base_frame + (tail_ns - base_ns) * 44100 / 1_000_000_000;
+        r.observe_clock(7, tail_frame, tail_ns, true);
+        r.observe_acc_with_source(
+            100_000_000_000 + tail_ns,
+            tail_ns,
+            tail_ns,
+            [f32::NAN, 0.0, 1000.0],
+        );
+        assert!(!r.core.snapshot(tail_ns).ready);
+        assert_eq!(r.phase, CommonBreathPhase::Unknown);
+        assert!(matches!(r.output(tail_ns), SetupDriverOutput::PolarTilt {
+            confirmed_phase: Some(phase), availability: SetupSampleAvailability::SampleUnavailable, ..
+        } if phase == replacement));
+        let mut first_render =
+            BreathCompositionDriver::new(crate::breath_composition_driver::tests::settings());
+        setup_frame(&mut first_render, r.output(tail_ns), tail_ns, 0.1);
+        let first_expected = if replacement == CommonBreathPhase::Hold {
+            0.2
+        } else {
+            0.175
+        };
+        assert!(
+            (first_render.value01() - first_expected).abs() < 0.000_001,
+            "a first render must accept a valid confirmation followed by an invalid tail"
+        );
+        setup_frame(&mut driver, r.output(tail_ns), tail_ns, 0.1);
+        let expected = if replacement == CommonBreathPhase::Hold {
+            0.3
+        } else {
+            0.275
+        };
+        assert!(
+            (driver.value01() - expected).abs() < 0.000_001,
+            "masked batch tail must apply newest confirmed {replacement:?}, value={}, marker={}",
+            driver.value01(),
+            driver.marker_fields()
+        );
+
+        // The first settled valid callback only primes classification. It also
+        // cannot replace the newer confirmed sensor state with render history.
+        for tick in 1..=5 {
+            let now = tail_ns + tick * 40_000_000;
+            r.observe_clock(7, tail_frame + tick * 1764, now, true);
+            r.observe_acc_with_source(100_000_000_000 + now, now, now, vector(final_volume));
+        }
+        let now = tail_ns + 200_000_000;
+        assert_eq!(r.phase, CommonBreathPhase::Unknown);
+        assert!(r.core.snapshot(now).ready);
+        assert!(matches!(r.output(now), SetupDriverOutput::PolarTilt {
+            confirmed_phase: Some(phase), availability: SetupSampleAvailability::PhaseUnconfirmed, ..
+        } if phase == replacement));
+        setup_frame(&mut driver, r.output(now), now, 0.1);
+        let expected = if replacement == CommonBreathPhase::Hold {
+            0.3
+        } else {
+            0.25
+        };
+        assert!((driver.value01() - expected).abs() < 0.000_001);
+    }
+}
