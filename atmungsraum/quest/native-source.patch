+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.io.PrintWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Real Java owner <-> real Rust Runtime over a test-only stdio boundary. */
+public final class BreathingSetupAudioNativeTest {
+    public static void main(String[] args) throws Exception {
+        String json = new String(Files.readAllBytes(Paths.get(args[0])), StandardCharsets.UTF_8);
+        String executable = args[1];
+        pretrainedModesUseTheRealAudioOwner(json, executable);
+        stalledRetryAndFullNewWindow(json, executable);
+        blockedPreparationCannotPlayAfterNativeTimeout(json, executable);
+        hungPollRemainsObservableAndQueuedRetryCannotRunLater(json, executable);
+        stoppedAndExceptionedPlayersRemainExplicitlyRecoverable(json, executable);
+        terminalRetirementCannotPlayReturningPreparation(json, executable);
+        System.out.println("BreathingSetupAudioNativeTest PASS (real Rust admission/ledger, 6 groups)");
+    }
+
+    private static void pretrainedModesUseTheRealAudioOwner(String json, String executable) throws Exception {
+        for (String mode : new String[]{"polar-fixed", "polar-adaptive"}) {
+            try (Fixture f = new Fixture(json, executable)) {
+                JSONObject select = f.request(mode);
+                check("confirmed".equals(BreathingSetupAudio.command(select).getString("state")), "fitted mode accepted without a participant window");
+                check(f.player.plays == 1 && f.player.prepares == 1, "accepted fitted mode starts the exact parked PCM owner once");
+                for (int tick = 1; tick <= 30; tick++) { f.advance(tick * 1764, 40000000L); f.acc(0.5); }
+                check(f.state().getBoolean("ready") && "idle".equals(f.state().getString("calibration")), "fitted state uses fresh input without participant fit");
+                BreathingSetupAudio.command(select);
+                check(f.player.plays == 1 && f.player.prepares == 1, "original fitted selection receipt cannot replay PCM");
+                long old = f.state().getLong("g");
+                f.clock.now += 300000000L;
+                JSONObject retry = f.request(mode);
+                check("pending".equals(BreathingSetupAudio.command(retry).getString("state")), "explicit fitted retry uses audio recovery");
+                check(f.state().getLong("g") > old && f.player.prepares == 2 && f.player.plays == 2, "fitted recovery replaces one retired player generation");
+                f.advance(1764, 40000000L); f.acc(0.5);
+                check("confirmed".equals(f.receipt(retry).getString("state")), "fresh post-claim mapped H10 completes fitted recovery");
+                check("idle".equals(f.state().getString("calibration")), "fitted recovery does not start participant training");
+                check(f.state().getString("input").equals("polar-fixed".equals(mode) ? "polar-tilt-fixed" : "polar-tilt-adaptive"), "original mode survives recovery");
+            }
+        }
+    }
+
+    private static void stalledRetryAndFullNewWindow(String json, String executable) throws Exception {
+        try (Fixture f = new Fixture(json, executable)) {
+            f.start(); f.advance(882, 20000000L);
+            long oldGeneration = f.state().getLong("g");
+            long sequence = f.state().getJSONObject("audio_clock").getLong("poll_sequence");
+            for (int i = 0; i < 14; i++) f.advance(882, 20000000L);
+            JSONObject stalled = f.state(); JSONObject diagnostics = stalled.getJSONObject("audio_clock");
+            check("clock_stalled".equals(stalled.getString("failure")) && !stalled.getBoolean("clock_valid"), "actual constant playing head fails the attempt");
+            check(diagnostics.getLong("poll_sequence") == sequence + 14 && diagnostics.getLong("dispatch_age_ns") == 0,
+                "poll and dispatch remain live while actual playback progress stalls");
+            check(diagnostics.getLong("advance_age_ns") == 280000000L && diagnostics.getLong("raw_head") == 882
+                && diagnostics.getBoolean("actual_playing") && diagnostics.getBoolean("intent_playing"), "intent and actual advancement are separate evidence");
+            check(!diagnostics.getBoolean("timestamp_available"), "unavailable platform timestamps do not synthesize frames");
+            check(stalled.getBoolean("audio_recovery_available"), "native preparation capability exposes explicit recovery");
+            JSONObject retry = f.request("calibrate");
+            JSONObject pending = BreathingSetupAudio.command(retry);
+            check("pending".equals(pending.getString("state")), "explicit retry is admitted pending rather than permanently clock-stale");
+            long generation = f.state().getLong("g");
+            check(generation > oldGeneration && f.player.prepares == 2 && f.player.plays == 2 && f.player.releases == 1,
+                "one accepted claim retires the old actual track and prepares/plays one fresh generation");
+            check(!f.state().getBoolean("clock_valid") && !f.state().getBoolean("ready"), "first frame zero alone cannot establish a fresh advancing clock");
+            check(f.receipt(retry).getLong("recovery_generation") == generation, "native receipt owns cross-generation provenance");
+            BreathingSetupAudio.command(retry);
+            check(f.player.prepares == 2 && f.player.plays == 2, "duplicate original pending command cannot replay its effect");
+            f.bridge.observe(oldGeneration, 1000000, f.clock.now, true);
+            check(f.state().getLong("position_frames") == 0 && f.state().getLong("g") == generation, "old generation callbacks cannot contaminate the fresh head");
+            long base = f.clock.now;
+            f.advance(882, 20000000L);
+            check("pending".equals(f.receipt(retry).getString("state")), "forward audio alone cannot substitute for fresh required input");
+            f.acc(0.0);
+            check("confirmed".equals(f.receipt(retry).getString("state")), "fresh mapped post-claim input completes the original native receipt");
+            check(f.state().getLong("attempt") == 2 && f.state().getLong("completed_frames") == 0
+                && f.state().getLong("target_frames") == 1411200, "new full two-cycle attempt starts with no retired training");
+            for (int frame = 1764; frame <= 2116800; frame += 1764) {
+                f.clock.now = base + frame * 1000000000L / 44100L; f.player.head = frame; f.owner.observe();
+                double t = (frame % 705600) / 44100.0;
+                double v = t < 4 ? t / 4 : t < 8 ? 1 : t < 12 ? (12 - t) / 4 : 0;
+                f.acc(v);
+                if (frame == 1411200) check(!"ready".equals(f.state().getString("calibration")), "one new cycle cannot salvage the failed attempt");
+            }
+            check("ready".equals(f.state().getString("calibration")) && f.state().getBoolean("ready"), "only complete fresh 32 s collection establishes the learned model");
+            BreathingSetupAudio.command(retry);
+            check(f.player.prepares == 2 && f.player.plays == 2, "late duplicate confirmed recovery cannot play again");
+            JSONObject healthy = BreathingSetupAudio.command(f.request("calibrate"));
+            check("confirmed".equals(healthy.getString("state")) && !healthy.has("recovery_generation")
+                && f.state().getLong("g") == generation && f.player.prepares == 2 && f.player.plays == 2,
+                "ordinary healthy retry preserves the same loop and receipt shape");
+        }
+    }
+
+    private static void blockedPreparationCannotPlayAfterNativeTimeout(String json, String executable) throws Exception {
+        try (Fixture f = new Fixture(json, executable)) {
+            f.start(); f.advance(882, 20000000L); f.clock.now += 300000000L;
+            JSONObject retry = f.request("calibrate");
+            f.player.prepareEntered = new CountDownLatch(1); f.player.prepareRelease = new CountDownLatch(1);
+            ExecutorService caller = Executors.newSingleThreadExecutor();
+            try {
+                Future<JSONObject> result = caller.submit(() -> BreathingSetupAudio.command(retry));
+                check(f.player.prepareEntered.await(2, TimeUnit.SECONDS), "recovery entered real owner preparation");
+                JSONObject uncertain = result.get(3, TimeUnit.SECONDS);
+                check("breathing-loop-command-outcome-uncertain".equals(uncertain.optString("reason")), "already-admitted blocked prepare retains uncertain outcome");
+                f.clock.now += 2100000000L;
+                JSONObject status = f.state();
+                check(status.isNull("recovery") && !status.getBoolean("ready"), "status bounds pending lifetime independently of blocked player monitor");
+                check("audio-recovery-timeout".equals(f.receipt(retry).getString("reason")), "the original native receipt resolves failed after deadline");
+                f.player.prepareRelease.countDown(); f.drain();
+                check(f.player.plays == 1 && f.player.releases == 2 && !f.player.playing,
+                    "a prepared track returning after token retirement is released and never receives late PLAY");
+                JSONObject next = BreathingSetupAudio.command(f.request("calibrate"));
+                check("pending".equals(next.getString("state")) && f.player.plays == 2, "new current-CAS explicit recovery remains possible after bounded failure");
+            } finally { f.player.prepareRelease.countDown(); caller.shutdownNow(); }
+        }
+    }
+
+    private static void hungPollRemainsObservableAndQueuedRetryCannotRunLater(String json, String executable) throws Exception {
+        try (Fixture f = new Fixture(json, executable)) {
+            f.start(); f.advance(882, 20000000L);
+            f.player.headEntered = new CountDownLatch(1); f.player.headRelease = new CountDownLatch(1);
+            f.worker().execute(() -> f.owner.observe());
+            try {
+                check(f.player.headEntered.await(2, TimeUnit.SECONDS), "actual poll entered a blocked head call");
+                f.clock.now += 400000000L;
+                JSONObject state = f.state(); JSONObject clock = state.getJSONObject("audio_clock");
+                check(clock.getLong("poll_started_ns") >= clock.getLong("poll_ended_ns") && clock.getLong("poll_age_ns") == 400000000L,
+                    "hung poll remains visible without acquiring its held player monitor");
+                check("observation-stale".equals(state.getJSONObject("clock").getString("reason")), "native accepted clock shows publication silence separately from raw fixed-head polling");
+                JSONObject cancelled = BreathingSetupAudio.command(f.request("calibrate"));
+                check("rejected".equals(cancelled.optString("state")), "retry queued behind hung poll is definitely cancelled before admission");
+            } finally { f.player.headRelease.countDown(); }
+            f.drain();
+            check(f.player.prepares == 1 && f.player.plays == 1, "cancelled queued recovery cannot start after poll unblocks");
+        }
+    }
+
+    private static void stoppedAndExceptionedPlayersRemainExplicitlyRecoverable(String json, String executable) throws Exception {
+        for (int fault = 0; fault < 3; fault++) {
+            try (Fixture f = new Fixture(json, executable)) {
+                f.start(); f.advance(882, 20000000L);
+                if (fault == 1) f.player.headFailure = new IllegalStateException("head-unavailable");
+                else if (fault == 2) f.bridge.dispatchFailure = new IllegalStateException("clock-dispatch-unavailable");
+                else f.player.playing = false;
+                f.clock.now += 20000000L; f.owner.observe();
+                JSONObject state = f.state();
+                check(!state.getBoolean("ready") && !state.getBoolean("clock_valid"), "stopped or exceptioned poll cannot retain audio readiness");
+                check(state.getJSONObject("audio_clock").getString("error").contains(fault == 1 ? "head-unavailable" : fault == 2 ? "clock-dispatch-unavailable" : "player-stopped"),
+                    "diagnostics retain the meaningful owner exception");
+                if (fault == 2) check(state.getJSONObject("audio_clock").getLong("dispatch_age_ns") == 20000000L
+                    && state.getJSONObject("audio_clock").getLong("poll_age_ns") == 0,
