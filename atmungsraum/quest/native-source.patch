diff --git a/tools/lib/meta_platform_packaging.py b/tools/lib/meta_platform_packaging.py
new file mode 100644
index 00000000..b94a55a8
--- /dev/null
+++ b/tools/lib/meta_platform_packaging.py
@@ -0,0 +1,252 @@
+"""Explicit external SDK207 closure. No SDK discovery, downloads or device calls."""
+import argparse
+import hashlib
+import json
+import pathlib
+import re
+import struct
+import sys
+import zipfile
+
+sys.dont_write_bytecode = True
+ARCHIVE_SHA256 = '00c4035dce5cda094eaf0272ad70f2deda389c32bf0d3eacc12135c16d385401'
+LOADER = 'libovrplatformloader.so'
+JNI = 'librusty_quest_meta_platform.so'
+JAVA_PATH = 'apps/native-renderer-android/src/meta-platform/java/io/github/mesmerprism/rustyquest/native_renderer/NativeRendererMetaPlatformTransport.java'
+SOURCE_PATHS = [JAVA_PATH] + ['apps/native-renderer-android/meta-platform/' + name for name in
+    ['meta_platform_transport.hpp', 'meta_platform_transport.cpp', 'meta_platform_jni.cpp']] + [
+    'apps/native-renderer-android/src/main/java/io/github/mesmerprism/rustyquest/native_renderer/'+name+'.java'
+    for name in ['NativeRendererMetaUpdate','NativeRendererMetaUpdateCoordinator','NativeRendererMetaUpdateService','NativeRendererMetaUpdateSdk','NativeRendererMetaUpdatePolicy','NativeRendererMetaUpdateHelper','NativeRendererSelfKioskApplication']]
+PREFIX = 'io.github.mesmerprism.rustyquest.native_renderer.NativeRendererMetaPlatformTransport'
+
+
+def need(condition, reason):
+    if not condition:
+        raise ValueError(reason)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode('utf-8')
+
+
+def bound_bytes(path, expected, limit):
+    need(isinstance(expected, str) and re.fullmatch('[0-9a-f]{64}', expected), 'artifact hash must be lowercase SHA256')
+    file = pathlib.Path(path)
+    need(file.is_file() and not file.is_symlink(), 'artifact file missing or linked')
+    size = file.stat().st_size
+    need(0 < size <= limit, 'artifact size outside bounds')
+    data = file.read_bytes()
+    need(len(data) == size and digest(data) == expected, 'artifact hash mismatch')
+    return data
+
+
+def elf(data, soname, dependencies):
+    need(len(data) >= 64 and data[:7] == b'\x7fELF\x02\x01\x01', 'ELF64 little-endian required')
+
+    def unpack(fmt, offset):
+        need(0 <= offset <= len(data)-struct.calcsize(fmt), 'ELF bounds')
+        return struct.unpack_from(fmt, data, offset)
+
+    kind, machine, version = unpack('<HHI', 16)
+    need((kind, machine, version) == (3, 183, 1), 'ELF AArch64 DYN required')
+    phoff, = unpack('<Q', 32)
+    ehsize, phsize, count = unpack('<HHH', 52)
+    need(ehsize == 64 and phsize == 56 and 0 < count <= 128, 'ELF program headers')
+    loads, dynamic = [], []
+    for index in range(count):
+        typ, flags, offset, address, _, size, memory, alignment = unpack('<IIQQQQQQ', phoff+index*56)
+        need(offset <= len(data) and size <= len(data)-offset, 'ELF segment bounds')
+        if typ == 1:
+            need(memory >= size and 16384 <= alignment <= 1073741824 and
+                 alignment & (alignment-1) == 0 and offset % alignment == address % alignment, 'ELF requires 16KiB LOAD alignment')
+            loads.append((offset, address, size, alignment))
+        elif typ == 2:
+            dynamic.append((offset, size))
+        elif typ == 0x6474e551:
+            need(not flags & 1, 'ELF executable stack forbidden')
+    need(loads and len(dynamic) == 1, 'ELF LOAD/dynamic closure')
+    offset, size = dynamic[0]
+    need(0 < size <= 65536 and size % 16 == 0, 'ELF dynamic bounds')
+    tags, needed, ended = {}, [], False
+    for cursor in range(offset, offset+size, 16):
+        tag, value = unpack('<QQ', cursor)
+        if tag == 0:
+            ended = True
+            break
+        if tag == 1:
+            needed.append(value)
+        elif tag in (5, 10, 14):
+            need(tag not in tags, 'ELF duplicate dynamic identity')
+            tags[tag] = value
+        elif tag in (15, 29):
+            raise ValueError('ELF RPATH/RUNPATH forbidden')
+    need(ended and all(tag in tags for tag in (5, 10, 14)) and 0 < tags[10] <= 1048576, 'ELF strings missing')
+    matches = [(off+tags[5]-addr, tags[10]) for off, addr, length, _ in loads
+               if addr <= tags[5] and tags[5]-addr+tags[10] <= length]
+    need(len(matches) == 1, 'ELF strings must be uniquely file backed')
+    base, length = matches[0]
+
+    def string(index):
+        need(index < length, 'ELF string offset')
+        end = data.find(b'\0', base+index, base+length)
+        need(base+index < end <= base+index+128, 'ELF bounded string')
+        value = data[base+index:end].decode('ascii')
+        need(re.fullmatch(r'lib[A-Za-z0-9_+.\-]+\.so', value), 'ELF dependency path')
+        return value
+
+    actual_dependencies = sorted(string(index) for index in needed)
+    need(string(tags[14]) == soname and actual_dependencies == sorted(dependencies), 'ELF SONAME/dependencies differ')
+    return dict(class_name='ELF64', machine='AArch64', soname=soname, dependencies=actual_dependencies,
+                load_alignments_bytes=sorted(set(row[3] for row in loads)))
+
+
+def header_inventory(root):
+    directory = pathlib.Path(root) / 'Include'
+    need(directory.is_dir() and not directory.is_symlink(), 'explicit SDK Include directory missing')
+    files = sorted(directory.rglob('*'))
+    need(not any(file.is_symlink() for file in files), 'SDK header links forbidden')
+    headers = [file for file in files if file.is_file()]
+    need(1 <= len(headers) <= 2048 and all(file.suffix == '.h' for file in headers), 'SDK header inventory differs')
+    records = []
+    for file in headers:
+        data = file.read_bytes()
+        need(0 < len(data) <= 1048576, 'SDK header outside bounds')
+        records.append(dict(path=file.relative_to(directory).as_posix(), sha256=digest(data), bytes=len(data)))
+    records.sort(key=lambda row: row['path'])
+    return records, digest(canonical(records))
+
+
+def select(enabled, app_id, sdk_root, headers_sha, loader_sha, archive_sha, policy_url='', helper=False):
+    if not enabled:
+        need(not any([app_id, sdk_root, headers_sha, loader_sha, archive_sha, policy_url, helper]), 'unselected Meta SDK inputs')
+        return dict(enabled=False, fingerprint='disabled')
+    need(isinstance(app_id, str) and re.fullmatch('[1-9][0-9]{0,19}', app_id), 'Meta app ID must be canonical positive decimal')
+    need(policy_url == 'https://viscereality.org/atmungsraum/quest-release.json' and isinstance(helper, bool), 'composition policy/helper selection invalid')
+    need(sdk_root and pathlib.Path(sdk_root).is_absolute(), 'explicit absolute SDK root required')
+    need(archive_sha == ARCHIVE_SHA256, 'SDK207 archive provenance differs')
+    records, actual = header_inventory(sdk_root)
+    need(re.fullmatch('[0-9a-f]{64}', headers_sha or '') and actual == headers_sha, 'SDK header inventory hash mismatch')
+    version = (pathlib.Path(sdk_root) / 'Include/OVR_PlatformVersion.h').read_text()
+    for name, value in [('PRODUCT', 1), ('MAJOR', 1), ('MINOR', 207), ('PATCH', 0), ('BUILD_NUMBER', 0)]:
+        macro = 'PLATFORM_'+name if name == 'BUILD_NUMBER' else 'PLATFORM_'+name+'_VERSION'
+        need(re.search(r'^#define\s+'+macro+r'\s+'+str(value)+r'\b', version, re.M), 'SDK version must be 1.207.0.0')
+    library = pathlib.Path(sdk_root) / 'Android/libs/arm64-v8a' / LOADER
+    loader_bytes = bound_bytes(library, loader_sha, 67108864)
+    loader_elf = elf(loader_bytes, LOADER, ['libc.so', 'libdl.so', 'liblog.so'])
+    archive_path = pathlib.Path(sdk_root) / 'oculus-platform-sdk-207.0.zip'
+    bound_bytes(archive_path, archive_sha, 268435456)
+    notices = []
+    with zipfile.ZipFile(archive_path) as archive:
+        need(len(archive.namelist()) == len(set(archive.namelist())), 'SDK archive duplicate entry')
+        need(sorted(row['path'] for row in records) == sorted(name[len('Include/'):] for name in archive.namelist()
+            if name.startswith('Include/') and not name.endswith('/')), 'SDK archive header closure differs')
+        for row in records:
+            need(digest(archive.read('Include/'+row['path'])) == row['sha256'], 'SDK header differs from official archive')
+        need(digest(archive.read('Android/libs/arm64-v8a/'+LOADER)) == loader_sha, 'SDK loader differs from official archive')
+        for name, destination in [('LICENSE.txt', 'license.txt'), ('THIRD_PARTY_NOTICES.txt', 'third-party-notices.txt')]:
+            file = pathlib.Path(sdk_root) / name
+            data = file.read_bytes()
+            need(0 < len(data) < 1048576 and data == archive.read(name), 'SDK license/notice differs from official archive')
+            notices.append(dict(source_path=str(file.resolve()), sha256=digest(data), bytes=len(data), apk_path='assets/meta-platform/'+destination))
+    repo = pathlib.Path(__file__).resolve().parents[2]
+    sources = [dict(path=path, sha256=digest((repo/path).read_bytes())) for path in SOURCE_PATHS]
+    notice = repo / 'docs/META_PLATFORM_UPDATE.md'
+    result = dict(enabled=True, sdk_version='1.207.0.0', app_id=app_id, policy_url=policy_url, helper_enabled=helper,
+        archive_sha256=archive_sha, headers_sha256=headers_sha, headers=records,
+        sources=sources, notice_sha256=digest(notice.read_bytes()),
+        loader=dict(source_path=str(library.resolve()), sha256=loader_sha, bytes=len(loader_bytes), apk_path='lib/arm64-v8a/'+LOADER),
+        notices=notices, elf=loader_elf, runtime_verified=False)
+    # Machine paths are evidence location, never identity.
+    identity = dict(result)
+    identity['loader'] = {key: value for key, value in result['loader'].items() if key != 'source_path'}
+    identity['notices'] = [{key: value for key, value in row.items() if key != 'source_path'} for row in notices]
+    result['fingerprint'] = digest(canonical(identity))
+    return result
+
+
+def verify_message_abi(classes):
+    signature = '<init>(JIIILjava/lang/String;Ljava/lang/String;Ljava/lang/String;JJIIILjava/lang/String;)V'
+    need(signature in classes.get(PREFIX+'$Message', {}).get('methods', {}), 'APK transport message constructor/error provenance ABI missing')
+
+
+def verify_queued_exit_abi(classes):
+    owner = 'io.github.mesmerprism.rustyquest.native_renderer.NativeRendererSelfKioskApplication'
+    methods = classes.get(owner, {}).get('methods', {})
+    need(all(signature in methods for signature in ['handoffForMetaInstall(Landroid/app/Activity;J)Z',
+        'exitForQueuedMetaUpdate(Landroid/app/Activity;JJJJ)Z']), 'APK selected helper queued exit/latch ABI missing')
+
+
+def verify_apk(selection, apk):
+    from android_component_closure import inspect_apk
+    classes, dex = inspect_apk(apk)
+    with zipfile.ZipFile(apk) as archive:
+        names = archive.namelist()
+        need(len(names) == len(set(names)), 'APK duplicate entries')
+        sdk_entries = [name for name in names if not name.endswith('/') and re.search(r'ovrplatform|rusty_quest_meta_platform|^assets/meta-platform/', name, re.I)]
+        sdk_classes = [name for name in classes if name.startswith(PREFIX)]
+        need(not any(name.startswith(('com.oculus.platform.', 'com.meta.platform.')) for name in classes), 'unexpected SDK Java/Kotlin closure')
+        if not selection['enabled']:
+            need(not sdk_entries and not sdk_classes, 'unselected SDK artifact/class in APK')
+            return dict(enabled=False, dex=dex)
+        expected_entries = ['lib/arm64-v8a/'+LOADER, 'lib/arm64-v8a/'+JNI] + [row['apk_path'] for row in selection['notices']]
+        need(sorted(sdk_entries) == sorted(expected_entries), 'APK Meta native closure differs')
+        need(sorted(sdk_classes) == sorted([PREFIX, PREFIX+'$Message']), 'APK transport DEX definitions differ')
+        verify_message_abi(classes)
+        if selection['helper_enabled']:
+            verify_queued_exit_abi(classes)
+        required = ['<init>()V', 'initialize(Landroid/app/Activity;Ljava/lang/String;)J', 'getVersion()J',
+            'startDownload()J', 'checkProgress()J', 'installUpdateAndRelaunch()J', 'cancelDownload()J', 'poll()L'+PREFIX.replace('.', '/')+'$Message;', 'close()V',
+            'beginAttempt(J)Z', 'retireAttempt(J)V', 'nativeBeginAttempt(J)Z', 'nativeRetireAttempt(J)V',
+            'nativeRequest(JILandroid/app/Activity;Ljava/lang/String;)J', 'nativePoll()L'+PREFIX.replace('.', '/')+'$Message;', 'nativeClose()V']
+        need(all(method in classes[PREFIX]['methods'] for method in required), 'APK transport DEX methods missing')
+        native = []
+        for key in ['loader', 'jni']:
+            row = selection[key]
+            data = archive.read(row['apk_path'])
+            need(len(data) == row['bytes'] and digest(data) == row['sha256'], 'APK Meta artifact hash differs')
+            native.append(dict(apk_path=row['apk_path'], sha256=row['sha256'], bytes=row['bytes']))
+        for row in selection['notices']:
+            data = archive.read(row['apk_path'])
+            need(len(data) == row['bytes'] and digest(data) == row['sha256'], 'APK SDK notice hash differs')
+        return dict(enabled=True, fingerprint=selection['fingerprint'], apk_sha256=digest(pathlib.Path(apk).read_bytes()), dex=dex, native=native,
+                    runtime_verified=False)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('command', choices=['headers', 'select', 'verify-apk', 'elf-jni'])
+    parser.add_argument('--sdk-root', default='')
+    parser.add_argument('--enabled', action='store_true')
+    parser.add_argument('--app-id', default='')
+    parser.add_argument('--headers-sha256', default='')
+    parser.add_argument('--loader-sha256', default='')
+    parser.add_argument('--archive-sha256', default='')
+    parser.add_argument('--policy-url', default='')
+    parser.add_argument('--helper', action='store_true')
+    parser.add_argument('--selection')
+    parser.add_argument('--apk')
+    parser.add_argument('--library')
+    args = parser.parse_args()
+    if args.command == 'headers':
+        records, fingerprint = header_inventory(args.sdk_root)
+        value = dict(headers_sha256=fingerprint, headers=records)
+    elif args.command == 'select':
+        value = select(args.enabled, args.app_id, args.sdk_root, args.headers_sha256, args.loader_sha256, args.archive_sha256,args.policy_url,args.helper)
+    elif args.command == 'verify-apk':
+        value = verify_apk(json.loads(pathlib.Path(args.selection).read_text(encoding='utf-8-sig')), args.apk)
+    else:
+        data = pathlib.Path(args.library).read_bytes()
+        value = elf(data, JNI, ['libovrplatformloader.so', 'libc.so', 'libm.so', 'libdl.so'])
+    print(json.dumps(value, separators=(',', ':')))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, OSError, zipfile.BadZipFile) as error:
+        print('Meta Platform verification: '+str(error), file=sys.stderr)
+        sys.exit(2)
