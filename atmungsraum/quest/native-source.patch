+#[cfg(target_os = "android")]
+fn notify_meta_update_first_frame(
+    app: &android_activity::AndroidApp,
+    epoch: u64,
+    generation: u64,
+) -> Result<(), String> {
+    use jni::{
+        jni_sig, jni_str,
+        objects::{JClass, JClassLoader, JObject, JValue},
+        JavaVM,
+    };
+    let vm = unsafe { JavaVM::from_raw(app.vm_as_ptr().cast()) };
+    let raw = app.activity_as_ptr() as jni::sys::jobject;
+    vm.attach_current_thread(|env| -> jni::errors::Result<()> {
+        let activity = unsafe { env.as_cast_raw::<JObject>(&raw)? };
+        let loader = env
+            .call_method(
+                &activity,
+                jni_str!("getClassLoader"),
+                jni_sig!("()Ljava/lang/ClassLoader;"),
+                &[],
+            )?
+            .l()?;
+        let loader: JClassLoader = env.cast_local::<JClassLoader>(loader)?;
+        let name = env.new_string(
+            "io.github.mesmerprism.rustyquest.native_renderer.NativeRendererMetaUpdate",
+        )?;
+        let owner = JClass::for_name_with_loader(env, name, true, loader)?;
+        env.call_static_method(
+            owner,
+            jni_str!("firstSubmittedFrame"),
+            jni_sig!("(Landroid/app/Activity;JJ)V"),
+            &[
+                JValue::Object(&activity),
+                JValue::Long(epoch as i64),
+                JValue::Long(generation as i64),
+            ],
+        )?;
+        Ok(())
+    })
+    .map_err(|error| format!("Meta update first-frame observation failed: {error}"))
+}
