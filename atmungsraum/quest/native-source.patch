+//! Display-only observation of the radius applied to a visible renderer frame.
+//! The clock boundary is independent from both PCM progress and recording admission.
+use crate::experiment_breathing_setup_runtime::{
+    invalidate_renderer_radius, observe_renderer_radius, SetupRendererLineage,
+};
+
+pub(crate) struct RendererRadiusFrame {
+    pub(crate) lineage: Option<SetupRendererLineage>,
+    pub(crate) ready: bool,
+    pub(crate) visible: bool,
+    pub(crate) parameter_source: &'static str,
+    pub(crate) progress01: f32,
+    pub(crate) radius_m: f32,
+    pub(crate) frame: u64,
+    pub(crate) render_generation: u64,
+    pub(crate) settings_revision: u64,
+}
+
+/// The real renderer calls this same gate with Android CLOCK_BOOTTIME. Host
+/// conformance substitutes only the kernel observation boundary, never an audio schedule.
+pub(crate) fn observe_frame(frame: RendererRadiusFrame, clock: impl FnOnce() -> Option<u64>) {
+    if frame.ready
+        && frame.visible
+        && matches!(
+            frame.parameter_source,
+            "particle-visual-profile-driver-slot-0" | "experiment-session-driver-slot-0"
+        )
+    {
+        if let Some(observed_ns) = clock().filter(|value| *value > 0) {
+            observe_renderer_radius(
+                frame.lineage,
+                frame.progress01,
+                frame.radius_m,
+                frame.frame,
+                observed_ns,
+                frame.render_generation,
+                frame.settings_revision,
+            );
+            return;
+        }
+    }
+    invalidate_renderer_radius(frame.render_generation);
+}
