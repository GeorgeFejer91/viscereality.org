+fn apply_checkpoint_lengths(
+    pins: &mut [Pinned],
+    terminal: &Value,
+    details: &Value,
+) -> Result<(), String> {
+    if terminal["stop_reason"] != "interrupted-recovery"
+        || details["v"] != 1
+        || details.as_object().is_none_or(|details| details.len() != 4)
+        || details["checkpoint_ordinal"]
+            .as_u64()
+            .is_none_or(|ordinal| ordinal == 0)
+        || !valid_digest(&details["checkpoint_sha256"])
+        || details["stream_sha256"]
+            .as_object()
+            .is_none_or(|hashes| hashes.len() != SESSION_STREAM_FILES.len())
+    {
+        return Err(denied());
+    }
+    for pin in pins
+        .iter_mut()
+        .filter(|pin| SESSION_STREAM_FILES.contains(&pin.name.as_str()))
+    {
+        pin.length = terminal["durable_stream_lengths"][&pin.name]
+            .as_u64()
+            .filter(|bytes| *bytes <= pin.stamp.len)
+            .ok_or_else(denied)?;
+        if !valid_digest(&details["stream_sha256"][&pin.name]) {
+            return Err(denied());
+        }
+    }
+    Ok(())
+}
