diff --git a/apps/native-renderer-android/tests/java/io/github/mesmerprism/rustyquest/native_renderer/ScenarioAudioPackageTest.java b/apps/native-renderer-android/tests/java/io/github/mesmerprism/rustyquest/native_renderer/ScenarioAudioPackageTest.java
new file mode 100644
index 00000000..bbbb387c
--- /dev/null
+++ b/apps/native-renderer-android/tests/java/io/github/mesmerprism/rustyquest/native_renderer/ScenarioAudioPackageTest.java
@@ -0,0 +1,107 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public final class ScenarioAudioPackageTest {
+    private static void check(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+
+    private static final class Receipt extends OutputStream {
+        long bytes;
+        boolean nonzeroPcm;
+
+        @Override public void write(int value) {
+            if (bytes >= 44 && (value & 255) != 0) nonzeroPcm = true;
+            bytes++;
+        }
+
+        @Override public void write(byte[] data, int offset, int size) {
+            for (int index = offset; index < offset + size; index++) write(data[index]);
+        }
+    }
+
+    private static void verifyAuthored(Path root, String catalogHash, ScenarioAudioPackage catalog) throws Exception {
+        String scenario = "free-exploration";
+        String media = "assets/audio/playground/" + scenario + ".mp3";
+        check(catalog.ids().contains(scenario), "authored exploration is discoverable");
+        try (java.io.ByteArrayOutputStream output = new java.io.ByteArrayOutputStream()) {
+            check(catalog.writeEncodedTrack(scenario, output) == 19_715_793, "original exploration frame count");
+            check(java.util.Arrays.equals(Files.readAllBytes(root.resolve(media)), output.toByteArray()),
+                "headset media input preserves the exact recording");
+        }
+        try {
+            catalog.writeWave(scenario, OutputStream.nullOutputStream());
+            throw new AssertionError("exploration rendered as a WAV instead of the verified MP3");
+        } catch (IOException expected) { }
+
+        for (String damagedPath : new String[] { media, "assets/audio/playground/calibration-prelude.mp3",
+                "assets/audio/main-study/de/probe-instructions.wav", "assets/audio/box-breathing/de/soft-v2/outro.wav" }) {
+            ScenarioAudioPackage damaged = ScenarioAudioPackage.open(path -> {
+                if (!path.equals(damagedPath)) return Files.newInputStream(root.resolve(path));
+                byte[] bytes = Files.readAllBytes(root.resolve(path));
+                bytes[bytes.length / 2] ^= 1;
+                return new ByteArrayInputStream(bytes);
+            }, catalogHash);
+            try {
+                damaged.verifyAll();
+                throw new AssertionError("accepted damaged authored media: " + damagedPath);
+            } catch (IOException expected) { }
+        }
+        System.out.println("PASS: authored catalog, exact encoded input and damaged media rejection.");
+    }
+
+    public static void main(String[] args) throws Exception {
+        Path root = Path.of(args[0]).toAbsolutePath();
+        String catalogHash = args[1];
+        ScenarioAudioPackage catalog = ScenarioAudioPackage.open(
+            path -> Files.newInputStream(root.resolve(path)), catalogHash
+        );
+        catalog.verifyAll();
+        if (args.length == 3 && "authored".equals(args[2])) {
+            verifyAuthored(root, catalogHash, catalog);
+            return;
+        }
+        org.json.JSONObject mainPlan = new org.json.JSONObject(catalog.recordingPlan("haupt-15"));
+        check(mainPlan.getInt("total_frames") == 39_690_000, "participant plan duration");
+        org.json.JSONArray phase = mainPlan.getJSONArray("phases").getJSONArray(1);
+        check(phase.getInt(0) == 1_146_600 && "calibration".equals(phase.getString(1)), "native calibration plan");
+        check(catalog.recordingPlan("box-20") == null, "diagnostic timeline is not a participant run");
+        String[] ids = { "probe-anleitung", "probe-5", "probe-10", "probe-15", "haupt-15", "box-20" };
+        int[] seconds = { 68, 300, 600, 900, 900, 1200 };
+        for (int i = 0; i < ids.length; i++) {
+            Receipt output = new Receipt();
+            long frames = catalog.writeWave(ids[i], output);
+            check(frames == 44100L * seconds[i], "frame length for " + ids[i]);
+            check(output.bytes == 44 + 2 * frames, "WAV byte length for " + ids[i]);
+            check(!output.nonzeroPcm, "placeholder PCM for " + ids[i]);
+        }
+        try {
+            ScenarioAudioPackage.open(path -> Files.newInputStream(root.resolve(path)), "0".repeat(64));
+            throw new AssertionError("accepted wrong catalog digest");
+        } catch (IOException expected) { }
+
+        ScenarioAudioPackage damaged = ScenarioAudioPackage.open(path -> {
+            if (!path.endsWith("_instruction-1.wav")) return Files.newInputStream(root.resolve(path));
+            byte[] bytes = Files.readAllBytes(root.resolve(path));
+            bytes[44] ^= 1;
+            return new ByteArrayInputStream(bytes);
+        }, catalogHash);
+        Receipt output = new Receipt();
+        try {
+            damaged.verifyAll();
+            throw new AssertionError("accepted a damaged authored cue in preflight");
+        } catch (IOException expected) { }
+        try {
+            damaged.writeWave("haupt-15", output);
+            throw new AssertionError("accepted a damaged authored cue");
+        } catch (IOException expected) {
+            check(output.bytes == 0, "wrote playback bytes before verifying all inputs");
+        }
+        System.out.println("PASS: six native WAV renders, exact frames, silent placeholders, catalog and cue integrity.");
+    }
+}
diff --git a/docs/EXPERIMENT_BREATHING_SETUP.md b/docs/EXPERIMENT_BREATHING_SETUP.md
new file mode 100644
index 00000000..7e418239
--- /dev/null
+++ b/docs/EXPERIMENT_BREATHING_SETUP.md
@@ -0,0 +1,334 @@
+# Shared breathing setup contract
+
+This optional app-owned path uses the packaged 44,100 Hz loop. Each of inhale,
+hold-in, exhale and hold-out occupies 176,400 frames. Other products retain their
+existing input and audio selection. The downstream project's accepted design and
+project checklist remain the lifecycle owner.
+
+## Controller State startup and temporary input loss — 2026-11-17
+
+The selected experiment's fixed-orientation Controller State path starts the
+phase classifier directly. It does not collect the separate 120-frame volume
+calibration. Its assessment remains Configured with no fitted volume model;
+fresh current-generation tracked poses and a valid diagnosed phase are still
+required. Generic controller/volume selections keep their existing calibration.
+
+For the selected experiment's manual input, temporary missing, stale or rejected
+Controller/Polar observations retain the last valid breath state. Each rendered
+frame continues the bounded integrator: inhale expands, exhale contracts and
+hold stays. Reconnection, sensor/model generation changes and audio recovery do
+not snap the displayed radius to minimum. New data must pass its original
+freshness, generation and confirmation checks before replacing that diagnosis.
+Readiness remains false while input is unusable; retained visual motion grants
+no recording, calibration, main-session or update authority.
+
+A changed app instance or manual input retires its old diagnosed state and
+confirmation namespace while preserving the displayed radius until fresh data.
+Actual configuration/activation rejection retains the original fail-closed
+reset. Before the first valid diagnosis the manual path holds its radius without
+inventing a phase. Automatic startup remains parked at minimum until an accepted
+preparation action starts the shared audio loop.
+
+## Parked and running states
+
+On load the selected input is Automatic, held at volume zero (the configured
+minimum visual radius). The PCM player is prepared but silent. Fresh native
+observations publish the prepared generation, frame zero and `playing=false`.
+An unconfigured selected renderer also explicitly holds zero; it never falls
+through to a separate Automatic oscillator.
+
+An accepted Calibrate or Controller command authorizes the Java audio owner to
+start its existing player once. A warming/rejected command starts nothing.
+Initial calibration reserves frame zero and waits for an actual playing native
+observation; it then consumes exactly 1,411,200 audio frames (32 seconds).
+No browser timer advances it. Subsequent healthy retries clear the old model and reserve
+the next full cycle without restarting PCM. Preparation continues after either
+result. Controller does not require Polar clock readiness.
+
+An actual audio pause during an active attempt cancels it with `audio_paused`.
+The initial parked state is not a pause. Resume retains the player, but a
+cancelled attempt needs a new explicit retry. A previously fitted model can
+survive an ordinary pause, subject to fresh source evidence on resume. Source
+replacement, source clock retirement and audio generation/clock faults remain
+hard barriers. Main admission requires ready calibrated tilt or controller,
+starts on a full cycle boundary and lasts exactly 39,690,000 frames (900 seconds).
+
+## Explicit unhealthy transport recovery
+
+A playing intent is separate from actual frame progress. A constant playing
+head for more than 250 ms fails the current attempt. Later plausible real
+frames can restore clock health, but never revive that failed attempt. The
+original platform cause of a stopped head is not inferred from silence, volume,
+play state or render activity.
+
+An explicit Calibrate or Controller action can reserve recovery of an unhealthy
+preparation transport. Its external `{v,id,g,r,op}` tuple is unchanged. Native
+validates the closed command, original-ID ledger and current CAS before any
+transport effect. Recovery requires current preparation with no pending,
+running, finished or unretired main admission. The existing accepted end-main
+operation can establish a new preparation; it preserves the physical clock's
+health/age while resetting model/session evidence.
+
+Reservation retires old training, model, driver confirmation and callback
+evidence. It returns a same-ID `accepted:true,state:pending` receipt with reason
+`audio-recovery-pending`. One private Java-owner claim binds a strictly newer
+generation exactly once before track release or prepare. Java retains the
+verified PCM bytes, releases the old track, creates a new actual static track
+and a fresh unsigned playback-head expander. Immediately before PLAY it
+rechecks the live native token and terminal-owner retirement fence. A blocked
+prepare that returns after timeout or owner retirement releases its prepared
+track and cannot play it. Duplicate commands and claims do not replay effects.
+Queued cancellation remains definite; an already admitted timeout remains
+outcome unknown until its native receipt resolves.
+
+The reservation expires after two seconds through native observation, status,
+command or receipt lookup. Failure/timeout leaves input and main unready. A new
+explicit current-CAS ID can request another bounded recovery. A genuinely
+retired Java owner stays retired; a recoverable stopped/exceptioned preparation
+poll retains its worker for explicit recovery. A blocked owner poll/prepare
+does not advertise immediately executable recovery.
+
+Frame zero alone does not establish recovery. Native requires fresh plausible
+forward observations of the claimed generation. Calibrate also requires the
+same source/projection lineage, a fresh measured source-clock pair and a
+finite gravity-valid post-claim sample with a fresh mapped host time.
+Pre-claim buffered input cannot supply that witness. Controller requires a
+new valid observation of its currently selected controller. Source projection
+warmup can delay recovery; it is never bypassed for actual attempt admission.
+Once these gates pass, native reserves the next complete cycle and collects a
+new full two-cycle/32-second calibration. Old generations cannot revive or
+poison the new clock. Main duration, recording authority and raw sensor clocks
+remain unchanged.
+
+The read-only receipt query remains `{v:1,id:<original>,op:receipt}`, without
+generation/revision fields. Recovery receipts add `recovery_generation:null`
+before claim and the trusted target generation after claim, including terminal
+receipts. Ordinary receipts retain their shape. Status adds `stage:recovering`,
+pending `recovery` metadata or null, and `audio_recovery_available`. That
+capability describes strict preparation transport eligibility and current Java
+owner executability; it is not an admission or readiness grant.
+
+The authenticated private-LAN gateway carries this query under action
+`breath-setup`, with the strict three-field native lookup as its payload. It
+requires the current active controller and revalidates that binding after the
+lookup. The lookup runs before generic journal conflict/CAS and does not require
+a new idle-VR or fresh-Polar admission. It cannot reserve, claim, prepare or play.
+Mutation admission still checks idle VR, fresh Polar where required and the
+shared canonical ID journal. Original mutation retries retrieve the native
+ledger before that journal can shadow pending/late completion. HTTP/HMAC reply
+payloads preserve native `accepted`, `reason` and recovery provenance; generic
+carrier receipts are an audit projection. Nonces, actor/owner epochs, exact
+Origin, guest/relay exclusions and current-controller retirement remain enforced.
+`tools/checks/test_experiment_gateway_audio_recovery.py` executes production
+HTTP parsing/auth/gateway and the real Java/native owner seam using modeled
+Android, carrier and socket boundaries, without opening a network port.
+
+## Bounded clock diagnostics
+
+Native `clock_valid` and `clock` report accepted observation health/reason,
+observation time/age and the last actual forward witness time/age. A historical
+attempt failure remains separate from current clock health. `observation-stale`
+identifies missing fresh publication; `clock_stalled` identifies repeated
+accepted nonadvancing playing frames. `observation-gap` records an accepted
+forward observation after an excessive callback gap; it cannot save its failed
+attempt. A newly prepared zero head has no last-advance witness.
+
+Java `audio_clock` is an inert bounded snapshot of generation, poll sequence,
+start/end/in-progress, preparation state, last successful native dispatch, raw
+unsigned head, absolute frame, actual play state, playing intent, last forward
+time, ages and a bounded meaningful exception. Platform timestamp availability
+and frame/time, route identity and underruns are sampled on the first poll of
+each fresh track, then at most once per second within that generation. Track
+replacement clears the retired snapshot and throttle; each platform sample
+carries its own `platform_generation`. A lock-free status read discards a
+sample whose tag differs from its reported audio generation. Missing optional
+timestamps never produce estimated frames. Status
+does not wait for the player monitor, so a blocked poll remains diagnosable.
+These fields grant no readiness or effect and emit no unbounded high-rate log.
+
+The focused host gate is `tools/checks/Test-BreathingSetupAudioHost.ps1`, with
+explicit Android/JSON jars, authored loop JSON, a current native `--lib` test
+executable and a fresh output directory. It runs the real Java contract, owner,
+backend and Java-to-real-Runtime stdio peer. The peer is an intentionally ignored
+Rust test launched by that harness, not a production endpoint. The separate
+`Test-BreathingSetupAudioAndroid.ps1` gate compiles actual production against the
+Android boot class path. Host evidence does not establish physical AudioTrack
+recovery, silent-hold consumption, wearer fit or experiment readiness.
+
+## Original clocks and derived projection
+
+The Android packet path retains original sensor timestamps, Java callback
+receipt timestamps, callback-backcalculated sample host timestamps, frame/sample
+identity and raw XYZ. Participant raw recording receives those original fields
+before any derived ingress decision. When parallel capture is active, this
+selected path also records original samples before projection/rejection; this
+does not activate capture or claim persistence when no recorder is active.
+
+Callback-backcalculated host estimates are not ordering authority: 40 samples at
+200 Hz span 195 ms. Callback intervals of 220 ms then 180 ms produce a 15 ms
+overlap in those estimates despite continuous 5 ms sensor timestamps.
+
+`polar_sensor_clock` therefore validates packet endpoint, rate/count, source
+binding, frame identity and sensor ordering. Four packet anchors spanning at
+least 500 ms warm a fixed sensor-to-JavaNanoTime projection. Its offset is the
+minimum observed receipt-minus-sensor-endpoint offset. Once ready, that offset
+does not move per packet or per calibration retry. Raw values are not clamped or
+rewritten. The projected JavaNanoTime value has separate provenance containing
+its generation, anchor and original packet/sample fields. The canonical driver
+queue uses this derived clock; raw records keep their supplied original clock.
+
+This is a **receipt-anchored estimate**, not exact acquisition time. The 250 ms
+receipt/delivery envelope is an engineering admission bound, not a measured
+one-way BLE latency guarantee. A later packet can reveal bounded residual jitter;
+it cannot retroactively change the trajectory. Excessive residuals are unusable
+timing data; true sensor-clock reset retires the source projection generation
+and requires new warmup. Current JavaNanoTime/Android-elapsed-realtime clock-pair
+freshness is still checked before native audio alignment.
+
+Before the first packet the selected Android path is unready; missing packet
+metadata never implies an already aligned clock. An explicit host-aligned
+compatibility input can declare that separate contract only with a newly accepted
+current-source measurement, whose original sample time also passes the fresh
+JavaNanoTime/elapsed-realtime clock-pair bound. Generic raw ingress cannot warm
+this compatibility path. Android setup JNI always uses the packet route.
+
+Tracking configuration adds a separate `sensor_clock_projection` metadata
+object (or null for an already host-aligned compatibility source/controller).
+It explicitly declares `exact_acquisition_time=false`. No public CSV column is
+renamed. Clock provenance must not be described as original raw host time.
+
+## Whole-window quality
+
+Ordinary motion, invalid samples, bounded delivery loss and timing/replay
+segments are masked rather than ending an attempt at frame zero. The native
+audio window runs to completion. Diagnostic `quality` counts/warnings are not
+command revisions or a success authority. The final decision uses actual usable
+timed samples and a usable learned mapping. Elapsed time alone cannot succeed.
+Quality counts are bounded 25 Hz slots (at most 800), not raw 200 Hz sample
+counts. Repeated rejections in one slot count once; a qualified usable point
+releases that slot's masked count. Several diagnostic reasons can share a slot.
+
+Raw finite values and gravity magnitude 0.85–1.15 g remain required. A causal
+100 ms time-constant estimate of normalized gravity separates high-rate sensor
+noise from directional motion. The existing 0.60 normalized-gravity chord per
+second guard applies to that estimate; motion/invalid gaps require 200 ms of
+settling before usable observations resume. Original raw XYZ is unchanged.
+
+Uniform 25 Hz training has at most 800 observations. Admission requires:
+
+- at least 600 usable observations over the window (75%);
+- at least 280 in each cycle (70%);
+- at least 60 in each of the eight four-second phases (60%);
+- at least six observations in the first and last second of each inhale and
+  exhale, providing timed observations across the labelled window;
+- finite, nondegenerate direction/range estimation and the existing measured
+  normalized-gravity projection span of 0.02–0.50.
+
+The participant is assumed to follow the scheduled cues. Their labels train the
+axis and its direction from observed vectors; the robust P10/P90 range comes from
+those observations. Admission does not compare the measured trajectory with an
+ideal ramp, require flat holds or enforce cross-cycle recurrence. Nonlinear
+breaths, movement during holds and a different second cycle can all train the
+mapping. The participant evaluates the resulting Polar-driven sphere.
+
+The retained span bounds are engineering usable-signal/gain limits, not evidence
+of cue compliance. A span of 0.02 is about 1.15 degrees and avoids amplifying very
+small variation into the full visual range; 0.50 is about 29 degrees and excludes
+posture-scale spans. These conservative limits are not wearer-validated. In
+particular, the lower limit can reject smaller genuine breathing motion; future
+wearer evidence must establish whether it should change. This increment preserves
+both limits rather than silently weakening them.
+
+Missing interior or final packets can be tolerated if the full window still
+meets these criteria. A missing phase or sustained unusable data cannot. The
+final tail has a bounded 250 ms delivery wait before coverage assessment.
+Successful model selection means that a usable mapping was learned; it does not
+judge the participant's cue compliance or establish wearer acceptance.
+
+Historical samples use bounded healthy, playing audio observations from the same
+generation. Future training labels wait for a real audio bracket; frames are not
+extrapolated. Actual sample freshness/sensor gaps remain 200 ms and sensor/host
+drift remains 150 ms. Quality-limited live output is unready rather than invented.
+Hard source/clock barriers still invalidate model lineage. Controller operation
+is independent of Polar quality.
+
+## Measured phase and rendering continuity
+
+Calibrated tilt projects the measured gravity direction through the learned
+axis and range to obtain a normalized coordinate for phase classification.
+The selected render driver integrates only confirmed Inhale, Exhale or Hold
+using its existing bounded integrator, configured rates and current render
+frame duration. It never assigns the measured coordinate directly to its slot.
+
+Sample availability and the last confirmed applied phase are separate. While
+the same source, projection, model and playing audio lineage remains valid,
+missing/stale/masked samples or an unconfirmed classifier result retain the
+last confirmed phase. Inhale and Exhale continue at the configured render-frame
+rate with endpoint clamping; Hold preserves the integrated value. Recovery
+applies only the current frame duration, with no packet-count or elapsed-gap
+catch-up. Invalid or motion-masked samples cannot establish a replacement
+phase. A genuine signal-history break re-primes classification, while the
+runtime retains the latest sensor-confirmed phase for that exact lineage,
+independently of current classifier history and sample availability. The driver
+receives that phase even if later samples in the same batch are masked before
+the next render. A confirmed state does not need to have been rendered once
+to survive a sample lapse; valid sensor evidence owns replacement of the state.
+
+Source ownership replacement/retirement, projection generation retirement,
+audio generation/clock faults or pause and calibration retry/model replacement
+retire full data and callback-confirmation lineage. A pause/resume between render
+frames remains an explicit data epoch barrier, even when the fitted model
+survives. The selected experiment separately retains its visual diagnosis for
+the same app instance and manual input through these temporary losses; this
+cannot revalidate old samples or rearm admission. Changing app/input retires
+that visual diagnosis while preserving radius. Configuration/activation rejection
+keeps its original reset. Startup Automatic remains parked at zero; running
+Automatic retains its exact observed audio-envelope mapping. Generic composition
+loss/reset semantics are unchanged.
+
+Each accepted confirmed sensor observation advances a separate revision that
+does not reset on masking or classifier re-prime. Driver configuration changes
+and activation rejection/restoration fence the current revision for its exact
+lineage. Pre-barrier cached phases cannot rearm the driver on later unavailable
+frames; a newer valid confirmed observation is required. That newer confirmation
+still survives an invalid batch tail before rendering. Cursor-only metadata
+under an unavailable audio/projection gate can retire older confirmations but
+supplies neither phase authority nor readiness.
+
+The existing render-driver marker reports `SetupAvailability`, the applied
+`SetupPhase`, compact `SetupLineage`, integrated `Value01`, `ResetCount` and
+`LastResetReason` under the `breathCompositionDriver` prefix. Its reason is
+`setup-participant-tilt-phase` for current confirmed input and
+`setup-retained-tilt-phase` when applying retained state. Lineage fields follow
+`polar:audio-generation:driver-epoch:source-owner:source-selection:source-reference:projection-generation:model-generation`.
+The existing setup `input_volume01` remains the measured coordinate and can be
+unavailable while the applied render phase continues. Recording freshness and
+admission continue to use current measured evidence.
+
+## Verification boundary
+
+Focused host tests cover 25/200 Hz input, packet jitter, preserved originals,
+parked startup, labelled nonlinear/variable breaths, full-window noise/motion
+masks, missing phases, source epochs, retry/fallback and exact main boundaries.
+Runtime-to-driver replay additionally covers continuous 200 Hz observations in
+36-sample/180 ms batches with 45 ms receipt jitter, crossing the unchanged
+200 ms freshness gate while preserving frame-rate phase integration. Driver
+tests cover retained Inhale/Exhale/Hold at 72/90/120 Hz, re-prime Unknown,
+newly confirmed Hold, lineage/configuration changes and an unseen audio pause.
+Additional callback-to-render cases confirm Hold/Exhale, append an invalid
+sample before rendering, and preserve the newer confirmed state through
+unavailable and re-prime Unknown output. Hard runtime barriers clear that
+callback-side memory independently of the driver's previous rendered state.
+Real runtime-to-driver rate/slot and activation barrier tests hold loss across
+unavailable frames, verify retired/current slot writes, and admit a newer
+post-barrier confirmation followed by an invalid tail. A separate projection
+gate case protects retirement of confirmations unseen by the previous render.
+The phase classifier itself remains unchanged: a normalized box-coordinate
+probe at 25/50/100/200 Hz has identical individual/burst phase ordering without
+chatter, but its per-observation derivative filter gives up to 160 ms difference
+in Hold transition latency between 25 and 200 Hz. This is a qualification limit,
+separate from render continuity; broader signal and participant quality remain
+unproven by that fixture.
+These engineering thresholds require
+worn-device qualification; synthetic fixtures establish software behavior, not
+physiological or clinical accuracy. No successful wearer fit is implied.
