+// Fixed 25 Hz independent fixtures: seconds 0..4 rise, 4..8 high,
+// 8..12 fall, 12..16 low. This does not call the production phase/envelope code.
+fn guided_vector(frame: u64) -> [f64; 3] {
+    let second = (frame % 705_600) as f64 / 44_100.0;
+    let volume = if second < 4.0 {
+        second / 4.0
+    } else if second < 8.0 {
+        1.0
+    } else if second < 12.0 {
+        (12.0 - second) / 4.0
+    } else {
+        0.0
+    };
+    let angle = -0.08 + 0.16 * volume;
+    [angle.sin(), 0.0, angle.cos()]
+}
+
+fn time(frame: u64) -> u64 {
+    1_000_000_000 + frame * 1_000_000_000 / 44_100
+}
