+                    .ledger
+                    .iter_mut()
+                    .find(|(command, _)| command["id"] == id)
+                {
+                    result["recovery_generation"] = json!(target);
+                }
+                self.refresh(now);
+                json!({"accepted":true,"effect":true,"reason":"audio-recovery-claimed"})
+            }
+            "claim" if recovery.target_generation == Some(target) => {
+                json!({"accepted":true,"effect":false,"reason":"audio-recovery-already-claimed"})
+            }
+            "check" if recovery.target_generation == Some(target) => {
+                json!({"accepted":true,"effect":false,"reason":"audio-recovery-current"})
+            }
+            "fail" if recovery.target_generation == Some(target) => {
+                self.finish_recovery(false, "audio-recovery-failed");
+                self.refresh(now);
+                json!({"accepted":true,"effect":false,"reason":"audio-recovery-failed"})
+            }
+            _ => json!({"accepted":false,"effect":false,"reason":"audio-recovery-mismatch"}),
