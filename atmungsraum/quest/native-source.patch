+    static boolean deferExperimentStart(final Runnable callback, final Runnable onRetired) {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner == null) return false;
+        try { return owner.call(new Callable<Boolean>() { public Boolean call() { return owner.defer(callback, onRetired); } }); }
+        catch (OutcomeUncertainException uncertain) { throw uncertain; }
