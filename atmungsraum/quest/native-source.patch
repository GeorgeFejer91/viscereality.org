+#[test]
+fn recovery_requires_single_owner_claim_actual_forward_head_and_fresh_postclaim_input() {
+    let (mut r, request, now) = stalled_recovery_runtime();
+    let id = request["id"].as_str().unwrap();
+    r.observe_clock(8, 882, now + 20_000_000, true);
+    assert_eq!(
+        r.status(now + 20_000_000)["g"],
+        7,
+        "no unclaimed generation can complete reservation"
+    );
+    assert_eq!(
+        r.recovery_effect(id, 7, 8, "claim", now + 20_000_000)["effect"],
+        true
+    );
+    assert_eq!(
+        r.recovery_effect("", 7, 7, "fault", now + 20_000_000)["accepted"],
+        false,
+        "retired owner faults cannot poison the claimed generation"
+    );
+    assert_eq!(
+        r.recovery_effect(id, 7, 8, "claim", now + 20_000_000)["effect"],
+        false
+    );
+    assert_eq!(
+        r.recovery_effect(id, 7, 9, "claim", now + 20_000_000)["accepted"],
+        false
+    );
+    r.observe_clock(8, 0, now + 40_000_000, true);
+    r.observe_source_pair(now + 40_000_000, now + 40_000_000);
+    r.observe_acc_with_source(100_000_000_000 + now, now, now, vector(0.0));
+    r.observe_clock(8, 882, now + 60_000_000, true);
+    assert_eq!(
+        r.command(&request, now + 60_000_000)["state"],
+        "pending",
+        "old source evidence cannot finish a new generation"
+    );
+    let epoch = r.driver_epoch;
+    r.observe_clock(7, 100_000, now + 65_000_000, true);
+    assert_eq!(
+        r.driver_epoch, epoch,
+        "retired callbacks cannot retire the new driver cursor again"
+    );
+    assert_eq!(r.status(now + 65_000_000)["position_frames"], 882);
+    r.observe_source_pair(now + 60_000_000, now + 60_000_000);
+    r.observe_acc_with_source(
+        100_000_000_000 + now + 60_000_000,
+        now + 60_000_000,
+        now + 60_000_000,
+        [f32::NAN, 0.0, 1000.0],
+    );
+    assert_eq!(r.command(&request, now + 60_000_000)["state"], "pending");
+    r.observe_acc_with_source(
+        100_000_000_001 + now + 60_000_000,
+        now + 60_000_000,
+        now + 60_000_000,
+        vector(0.0),
+    );
+    assert_eq!(r.command(&request, now + 60_000_000)["state"], "confirmed");
+    let s = r.core.snapshot(now + 60_000_000);
+    assert_eq!(s.calibration_generation, 2);
+    assert_eq!(s.calibration_start_frame, Some(705_600));
+    assert_eq!(s.calibration_target_frames, 1_411_200);
+    assert_eq!(s.calibration_completed_frames, 0);
+    assert_eq!(s.accepted_samples, 0);
+    assert!(r.core.model().is_none());
+    // The original receipt remains queryable after g/r changed and cannot replay recovery.
+    assert_eq!(
+        r.command(&json!({"v":1,"id":id,"op":"receipt"}), now + 60_000_000)["state"],
+        "confirmed"
+    );
+    assert_eq!(
+        r.recovery_effect(id, 7, 8, "check", now + 60_000_000)["accepted"],
+        false
+    );
+    let base = now + 40_000_000;
+    for frame in (1764..=2_116_800).step_by(1764) {
+        let at = base + frame * 1_000_000_000 / 44_100;
+        r.observe_clock(8, frame, at, true);
+        r.observe_source_pair(at, at);
+        let seconds = (frame % 705600) as f64 / 44100.0;
+        let volume = match seconds {
+            t if t < 4.0 => t / 4.0,
+            t if t < 8.0 => 1.0,
+            t if t < 12.0 => (12.0 - t) / 4.0,
+            _ => 0.0,
+        };
+        r.observe_acc_with_source(100_000_000_000 + at, at, at, vector(volume));
+        if frame < 2_116_800 {
+            assert_ne!(r.status(at)["calibration"], "ready");
+        }
+    }
+    assert_eq!(r.status(base + 48_000_000_000)["calibration"], "ready");
+}
