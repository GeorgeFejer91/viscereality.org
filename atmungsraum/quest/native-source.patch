+fn verify_checkpoint_reference(
+    session: &Directory,
+    terminal: &Value,
+    details: &Value,
+    check: &dyn Fn() -> bool,
+) -> Result<(), String> {
+    check_owner(check)?;
+    let ordinal = details["checkpoint_ordinal"].as_u64().ok_or_else(denied)?;
+    let name = format!("checkpoint-{ordinal:020}.json");
+    let (file, original) = session.child(&name, true)?;
+    if original.len > 1024 * 1024 {
+        return Err(denied());
+    }
+    let mut file = file;
+    let mut bytes = Vec::with_capacity(original.len as usize);
+    CheckedRead {
+        file: &mut file,
+        remaining: original.len,
+        check,
+    }
+    .read_to_end(&mut bytes)
+    .map_err(|_| denied())?;
+    if bytes.len() as u64 != original.len {
+        return Err(denied());
+    }
+    let value: Value = serde_json::from_slice(&bytes).map_err(|_| denied())?;
+    let digest = format!("{:x}", Sha256::digest(&bytes));
+    let matching = [
+        "started_at_utc",
+        "condition",
+        "experiment_identity",
+        "completed",
+        "durable_stream_lengths",
+        "loss",
+        "checkpoint_ordinal",
+    ]
+    .iter()
+    .all(|name| value.get(name) == terminal.get(name));
+    if details["checkpoint_sha256"].as_str() != Some(&digest)
+        || value["schema"] != crate::session_recording_contract::SESSION_CHECKPOINT_SCHEMA
+        || !matching
+        || stamp(&file, true)? != original
+        || session.child(&name, true)?.1 != original
+    {
+        return Err(denied());
+    }
+    check_owner(check)
+}
