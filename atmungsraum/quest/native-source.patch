+#[test]
+fn idle_automatic_acc_batches_cannot_starve_a_fresh_phone_start_revision() {
+    let mut r = runtime();
+    r.observe_clock(1, 0, 1_000_000_000, true);
+    r.bind_source((5, 1));
+    r.observe_acc(101_000_000_000, 1_000_000_000, [0.0, 0.0, 1000.0]);
+    let baseline = r.status(1_000_000_000);
+
+    // Keep the actual audio readback fresh throughout a 400 ms interruption.
+    // Original 200 Hz batch samples straddle the 150 ms alignment bound.
+    for i in 1..=20 {
+        r.observe_clock(1, i * 882, 1_000_000_000 + i * 20_000_000, true);
+    }
+    for host in (1_200_000_000..=1_400_000_000).step_by(5_000_000) {
+        r.observe_acc(100_000_000_000 + host, host, [0.0, 0.0, 1000.0]);
+    }
+    let before = r.status(1_400_000_000);
+    let request =
+        json!({"v":1,"id":"0000000000000001","g":before["g"],"r":before["r"],"op":"start"});
+
+    // A second normal batch can reach native between phone status and command.
+    for i in 21..=30 {
+        r.observe_clock(1, i * 882, 1_000_000_000 + i * 20_000_000, true);
+    }
+    for host in (1_400_000_001..=1_600_000_000).step_by(5_000_000) {
+        r.observe_acc(100_000_000_000 + host, host, [0.0, 0.0, 1000.0]);
+    }
+    let after = r.status(1_600_000_000);
+    let receipt = r.command(&request, 1_600_000_000);
+    assert_eq!(
+        receipt["accepted"], true,
+        "{receipt}; before={before}; after={after}"
+    );
+    assert_eq!(before["r"], baseline["r"]);
+    assert_eq!(after["r"], before["r"]);
+    assert_eq!(after["failure"], "");
+    assert_eq!(after["calibration"], "idle");
+    assert_eq!(after["attempt"], 0);
+    assert_eq!(after["playing"], true);
+    assert_eq!(after["position_frames"], 26460);
+}
