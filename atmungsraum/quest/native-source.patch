+#[test]
+fn driver_barriers_fence_real_runtime_confirmations_until_new_valid_sensor_evidence() {
+    use crate::breath_composition_driver::{
+        tests::{changed_settings, settings, setup_frame_with_settings},
+        BreathCompositionDriver,
+    };
+    for barrier in ["rate", "slot", "activation"] {
+        let (mut r, base_frame, base_ns) = calibrated_inhale_runtime();
+        let mut driver = BreathCompositionDriver::new(settings());
+        setup_frame_with_settings(
+            &mut driver,
+            r.output(base_ns),
+            settings(),
+            true,
+            base_ns,
+            0.2,
+        );
+        let invalid_ns = base_ns + 5_000_000;
+        let original_revision = r.confirmation_revision;
+        r.observe_clock(7, base_frame + 220, invalid_ns, true);
+        r.observe_acc_with_source(
+            100_000_000_000 + invalid_ns,
+            invalid_ns,
+            invalid_ns,
+            [f32::NAN, 0.0, 1000.0],
+        );
+        assert_eq!(r.phase, CommonBreathPhase::Unknown);
+        let selected = match barrier {
+            "rate" => changed_settings(0.6, 2),
+            "slot" => changed_settings(0.5, 5),
+            _ => settings(),
+        };
+        for tick in 1..=4 {
+            let now = invalid_ns + tick * 20_000_000;
+            r.observe_clock(
+                7,
+                base_frame + (now - base_ns) * 44100 / 1_000_000_000,
+                now,
+                true,
+            );
+            setup_frame_with_settings(
+                &mut driver,
+                r.output(now),
+                selected,
+                barrier != "activation" || tick > 1,
+                now,
+                0.1,
+            );
+            assert_eq!(
+                driver.value01(),
+                0.2,
+                "{barrier} must fence cached inhale across unavailable frame {tick}"
+            );
+            assert!(driver.marker_fields().contains("SetupPhase=none"));
+            let mut values = [0.9; 8];
+            assert!(driver.apply_to_driver_values(&mut values));
+            assert_eq!(values[selected.target_slot()], 0.2);
+            if barrier == "slot" && tick == 1 {
+                assert_eq!(values[2], 0.2, "retired slot must reset too");
+            }
+        }
+        // A valid post-barrier classification can rearm the driver even when
+        // another invalid callback follows before the next rendered frame.
+        let mut confirmed_ns = 0;
+        for tick in 3..=30 {
+            let now = invalid_ns + tick * 40_000_000;
+            r.observe_clock(
+                7,
+                base_frame + (now - base_ns) * 44100 / 1_000_000_000,
+                now,
+                true,
+            );
+            r.observe_acc_with_source(
+                100_000_000_000 + now,
+                now,
+                now,
+                vector(0.2 + tick as f64 / 200.0),
+            );
+            if r.phase == CommonBreathPhase::Inhale {
+                confirmed_ns = now;
+                break;
+            }
+        }
+        assert!(
+            confirmed_ns > 0,
+            "new real classification must confirm after {barrier}"
+        );
+        assert!(
+            r.confirmation_revision > original_revision,
+            "confirmation revision must advance across mask/re-prime"
+        );
+        let tail_ns = confirmed_ns + 5_000_000;
+        r.observe_clock(
+            7,
+            base_frame + (tail_ns - base_ns) * 44100 / 1_000_000_000,
+            tail_ns,
+            true,
+        );
+        r.observe_acc_with_source(
+            100_000_000_000 + tail_ns,
+            tail_ns,
+            tail_ns,
+            [f32::NAN, 0.0, 1000.0],
+        );
+        assert!(!r.core.snapshot(tail_ns).ready);
+        setup_frame_with_settings(&mut driver, r.output(tail_ns), selected, true, tail_ns, 0.1);
+        let expected = if barrier == "rate" { 0.26 } else { 0.25 };
+        assert!(
+            (driver.value01() - expected).abs() < 0.000_001,
+            "new confirmed state must rearm {barrier}"
+        );
+    }
