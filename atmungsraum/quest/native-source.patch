+pub(crate) fn observe_accepted_acc(binding: (u64, u64), sensor: u64, host: u64, mg: [f32; 3]) {
+    if !selected() || binding != crate::polar_input_health::source_binding() {
+        return;
+    }
+    let observation = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return;
+        };
+        r.bind_source(binding);
+        let Some(mapped_host) = r.map_raw_host(host) else {
+            return;
+        };
+        r.observe_acc_with_source(sensor, mapped_host, host, mg);
+        let now = r.now_ns().max(mapped_host);
+        r.tilt_assessment(now).map(|assessment| {
+            (
+                assessment,
+                r.revision,
+                r.core.snapshot(now).experiment == ExperimentState::Running,
+            )
+        })
+    };
+    if let Some((assessment, revision, main_running)) = observation {
+        crate::breath_composition_runtime::record_setup_assessment(
+            assessment,
+            revision,
+            main_running,
+        );
+    }
