+package io.github.mesmerprism.rustyquest.native_renderer;
+import org.json.JSONObject;
+public final class ExperimentPhonePairingUiPolicyTest {
+    static int checks;
+    static void check(boolean value,String why){checks++;if(!value)throw new AssertionError(why);}
+    static JSONObject prompt(String id,String code)throws Exception{return new JSONObject().put("pairing_id",id).put("code",code).put("phone_name","My phone").put("expires_in_ms",120000).put("phone_confirmed",false).put("headset_confirmed",false);}
+    static JSONObject visibility(long generation,long revision,boolean visible)throws Exception{return new JSONObject().put("generation",generation).put("request_revision",revision).put("requested_visible",visible);}
+    public static void main(String[] args)throws Exception {
+        Object owner=new Object();ExperimentPhonePairingUiPolicy policy=new ExperimentPhonePairingUiPolicy();
+        JSONObject original=prompt("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","012345");
+        check(ExperimentPhonePairingUiPolicy.valid(original),"valid frozen prompt");
+        check(!ExperimentPhonePairingUiPolicy.valid(new JSONObject(original.toString()).put("code",12345)),"numeric code coercion");
+        check(!ExperimentPhonePairingUiPolicy.valid(new JSONObject(original.toString()).put("code","12345")),"six digits required");
+        check(!ExperimentPhonePairingUiPolicy.valid(new JSONObject(original.toString()).put("phone_name","bad\nlabel")),"control characters excluded");
+        check(!ExperimentPhonePairingUiPolicy.valid(new JSONObject(original.toString()).put("expires_in_ms",0)),"expired prompt");
+        ExperimentPhonePairingUiPolicy.Token token=policy.begin(owner,original,visibility(7,2,false),visibility(7,3,true));
+        check(token!=null&&token.code.equals("012345")&&token.phoneName.equals("My phone"),"same code and short label projected");
+        check(policy.decisionCurrent(token,owner,original),"real current Allow or Reject admitted");
+        check(!policy.decisionCurrent(token,new Object(),original),"retired presentation owner");
+        check(!policy.decisionCurrent(token,owner,prompt("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","012345")),"stale dialog cannot decide a replacement");
+        check(!policy.decisionCurrent(token,owner,prompt("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","543210")),"changed code cannot inherit approval");
+        check(!policy.decisionCurrent(token,owner,new JSONObject(original.toString()).put("expires_in_ms",0)),"expired dialog cannot decide");
+        check(!policy.decisionCurrent(token,owner,null),"cancelled/retired request cannot decide");
+        check(policy.restoreVisibility(token,owner,visibility(7,3,true)),"prompt-owned opening restored");
+        check(!policy.restoreVisibility(token,owner,visibility(7,4,true)),"manual reopen retained");
+        check(!policy.restoreVisibility(token,owner,visibility(7,4,false)),"manual close retained");
+        check(!policy.restoreVisibility(token,owner,visibility(8,3,true)),"new producer retained");
+        check(!policy.restoreVisibility(token,new Object(),visibility(7,3,true)),"new host retained");
+        policy.finish(token);check(!policy.decisionCurrent(token,owner,original),"decision cannot replay after dismissal");
+        ExperimentPhonePairingUiPolicy.Token visible=policy.begin(owner,original,visibility(7,6,true),null);
+        check(!policy.restoreVisibility(visible,owner,visibility(7,6,true)),"already-open panel is never prompt-owned");
+        policy.finish(visible);
+        check(policy.begin(owner,new JSONObject(original.toString()).put("expires_in_ms",-1),visibility(7,6,false),visibility(7,7,true))==null,"invalid prompt cannot open modal state");
+        System.out.println("PASS "+checks+" actual pairing UI policy controls: immutable same code, owner/id/expiry fences and prompt-owned visibility only");
+    }
+}
