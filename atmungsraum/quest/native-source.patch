+/// Launched only by the JVM owner conformance harness. Every request executes
+/// this real Runtime; the Java test never copies its admission/receipt rules.
+#[test]
+#[ignore = "stdio peer for the Java audio-owner integration test"]
+fn java_audio_recovery_native_peer() {
+    use std::io::{BufRead, Write};
+    assert_eq!(std::env::var("RQ_AUDIO_RECOVERY_PEER").as_deref(), Ok("1"));
+    let mut r = runtime();
+    for line in std::io::stdin().lock().lines() {
+        let value: Value = serde_json::from_str(&line.unwrap()).unwrap();
+        let n = |key: &str| value[key].as_u64().unwrap();
+        let response = match value["kind"].as_str().unwrap() {
+            "configure" => {
+                let text = value["json"].as_str().unwrap();
+                let hash = value["hash"].as_str().unwrap();
+                let schedule = validate_loop(text, hash, Some(hash)).unwrap();
+                r = Runtime::new(schedule, hash.to_owned());
+                r.bind_source((5, 1));
+                r.projection_ready = true;
+                json!({"accepted":true})
+            }
+            "pair" => {
+                r.observe_source_pair(n("nano"), n("elapsed"));
+                json!({})
+            }
+            "observe" => {
+                r.observe_clock(
+                    n("g"),
+                    n("frame"),
+                    n("now"),
+                    value["playing"].as_bool().unwrap(),
+                );
+                json!({})
+            }
+            "status" => r.status(n("now")),
+            "command" => r.command(&value["command"], n("now")),
+            "effect" => r.recovery_effect(
+                value["id"].as_str().unwrap(),
+                n("old"),
+                n("target"),
+                value["action"].as_str().unwrap(),
+                n("now"),
+            ),
+            "acc" => {
+                let mg = std::array::from_fn(|index| value["mg"][index].as_f64().unwrap() as f32);
+                r.observe_acc_with_source(n("sensor"), n("host"), n("source"), mg);
+                r.status(n("now"))
+            }
+            "quit" => break,
+            _ => panic!("unknown JVM peer request"),
+        };
+        println!("RQ_AUDIO_PEER {response}");
+        std::io::stdout().flush().unwrap();
+    }
+}
