@@ -0,0 +1,22 @@
+[CmdletBinding()]
+param([Parameter(Mandatory)][string]$JsonJar,[Parameter(Mandatory)][string]$OutputRoot,[string]$WebTest)
+$ErrorActionPreference='Stop'
+if(Test-Path -LiteralPath $OutputRoot){throw 'Create-new output required'}
+$null=New-Item -ItemType Directory -Path $OutputRoot
+$repo=Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
+$pkg='io/github/mesmerprism/rustyquest/native_renderer'
+$production=Join-Path $repo "apps/native-renderer-android/panel-modules/breath-composition/src/main/java/$pkg/ExperimentPhonePairing.java"
+$test=Join-Path $repo "apps/native-renderer-android/tests/java/$pkg/ExperimentPhonePairingTest.java"
+& javac --release 8 -encoding UTF-8 -cp $JsonJar -d $OutputRoot $production $test
+if($LASTEXITCODE-ne0){throw 'Phone pairing compilation failed'}
+& java -cp "$OutputRoot$([IO.Path]::PathSeparator)$JsonJar" io.github.mesmerprism.rustyquest.native_renderer.ExperimentPhonePairingTest
+if($LASTEXITCODE-ne0){throw 'Phone pairing tests failed'}
+if($WebTest){
+    $previousClasspath=$env:RQ_PAIRING_JAVA_CLASSPATH
+    try{
+        $env:RQ_PAIRING_JAVA_CLASSPATH="$(Convert-Path -LiteralPath $OutputRoot)$([IO.Path]::PathSeparator)$(Convert-Path -LiteralPath $JsonJar)"
+        & node --test $WebTest
+        if($LASTEXITCODE-ne0){throw 'Full browser WebCrypto to production Java pairing tests failed'}
+    }finally{$env:RQ_PAIRING_JAVA_CLASSPATH=$previousClasspath}
+}
+@{passed=$true;web_java_interop_ran=[bool]$WebTest;scope='Real JCE pairing owner host tests and optional actual WebCrypto/Java request integration; no Android, network, APK or headset effects'}|ConvertTo-Json|Set-Content (Join-Path $OutputRoot 'RESULT.json')
