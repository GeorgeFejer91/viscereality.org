+pub(crate) fn observe_rejected_acc(binding: (u64, u64), mg: [f32; 3]) {
+    if !selected() || binding != crate::polar_input_health::source_binding() {
+        return;
+    }
+    let required = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return;
+        };
+        if r.source_binding != Some(binding) {
+            return;
+        }
+        let reason = if mg.iter().all(|v| v.is_finite()) {
+            crate::experiment_breathing_setup::SetupFailure::ReorderedSample
+        } else {
+            crate::experiment_breathing_setup::SetupFailure::InvalidSample
+        };
+        r.core.reject_acc(r.source_reference, reason);
+        r.refresh(r.now_ns());
+        r.core.snapshot(r.now_ns()).input == SetupInput::PolarTilt
+    };
+    crate::polar_input_health::set_setup_required(Some(required));
