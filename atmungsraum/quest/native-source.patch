+        int head();
+        void release();
+    }
+    interface NativeBridge {
+        String configure(String json, String sha256);
+        default void observeSourceClockPair(long javaNanoNs, long elapsedNs) { }
+        void observe(long generation, long frame, long monotonicNs, boolean playing);
+        String status(long nowNs);
+        String command(String json, long nowNs);
+    }
+
+    private static native String nativeConfigure(String loopJson, String sha256);
+    private static native void nativeObserveClock(long generation, long frame, long monotonicNs, boolean playing);
+    private static native void nativeObserveSourceClockPair(long javaNanoNs, long elapsedNs);
+    private static native String nativeStatus(long nowNs);
+    private static native String nativeCommand(String json, long nowNs);
+
+    static boolean selected(Context context) {
+        if (context == null) return false;
+        try {
+            ApplicationInfo app = context.getPackageManager().getApplicationInfo(context.getPackageName(), PackageManager.GET_META_DATA);
+            return app.metaData != null && app.metaData.getBoolean(ENABLED, false);
+        } catch (Exception unavailable) { return false; }
+    }
+
