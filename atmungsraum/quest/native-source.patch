+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{self, Read},
+    path::Path,
+};
+
+use crate::{
+    session_recording_clock::{ClockAnchor, MonotonicNanos, SessionTimestampKey, UtcEpochNanos},
+    session_recording_contract::{SESSION_FINAL_SCHEMA, SESSION_STREAM_FILES},
+    session_recording_export::{MAX_EXPORT_BYTES, open_regular_recording_file},
+    session_recording_participant::{ParticipantRun, RECOVERY_RECEIPT, discard_recovery_csv},
+    session_recording_recovery::{RecoveryDisposition, RecoveryReport, participant_checkpoint},
+    session_recording_writer::publish_json_exclusive,
+};
+
+pub(crate) fn publish_recovered(root: &Path, report: &mut RecoveryReport) {
+    for run in &mut report.sessions {
+        if run.error.is_some()
+            || !matches!(
+                run.disposition,
+                RecoveryDisposition::InterruptedEarly | RecoveryDisposition::InterruptedCompleted
+            )
+        {
+            continue;
+        }
+        if let Err(error) = publish_run(&root.join(run.started_at.as_str()), &run.started_at) {
+            run.error = Some(error);
+            report.counts.errors = report.counts.errors.saturating_add(1);
+            if let Some(identity) = &run.experiment_identity {
+                let counts = match identity.condition_id.as_str() {
+                    "condition-a" => Some(&mut report.condition_counts.condition_a),
+                    "condition-b" => Some(&mut report.condition_counts.condition_b),
+                    _ => None,
+                };
+                if let Some(counts) = counts {
+                    counts.errors = counts.errors.saturating_add(1);
+                }
+            }
+        }
+    }
+}
+
+fn absent(path: &Path) -> Result<bool, String> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => Ok(false),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(true),
+        Err(error) => Err(format!("participant-recovery-path:{:?}", error.kind())),
+    }
+}
+
+fn publish_run(directory: &Path, key: &SessionTimestampKey) -> Result<(), String> {
+    let metadata = fs::symlink_metadata(directory)
+        .map_err(|_| "participant-recovery-directory-unavailable")?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err("participant-recovery-directory-invalid".into());
+    }
+    if !absent(&directory.join("final.json"))? || !absent(&directory.join(RECOVERY_RECEIPT))? {
+        return Ok(());
+    }
+    let Some((original, mut terminal)) = participant_checkpoint(directory, key)? else {
+        return Ok(());
+    };
+    let run = ParticipantRun::restore(&original["participant"]).map_err(str::to_owned)?;
+    let clock = &original["clock_anchor"];
+    let utc = UtcEpochNanos::new(
+        clock["utc_epoch_ns"]
+            .as_u64()
+            .ok_or("participant-recovery-utc")?,
+    );
+    if &SessionTimestampKey::from_utc(utc) != key
+        || clock["monotonic_clock"] != "android-elapsed-realtime"
+    {
+        return Err("participant-recovery-clock-binding".into());
+    }
+    let anchor = ClockAnchor::new(
+        MonotonicNanos::new(
+            clock["monotonic_ns"]
+                .as_u64()
+                .ok_or("participant-recovery-clock")?,
+        ),
+        utc,
+    );
+    let ordinal = terminal["checkpoint_ordinal"]
+        .as_u64()
+        .filter(|ordinal| *ordinal > 0)
+        .ok_or("participant-recovery-checkpoint-ordinal")?;
+    let checkpoint_path = directory.join(format!("checkpoint-{ordinal:020}.json"));
+    let checkpoint_file = open_regular_recording_file(&checkpoint_path)?;
+    let mut checkpoint_bytes = Vec::new();
+    checkpoint_file
+        .take(1024 * 1024 + 1)
+        .read_to_end(&mut checkpoint_bytes)
+        .map_err(|_| "participant-recovery-checkpoint-read")?;
+    if checkpoint_bytes.len() > 1024 * 1024
+        || serde_json::from_slice::<Value>(&checkpoint_bytes)
+            .ok()
+            .as_ref()
+            != Some(&terminal)
+    {
+        return Err("participant-recovery-checkpoint-changed".into());
+    }
+    let checkpoint_hash = format!("{:x}", Sha256::digest(&checkpoint_bytes));
+    let lengths = &terminal["durable_stream_lengths"];
+    let mut hashes = serde_json::Map::new();
+    let mut total = 0u64;
+    for name in SESSION_STREAM_FILES {
+        let length = lengths[name]
+            .as_u64()
+            .ok_or("participant-recovery-prefix-size")?;
+        total = total
+            .checked_add(length)
+            .filter(|bytes| *bytes <= MAX_EXPORT_BYTES)
+            .ok_or("participant-recovery-size-limit")?;
+        let file = open_regular_recording_file(&directory.join(name))?;
+        let mut hash = Sha256::new();
+        let copied = io::copy(&mut file.take(length), &mut hash)
+            .map_err(|_| "participant-recovery-prefix-read")?;
+        if copied != length {
+            return Err("participant-recovery-prefix-short".into());
+        }
+        hashes.insert(name.to_owned(), json!(format!("{:x}", hash.finalize())));
+    }
+    let Some((csv, ended_at)) = run.recover_csv(
+        directory,
+        anchor,
+        lengths["events.jsonl"].as_u64().expect("validated lengths"),
+        lengths["polar-ecg.jsonl"]
+            .as_u64()
+            .expect("validated lengths"),
+        hashes["polar-ecg.jsonl"]
+            .as_str()
+            .expect("hashed ECG prefix"),
+    )?
+    else {
+        return Ok(());
+    };
+    terminal["schema"] = json!(SESSION_FINAL_SCHEMA);
+    terminal["saved"] = json!(true);
+    terminal["dropped_records"] = json!(0);
+    terminal["stop_reason"] = json!("interrupted-recovery");
+    terminal["ended_monotonic_ns"] = json!(ended_at);
+    terminal["ended_utc_ns"] = json!(
+        anchor
+            .utc_at(MonotonicNanos::new(ended_at))
+            .map(|utc| utc.get())
+    );
+    terminal["accepted_sequence_cutoff"] = terminal["last_accepted_sequence"].clone();
+    terminal["participant"] = run.metadata();
+    terminal["participant_csv"] = csv;
+    terminal["recovery"] = json!({
+        "v": 1,
+        "checkpoint_ordinal": ordinal,
+        "checkpoint_sha256": checkpoint_hash,
+        "stream_sha256": Value::Object(hashes),
+    });
+    discard_recovery_csv(&directory.join(format!(".{RECOVERY_RECEIPT}.partial")))?;
+    publish_json_exclusive(directory, RECOVERY_RECEIPT, &terminal)
+}
