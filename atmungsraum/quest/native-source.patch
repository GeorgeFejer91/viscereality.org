+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.io.ByteArrayInputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.HashMap;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+public final class BreathingSetupAudioContractTest {
+    public static void main(String[] args) throws Exception {
+        concatenatesVerifiedDistinctCues();
+        rejectsClockAndCueMutations();
+        rejectsTrailingBytesInsideRiff();
+        playbackHeadRolloverPauseAndFreshness();
+        boundaryGateUsesFramesAndCancelsRetiredStart();
+        System.out.println("BreathingSetupAudioContractTest PASS (5 groups)");
+    }
+    private static void rejectsTrailingBytesInsideRiff() throws Exception {
+        for (int extra = 1; extra <= 7; extra++) {
+            final Fixture f = new Fixture(); String path = "assets/audio/inhale.wav";
+            byte[] original = f.cues.get(path);
+            byte[] trailing = java.util.Arrays.copyOf(original, original.length + extra);
+            java.util.Arrays.fill(trailing, original.length, trailing.length, (byte) 0x7f);
+            ByteBuffer.wrap(trailing).order(ByteOrder.LITTLE_ENDIAN).putInt(4, trailing.length - 8);
+            f.cues.put(path, trailing);
+            f.json.getJSONArray("phases").getJSONObject(0).getJSONObject("cue")
+                .put("bytes", trailing.length).put("sha256", BreathingSetupAudioContract.sha256(trailing));
+            BreathingSetupAudioContract loop = BreathingSetupAudioContract.parse(f.json.toString());
+            reject(() -> loop.loadCycle(name -> new ByteArrayInputStream(f.cues.get(name))),
+                "incomplete trailing WAV chunk with " + extra + " bytes");
+        }
+    }
+
+    private static void concatenatesVerifiedDistinctCues() throws Exception {
+        Fixture f = new Fixture();
+        BreathingSetupAudioContract loop = BreathingSetupAudioContract.parse(f.json.toString());
+        byte[] pcm = loop.loadCycle(path -> new ByteArrayInputStream(f.cues.get(path)));
+        check(pcm.length == 1411200, "exact 16-second PCM cycle");
+        for (int i = 0; i < 4; i++) {
+            check(pcm[i * 352800] == i + 1 && pcm[(i + 1) * 352800 - 1] == i + 1,
+                "each distinct cue occupies exactly its scheduled phase");
+        }
+        JSONObject recording = new JSONObject(loop.recordingPlan("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"));
+        check(recording.getInt("total_frames") == 39690000, "exact 900-second recording");
+        check(recording.getJSONArray("phases").length() == 225, "225 four-second phases");
+        JSONArray last = recording.getJSONArray("phases").getJSONArray(224);
+        check(last.getInt(0) == 39513600 && last.getString(1).equals("inhale"), "last phase boundary");
+    }
+
+    private static void rejectsClockAndCueMutations() throws Exception {
+        final Fixture f = new Fixture();
+        JSONObject bad = new JSONObject(f.json.toString()); bad.put("sample_rate", 48000);
+        reject(() -> BreathingSetupAudioContract.parse(bad.toString()), "sample-rate drift");
+        JSONObject gap = new JSONObject(f.json.toString()); gap.getJSONArray("phases").getJSONObject(1).put("offset_frames", 176401);
+        reject(() -> BreathingSetupAudioContract.parse(gap.toString()), "phase gap");
+        JSONObject fractional = new JSONObject(f.json.toString()); fractional.getJSONArray("phases").getJSONObject(0).put("duration_frames", 176400.5);
+        reject(() -> BreathingSetupAudioContract.parse(fractional.toString()), "fractional phase");
+        BreathingSetupAudioContract loop = BreathingSetupAudioContract.parse(f.json.toString());
+        f.cues.get("assets/audio/inhale.wav")[100] ^= 1;
+        reject(() -> loop.loadCycle(path -> new ByteArrayInputStream(f.cues.get(path))), "bad cue hash");
+        final Fixture format = new Fixture();
+        format.cues.get("assets/audio/inhale.wav")[20] = 3;
+        format.json.getJSONArray("phases").getJSONObject(0).getJSONObject("cue")
+            .put("sha256", BreathingSetupAudioContract.sha256(format.cues.get("assets/audio/inhale.wav")));
+        BreathingSetupAudioContract invalidFormat = BreathingSetupAudioContract.parse(format.json.toString());
+        reject(() -> invalidFormat.loadCycle(path -> new ByteArrayInputStream(format.cues.get(path))), "non-PCM WAV");
+    }
+
+    private static void playbackHeadRolloverPauseAndFreshness() {
+        BreathingSetupAudioContract.PlaybackHead head = new BreathingSetupAudioContract.PlaybackHead(44100);
+        check(head.observe(0xfffffff0, 1000000000L, true) == 4294967280L, "head is unsigned");
+        check(head.observe(16, 1001000000L, true) == 4294967312L, "32-bit rollover is continuous");
+        check(head.observe(16, 2001000000L, false) == 4294967312L, "pause freezes the frame clock");
+        check(!head.fresh(2001000001L), "paused clock is unavailable");
+        check(head.observe(60, 2002000000L, true) == 4294967356L, "resume preserves cycle position");
+        check(head.fresh(2202000000L), "recent observation is usable");
+        check(!head.fresh(2302000001L), "stale observation is unavailable");
+        reject(() -> head.observe(50, 2303000000L, true), "head reset cannot fabricate rollover");
+        reject(() -> head.observe(61, 1L, true), "monotonic time cannot reorder");
+    }
+
+    private static void boundaryGateUsesFramesAndCancelsRetiredStart() {
+        BreathingSetupAudioContract.BoundaryGate gate = new BreathingSetupAudioContract.BoundaryGate();
+        gate.arm(705600L);
+        check(!gate.take(705599L, true), "no early callback");
+        check(!gate.take(705600L, false), "paused callback is deferred");
+        check(gate.take(705610L, true), "observed frame crosses the exact target");
+        check(!gate.take(705620L, true), "start fires once");
+        gate.arm(1411200L); gate.cancel();
+        check(!gate.take(1411200L, true), "retirement cancels deferred effect");
+    }
+
+    private static final class Fixture {
+        final Map<String, byte[]> cues = new HashMap<String, byte[]>();
+        final JSONObject json = new JSONObject();
+        Fixture() throws Exception {
+            json.put("schema", "atmungsraum.box_breathing_loop.v1").put("sample_rate", 44100)
+                .put("channels", 1).put("bits_per_sample", 16).put("cycle_frames", 705600).put("main_seconds", 900);
+            JSONArray phases = new JSONArray(); String[] ids = {"inhale", "hold_in", "exhale", "hold_out"};
+            for (int i = 0; i < ids.length; i++) {
+                byte[] wav = wav((byte) (i + 1)); String path = "assets/audio/" + ids[i] + ".wav";
+                cues.put(path, wav);
+                phases.put(new JSONObject().put("id", ids[i]).put("offset_frames", i * 176400).put("duration_frames", 176400)
+                    .put("cue", new JSONObject().put("path", path).put("sha256", BreathingSetupAudioContract.sha256(wav))
+                        .put("bytes", wav.length).put("frames", 176400)));
+            }
+            json.put("phases", phases);
+        }
+    }
+    private static byte[] wav(byte value) {
+        ByteBuffer b = ByteBuffer.allocate(352844).order(ByteOrder.LITTLE_ENDIAN);
+        b.put(new byte[]{82,73,70,70}).putInt(352836).put(new byte[]{87,65,86,69,102,109,116,32})
+            .putInt(16).putShort((short)1).putShort((short)1).putInt(44100).putInt(88200)
+            .putShort((short)2).putShort((short)16).put(new byte[]{100,97,116,97}).putInt(352800);
+        while (b.hasRemaining()) b.put(value);
+        return b.array();
+    }
+    private interface Action { void run() throws Exception; }
+    private static void reject(Action action, String label) {
+        try { action.run(); } catch (Exception expected) { return; }
+        throw new AssertionError("accepted " + label);
+    }
+    private static void check(boolean value, String reason) { if (!value) throw new AssertionError(reason); }
+}
