+  check(owner.openControl(),"fixture retains product open_control_default true");
+  int before=effects;JSONObject body=ping("1111111111111111","2222222222222222");write(selected,peer,body,false,true,0);Handler.drain();
+  check(selected.lastStatus!=BluetoothGatt.GATT_SUCCESS&&effects==before,"selected product rejects public open-control BLE bypass before gateway attachment");
+  for(String op:new String[]{"arm","save-next","save-exit","return-vr","open-polar"}){
+   JSONObject command=ping(ExperimentSessionBleProtocol.newHex(8),ExperimentSessionBleProtocol.newHex(8)).put("op",op);
+   if(op.equals("arm"))command.put("condition","condition-a").put("bias",50);
+   write(selected,peer,command,false,true,0);Handler.drain();check(selected.lastStatus!=0&&effects==before,"selected public BLE operation denied: "+op);
+  }
+  for(int version:new int[]{2,3,4}){write(selected,peer,new JSONObject().put("v",version),false,true,0);Handler.drain();check(selected.lastStatus!=0&&effects==before,"all legacy typed mutation versions denied before authority parsing");}
+  write(selected,peer,body,true,true,0);check(selected.lastStatus!=0,"prepared command write denied");
+  selected.callback.onExecuteWrite(peer,124,true);check(selected.lastStatus!=0,"prepared execute denied");
+  selected.callback.onExecuteWrite(peer,125,false);check(selected.lastStatus!=0,"prepared cancel acknowledges no mutation authority");
+  write(selected,peer,body,false,true,1);check(selected.lastStatus!=0,"offset command write denied");
+  int replies=selected.responses;write(selected,peer,body,false,false,0);Handler.drain();check(selected.responses==replies&&effects==before,"write without response cannot mutate");
+  owner.setOpenControl(false,context);selected=server();selected.callback.onConnectionStateChange(peer,0,2);
+  selected.callback.onCharacteristicReadRequest(peer,126,0,field(ExperimentSessionBleProtocol.CHALLENGE));String challenge=new JSONObject(new String(selected.lastBytes,"UTF-8")).getString("n"),code=owner.pairingCode();
+  check(!code.isEmpty(),"fixture possesses real legacy pair code");body=ping("3333333333333333","4444444444444444");
+  body.put("mac",codeMac(code,"RQEC1|"+challenge+"|3333333333333333|ping||0|4444444444444444"));
+  check(ExperimentSessionBleProtocol.verify(code,challenge,body.getString("id"),"ping","",0,body.getString("nonce"),body.getString("mac")),"fixture proof is cryptographically valid");
+  write(selected,peer,body,false,true,0);Handler.drain();check(selected.lastStatus!=0&&effects==before,"even valid public legacy pairing proof cannot bypass trusted-phone control");
+  final ExperimentSessionCommandJournal journal=new ExperimentSessionCommandJournal();final int[] admissions={0};
+  owner.attachCommandGateway(true);owner.gatewayBinding(new ExperimentSessionBleServer.GatewayReceiptListener(){
+   public void receipt(JSONObject receipt){try{journal.observe(receipt);}catch(Exception e){throw new RuntimeException(e);}}
+   public boolean known(JSONObject body)throws Exception{admissions[0]++;return journal.known(body);}public boolean reserve(JSONObject body)throws Exception{admissions[0]++;return journal.reserve(body);}public JSONObject original(String id)throws Exception{return journal.original(id);}
+  },"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","42");
+  write(selected,peer,body,false,true,0);Handler.drain();check(admissions[0]==0&&effects==before,"public rejection neither reserves nor adopts authenticated gateway journal");
+  String internal="5555555555555555";journal.reserve(ping(internal,"aaaaaaaaaaaaaaaa"));owner.updateReceipt(internal,"accepted","Authenticated internal carrier");owner.updateReceipt(internal,"confirmed","Internal native completion");
+  check(journal.original(internal).getString("state").equals("confirmed")&&owner.currentGeneration()>0&&owner.acceptsNativeOwner(1,7),"readonly public policy preserves internal carrier native ownership and receipt callbacks");
+  selected.callback.onCharacteristicReadRequest(peer,127,0,field(ExperimentSessionBleProtocol.STATUS));check(selected.lastStatus==0,"public readonly status still responds");
+  owner.nativeOwnerEnded(1,7);replies=selected.responses;write(selected,peer,body,false,true,0);selected.callback.onExecuteWrite(peer,128,true);Handler.drain();
+  check(selected.responses==replies&&effects==before,"retired public callbacks cannot answer or dispatch through successor owner");
+  owner=fresh(Boolean.FALSE);BluetoothGattServer queued=server();queued.callback.onConnectionStateChange(peer,0,2);body=ping("6666666666666666","7777777777777777");write(queued,peer,body,false,true,0);
+  check(queued.lastStatus==0,"legacy fixture admits a queued command before selected policy is observed");Bundle.phonePairing=Boolean.TRUE;Handler.drain();
+  check(effects==before,"actual main effect callback rechecks newly selected public denial");
+  Bundle.phonePairing=Boolean.FALSE;write(queued,peer,ping("8888888888888888","9999999999999999"),false,true,0);Handler.drain();check(queued.lastStatus!=0&&effects==before,"observed selected policy cannot reopen within the process");
+  for(Object off:new Object[]{null,Boolean.FALSE,"true",Integer.valueOf(1)}){
+   owner=fresh(off);BluetoothGattServer legacy=server();legacy.callback.onConnectionStateChange(peer,0,2);write(legacy,peer,ping(ExperimentSessionBleProtocol.newHex(8),ExperimentSessionBleProtocol.newHex(8)),false,true,0);Handler.drain();
+   check(legacy.lastStatus==0&&effects==++before,"only strict manifest Boolean true selects public denial");
+   replies=legacy.responses;legacy.callback.onExecuteWrite(peer,129,true);check(legacy.responses==replies,"legacy execute callback behavior unchanged");
+  }
+  owner=fresh(Boolean.FALSE);BluetoothGattServer stale=server();stale.callback.onConnectionStateChange(peer,0,2);write(stale,peer,ping("aaaaaaaaaaaaaaaa","bbbbbbbbbbbbbbbb"),false,true,0);owner.nativeOwnerEnded(1,7);Handler.drain();
+  check(effects==before,"legacy queued stale native owner remains fenced");
+  System.out.println("PASS "+checks+" production BLE selected admission, open/code bypass denial, write/prepare/execute, queued selection and stale-owner guards, internal carrier and strict default-off legacy checks; inert Android");
+ }
+}'''
+
+if __name__=='__main__':owner.main()
