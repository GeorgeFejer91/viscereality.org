+    );
+    assert!(r.guidance_sample(1_000_000_000).is_none());
+    for i in 1..=45_800 {
+        let now = 1_000_000_000 + i * 20_000_000;
+        r.observe_controller(3, true, now);
+        r.observe_clock(7, i * 882, now, true);
+        match i {
+            800 => {
+                let (index, start, end, target) = r.guidance_sample(now).unwrap();
+                assert_eq!((index, start, end), (0, 0, 4000));
+                assert_eq!(target.expected_phase, CommonBreathPhase::Inhale);
+                assert_eq!(target.official_active_time_ms, 0);
+                assert_eq!(target.bias_percent, 0);
+            }
+            1000 => assert_eq!(
+                r.guidance_sample(now).unwrap().3.expected_phase,
+                CommonBreathPhase::Hold
+            ),
+            1200 => assert_eq!(
+                r.guidance_sample(now).unwrap().3.expected_phase,
+                CommonBreathPhase::Exhale
+            ),
+            1400 => assert_eq!(
+                r.guidance_sample(now).unwrap().3.expected_phase,
+                CommonBreathPhase::Hold
+            ),
+            45_800 => {
+                assert!(r.guidance_sample(now).is_none());
+                assert_eq!(r.status(now)["experiment_elapsed_ms"], 900000);
+            }
+            _ => {}
+        }
+    }
+    let segments = r.guidance_segments(0, 20_000);
+    assert_eq!(segments[0], json!([0, 4000, "inhale", 0.0, 1.0]));
+    assert_eq!(segments[1], json!([4000, 8000, "hold", 1.0, 1.0]));
+    assert_eq!(segments[2], json!([8000, 12000, "exhale", 1.0, 0.0]));
+    assert_eq!(segments[3], json!([12000, 16000, "hold", 0.0, 0.0]));
+}
