+    static String mainRecordingPlan(String scenarioId) {
+        BreathingSetupAudio owner = appLifetime;
+        if (!continuousMain(scenarioId) || owner == null) return null;
+        synchronized (owner) { return owner.initialized && !owner.closed ? owner.recordingPlan : null; }
+    }
+    static long mainPlaybackPositionMs() {
+        BreathingSetupAudio owner = appLifetime;
+        return owner == null ? -1 : owner.positionMs();
+    }
+    static long mainAdmissionFrame() {
+        BreathingSetupAudio owner = appLifetime;
+        if (owner == null) return -1;
+        synchronized (owner) { return owner.closed ? -1 : owner.mainStartFrame; }
+    }
+    static void endMain(final long admittedFrame) {
+        final BreathingSetupAudio owner = appLifetime;
+        if (owner == null || admittedFrame < 0) return;
+        try { owner.call(new Callable<Boolean>() { public Boolean call() throws Exception { return owner.endMainIfCurrent(admittedFrame); } }); }
+        catch (OutcomeUncertainException uncertain) { throw uncertain; }
