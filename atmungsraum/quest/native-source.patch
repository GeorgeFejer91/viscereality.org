+fn learned_tilt_classifies_actual_motion_without_scheduled_phase_bias_and_retires_on_owner_change()
+{
+    let mut r = runtime();
+    r.observe_clock(7, 0, sample_time(0), true);
+    r.bind_source((5, 1));
+    assert_eq!(
+        command(&mut r, 1, "calibrate", sample_time(0))["accepted"],
+        true
+    );
+    for frame in (1764..=2_293_200).step_by(1764) {
+        let seconds = (frame % 705600) as f64 / 44100.0;
+        let v = if seconds < 4.0 {
+            seconds / 4.0
+        } else if seconds < 8.0 {
+            1.0
+        } else if seconds < 12.0 {
+            (12.0 - seconds) / 4.0
+        } else {
+            0.0
+        };
+        r.observe_clock(7, frame, sample_time(frame), true);
+        r.observe_acc(
+            100_000_000_000 + sample_time(frame),
+            sample_time(frame),
+            vector(v),
+        );
+    }
+    assert_eq!(r.status(sample_time(2_293_200))["calibration"], "ready");
+    assert_eq!(r.status(sample_time(2_293_200))["phase"], "hold_in");
+    for i in 1..=40 {
+        let frame = 2_293_200 + i * 1764;
+        let now = sample_time(frame);
+        r.observe_clock(7, frame, now, true);
+        r.observe_acc(100_000_000_000 + now, now, vector(1.0 - i as f64 / 50.0));
+    }
+    let now = sample_time(2_363_760);
+    assert_eq!(
+        r.phase,
+        CommonBreathPhase::Exhale,
+        "cue remains hold-in while actual signal falls"
+    );
+    assert!(matches!(
+        r.output(now),
+        SetupDriverOutput::PolarTilt {
+            phase: CommonBreathPhase::Exhale,
+            ..
+        }
+    ));
+    assert_eq!(r.status(now)["ready"], true);
+    r.bind_source((5, 2));
+    assert_eq!(r.status(now)["input"], "automatic");
+    assert_eq!(r.status(now)["ready"], false);
+    assert!(r.core.model().is_none());
+}
