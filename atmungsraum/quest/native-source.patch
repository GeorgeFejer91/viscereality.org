+                "-12"
+            ]
+        );
+        assert_eq!(rows[0][24], "500");
+        assert_eq!(rows[1][18], "");
+        assert_eq!(rows[1][21], "missing");
+        assert_eq!(
+            rows[2][15..19],
+            ["26000.000", "paused", "calibration", "230"]
+        );
+        assert_eq!(
+            rows[4][15..19],
+            ["41000.000", "playing", "instruction_2", "-31"]
+        );
+        assert!(
+            run.finalize_csv(directory, anchor, end, false, "save-and-exit")
+                .is_err()
+        );
+    }
