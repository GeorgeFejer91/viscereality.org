+struct ValidatedCheckpoint {
+    value: Value,
+    completed: bool,
+    lengths: BTreeMap<String, u64>,
+    error: Option<String>,
+}
+
+pub(crate) fn participant_checkpoint(
+    directory: &Path,
+    started_at: &SessionTimestampKey,
+) -> Result<Option<(Value, Value)>, String> {
+    let original = read_json(&directory.join("manifest.json"))?;
+    if original.get("participant").is_none() {
+        return Ok(None);
+    }
+    let manifest = validate_manifest_value(&original, started_at)?;
+    let Some(checkpoint) = latest_valid_checkpoint(directory, started_at, &manifest)? else {
+        return Ok(None);
+    };
+    if checkpoint.error.is_some() {
+        return Ok(None);
+    }
+    Ok(Some((original, checkpoint.value)))
