+            "expected_gateway_lifecycle_revision","expected_enrollment_reference",provision?"hardware_serial":"trusted_lan_consent"};
+        if(request.length()!=fields.length)throw new SecurityException("headset-setup-unexpected-field");
+        for(String field:fields){
+            Object value=request.opt(field);
+            if(field.equals("trusted_lan_consent")){if(!Boolean.TRUE.equals(value))throw new SecurityException("trusted-lan-consent-required");}
+            else if(field.matches("expected_(pid|uid|process_start_ticks|runtime_epoch|generation|native_owner_identity|gateway_lifecycle_revision)")){
+                if(!(value instanceof Integer)&&!(value instanceof Long)||((Number)value).longValue()<0
+                    ||((Number)value).longValue()==0&&!field.equals("expected_generation"))throw new SecurityException("headset-setup-integer-field-required");
+            }else if(!(value instanceof String))throw new SecurityException("headset-setup-string-field-required");
+        }
+        if(!"rusty.quest.experiment_session.operator_command.v1".equals(request.getString("schema")))throw new SecurityException("headset-setup-schema-invalid");
+        if(!read&&(!ExperimentSessionBleProtocol.isLowerHex(request.getString("operation_id"),16)
+            ||!ExperimentSessionBleProtocol.isLowerHex(request.getString("expected_enrollment_reference"),32)
+            ||!ExperimentSessionBleProtocol.isLowerHex(request.getString("expected_apk_sha256"),64)
+            ||!ExperimentSessionBleProtocol.isLowerHex(request.getString("expected_binding_sha256"),64)
+            ||!"shell-headset-setup-v1".equals(request.getString("operator_origin"))))throw new SecurityException("headset-setup-binding-invalid");
+        if(provision&&!ExperimentSessionHeadsetIdentity.valid(request.getString("hardware_serial")))throw new SecurityException("hardware-serial-invalid");
+    }
+    static void validateActorFacts(JSONObject r,long pid,long uid,long birth,String apk)throws Exception{
+        if(r.getLong("expected_pid")!=pid||r.getLong("expected_uid")!=uid||r.getLong("expected_process_start_ticks")!=birth||!r.getString("expected_apk_sha256").equals(apk))
+            throw new SecurityException("headset-setup-actor-apk-changed");
+    }
+    static void validateSession(JSONObject r,JSONObject current,JSONObject breath)throws Exception{
+        Object generation=current.opt("generation"),runtime=current.opt("runtime_epoch");
+        if((!(generation instanceof Integer)&&!(generation instanceof Long))||(!(runtime instanceof Integer)&&!(runtime instanceof Long)))
+            throw new SecurityException("headset-setup-native-integer-required");
+        if(!Boolean.TRUE.equals(breath.opt("feature_lock_active"))||!Boolean.TRUE.equals(breath.opt("activation_binding_matches"))
+                ||!r.getString("expected_binding_sha256").equals(breath.opt("activation_binding_sha256"))
+                ||!"idle".equals(current.opt("phase"))||!"idle".equals(current.opt("control_state"))
+                ||!current.has("condition_id")||!current.has("non_audio_profile_sha256")||!current.has("session_key")||!current.isNull("session_key")
+                ||r.getLong("expected_runtime_epoch")!=current.getLong("runtime_epoch")||r.getLong("expected_generation")!=current.getLong("generation")
+                ||!"-".equals(r.getString("expected_session_key"))
+                ||!r.getString("expected_condition").equals(current.isNull("condition_id")?"":current.getString("condition_id"))
+                ||!r.getString("expected_profile_sha256").equals(current.isNull("non_audio_profile_sha256")?"":current.getString("non_audio_profile_sha256")))
