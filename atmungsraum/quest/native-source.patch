+//! Opt-in immutable particle rendering defaults, independent of product UI and inputs.
+use crate::native_renderer_stimulus_panel::{
+    parse_private_particle_dynamics_json, PrivateParticleDynamicsPanelCandidate,
+    PRIVATE_PARTICLE_DYNAMICS_SCHEMA,
+};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::sync::OnceLock;
+
+#[derive(Debug)]
+pub(crate) struct ParticleVisualProfile {
+    candidate: PrivateParticleDynamicsPanelCandidate,
+    radius: [f32; 2],
+    gain: [f32; 3],
+}
+
+impl ParticleVisualProfile {
+    pub(crate) fn parse(raw: &str) -> Result<Self, String> {
+        let mut value: Value = serde_json::from_str(raw).map_err(|_| "particle_profile_json")?;
+        let bounded = |v: &Value, low: f64, high: f64| -> Result<f32, String> {
+            v.as_f64()
+                .filter(|v| v.is_finite() && *v >= low && *v <= high)
+                .map(|v| v as f32)
+                .ok_or_else(|| "particle_profile_range".into())
+        };
+        let radius = [
+            bounded(&value["radius"]["minimum_m"], 0.01, 100.0)?,
+            bounded(&value["radius"]["maximum_m"], 0.01, 100.0)?,
+        ];
+        if radius[1] < radius[0] {
+            return Err("particle_profile_radius_order".into());
+        }
+        let mode = match value["frame_extension"]["mode"].as_str() {
+            Some("constant") => 0.0,
+            Some("radius") => 1.0,
+            _ => return Err("particle_profile_extension_mode".into()),
+        };
+        let gain = [
+            mode,
+            bounded(&value["frame_extension"]["endpoint_gain"], 0.0, 8.0)?,
+            bounded(&value["frame_extension"]["midpoint_gain"], 0.0, 8.0)?,
+        ];
+        let object = value.as_object_mut().ok_or("particle_profile_object")?;
+        object.remove("radius");
+        object.remove("frame_extension");
+        let mut candidate = parse_private_particle_dynamics_json(
+            &json!({
+                "schema": PRIVATE_PARTICLE_DYNAMICS_SCHEMA, "revision": 1,
+                "private_particles": value,
+            })
+            .to_string(),
+        )?;
+        // These defaults never reset simulation or acquire breath/anchor authority.
+        candidate.update_mask.full_snapshot = false;
+        candidate.update_mask.world_anchor_scale_m = false;
+        candidate.update_mask.driver_values01[0] = false;
+        Ok(Self {
+            candidate,
+            radius,
+            gain,
+        })
+    }
+    pub(crate) fn candidate(&self) -> PrivateParticleDynamicsPanelCandidate {
+        self.candidate.clone()
+    }
+    pub(crate) fn radius_m(&self, progress: f32) -> f32 {
+        self.radius[0] + (self.radius[1] - self.radius[0]) * progress.clamp(0.0, 1.0)
+    }
+    pub(crate) fn extension(&self, progress: f32) -> [[f32; 4]; 2] {
+        [
+            [7601.0, 1.0, 1.0, self.gain[0]],
+            [progress.clamp(0.0, 1.0), self.gain[1], self.gain[2], 0.0],
+        ]
+    }
+}
+
+pub(crate) fn packaged() -> Result<&'static ParticleVisualProfile, &'static str> {
+    static PROFILE: OnceLock<Result<ParticleVisualProfile, String>> = OnceLock::new();
+    PROFILE
+        .get_or_init(|| {
+            let raw = include_str!(concat!(env!("OUT_DIR"), "/particle-visual-profile.json"));
+            let expected =
+                option_env!("RUSTY_QUEST_NATIVE_RENDERER_PRIVATE_PARTICLE_VISUAL_PROFILE_SHA256")
+                    .unwrap_or("");
+            if format!("{:x}", Sha256::digest(raw.as_bytes())) != expected {
+                return Err("particle_profile_digest_mismatch".into());
+            }
+            ParticleVisualProfile::parse(raw)
+        })
+        .as_ref()
+        .map_err(String::as_str)
+}
+
