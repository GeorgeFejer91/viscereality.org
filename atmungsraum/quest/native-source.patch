+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.app.Activity;
+
+/** Selected SDK207 transport. The startup coordinator owns all policy/timers. */
+public final class NativeRendererMetaPlatformTransport implements AutoCloseable {
+    public static final int TYPE_INITIALIZE=1, TYPE_VERSION=2, TYPE_DOWNLOAD=3,
+            TYPE_PROGRESS=4, TYPE_INSTALL=5, TYPE_CANCEL=6;
+    private static boolean acquired;
+    private boolean closed, initialized;
+    private long attempt;
+
+    public NativeRendererMetaPlatformTransport() {
+        synchronized (NativeRendererMetaPlatformTransport.class) {
+            if (acquired) throw new IllegalStateException("Meta SDK queue already owned in this process");
+            System.loadLibrary("rusty_quest_meta_platform");
+            acquired=true;
+        }
+    }
+    public synchronized boolean beginAttempt(long value) {
+        if(closed||attempt!=0||value<=0||!nativeBeginAttempt(value))return false;
+        attempt=value;return true;
+    }
+    public synchronized void retireAttempt(long value) {
+        if(value>0&&value==attempt){nativeRetireAttempt(value);attempt=0;}
+    }
+    public synchronized long initialize(Activity activity, String appId) {
+        if (closed || attempt<=0 || initialized || activity==null || appId==null || !appId.matches("[1-9][0-9]{0,19}"))
+            throw new IllegalStateException("Invalid Meta initialization owner or app ID");
+        initialized=true;
+        return nativeRequest(attempt,TYPE_INITIALIZE,activity,appId);
+    }
+    private long request(int type) {
+        if (closed || attempt<=0 || !initialized) throw new IllegalStateException("Meta transport inactive");
+        return nativeRequest(attempt,type,null,null);
+    }
+    public synchronized long getVersion(){return request(TYPE_VERSION);}
+    public synchronized long startDownload(){return request(TYPE_DOWNLOAD);}
+    public synchronized long checkProgress(){return request(TYPE_PROGRESS);}
+    public synchronized long installUpdateAndRelaunch(){return request(TYPE_INSTALL);}
+    public synchronized long cancelDownload(){return request(TYPE_CANCEL);}
+    public synchronized Message poll(){return closed ? null : nativePoll();}
+    public synchronized void close(){if(!closed){closed=true;nativeClose();}}
+
+    public static final class Message {
+        public final long requestId, downloadedBytes, totalBytes;
+        public final int type, sdkMessageType, errorCode, resultCode, progressStatus, httpCode;
+        public final String errorMessage, currentCode, availableCode, installResult;
+        public Message(long requestId,int type,int sdkMessageType,int errorCode,String errorMessage,
+                String currentCode,String availableCode,long downloadedBytes,long totalBytes,int resultCode,int progressStatus) {
+            this(requestId,type,sdkMessageType,errorCode,errorMessage,currentCode,availableCode,downloadedBytes,totalBytes,resultCode,progressStatus,0,"UNKNOWN");
+        }
+        public Message(long requestId,int type,int sdkMessageType,int errorCode,String errorMessage,
+                String currentCode,String availableCode,long downloadedBytes,long totalBytes,int resultCode,int progressStatus,int httpCode,String installResult) {
+            this.requestId=requestId;this.type=type;this.sdkMessageType=sdkMessageType;this.errorCode=errorCode;
+            this.installResult=installResult!=null&&installResult.matches("UNKNOWN|LOW_STORAGE|NETWORK_ERROR|DUPLICATE_REQUEST|INSTALLER_ERROR|USER_CANCELLED|AUTHORIZATION_ERROR|SUCCESS")?installResult:"UNKNOWN";
+            this.httpCode=httpCode>=100&&httpCode<=599?httpCode:0;
+            this.errorMessage=this.installResult;this.currentCode=currentCode;this.availableCode=availableCode;
+            this.downloadedBytes=downloadedBytes;this.totalBytes=totalBytes;this.resultCode=resultCode;this.progressStatus=progressStatus;
+        }
+    }
+    private static native boolean nativeBeginAttempt(long attempt);
+    private static native void nativeRetireAttempt(long attempt);
+    private static native long nativeRequest(long attempt,int operation,Activity activity,String appId);
+    private static native Message nativePoll();
+    private static native void nativeClose();
+}
