diff --git a/apps/native-renderer-android/native/src/meta_update_admission.rs b/apps/native-renderer-android/native/src/meta_update_admission.rs
new file mode 100644
index 00000000..61beb1b0
--- /dev/null
+++ b/apps/native-renderer-android/native/src/meta_update_admission.rs
@@ -0,0 +1,643 @@
+//! Process-local preparation cycle authority. No lock spans SDK, writer, or audio callbacks.
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Default)]
+struct Admission {
+    attempt: u64,
+    attempt_cycle: u64,
+    phase: u8, // 0 unselected, 1 maintenance, 2 granted, 3 irreversible, 4 requires, 5 park, 6 failed writer
+    session_seen: bool,
+    queued: u64,
+    owner: Option<(u64, u64)>,
+    retired_owner: Option<(u64, u64)>,
+    cycle: u64,
+    revision: u64,
+}
+impl Admission {
+    fn select(&mut self) -> bool {
+        if self.phase != 0 || self.session_seen {
+            return false;
+        }
+        self.cycle = 1;
+        self.revision = 1;
+        self.phase = 4;
+        true
+    }
+    fn begin(&mut self, attempt: u64, cycle: u64, revision: u64, owner: (u64, u64)) -> bool {
+        if attempt == 0
+            || attempt == self.attempt
+            || cycle != self.cycle
+            || revision != self.revision
+            || self.session_seen
+            || self.queued > 0
+            || !matches!(self.phase, 2 | 4)
+            || owner.0 == 0
+            || owner.1 == 0
+        {
+            return false;
+        }
+        self.attempt = attempt;
+        self.attempt_cycle = self.cycle;
+        self.owner = Some(owner);
+        self.phase = 1;
+        self.bump();
+        true
+    }
+    fn bump(&mut self) {
+        if let Some(next) = self.revision.checked_add(1) {
+            self.revision = next;
+        } else {
+            self.phase = 3;
+        }
+    }
+    fn exact(&self, attempt: u64, cycle: u64, revision: u64) -> bool {
+        attempt > 0 && attempt == self.attempt && cycle == self.cycle && revision == self.revision
+    }
+    fn valid(&self, attempt: u64, cycle: u64, revision: u64, owner: (u64, u64)) -> bool {
+        self.exact(attempt, cycle, revision)
+            && matches!(self.phase, 1 | 3)
+            && self.owner == Some(owner)
+    }
+    fn grant(&mut self, attempt: u64, cycle: u64, revision: u64) -> bool {
+        if self.phase != 1 || !self.exact(attempt, cycle, revision) {
+            return false;
+        }
+        self.phase = 2;
+        self.bump();
+        true
+    }
+    fn block(&mut self, attempt: u64, cycle: u64, revision: u64) -> bool {
+        if self.phase != 1 || !self.exact(attempt, cycle, revision) {
+            return false;
+        }
+        self.phase = 4;
+        self.bump();
+        true
+    }
+    fn terminal_success(&mut self) {
+        if self.phase != 2 || !self.session_seen {
+            return;
+        }
+        if let Some(next) = self.cycle.checked_add(1) {
+            self.cycle = next;
+            self.phase = 5;
+            self.bump();
+        } else {
+            self.phase = 3;
+        }
+        self.owner = None;
+        self.queued = 0;
+    }
+    fn park_ack(&mut self, cycle: u64) -> bool {
+        if self.phase != 5 || self.cycle != cycle {
+            return false;
+        }
+        self.phase = 4;
+        self.session_seen = false;
+        self.bump();
+        true
+    }
+    fn reserve(&mut self, cycle: u64) -> bool {
+        if cycle != self.cycle || !matches!(self.phase, 0 | 2) {
+            return false;
+        }
+        match self.queued.checked_add(1) {
+            Some(next) => {
+                self.queued = next;
+                true
+            }
+            None => false,
+        }
+    }
+    fn unreserve(&mut self, cycle: u64) {
+        if self.cycle == cycle {
+            self.queued = self.queued.saturating_sub(1);
+        }
+    }
+    fn session(&mut self) -> bool {
+        if !matches!(self.phase, 0 | 2) {
+            return false;
+        }
+        self.session_seen = true;
+        true
+    }
+    fn matches(&self, attempt: u64) -> bool {
+        attempt > 0 && self.attempt == attempt && self.phase == 1
+    }
+    fn bind(&mut self, attempt: u64, owner: (u64, u64)) -> bool {
+        if !self.matches(attempt) || owner.0 == 0 || owner.1 == 0 {
+            return false;
+        }
+        if let Some(bound) = self.owner {
+            return bound == owner;
+        }
+        self.owner = Some(owner);
+        true
+    }
+    fn install(&mut self, attempt: u64, owner: (u64, u64)) -> bool {
+        if !self.matches(attempt) || self.owner != Some(owner) {
+            return false;
+        }
+        self.phase = 3;
+        true
+    }
+    fn external_install(&mut self, attempt: u64) -> bool {
+        if attempt > 0 && self.attempt == attempt && self.phase != 0 {
+            self.phase = 3;
+            true
+        } else {
+            false
+        }
+    }
+    fn retire_owner(&mut self, owner: (u64, u64)) {
+        if owner.0 == 0
+            || owner.1 == 0
+            || self.retired_owner == Some(owner)
+            || self.owner.is_some_and(|bound| bound != owner)
+            || !matches!(self.phase, 1 | 2 | 4)
+        {
+            return;
+        }
+        if self.session_seen {
+            // Preserve admitted preparation/writer lineage; retirement cannot manufacture a safe cycle.
+            self.phase = 6;
+        } else if let Some(next) = self.cycle.checked_add(1) {
+            self.cycle = next;
+            self.phase = 4;
+            self.queued = 0;
+        } else {
+            self.phase = 3;
+        }
+        self.owner = None;
