+        if(reference.isEmpty()||!reference.equals(request.getString("expected_enrollment_reference"))
+                ||android.os.SystemClock.elapsedRealtime()<observed||android.os.SystemClock.elapsedRealtime()>deadline)
+            throw new SecurityException("headset-setup-offer-stale");
+        // Admission consumes the offer and operation ID before any possibly unknown effect.
+        if(ids.size()>=128||!ids.add(request.getString("operation_id")))throw new SecurityException("headset-setup-no-replay");
