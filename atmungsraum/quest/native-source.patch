+#[path = "session_recording_participant/live_csv.rs"]
+pub(crate) mod live_csv;
+
+const CSV_SCHEMA_VERSION: u64 = 3;
+const NANOS_PER_SECOND: u64 = 1_000_000_000;
+const EXPLORATION_SAMPLE_RATE: u64 = 44_100;
+const EXPLORATION_FRAMES: u64 = 19_715_793;
+const HEADER: &str = "schema_version,participant_id,session_id,run_index,scenario_id,record_type,timestamp_utc,elapsed_us,audio_elapsed_us,playback_state,audio_phase,sensor_time_ns,sensor_frame_sequence,sensor_sample_index,ecg_uv,acc_x_mg,acc_y_mg,acc_z_mg,render_frame,radius_m,breathing_phase,session_status,end_reason,signal_reason\r\n";
+pub(crate) const RECOVERY_RECEIPT: &str = "participant-recovered.json";
