+fn hard_runtime_barriers_clear_callback_confirmed_phase_memory() {
+    for barrier in [
+        "source-owner",
+        "source-selection",
+        "source-retired",
+        "audio-generation",
+        "audio-pause",
+        "clock-reversed",
+        "projection-generation",
+        "retry",
+        "controller",
+        "end-main",
+    ] {
+        let (mut r, frame, now) = calibrated_inhale_runtime();
+        assert!(
+            r.last_confirmed_phase.is_some(),
+            "fixture must have sensor-confirmed state"
+        );
+        match barrier {
+            "source-owner" => r.bind_source((6, 1)),
+            "source-selection" => r.bind_source((5, 2)),
+            "source-retired" => r.bind_source((0, 2)),
+            "audio-generation" => r.observe_clock(8, frame + 1764, now + 40_000_000, true),
+            "audio-pause" => r.observe_clock(7, frame, now + 40_000_000, false),
+            "clock-reversed" => r.observe_clock(7, frame - 1, now + 40_000_000, true),
+            "projection-generation" => {
+                // The owning SensorClock retirement path also invalidates the
+                // model. Independently protect the confirmed-memory binding.
+                r.projection_generation = Some(4);
+                r.refresh(now);
+            }
+            "end-main" => {
+                assert_eq!(command(&mut r, 2, "begin-main", now)["accepted"], true);
+                let s = r.status(now);
+                let receipt = r.command(
+                    &json!({"v":1,"id":"0000000000000003","g":s["g"],"r":s["r"],
+                    "op":"end-main","main_start_frame":r.last_admitted_frame.unwrap()}),
+                    now,
+                );
+                assert_eq!(receipt["accepted"], true, "{receipt}");
+            }
+            op => assert_eq!(
+                command(&mut r, 2, if op == "retry" { "calibrate" } else { op }, now)["accepted"],
+                true,
+                "barrier command {op}"
+            ),
+        }
+        assert_eq!(r.last_confirmed_phase, None, "barrier {barrier}");
+        if let SetupDriverOutput::PolarTilt {
+            confirmed_phase, ..
+        } = r.output(now + 40_000_000)
+        {
+            assert_eq!(confirmed_phase, None, "output after {barrier}");
+        }
+    }
+}
