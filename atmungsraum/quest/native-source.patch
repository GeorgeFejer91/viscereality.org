+                        BreathingSetupAudioContract.sha256(bytes), cycle, new StaticPlayer(), JNI,
+                        new Clock() { public long nowNs() { return SystemClock.elapsedRealtimeNanos(); } });
+                    synchronized (BreathingSetupAudio.class) { appLifetime = owner; }
+                    owner.worker.execute(new Runnable() { @Override public void run() {
+                        try {
+                            owner.initialize();
+                            owner.worker.scheduleWithFixedDelay(new Runnable() { public void run() { owner.observe(); } },
+                                0L, 20L, TimeUnit.MILLISECONDS);
+                        } catch (Throwable error) { owner.fail("breathing-loop-initialization-failed"); }
+                    } });
