+            // Once admitted, an Android/native call may already have an effect. False would
+            // incorrectly promise rejection; the caller must fence/cancel the uncertain request.
+            throw new OutcomeUncertainException(timeout);
+        } catch (InterruptedException interrupted) {
+            boolean cancelled = request.cancelQueued();
+            if (cancelled) future.cancel(false);
+            Thread.currentThread().interrupt();
+            if (cancelled) throw interrupted;
+            throw new OutcomeUncertainException(interrupted);
+        }
+    }
+    static final class OutcomeUncertainException extends IllegalStateException {
+        OutcomeUncertainException(Throwable cause) { super("breathing-loop-command-outcome-uncertain", cause); }
+    }
+    /** Cancellation and owner admission race on this token before any submitted effect. */
+    private static final class Request<T> implements Callable<T> {
+        private final AtomicInteger admission = new AtomicInteger(0); // queued, admitted, cancelled, completed
+        private final Callable<T> action;
+        Request(Callable<T> action) { this.action = action; }
+        boolean cancelQueued() { return admission.compareAndSet(0, 2); }
+        public T call() throws Exception {
+            if (!admission.compareAndSet(0, 1)) throw new CancellationException("breathing-loop-request-cancelled");
+            try { return action.call(); }
+            finally { admission.set(3); }
+        }
+    }
