+    pub(crate) calibration_start_frame: Option<u64>,
+    pub(crate) calibration_completed_frames: u64,
+    pub(crate) calibration_target_frames: u64,
+    pub(crate) accepted_samples: usize,
+    pub(crate) failure: Option<SetupFailure>,
+    pub(crate) source_owner: Option<u64>,
+    pub(crate) model_generation: Option<u64>,
+    pub(crate) experiment: ExperimentState,
+    pub(crate) experiment_start_frame: Option<u64>,
+    pub(crate) experiment_completed_frames: u64,
+    pub(crate) experiment_target_frames: u64,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+pub(crate) struct QualityStatus {
+    pub(crate) masked: u64,
+    pub(crate) motion: u64,
+    pub(crate) timing: u64,
+    pub(crate) invalid: u64,
+    pub(crate) warning: &'static str,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct TiltSample {
+    pub(crate) input: SetupInput,
+    pub(crate) volume: f64,
+    pub(crate) phase: Option<SetupPhase>,
+    pub(crate) source_owner: Option<u64>,
+    pub(crate) model_generation: Option<u64>,
+    pub(crate) source_timestamp_ns: u64,
+}
+
+// Conservative engineering admission limits, not physiological/clinical bounds.
+// A 25 Hz training grid gives equal time weighting and a hard 800 sample bound.
+const CLOCK_FRESH_NS: u64 = 250_000_000;
+const SIGNAL_FRESH_NS: u64 = 200_000_000;
+const ALIGNMENT_TOLERANCE_NS: u64 = 150_000_000;
+const TRAINING_STEP_NS: u64 = 40_000_000;
+const MAX_TILT_SPEED_PER_S: f64 = 0.60; // normalized gravity chord / second
+const MAX_TRAINING_SAMPLES: usize = 800;
+// Buffered source history and packet delivery use the existing 250 ms bridge
+// envelope. These are distinct from 200 ms actual-sample freshness/gaps and
+// 150 ms sensor/host clock drift. History never extrapolates audio frames.
+const BUFFERED_HISTORY_NS: u64 = CLOCK_FRESH_NS;
+const MAX_AUDIO_HISTORY: usize = 32;
+const MAX_PENDING_TRAINING: usize = 64;
+const GRAVITY_TAU_S: f64 = 0.10;
+const SETTLE_NS: u64 = 200_000_000;
+const MIN_WINDOW_SAMPLES: usize = 600;
+const MIN_CYCLE_SAMPLES: usize = 280;
+const MIN_PHASE_SAMPLES: usize = 60;
+const MIN_RAMP_ENDPOINT_SAMPLES: usize = 6;
+
+#[derive(Debug)]
+pub(crate) struct TiltModel {
+    pub(crate) source_owner: u64,
+    pub(crate) generation: u64,
+    pub(crate) axis: [f64; 3],
+    pub(crate) low: f64,
+    pub(crate) high: f64,
+}
+impl TiltModel {
+    pub(crate) fn project(&self, vector_g: [f64; 3]) -> Option<f64> {
+        let unit = gravity_direction(vector_g)?;
+        Some(((dot(unit, self.axis) - self.low) / (self.high - self.low)).clamp(0.0, 1.0))
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct AudioClock {
+    generation: u64,
+    frame: u64,
+    host_ns: u64,
+    playing: bool,
+    advanced_ns: u64,
+    observed_advance_ns: Option<u64>,
+    healthy: bool,
+    fault: Option<SetupFailure>,
+}
+#[derive(Debug, Clone, Copy)]
+struct AccObservation {
+    sensor_ns: u64,
+    host_ns: u64,
+    unit: [f64; 3],
+}
+#[derive(Debug, Clone, Copy)]
+struct TrainingSample {
+    frame: u64,
+    unit: [f64; 3],
+}
+
+pub(crate) struct BreathingSetup {
+    schedule: LoopSchedule,
+    clock: Option<AudioClock>,
+    ever_played: bool,
+    audio_advance_required: bool,
+    quality: QualityStatus,
+    quality_slot_flags: [u8; MAX_TRAINING_SAMPLES],
+    quality_sample_frame: Option<u64>,
+    gravity_estimate: Option<[f64; 3]>,
+    settle_until_sensor_ns: Option<u64>,
+    settle_reason: SetupFailure,
+    clock_history: VecDeque<AudioClock>,
+    pending_training: VecDeque<AccObservation>,
+    delivery_witness_ns: Option<u64>,
+    calibration_last_mapped_frame: Option<u64>,
+    input: SetupInput,
+    calibration: CalibrationState,
+    calibration_generation: u64,
+    calibration_start_frame: Option<u64>,
+    calibration_completed_frames: u64,
+    failure: Option<SetupFailure>,
+    source_owner: Option<u64>,
+    model: Option<TiltModel>,
+    live: Option<AccObservation>,
+    last_acc: Option<AccObservation>,
+    motion_continuity: bool,
+    phase_history_epoch: u64,
+    // Technical retirement is stronger than a recoverable quality mask.
+    evidence_retirement_epoch: u64,
+    alignment_anchor: Option<(u64, u64)>,
+    signal_resume_ns: Option<u64>,
+    samples: Vec<TrainingSample>,
+    last_training_slot: Option<u64>,
+    experiment: ExperimentState,
+    experiment_start_frame: Option<u64>,
+    experiment_completed_frames: u64,
+}
+impl BreathingSetup {
+    pub(crate) fn new(schedule: LoopSchedule) -> Self {
+        Self {
+            schedule,
+            clock: None,
+            ever_played: false,
+            audio_advance_required: false,
+            quality: QualityStatus::default(),
+            quality_slot_flags: [0; MAX_TRAINING_SAMPLES],
+            quality_sample_frame: None,
+            gravity_estimate: None,
+            settle_until_sensor_ns: None,
+            settle_reason: SetupFailure::ExcessiveMotion,
+            clock_history: VecDeque::with_capacity(MAX_AUDIO_HISTORY),
+            pending_training: VecDeque::with_capacity(MAX_PENDING_TRAINING),
+            delivery_witness_ns: None,
+            calibration_last_mapped_frame: None,
+            input: SetupInput::Automatic,
+            calibration: CalibrationState::Idle,
+            calibration_generation: 0,
+            calibration_start_frame: None,
+            calibration_completed_frames: 0,
+            failure: None,
+            source_owner: None,
+            model: None,
+            live: None,
+            last_acc: None,
+            motion_continuity: false,
+            phase_history_epoch: 0,
+            evidence_retirement_epoch: 0,
+            alignment_anchor: None,
+            signal_resume_ns: None,
+            samples: Vec::with_capacity(MAX_TRAINING_SAMPLES),
+            last_training_slot: None,
+            experiment: ExperimentState::Preparation,
+            experiment_start_frame: None,
+            experiment_completed_frames: 0,
+        }
+    }
+
+    pub(crate) fn observe_clock(
+        &mut self,
+        audio_generation: u64,
+        absolute_frame: u64,
+        monotonic_ns: u64,
+        playing: bool,
+    ) {
+        let mut advanced_ns = monotonic_ns;
+        let mut healthy = true;
+        let mut fault = None;
+        let mut plausible_forward = false;
+        let mut observed_advance_ns = self
+            .clock
+            .filter(|clock| clock.generation == audio_generation)
+            .and_then(|clock| clock.observed_advance_ns);
+        if let Some(previous) = self.clock {
+            if audio_generation < previous.generation {
+                self.fail(SetupFailure::ClockRetired);
+                self.clock_history.clear();
+                if let Some(clock) = &mut self.clock {
+                    clock.healthy = false;
+                    clock.fault = Some(SetupFailure::ClockRetired);
+                }
+                return;
+            }
+            if audio_generation != previous.generation {
+                self.fail(SetupFailure::ClockRetired);
+                self.reset_sample_continuity();
+            } else if monotonic_ns < previous.host_ns || absolute_frame < previous.frame {
+                self.fail(SetupFailure::ClockReversed);
+                healthy = false;
+                fault = Some(SetupFailure::ClockReversed);
+            } else {
+                let elapsed = monotonic_ns - previous.host_ns;
+                let advanced = absolute_frame - previous.frame;
+                let plausible = frames_for_ns(elapsed, self.schedule.sample_rate)
+                    .saturating_add(u64::from(self.schedule.sample_rate) / 10);
+                if advanced > plausible
+                    || (!previous.playing && !playing && advanced > 0)
+                    || (!previous.playing
+                        && playing
+                        && advanced > u64::from(self.schedule.sample_rate) / 10)
+                {
+                    self.fail(SetupFailure::ClockReversed);
+                    healthy = false;
+                    fault = Some(SetupFailure::ClockReversed);
+                } else if previous.playing && elapsed > CLOCK_FRESH_NS {
+                    self.fail(SetupFailure::ClockStale);
+                    fault = Some(SetupFailure::ClockStale);
+                }
+                if playing && previous.playing && advanced == 0 {
+                    advanced_ns = previous.advanced_ns;
+                    if monotonic_ns.saturating_sub(advanced_ns) > CLOCK_FRESH_NS {
+                        self.fail(SetupFailure::ClockStalled);
+                        healthy = false;
+                        fault = Some(SetupFailure::ClockStalled);
+                    }
+                }
+                plausible_forward = healthy
+                    && playing
+                    && previous.playing
+                    && advanced > 0
+                    && elapsed > 0
+                    && elapsed <= CLOCK_FRESH_NS;
+                if plausible_forward {
+                    observed_advance_ns = Some(monotonic_ns);
+                }
+                if previous.playing != playing {
+                    if previous.playing && !playing && self.calibration_active() {
+                        self.fail(SetupFailure::AudioPaused);
+                    }
+                    // An explicit pause breaks motion/gap continuity, not the
+                    // source's timestamp order or sensor/host clock lineage.
+                    self.motion_continuity = false;
+                    self.live = None;
+                    self.signal_resume_ns = playing.then_some(monotonic_ns);
+                    self.delivery_witness_ns = playing.then_some(monotonic_ns);
+                }
+            }
+        }
+        if self.audio_advance_required {
+            if plausible_forward {
+                self.audio_advance_required = false;
+            } else {
+                healthy = false;
+                fault = Some(SetupFailure::ClockStale);
+            }
+        }
+        let continuous = self.clock.is_some_and(|previous| {
+            healthy
+                && previous.healthy
+                && playing
+                && previous.playing
+                && previous.generation == audio_generation
+                && monotonic_ns >= previous.host_ns
+                && monotonic_ns - previous.host_ns <= CLOCK_FRESH_NS
+        });
+        if !continuous {
+            self.clock_history.clear();
+            self.pending_training.clear();
+        }
+        self.clock = Some(AudioClock {
+            generation: audio_generation,
+            frame: absolute_frame,
+            host_ns: monotonic_ns,
+            playing,
+            advanced_ns,
+            observed_advance_ns,
+            healthy,
+            fault,
+        });
+        if !healthy || !playing {
+            return;
+        }
+        self.ever_played = true;
+        self.remember_clock();
+
+        if self.calibration == CalibrationState::Waiting {
+            if let Some(start) = self.calibration_start_frame {
+                if absolute_frame >= start {
+                    self.calibration = CalibrationState::Collecting;
+                    self.quality = QualityStatus::default();
+                    self.quality_slot_flags.fill(0);
+                }
+            }
+        }
+        self.flush_pending_training();
+        if (self.model.is_some()
+            || self.input.pretrained()
+            || matches!(
+                self.calibration,
+                CalibrationState::Waiting | CalibrationState::Collecting
+            ))
+            && self
+                .delivery_witness_ns
+                .is_some_and(|last| monotonic_ns.saturating_sub(last) > BUFFERED_HISTORY_NS)
+        {
+            self.live = None;
+            self.quality.warning = "timing";
+            if self.input.is_polar()
+                && !self.calibration_active()
+                && matches!(
+                    self.experiment,
+                    ExperimentState::Waiting | ExperimentState::Running
+                )
+            {
+                self.experiment = ExperimentState::Invalidated;
+                self.failure = Some(SetupFailure::SignalGap);
+            }
+        }
+        if self.calibration == CalibrationState::Collecting {
+            let start = self.calibration_start_frame.unwrap();
+            self.calibration_completed_frames = absolute_frame
+                .saturating_sub(start)
+                .min(self.calibration_target_frames());
+            let end = start + self.calibration_target_frames();
+            // One 25 Hz training interval bounds the last in-window evidence.
+            // End-of-audio alone cannot fit a missing final packet. Late valid
+            // history can finish within the separate bounded delivery window.
+            let tail_observed = self.calibration_last_mapped_frame.is_some_and(|last| {
+                last >= end
+                    .saturating_sub(frames_for_ns(TRAINING_STEP_NS, self.schedule.sample_rate))
+            });
+            let tail_expired = absolute_frame.saturating_sub(end)
+                >= frames_for_ns(BUFFERED_HISTORY_NS, self.schedule.sample_rate);
+            if absolute_frame >= end && (tail_observed || tail_expired) {
+                match self.fit_model() {
+                    Ok(model) => {
+                        self.model = Some(model);
+                        self.calibration = CalibrationState::Succeeded;
+                        self.input = SetupInput::PolarTilt;
+                        self.failure = None;
+                    }
+                    Err(error) => self.fail(self.final_quality_failure(error)),
+                }
+            }
+        }
+        if (self.model.is_some()
+            || self.input.pretrained()
+            || self.calibration == CalibrationState::Collecting)
+            && self
+                .signal_resume_ns
+                .is_some_and(|resumed| monotonic_ns.saturating_sub(resumed) > SIGNAL_FRESH_NS)
+        {
+            self.mask_quality(SetupFailure::SignalGap);
+            if matches!(
+                self.experiment,
+                ExperimentState::Waiting | ExperimentState::Running
+            ) {
+                self.experiment = ExperimentState::Invalidated;
+                self.failure = Some(SetupFailure::SignalGap);
+            }
+            self.delivery_witness_ns = None;
+        }
+        let signal_resuming = self
+            .signal_resume_ns
+            .is_some_and(|resumed| monotonic_ns.saturating_sub(resumed) <= SIGNAL_FRESH_NS);
+        let buffered_delivery = self.input.is_polar()
+            && self
+                .delivery_witness_ns
+                .is_some_and(|last| monotonic_ns.saturating_sub(last) <= BUFFERED_HISTORY_NS);
+        if self.experiment == ExperimentState::Waiting {
+            if !self.input_ready(monotonic_ns) {
+                if !signal_resuming && !buffered_delivery {
+                    self.fail(SetupFailure::InputNotReady);
+                } else if absolute_frame >= self.experiment_start_frame.unwrap() {
+                    // Never admit or backdate a main without fresh input. A
+                    // boundary missed during resume moves to the next complete
+                    // cycle, exposed to the recording/deferred callback owner.
+                    match self.next_boundary() {
+                        Ok(start)
+                            if start.checked_add(self.experiment_target_frames()).is_some() =>
+                        {
+                            self.experiment_start_frame = Some(start);
+                        }
+                        _ => self.fail(SetupFailure::FrameOverflow),
+                    }
+                }
+            } else if absolute_frame >= self.experiment_start_frame.unwrap() {
+                self.experiment = ExperimentState::Running;
+            }
+        }
+        if self.experiment == ExperimentState::Running {
+            if !self.input_ready(monotonic_ns) && !signal_resuming && !buffered_delivery {
+                self.fail(SetupFailure::InputNotReady);
+                return;
+            }
+            self.experiment_completed_frames = absolute_frame
+                .saturating_sub(self.experiment_start_frame.unwrap())
+                .min(self.experiment_target_frames());
+            if self.experiment_completed_frames == self.experiment_target_frames() {
+                self.experiment = ExperimentState::Finished;
+            }
+        }
+    }
+
+    pub(crate) fn start_calibration(
+        &mut self,
+        source_owner: u64,
+        now_ns: u64,
+    ) -> Result<(), SetupFailure> {
+        self.ensure_preparation()?;
+        if source_owner == 0 {
+            return Err(SetupFailure::InvalidSource);
+        }
+        if !self.clock_ready(now_ns) && !(self.parked() && self.clock_fresh(now_ns)) {
+            return Err(SetupFailure::ClockStale);
+        }
+        let start = if self.parked() {
+            0
+        } else {
+            self.next_boundary()?
+        };
+        start
+            .checked_add(self.calibration_target_frames())
+            .ok_or(SetupFailure::FrameOverflow)?;
+        let generation = self
+            .calibration_generation
+            .checked_add(1)
+            .ok_or(SetupFailure::FrameOverflow)?;
+        self.input = SetupInput::Automatic;
+        self.calibration = CalibrationState::Waiting;
+        self.calibration_generation = generation;
+        self.calibration_start_frame = Some(start);
+        self.calibration_completed_frames = 0;
+        self.calibration_last_mapped_frame = None;
+        self.failure = None;
+        self.quality = QualityStatus::default();
+        self.quality_slot_flags.fill(0);
+        self.quality_sample_frame = None;
+        self.source_owner = Some(source_owner);
+        self.model = None;
+        self.live = None;
+        self.reset_sample_continuity();
+        self.signal_resume_ns = None;
+        self.delivery_witness_ns = Some(now_ns);
+        self.pending_training.clear();
+        self.samples.clear();
+        self.last_training_slot = None;
+        self.experiment = ExperimentState::Preparation;
+        self.experiment_start_frame = None;
+        self.experiment_completed_frames = 0;
+        Ok(())
+    }
+
+    /// Explicit operator recovery uses Automatic until its request completes.
+    pub(crate) fn retire_audio_evidence(&mut self) {
+        self.retire_audio_owner_evidence();
+        self.input = SetupInput::Automatic;
+    }
+
+    /// A spontaneous transport-owner fault retires evidence, not selection.
+    /// The accepted transport owner must subsequently supply a real new clock.
+    pub(crate) fn retire_audio_owner_evidence(&mut self) {
+        self.fail(self.failure.unwrap_or(SetupFailure::ClockStale));
+        self.samples.clear();
+        self.last_training_slot = None;
+        self.clock_history.clear();
+        self.pending_training.clear();
+        self.reset_sample_continuity();
+        self.audio_advance_required = true;
+        if let Some(clock) = &mut self.clock {
+            clock.healthy = false;
+            clock.fault = Some(SetupFailure::ClockStale);
+        }
+    }
+
+    pub(crate) fn schedule(&self) -> LoopSchedule {
+        self.schedule
+    }
+
+    /// The existing explicit main-end lifecycle resets preparation, never the
+    /// truth/age of its still-owned physical audio clock.
+    pub(crate) fn reset_preparation(&mut self) {
+        let clock = self.clock;
+        let ever_played = self.ever_played;
+        let audio_advance_required = self.audio_advance_required;
+        *self = Self::new(self.schedule);
+        self.clock = clock;
+        self.ever_played = ever_played;
+        self.audio_advance_required = audio_advance_required;
+        if clock.is_some_and(|clock| clock.healthy && clock.playing) {
+            self.remember_clock();
+        }
+    }
+
+    pub(crate) fn clock_diagnostics(&self, now: u64) -> (Option<u64>, Option<u64>, &'static str) {
+        let Some(clock) = self.clock else {
+            return (None, None, "clock-unavailable");
+        };
+        let reason = if now < clock.host_ns {
+            "clock-future"
+        } else if now - clock.host_ns > CLOCK_FRESH_NS {
+            "observation-stale"
+        } else if !clock.healthy {
+            clock.fault.unwrap_or(SetupFailure::ClockStale).as_str()
+        } else if !clock.playing {
+            "paused"
+        } else if clock.fault == Some(SetupFailure::ClockStale) {
+            "observation-gap"
+        } else {
+            "healthy"
+        };
+        (Some(clock.host_ns), clock.observed_advance_ns, reason)
+    }
+
+    /// Apply source-health ownership before any current sample is available.
+    /// Zero retires the source; repeating the same owner is idempotent. This
+    /// never supplies ACC evidence or changes the shared audio clock.
+    pub(crate) fn observe_source_owner(&mut self, owner: u64) {
+        let next_owner = (owner != 0).then_some(owner);
+        if self.source_owner == next_owner {
+            return;
+        }
+        if self.source_owner.is_some() {
+            self.fail_polar(if owner == 0 {
+                SetupFailure::InvalidSource
+            } else {
+                SetupFailure::SourceReplaced
+            });
+        }
+        self.source_owner = next_owner;
+        self.reset_sample_continuity();
+        self.clock_history.clear();
+        self.pending_training.clear();
+        self.delivery_witness_ns = None;
+        if let Some(clock) = self.clock.filter(|clock| clock.healthy && clock.playing) {
+            self.clock_history.push_back(clock);
+        }
+        self.live = None;
+        self.signal_resume_ns = None;
+    }
+
+    /// Rejected current-source evidence invalidates an attempt/model without
+    /// admitting the bad sample into calibration or changing source lineage.
+    pub(crate) fn reject_acc(&mut self, owner: u64, failure: SetupFailure) {
+        self.quality_sample_frame = None;
+        if owner == 0 || self.source_owner != Some(owner) || self.input == SetupInput::Controller {
+            return;
+        }
+        if self.input.is_polar()
+            || matches!(
+                self.calibration,
+                CalibrationState::Waiting | CalibrationState::Collecting
+            )
+        {
+            self.mask_quality(failure);
+        }
+    }
+
+    pub(crate) fn observe_acc(
+        &mut self,
+        source_owner: u64,
+        sensor_timestamp_ns: u64,
+        host_timestamp_ns: u64,
+        vector_g: [f64; 3],
+    ) {
+        self.quality_sample_frame = None;
+        if source_owner == 0 {
+            self.observe_source_owner(0);
+            self.fail_polar(SetupFailure::InvalidSource);
+            return;
+        }
+        self.observe_source_owner(source_owner);
+        if self.model.is_none() && !self.input.pretrained() && !self.calibration_active() {
+            return;
+        }
+        let Some(clock) = self.clock else {
+            return;
+        };
+        if !clock.playing {
+            return;
+        }
+        let mapped_frame = match self.frame_for_sample(host_timestamp_ns) {
+            Ok(frame) => frame,
+            Err(reason) => {
+                self.mask_quality(reason);
+                return;
+            }
+        };
+        self.quality_sample_frame = mapped_frame;
+        let Some(unit) = gravity_direction(vector_g) else {
+            self.gravity_estimate = None;
+            self.settle_until_sensor_ns = Some(sensor_timestamp_ns.saturating_add(SETTLE_NS));
+            self.settle_reason = SetupFailure::InvalidSample;
+            self.mask_quality(SetupFailure::InvalidSample);
+            return;
+        };
+        let observation = AccObservation {
+            sensor_ns: sensor_timestamp_ns,
+            host_ns: host_timestamp_ns,
+            unit,
+        };
+        let elapsed = if let Some(previous) = self.last_acc {
+            if sensor_timestamp_ns <= previous.sensor_ns {
+                if previous.sensor_ns.saturating_sub(sensor_timestamp_ns) > SIGNAL_FRESH_NS {
+                    self.fail(SetupFailure::ClockRetired);
+                } else {
+                    self.mask_quality(SetupFailure::ReorderedSample);
+                }
+                return;
+            }
+            if host_timestamp_ns < previous.host_ns {
+                self.mask_quality(SetupFailure::ReorderedSample);
+                return;
+            }
+            let gap = sensor_timestamp_ns - previous.sensor_ns;
+            if self.motion_continuity
+                && (gap > SIGNAL_FRESH_NS || host_timestamp_ns - previous.host_ns > SIGNAL_FRESH_NS)
+            {
+                self.last_acc = Some(observation);
+                self.motion_continuity = true;
+                self.gravity_estimate = None;
+                self.settle_until_sensor_ns = Some(sensor_timestamp_ns.saturating_add(SETTLE_NS));
+                self.settle_reason = SetupFailure::SignalGap;
+                self.mask_quality(SetupFailure::SignalGap);
+                return;
+            }
+            gap as f64 / 1_000_000_000.0
+        } else {
+            0.0
+        };
+        if let Some((sensor_anchor, host_anchor)) = self.alignment_anchor {
+            let sensor_delta = i128::from(sensor_timestamp_ns) - i128::from(sensor_anchor);
+            let host_delta = i128::from(host_timestamp_ns) - i128::from(host_anchor);
+            if (sensor_delta - host_delta).unsigned_abs() > u128::from(ALIGNMENT_TOLERANCE_NS) {
+                self.mask_quality(SetupFailure::ReorderedSample);
+                return;
+            }
+        } else {
+            self.alignment_anchor = Some((sensor_timestamp_ns, host_timestamp_ns));
+        }
+        let previous = self.gravity_estimate.filter(|_| self.motion_continuity);
+        let filtered = if let Some(before) = previous {
+            let alpha = 1.0 - (-elapsed / GRAVITY_TAU_S).exp();
+            let next = std::array::from_fn(|i| before[i] + alpha * (unit[i] - before[i]));
+            let norm = dot(next, next).sqrt();
+            if norm < 1.0e-6 {
+                self.mask_quality(SetupFailure::ExcessiveMotion);
+                return;
+            }
+            next.map(|v| v / norm)
+        } else {
+            unit
+        };
+        self.gravity_estimate = Some(filtered);
+        self.last_acc = Some(observation);
+        self.motion_continuity = true;
+        if previous.is_some_and(|before| {
+            elapsed > 0.0
+                && dot(subtract(filtered, before), subtract(filtered, before)).sqrt() / elapsed
+                    > MAX_TILT_SPEED_PER_S
+        }) {
+            self.settle_until_sensor_ns = Some(sensor_timestamp_ns.saturating_add(SETTLE_NS));
+            self.settle_reason = SetupFailure::ExcessiveMotion;
+            self.mask_quality(self.settle_reason);
+            return;
+        }
+        if self
+            .settle_until_sensor_ns
+            .is_some_and(|until| sensor_timestamp_ns < until)
+        {
+            self.mask_quality(self.settle_reason);
+            return;
+        }
+        let filtered_observation = AccObservation {
+            unit: filtered,
+            ..observation
+        };
+        self.live = Some(filtered_observation);
+        self.signal_resume_ns = None;
+        self.delivery_witness_ns = Some(clock.host_ns);
+        if !self.calibration_active() {
+            return;
+        }
+        if let Some(frame) = mapped_frame {
+            self.record_training(frame, filtered);
+        } else if self.pending_training.len() < MAX_PENDING_TRAINING {
+            self.pending_training.push_back(filtered_observation);
+        } else {
+            self.mask_quality(SetupFailure::InsufficientCoverage);
+        }
+    }
+
+    fn record_training(&mut self, frame: u64, unit: [f64; 3]) {
+        if self.calibration != CalibrationState::Collecting {
+            return;
+        }
+        let start = self.calibration_start_frame.unwrap();
+        if frame < start || frame >= start + self.calibration_target_frames() {
+            return;
+        }
+        self.calibration_last_mapped_frame = Some(
+            self.calibration_last_mapped_frame
+                .map_or(frame, |last| last.max(frame)),
+        );
+        let slot_frames = frames_for_ns(TRAINING_STEP_NS, self.schedule.sample_rate);
+        let slot = (frame - start) / slot_frames;
+        if self
+            .last_training_slot
+            .is_some_and(|previous| slot <= previous)
+        {
+            return;
+        }
+        if self.samples.len() >= MAX_TRAINING_SAMPLES {
+            self.fail(SetupFailure::InsufficientCoverage);
+            return;
+        }
+        self.samples.push(TrainingSample { frame, unit });
+        self.last_training_slot = Some(slot);
+        let flags = &mut self.quality_slot_flags[slot as usize];
+        if *flags & 7 != 0 {
+            self.quality.masked = self.quality.masked.saturating_sub(1);
+            if *flags & 1 != 0 {
+                self.quality.motion = self.quality.motion.saturating_sub(1);
+            }
+            if *flags & 2 != 0 {
+                self.quality.timing = self.quality.timing.saturating_sub(1);
+            }
+            if *flags & 4 != 0 {
+                self.quality.invalid = self.quality.invalid.saturating_sub(1);
+            }
+        }
+        *flags = 8;
+    }
+
+    fn remember_clock(&mut self) {
+        let clock = self.clock.unwrap();
+        if self
+            .clock_history
+            .back()
+            .is_some_and(|last| last.host_ns == clock.host_ns)
+        {
+            return;
+        }
+        if self.clock_history.len() == MAX_AUDIO_HISTORY {
+            self.clock_history.pop_front();
+        }
+        self.clock_history.push_back(clock);
+        let oldest = clock.host_ns.saturating_sub(BUFFERED_HISTORY_NS);
+        while self.clock_history.len() > 2 && self.clock_history[1].host_ns < oldest {
+            self.clock_history.pop_front();
+        }
+    }
+
+    /// None means a future sample awaits its next actual audio observation.
+    fn frame_for_sample(&self, host_ns: u64) -> Result<Option<u64>, SetupFailure> {
+        let clock = self
+            .clock
+            .filter(|clock| clock.healthy && clock.playing)
+            .ok_or(SetupFailure::ClockStale)?;
+        if clock.host_ns.abs_diff(host_ns) > BUFFERED_HISTORY_NS {
+            return Err(SetupFailure::ClockStale);
+        }
+        if host_ns > clock.host_ns {
+            return Ok(None);
+        }
+        let mut previous: Option<AudioClock> = None;
+        for &next in &self.clock_history {
+            if host_ns == next.host_ns {
+                return Ok(Some(next.frame));
+            }
+            if let Some(before) = previous {
+                if before.host_ns < host_ns
+                    && host_ns < next.host_ns
+                    && before.generation == next.generation
+                    && before.healthy
+                    && next.healthy
+                    && before.playing
+                    && next.playing
+                {
+                    let span = next.host_ns - before.host_ns;
+                    let frames = next
+                        .frame
+                        .checked_sub(before.frame)
+                        .ok_or(SetupFailure::ClockReversed)?;
+                    let offset = (u128::from(host_ns - before.host_ns) * u128::from(frames)
+                        / u128::from(span)) as u64;
+                    return before
+                        .frame
+                        .checked_add(offset)
+                        .map(|frame| Some(frame))
+                        .ok_or(SetupFailure::FrameOverflow);
+                }
+            }
+            previous = Some(next);
+        }
+        Err(SetupFailure::ClockStale)
+    }
+
+    fn flush_pending_training(&mut self) {
+        while let Some(sample) = self.pending_training.front().copied() {
+            match self.frame_for_sample(sample.host_ns) {
+                Ok(None) => break,
+                Ok(Some(frame)) => {
+                    self.pending_training.pop_front();
+                    self.record_training(frame, sample.unit);
+                }
+                Err(reason) => {
+                    self.fail_polar(reason);
+                    break;
+                }
+            }
+        }
+    }
+
+    /// Select a packaged fitted classifier; this is not participant calibration.
+    /// The shared PCM evidence stays owned by its existing generation.
+    pub(crate) fn select_pretrained(
+        &mut self,
+        input: SetupInput,
+        owner: u64,
+        now: u64,
+    ) -> Result<(), SetupFailure> {
+        self.ensure_preparation()?;
+        if !input.pretrained() || owner == 0 || self.source_owner != Some(owner) {
+            return Err(SetupFailure::InvalidSource);
+        }
+        if !self.clock_ready(now) && !(self.parked() && self.clock_fresh(now)) {
+            return Err(SetupFailure::ClockStale);
+        }
+        let generation = self
+            .calibration_generation
+            .checked_add(1)
+            .ok_or(SetupFailure::FrameOverflow)?;
+        self.select_controller()?;
+        self.input = input;
+        self.model = None;
+        self.calibration_generation = generation;
+        self.live = None;
+        self.reset_sample_continuity();
+        self.signal_resume_ns = None;
+        self.delivery_witness_ns = Some(now);
+        self.quality = QualityStatus::default();
+        Ok(())
+    }
+
+    pub(crate) fn select_controller(&mut self) -> Result<(), SetupFailure> {
+        self.ensure_preparation()?;
+        self.input = SetupInput::Controller;
+        self.calibration = CalibrationState::Idle;
+        self.calibration_start_frame = None;
+        self.calibration_completed_frames = 0;
+        self.samples.clear();
+        self.pending_training.clear();
+        self.failure = None;
+        self.experiment = ExperimentState::Preparation;
+        self.experiment_start_frame = None;
+        Ok(())
+    }
+
+    /// The external controller assessment owns its freshness. Before observing
+    /// a real audio frame without that evidence, defer a queued Controller main
+    /// to a later full cycle without inventing a pause or advancing the clock.
+    pub(crate) fn defer_controller_main_until_after(&mut self, frame: u64) {
+        if self.input != SetupInput::Controller
+            || self.experiment != ExperimentState::Waiting
+            || self
+                .experiment_start_frame
+                .is_none_or(|start| frame < start)
+        {
+            return;
+        }
+        let next = (frame / self.schedule.cycle_frames)
+            .checked_add(1)
+            .and_then(|cycle| cycle.checked_mul(self.schedule.cycle_frames))
+            .filter(|start| start.checked_add(self.experiment_target_frames()).is_some());
+        match next {
+            Some(start) => self.experiment_start_frame = Some(start),
+            None => self.fail(SetupFailure::FrameOverflow),
+        }
+    }
+
+    pub(crate) fn request_experiment(&mut self, now_ns: u64) -> Result<(), SetupFailure> {
+        self.ensure_preparation()?;
+        if !self.input_ready(now_ns) {
+            return Err(SetupFailure::InputNotReady);
+        }
+        let start = self.next_boundary()?;
+        start
+            .checked_add(self.experiment_target_frames())
+            .ok_or(SetupFailure::FrameOverflow)?;
+        self.experiment_start_frame = Some(start);
+        self.experiment_completed_frames = 0;
+        self.experiment = ExperimentState::Waiting;
+        Ok(())
+    }
+
+    /// Model inspection/projection only. Use `driver_sample(now_ns)` for output
+    /// and `snapshot(now_ns).ready` for readiness; both enforce live freshness.
+    pub(crate) fn model(&self) -> Option<&TiltModel> {
+        self.model.as_ref()
+    }
+
+    /// Classification history breaks on rejected signal evidence, independently
+    /// of retained model ownership and render-time sample freshness.
+    pub(crate) fn phase_history_epoch(&self) -> u64 {
+        self.phase_history_epoch
+    }
+
+    pub(crate) fn evidence_retirement_epoch(&self) -> u64 {
+        self.evidence_retirement_epoch
+    }
+
+    pub(crate) fn driver_sample(&self, now_ns: u64) -> Option<TiltSample> {
+        if self.parked() && self.clock_fresh(now_ns) {
+            return Some(TiltSample {
+                input: SetupInput::Automatic,
+                volume: 0.0,
+                phase: Some(SetupPhase::HoldOut),
+                source_owner: None,
+                model_generation: None,
+                source_timestamp_ns: self.clock?.host_ns,
+            });
+        }
+        if !self.clock_ready(now_ns) {
+            return None;
+        }
+        match self.input {
+            SetupInput::Automatic => {
+                let clock = self.clock?;
+                let (phase, _, volume) = self.schedule.phase_at(clock.frame);
+                Some(TiltSample {
+                    input: self.input,
+                    volume,
+                    phase: Some(phase),
+                    source_owner: None,
+                    model_generation: None,
+                    source_timestamp_ns: clock.host_ns,
+                })
+            }
+            input if input.pretrained() && self.input_ready(now_ns) => {
+                let live = self.live?;
+                Some(TiltSample {
+                    input,
+                    volume: 0.0, // No continuous estimate; State consumers omit this value.
+                    phase: None,
+                    source_owner: self.source_owner,
+                    model_generation: Some(self.calibration_generation),
+                    source_timestamp_ns: live.host_ns,
+                })
+            }
+            SetupInput::PolarTilt if self.input_ready(now_ns) => {
+                let model = self.model.as_ref()?;
+                let live = self.live?;
+                let volume = ((dot(live.unit, model.axis) - model.low) / (model.high - model.low))
+                    .clamp(0.0, 1.0);
+                Some(TiltSample {
+                    input: self.input,
+                    volume,
+                    phase: None,
+                    source_owner: Some(model.source_owner),
+                    model_generation: Some(model.generation),
+                    source_timestamp_ns: live.host_ns,
+                })
+            }
+            _ => None,
+        }
+    }
+
+    pub(crate) fn snapshot(&self, now_ns: u64) -> SetupStatus {
+        let frame = self.clock.map_or(0, |clock| clock.frame);
+        let (phase, phase_frame, automatic_volume) = self.schedule.phase_at(frame);
+        let clock_valid = self.clock_fresh(now_ns);
+        SetupStatus {
+            parked: self.parked(),
+            quality: self.quality,
+            input: self.input,
+            phase,
+            absolute_frame: frame,
+            cycle_frames: self.schedule.cycle_frames,
+            cycle_frame: frame % self.schedule.cycle_frames,
+            phase_frame,
+            automatic_volume,
+            clock_valid,
+            playing: self.clock.is_some_and(|clock| clock.playing),
+            ready: self.input_ready(now_ns),
+            calibration: self.calibration,
+            calibration_generation: self.calibration_generation,
+            calibration_start_frame: self.calibration_start_frame,
+            calibration_completed_frames: self.calibration_completed_frames,
+            calibration_target_frames: self.calibration_target_frames(),
+            accepted_samples: self.samples.len(),
+            failure: if clock_valid {
+                self.failure
+            } else {
+                self.failure.or(Some(SetupFailure::ClockStale))
+            },
+            source_owner: self.source_owner,
+            model_generation: if self.input.pretrained() {
+                Some(self.calibration_generation)
+            } else {
+                self.model.as_ref().map(|model| model.generation)
+            },
+            experiment: self.experiment,
+            experiment_start_frame: self.experiment_start_frame,
+            experiment_completed_frames: self.experiment_completed_frames,
+            experiment_target_frames: self.experiment_target_frames(),
+        }
+    }
+
+    fn calibration_target_frames(&self) -> u64 {
+        self.schedule.cycle_frames * 2
+    }
+    fn experiment_target_frames(&self) -> u64 {
+        u64::from(self.schedule.sample_rate) * 900
+    }
+    fn clock_fresh(&self, now_ns: u64) -> bool {
+        self.clock.is_some_and(|clock| {
+            clock.healthy && now_ns >= clock.host_ns && now_ns - clock.host_ns <= CLOCK_FRESH_NS
+        })
+    }
+    fn clock_ready(&self, now_ns: u64) -> bool {
+        self.clock_fresh(now_ns) && self.clock.is_some_and(|clock| clock.playing)
+    }
+    fn input_ready(&self, now_ns: u64) -> bool {
+        if !self.clock_ready(now_ns) {
+            return false;
+        }
+        match self.input {
+            SetupInput::Controller => true,
+            SetupInput::PolarTiltFixed | SetupInput::PolarTiltAdaptive => {
+                self.source_owner.is_some()
+                    && self.live.is_some_and(|live| {
+                        now_ns >= live.host_ns && now_ns - live.host_ns <= SIGNAL_FRESH_NS
+                    })
+            }
+            SetupInput::PolarTilt => {
+                self.model
+                    .as_ref()
+                    .is_some_and(|model| self.source_owner == Some(model.source_owner))
+                    && self.live.is_some_and(|live| {
+                        now_ns >= live.host_ns && now_ns - live.host_ns <= SIGNAL_FRESH_NS
+                    })
+            }
+            SetupInput::Automatic => false,
+        }
+    }
+    fn next_boundary(&self) -> Result<u64, SetupFailure> {
+        let frame = self.clock.ok_or(SetupFailure::ClockStale)?.frame;
+        (frame / self.schedule.cycle_frames)
+            .checked_add(1)
+            .and_then(|cycle| cycle.checked_mul(self.schedule.cycle_frames))
+            .ok_or(SetupFailure::FrameOverflow)
+    }
+    fn ensure_preparation(&self) -> Result<(), SetupFailure> {
+        if matches!(
+            self.experiment,
+            ExperimentState::Waiting | ExperimentState::Running | ExperimentState::Finished
+        ) {
+            Err(SetupFailure::ExperimentActive)
+        } else {
+            Ok(())
+        }
+    }
+    fn reset_sample_continuity(&mut self) {
+        self.phase_history_epoch = self.phase_history_epoch.saturating_add(1);
+        self.last_acc = None;
+        self.motion_continuity = false;
+        self.alignment_anchor = None;
+        self.gravity_estimate = None;
+        self.settle_until_sensor_ns = None;
+    }
+    fn parked(&self) -> bool {
+        !self.ever_played
+            && self
+                .clock
+                .is_none_or(|clock| !clock.playing && clock.frame == 0)
+    }
+    fn calibration_active(&self) -> bool {
+        matches!(
+            self.calibration,
+            CalibrationState::Waiting | CalibrationState::Collecting
+        )
+    }
+    fn mask_quality(&mut self, reason: SetupFailure) {
+        self.phase_history_epoch = self.phase_history_epoch.saturating_add(1);
+        self.live = None;
+        self.quality.warning = match reason {
+            SetupFailure::ExcessiveMotion => "motion",
+            SetupFailure::InvalidSample => "invalid",
+            _ => "timing",
+        };
+        if self.calibration == CalibrationState::Collecting {
+            if let Some(frame) = self
+                .quality_sample_frame
+                .or_else(|| self.clock.map(|clock| clock.frame))
+            {
+                let start = self.calibration_start_frame.unwrap();
+                if frame >= start && frame < start + self.calibration_target_frames() {
+                    let slot = ((frame - start)
+                        / frames_for_ns(TRAINING_STEP_NS, self.schedule.sample_rate))
+                        as usize;
+                    let bit = match self.quality.warning {
+                        "motion" => 1,
+                        "invalid" => 4,
+                        _ => 2,
+                    };
+                    let flags = &mut self.quality_slot_flags[slot];
+                    if *flags & 8 == 0 && *flags & bit == 0 {
+                        if *flags & 7 == 0 {
+                            self.quality.masked += 1;
+                        }
+                        match bit {
+                            1 => self.quality.motion += 1,
+                            4 => self.quality.invalid += 1,
+                            _ => self.quality.timing += 1,
+                        };
+                        *flags |= bit;
+                    }
+                }
+            }
+        }
+    }
+    fn final_quality_failure(&self, reason: SetupFailure) -> SetupFailure {
+        if reason != SetupFailure::InsufficientCoverage {
+            return reason;
+        }
+        if self.quality.motion > self.quality.timing && self.quality.motion > self.quality.invalid {
+            SetupFailure::ExcessiveMotion
+        } else if self.quality.invalid > self.quality.timing {
+            SetupFailure::InvalidSample
+        } else if self.quality.warning == "timing" || self.quality.timing > 0 {
+            SetupFailure::SignalGap
+        } else {
+            reason
+        }
+    }
+    fn fail(&mut self, reason: SetupFailure) {
+        self.invalidate(reason, true);
+    }
+    fn fail_polar(&mut self, reason: SetupFailure) {
+        self.invalidate(reason, false);
+    }
+    fn invalidate(&mut self, reason: SetupFailure, affects_clock: bool) {
+        let affects_selected_input = affects_clock || self.input != SetupInput::Controller;
+        self.model = None;
+        self.live = None;
+        self.signal_resume_ns = None;
+        self.delivery_witness_ns = None;
+        self.pending_training.clear();
+        if matches!(
+            self.calibration,
+            CalibrationState::Waiting | CalibrationState::Collecting | CalibrationState::Succeeded
+        ) {
+            self.calibration = CalibrationState::Failed;
+        }
+        // Selection owns visual continuity, independently of live evidence.
+        // Explicit calibration/input/reset operations still own method changes.
+        self.evidence_retirement_epoch = self.evidence_retirement_epoch.saturating_add(1);
+        self.reset_sample_continuity();
+        if affects_selected_input
+            && matches!(
+                self.experiment,
+                ExperimentState::Waiting | ExperimentState::Running
+            )
+        {
+            self.experiment = ExperimentState::Invalidated;
+        }
+        self.failure = Some(reason);
+    }
+    fn fit_model(&self) -> Result<TiltModel, SetupFailure> {
+        let start = self
+            .calibration_start_frame
+            .ok_or(SetupFailure::InsufficientCoverage)?;
+        let mut counts = [[[0_usize; 4]; 4]; 2];
+        for sample in &self.samples {
+            let (cycle, phase, quarter) = self.training_bin(sample.frame, start);
+            counts[cycle][phase][quarter] += 1;
+        }
+        if self.samples.len() < MIN_WINDOW_SAMPLES
+            || (0..2).any(|cycle| {
+                counts[cycle].iter().flatten().sum::<usize>() < MIN_CYCLE_SAMPLES
+                    || (0..4)
+                        .any(|phase| counts[cycle][phase].iter().sum::<usize>() < MIN_PHASE_SAMPLES)
+                    || [0, 2].iter().any(|&phase| {
+                        [0, 3].iter().any(|&quarter| {
+                            counts[cycle][phase][quarter] < MIN_RAMP_ENDPOINT_SAMPLES
+                        })
+                    })
+            })
+        {
+            return Err(SetupFailure::InsufficientCoverage);
+        }
+        // The participant is assumed to follow the cues. Scheduled labels
+        // provide training context for direction, never a target waveform
+        // whose correlation, holds or recurrence can reject the participant.
+        let mean_envelope = self
+            .samples
+            .iter()
+            .map(|sample| self.schedule.phase_at(sample.frame).2)
+            .sum::<f64>()
+            / self.samples.len() as f64;
+        let mut covariance = [0.0; 3];
+        for sample in &self.samples {
+            let envelope = self.schedule.phase_at(sample.frame).2;
+            for (sum, value) in covariance.iter_mut().zip(sample.unit) {
+                *sum += (envelope - mean_envelope) * value;
+            }
+        }
+        let norm = dot(covariance, covariance).sqrt();
+        if norm < 1.0e-8 {
+            return Err(SetupFailure::InsufficientRange);
+        }
+        let axis = covariance.map(|v| v / norm);
+        let mut projections: Vec<f64> = self
+            .samples
+            .iter()
+            .map(|sample| dot(sample.unit, axis))
+            .collect();
+        projections.sort_by(f64::total_cmp);
+        let low = projections[projections.len() / 10];
+        let high = projections[projections.len() * 9 / 10];
+        let range = high - low;
+        // Existing engineering usable-signal/gain bounds, not compliance:
+        // 0.02 (~1.15 degrees) limits amplification of a very small signal;
+        // 0.50 (~29 degrees) limits posture-scale spans. The lower bound can
+        // exclude smaller real motion; neither bound is wearer-validated.
+        if !(0.02..=0.50).contains(&range) {
+            return Err(SetupFailure::InsufficientRange);
+        }
+
+        Ok(TiltModel {
+            source_owner: self.source_owner.ok_or(SetupFailure::InvalidSource)?,
+            generation: self.calibration_generation,
+            axis,
+            low,
+            high,
+        })
+    }
+
+    fn training_bin(&self, frame: u64, start: u64) -> (usize, usize, usize) {
+        let cycle = ((frame - start) / self.schedule.cycle_frames) as usize;
+        let mut offset = frame % self.schedule.cycle_frames;
+        for (phase, duration) in self.schedule.phase_frames.into_iter().enumerate() {
+            if offset < duration {
+                return (cycle, phase, ((offset * 4) / duration) as usize);
+            }
+            offset -= duration;
+        }
+        unreachable!("validated schedule")
+    }
+}
+
+fn frames_for_ns(ns: u64, sample_rate: u32) -> u64 {
+    ((u128::from(ns) * u128::from(sample_rate)) / 1_000_000_000).min(u128::from(u64::MAX)) as u64
+}
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a.into_iter().zip(b).map(|(x, y)| x * y).sum()
+}
+fn subtract(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    std::array::from_fn(|i| a[i] - b[i])
+}
+fn gravity_direction(raw: [f64; 3]) -> Option<[f64; 3]> {
+    if !raw.into_iter().all(f64::is_finite) {
+        return None;
+    }
+    let norm = dot(raw, raw).sqrt();
+    if !(0.85..=1.15).contains(&norm) {
+        return None;
+    }
+    Some(raw.map(|v| v / norm))
+}
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct LoopSchedule {
+    pub(crate) sample_rate: u32,
+    pub(crate) phase_frames: [u64; 4],
+    pub(crate) cycle_frames: u64,
+}
+
+impl LoopSchedule {
+    pub(crate) fn new(sample_rate: u32, phase_frames: [u64; 4]) -> Result<Self, SetupFailure> {
+        if sample_rate != 44_100 || phase_frames != [176_400; 4] {
+            return Err(SetupFailure::InvalidSchedule);
+        }
+        Ok(Self {
+            sample_rate,
+            phase_frames,
+            cycle_frames: phase_frames.iter().sum(),
+        })
+    }
+
+    pub(crate) fn phase_at(self, frame: u64) -> (SetupPhase, u64, f64) {
+        let mut offset = frame % self.cycle_frames;
+        for (index, duration) in self.phase_frames.into_iter().enumerate() {
+            if offset < duration {
+                let part = offset as f64 / duration as f64;
+                return match index {
+                    0 => (SetupPhase::Inhale, offset, part),
+                    1 => (SetupPhase::HoldIn, offset, 1.0),
+                    2 => (SetupPhase::Exhale, offset, 1.0 - part),
+                    _ => (SetupPhase::HoldOut, offset, 0.0),
+                };
+            }
+            offset -= duration;
+        }
+        unreachable!("validated nonzero schedule")
+    }
+}
