+fn sample_time(frame: u64) -> u64 {
+    1_000_000_000 + frame * 1_000_000_000 / 44100
+}
+fn vector(volume: f64) -> [f32; 3] {
+    let a = -0.08 + 0.16 * volume;
+    [(a.sin() * 1000.0) as f32, 0.0, (a.cos() * 1000.0) as f32]
+}
+
+fn calibrated_inhale_runtime() -> (Runtime, u64, u64) {
+    calibrated_inhale_runtime_with_binding((5, 1))
+}
+fn calibrated_inhale_runtime_with_binding(binding: (u64, u64)) -> (Runtime, u64, u64) {
+    let mut r = runtime();
+    r.observe_clock(7, 0, sample_time(0), true);
+    r.bind_source(binding);
+    r.observe_host_aligned_acc(
+        100_000_000_000 + sample_time(0),
+        sample_time(0),
+        vector(0.0),
+    );
+    assert_eq!(
+        command(&mut r, 1, "calibrate", sample_time(0))["accepted"],
+        true
+    );
+    for frame in (1764..=2_116_800).step_by(1764) {
+        let seconds = (frame % 705600) as f64 / 44100.0;
+        let v = match seconds {
+            t if t < 4.0 => t / 4.0,
+            t if t < 8.0 => 1.0,
+            t if t < 12.0 => (12.0 - t) / 4.0,
+            _ => 0.0,
+        };
+        let now = sample_time(frame);
+        r.observe_clock(7, frame, now, true);
+        r.observe_host_aligned_acc(100_000_000_000 + now, now, vector(v));
+    }
+    assert!(r.core.model().is_some());
+    let frame = 2_116_800 + 20 * 1764;
+    for i in 1..=20 {
+        let frame = 2_116_800 + i * 1764;
+        let now = sample_time(frame);
+        r.observe_clock(7, frame, now, true);
+        r.observe_host_aligned_acc(100_000_000_000 + now, now, vector(i as f64 / 100.0));
+    }
+    assert_eq!(r.phase, CommonBreathPhase::Inhale);
+    (r, frame, sample_time(frame))
+}
