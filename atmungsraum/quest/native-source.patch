+owner.HARNESS=r'''package io.github.mesmerprism.rustyquest.native_renderer;
+import android.bluetooth.*;import android.os.*;import java.util.*;import org.json.JSONObject;
+class GatewayBleJournalTest {
+ static int checks,effects;static android.app.Activity context;
+ static void check(boolean yes,String why){checks++;if(!yes)throw new AssertionError(why);}
+ static ExperimentSessionBleServer fresh(Object selection)throws Exception {
+  Handler.queued.clear();Bundle.phonePairing=selection;java.lang.reflect.Field process=ExperimentSessionBleServer.class.getDeclaredField("process");process.setAccessible(true);process.set(null,null);
+  context=new android.app.Activity();ExperimentSessionBleServer owner=ExperimentSessionBleServer.process(context,new ExperimentSessionBleServer.Delegate(){
+   public boolean openControlDefault(){return true;}
+   public JSONObject snapshot()throws Exception{return new JSONObject().put("v",1).put("g",7).put("p","IDLE").put("pending",false);}
+   public void dispatch(ExperimentSessionBleServer.CommandRequest command){effects++;}
+  });owner.nativeOwnerStarted(1,7);return owner;
+ }
+ static BluetoothGattServer server(){return context.manager.servers.get(context.manager.servers.size()-1);}
+ static BluetoothGattCharacteristic field(String uuid){return new BluetoothGattCharacteristic(UUID.fromString(uuid),8,16);}
+ static JSONObject ping(String id,String nonce)throws Exception{return new JSONObject().put("v",1).put("id",id).put("op","ping").put("condition","").put("bias",0).put("nonce",nonce);}
+ static void write(BluetoothGattServer server,BluetoothDevice peer,JSONObject body,boolean prepared,boolean response,int offset)throws Exception {
+  server.callback.onCharacteristicWriteRequest(peer,123,field(ExperimentSessionBleProtocol.COMMAND),prepared,response,offset,body.toString().getBytes("UTF-8"));
+ }
+ static String codeMac(String code,String input)throws Exception {
+  javax.crypto.Mac mac=javax.crypto.Mac.getInstance("HmacSHA256");mac.init(new javax.crypto.spec.SecretKeySpec(code.getBytes("UTF-8"),"HmacSHA256"));
+  byte[] bytes=mac.doFinal(input.getBytes("UTF-8"));StringBuilder out=new StringBuilder();for(int i=0;i<16;i++)out.append(String.format(java.util.Locale.ROOT,"%02x",bytes[i]&255));return out.toString();
+ }
+ public static void main(String[] args)throws Exception {
+  ExperimentSessionBleServer startup=fresh(Boolean.TRUE);context.permission=-1;PolarBleRuntimeSupport.coordinated=true;PolarBleRuntimeSupport.busy=true;
