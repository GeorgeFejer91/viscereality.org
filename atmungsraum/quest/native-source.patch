+            JSONObject nativeResponse=session(),offer=gateway.localOperatorEnrollmentStatus();
+            if(Boolean.TRUE.equals(offer.opt("available"))){reference=offer.getString("reference");observed=android.os.SystemClock.elapsedRealtime();}
+            return envelope.put("pid",android.os.Process.myPid()).put("uid",android.os.Process.myUid()).put("process_start_ticks",processStartTicks())
+                .put("apk_sha256",installedApkSha256(context)).put("snapshot",breath).put("native_response",nativeResponse)
+                .put("headset_setup",gateway.localOperatorSetupReadback()).put("local_enrollment",offer).toString();
+        }
