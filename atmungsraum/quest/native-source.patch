+    }
+}
+foreach ($case in @(
+    @{ field = 'android_target_sdk_version'; value = '34' },
+    @{ field = 'android_target_sdk_version'; value = 34.5 },
+    @{ field = 'android_target_sdk_version'; value = $true },
+    @{ field = 'android_target_sdk_version'; value = 28 },
+    @{ field = 'android_target_sdk_version'; value = 37 },
+    @{ field = 'android_target_sdk_version'; value = $null },
+    @{ field = 'android_install_location'; value = 'Auto' },
+    @{ field = 'android_install_location'; value = '' },
