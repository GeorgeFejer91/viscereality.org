+//! Explicit product adapter for the audio-frame-owned breathing setup.
+use crate::experiment_breathing_setup::{
+    BreathingSetup, CalibrationState, ExperimentState, LoopSchedule, SetupInput, SetupStatus,
+};
+use rusty_quest_breath_contract::{
+    assessment::CommonBreathPhase,
+    phase::{
+        CommonPhaseClassifier, CommonPhaseConfiguration, CommonPhaseInput, CommonPhaseParameters,
+    },
+    BreathTimestampMicros,
+};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::VecDeque,
+    sync::{Mutex, OnceLock},
+    time::Instant,
+};
+
+fn validate_loop(
+    json: &str,
+    digest: &str,
+    expected: Option<&str>,
+) -> Result<LoopSchedule, &'static str> {
+    let expected = expected.filter(|v| is_hex(v, 64)).ok_or("not-selected")?;
+    if json.len() > 16_384
+        || digest != expected
+        || format!("{:x}", Sha256::digest(json.as_bytes())) != expected
+    {
+        return Err("loop-digest-mismatch");
+    }
+    let value: Value = serde_json::from_str(json).map_err(|_| "loop-json-invalid")?;
+    closed(
+        &value,
+        &[
+            "schema",
+            "sample_rate",
+            "channels",
+            "bits_per_sample",
+            "cycle_frames",
+            "main_seconds",
+            "phases",
+        ],
+    )?;
+    if value["schema"] != "atmungsraum.box_breathing_loop.v1"
+        || value["sample_rate"] != 44_100
+        || value["channels"] != 1
+        || value["bits_per_sample"] != 16
+        || value["cycle_frames"] != 705_600
+        || value["main_seconds"] != 900
+    {
+        return Err("loop-schedule-invalid");
+    }
+    let phases = value["phases"]
+        .as_array()
+        .filter(|p| p.len() == 4)
+        .ok_or("loop-phases-invalid")?;
+    for (index, (phase, id)) in phases
+        .iter()
+        .zip(["inhale", "hold_in", "exhale", "hold_out"])
+        .enumerate()
+    {
+        closed(phase, &["id", "offset_frames", "duration_frames", "cue"])?;
+        let cue = &phase["cue"];
+        closed(cue, &["path", "sha256", "bytes", "frames"])?;
+        if phase["id"] != id
+            || phase["offset_frames"] != (index as u64) * 176_400
+            || phase["duration_frames"] != 176_400
+            || cue["frames"] != 176_400
+            || cue["bytes"]
+                .as_u64()
+                .is_none_or(|v| !(352_800..=353_824).contains(&v))
+            || cue["sha256"].as_str().is_none_or(|v| !is_hex(v, 64))
+            || cue["path"].as_str().is_none_or(|v| {
+                v.is_empty()
+                    || v.len() > 256
+                    || v.starts_with('/')
+                    || v.contains("..")
+                    || v.contains('\\')
+                    || v.contains(':')
+            })
+        {
+            return Err("loop-cue-invalid");
+        }
+    }
+    LoopSchedule::new(44_100, [176_400; 4]).map_err(|_| "loop-schedule-invalid")
+}
+fn is_hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        && value.bytes().any(|b| b != b'0')
+}
+fn is_command_id(value: &str) -> bool {
+    value.len() == 16
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn closed(value: &Value, keys: &[&str]) -> Result<(), &'static str> {
+    let o = value.as_object().ok_or("object-required")?;
+    if o.len() != keys.len() || keys.iter().any(|k| !o.contains_key(*k)) {
+        Err("closed-fields-required")
+    } else {
+        Ok(())
+    }
+}
+struct Runtime {
+    core: BreathingSetup,
+    schedule: LoopSchedule,
+    digest: String,
+    generation: u64,
+    revision: u64,
+    semantic: Value,
+    started: bool,
+    clock_anchor: Option<(u64, Instant)>,
+    last_clock: Option<(u64, u64, u64, bool)>,
+    last_admitted_frame: Option<u64>,
+    source_binding: Option<(u64, u64)>,
+    source_reference: u64,
+    controller_generation: Option<u64>,
+    controller_seen_ns: Option<u64>,
+    controller_volume01: Option<f64>,
+    controller_lost: bool,
+    controller_resume_deadline_ns: Option<u64>,
+    controller_lost_frames: Option<u64>,
+    source_clock_pair: Option<(u64, u64, Instant)>,
+    classifier: CommonPhaseClassifier,
+    classified_model: Option<u64>,
+    classified_at: Option<u64>,
+    sequence: u64,
+    phase: CommonBreathPhase,
+    ledger: VecDeque<(Value, Value)>,
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum SetupDriverOutput {
+    Waiting,
+    Automatic {
+        volume: f64,
+        generation: u64,
+    },
+    PolarTilt {
+        volume: f64,
+        phase: CommonBreathPhase,
+        generation: u64,
+        model_generation: u64,
+    },
+    Controller,
+}
+impl Runtime {
+    fn observe_source_pair(&mut self, nano: u64, elapsed: u64) {
+        if nano > 0 && elapsed > 0 {
+            self.source_clock_pair = Some((nano, elapsed, Instant::now()));
+        }
+    }
+    fn map_raw_host(&self, host: u64) -> Option<u64> {
+        let (nano, elapsed, observed) = self.source_clock_pair?;
+        if observed.elapsed().as_nanos() > 250_000_000 || host.abs_diff(nano) > 250_000_000 {
+            return None;
+        }
+        if host >= nano {
+            elapsed.checked_add(host - nano)
+        } else {
+            elapsed.checked_sub(nano - host)
+        }
+    }
+    #[cfg(not(feature = "showcase"))]
+    fn guidance_sample(
+        &self,
+        now: u64,
+    ) -> Option<(
+        usize,
+        u64,
+        u64,
+        crate::breath_guidance::BreathGuidanceTarget,
+    )> {
+        let s = self.core.snapshot(now);
+        if s.experiment != ExperimentState::Running
+            || !s.clock_valid
+            || !s.playing
+            || self.controller_lost
+        {
+            return None;
+        }
+        let elapsed = s.absolute_frame.checked_sub(s.experiment_start_frame?)?;
+        let index = elapsed / self.schedule.phase_frames[0];
+        let start =
+            index * self.schedule.phase_frames[0] * 1000 / u64::from(self.schedule.sample_rate);
+        let end = ((index + 1) * self.schedule.phase_frames[0] * 1000
+            / u64::from(self.schedule.sample_rate))
+        .min(900_000);
+        let (expected_phase, expected_phase_token) = match s.phase {
+            crate::experiment_breathing_setup::SetupPhase::Inhale => {
+                (CommonBreathPhase::Inhale, "inhale")
+            }
+            crate::experiment_breathing_setup::SetupPhase::Exhale => {
+                (CommonBreathPhase::Exhale, "exhale")
+            }
+            _ => (CommonBreathPhase::Hold, "hold"),
+        };
+        Some((
+            index as usize,
+            start,
+            end,
+            crate::breath_guidance::BreathGuidanceTarget {
+                bias_revision: 0,
+                expected_phase,
+                expected_phase_token,
+                bias_percent: 0,
+                official_active_time_ms: elapsed * 1000 / u64::from(self.schedule.sample_rate),
+            },
+        ))
+    }
+    #[cfg(not(feature = "showcase"))]
+    fn guidance_segments(&self, start: u64, end: u64) -> Vec<Value> {
+        let duration = self.schedule.phase_frames[0] * 1000 / u64::from(self.schedule.sample_rate);
+        let mut result = Vec::new();
+        for index in start / duration..=end.min(899_999) / duration {
+            let frame = index * self.schedule.phase_frames[0];
+            let (phase, _, from) = self.schedule.phase_at(frame);
+            let (token, to) = match phase {
+                crate::experiment_breathing_setup::SetupPhase::Inhale => ("inhale", 1.0),
+                crate::experiment_breathing_setup::SetupPhase::Exhale => ("exhale", 0.0),
+                _ => ("hold", from),
+            };
+            result.push(json!([
+                index * duration,
+                ((index + 1) * duration).min(900_000),
+                token,
+                from,
+                to
+            ]));
+            if result.len() == 257 {
+                break;
+            }
+        }
+        result
+    }
+    fn tracking_configuration(
+        &self,
+        generation: u64,
+        operation: &str,
+    ) -> Result<Value, &'static str> {
+        let now = self.now_ns();
+        let s = self.core.snapshot(now);
+        if !self.ready(s, now) {
+            return Err("setup-input-not-ready");
+        }
+        if generation == 0 || operation.is_empty() || operation.len() > 256 {
+            return Err("setup-arm-identity-invalid");
+        }
+        let model=self.core.model().filter(|_|s.input==SetupInput::PolarTilt).map(|m|json!({"owner":m.source_owner,"generation":m.generation,"axis":m.axis,"low":m.low,"high":m.high}));
+        let source_pair = if s.input == SetupInput::PolarTilt {
+            let (nano, elapsed, observed) = self
+                .source_clock_pair
+                .ok_or("source-clock-pair-unavailable")?;
+            if observed.elapsed().as_nanos() > 250_000_000 {
+                return Err("source-clock-pair-stale");
+            }
+            Some(
+                json!({"java_nano_ns":nano,"android_elapsed_ns":elapsed,"maximum_age_ms":250,"maximum_sample_distance_ms":250}),
+            )
+        } else {
+            None
+        };
+        Ok(
+            json!({"schema":"rusty.quest.breathing_setup_tracking_configuration.v1","input":s.input.as_str(),"source":if s.input==SetupInput::Controller {"controller"} else {"polar-acc"},
+            "mapping":"state","controller_projection":"fixed-orientation","phase_classifier":if s.input==SetupInput::Controller {"controller-state"} else {"common-normalized-tilt"},
+            "sampled_clock":if s.input==SetupInput::Controller {"openxr-time"} else {"java-nano-time"},"core_alignment_clock":"android-elapsed-realtime",
+            "raw_sampled_clock":if s.input==SetupInput::Controller {"openxr-time"} else {"java-nano-time"},"source_clock_pair":source_pair,
+            "audio_generation":self.generation,"controller_generation":if s.input==SetupInput::Controller {self.controller_generation} else {None},
+            "calibration_generation":s.calibration_generation,"model":model,"loop_sha256":self.digest,
+            "experiment_generation":generation,"arm_operation_id":operation,"prepared_monotonic_ns":now,"prepared_monotonic_clock":"android-elapsed-realtime",
+            "acknowledgement":"setup-input-retained","tracking_claim":"fresh-input-observed"}),
+        )
+    }
+    fn observe_acc(&mut self, sensor: u64, host: u64, mg: [f32; 3]) {
+        self.observe_acc_with_source(sensor, host, host, mg);
+    }
+    fn observe_acc_with_source(&mut self, sensor: u64, host: u64, source_ns: u64, mg: [f32; 3]) {
+        self.core.observe_acc(
+            self.source_reference,
+            sensor,
+            host,
+            mg.map(|v| f64::from(v) / 1000.0),
+        );
+        let now = self.now_ns().max(host);
+        if let Some(sample) = self
+            .core
+            .driver_sample(now)
+            .filter(|s| s.input == SetupInput::PolarTilt)
+        {
+            if sample.model_generation != self.classified_model {
+                let _ = self
+                    .classifier
+                    .reset(BreathTimestampMicros::new(source_ns / 1000));
+                self.classified_model = sample.model_generation;
+                self.classified_at = None;
+                self.phase = CommonBreathPhase::Unknown;
+            }
+            if self.classified_at != Some(source_ns) {
+                self.sequence = self.sequence.saturating_add(1);
+                self.phase = self
+                    .classifier
+                    .observe(
+                        BreathTimestampMicros::new(
+                            source_ns.saturating_add(now.saturating_sub(host)) / 1000,
+                        ),
+                        CommonPhaseInput::Sample {
+                            sequence_id: self.sequence,
+                            sampled_at: BreathTimestampMicros::new(source_ns / 1000),
+                            value01: sample.volume,
+                        },
+                    )
+                    .phase;
+                self.classified_at = Some(source_ns);
+            }
+        }
+        self.refresh(now);
+    }
+    fn output(&self, now: u64) -> SetupDriverOutput {
+        let s = self.core.snapshot(now);
+        if s.input == SetupInput::Controller {
+            return if s.clock_valid && s.playing && self.controller_ready(now) {
+                SetupDriverOutput::Controller
+            } else {
+                SetupDriverOutput::Waiting
+            };
+        }
+        match self.core.driver_sample(now) {
+            Some(sample) if sample.input == SetupInput::Automatic => SetupDriverOutput::Automatic {
+                volume: sample.volume,
+                generation: self.generation,
+            },
+            Some(sample)
+                if sample.input == SetupInput::PolarTilt
+                    && self.classified_model_matches(sample.model_generation) =>
+            {
+                SetupDriverOutput::PolarTilt {
+                    volume: sample.volume,
+                    phase: self.phase,
+                    generation: self.generation,
+                    model_generation: sample.model_generation.unwrap_or(0),
+                }
+            }
+            _ => SetupDriverOutput::Waiting,
+        }
+    }
+    fn classified_model_matches(&self, model_generation: Option<u64>) -> bool {
+        model_generation.is_some()
+            && self.classified_model == model_generation
+            && self.classified_at.is_some()
+    }
+    fn new(schedule: LoopSchedule, digest: String) -> Self {
+        Self {
+            core: BreathingSetup::new(schedule),
+            schedule,
+            digest,
+            generation: 0,
+            revision: 1,
+            semantic: Value::Null,
+            started: false,
+            clock_anchor: None,
+            last_clock: None,
+            last_admitted_frame: None,
+            source_binding: None,
+            source_reference: 0,
+            controller_generation: None,
+            controller_seen_ns: None,
+            controller_volume01: None,
+            controller_lost: false,
+            controller_resume_deadline_ns: None,
+            controller_lost_frames: None,
+            source_clock_pair: None,
+            classifier: CommonPhaseClassifier::new(
+                CommonPhaseConfiguration::new(CommonPhaseParameters::default())
+                    .expect("valid phase defaults"),
+            ),
+            classified_model: None,
+            classified_at: None,
+            sequence: 0,
+            phase: CommonBreathPhase::Unknown,
+            ledger: VecDeque::new(),
+        }
+    }
+    fn now_ns(&self) -> u64 {
+        self.clock_anchor.map_or(0, |(ns, at)| {
+            ns.saturating_add(at.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64)
+        })
+    }
+    fn observe_clock(&mut self, g: u64, frame: u64, ns: u64, playing: bool) {
+        let resuming = playing
+            && self
+                .last_clock
+                .is_some_and(|(_, _, _, previous_playing)| !previous_playing);
+        if resuming {
+            self.controller_resume_deadline_ns = ns.checked_add(250_000_000);
+            self.classified_model = None;
+            self.classified_at = None;
+            self.phase = CommonBreathPhase::Unknown;
+        }
+        if g > self.generation {
+            self.controller_seen_ns = None;
+            self.phase = CommonBreathPhase::Unknown;
+            self.classified_model = None;
+        }
+        self.generation = self.generation.max(g);
+        if !self.controller_ready(ns) {
+            self.core.defer_controller_main_until_after(frame);
+        }
+        self.core.observe_clock(g, frame, ns, playing);
+        if self
+            .last_clock
+            .is_none_or(|(old_g, _, old_ns, _)| g >= old_g && ns >= old_ns)
+        {
+            self.clock_anchor = Some((ns, Instant::now()));
+            self.last_clock = Some((g, frame, ns, playing));
+        }
+        let s = self.core.snapshot(ns);
+        if s.input == SetupInput::Controller
+            && playing
+            && matches!(
+                s.experiment,
+                ExperimentState::Waiting | ExperimentState::Running
+            )
+            && !self.controller_ready(ns)
+            && !self
+                .controller_resume_deadline_ns
+                .is_some_and(|deadline| ns <= deadline)
+        {
+            self.controller_lost = true;
+            self.controller_lost_frames
+                .get_or_insert(s.experiment_completed_frames);
+        }
+        self.refresh(ns);
+    }
+    fn bind_source(&mut self, binding: (u64, u64)) {
+        if self.source_binding != Some(binding) {
+            if self.source_binding.is_some_and(|old| old.0 != binding.0) {
+                self.controller_generation = None;
+                self.controller_seen_ns = None;
+                self.controller_volume01 = None;
+            }
+            self.source_binding = Some(binding);
+            self.source_reference = self.source_reference.checked_add(1).unwrap_or(0);
+            self.core.observe_source_owner(if binding.0 == 0 {
+                0
+            } else {
+                self.source_reference
+            });
+        }
+    }
+    fn controller_ready(&self, now: u64) -> bool {
+        self.controller_generation.is_some()
+            && self
+                .controller_seen_ns
+                .is_some_and(|at| now >= at && now - at <= 250_000_000)
+            && !self.controller_lost
+    }
+    fn observe_controller(&mut self, g: u64, valid: bool, now: u64) {
+        if self.controller_generation == Some(g) {
+            self.controller_seen_ns = valid.then_some(now);
+            if valid {
+                self.controller_resume_deadline_ns = None;
+            }
+            self.refresh(now);
+        }
+    }
+    fn ready(&self, s: SetupStatus, now: u64) -> bool {
+        s.ready && (s.input != SetupInput::Controller || self.controller_ready(now))
+    }
+    fn stage(&self, s: SetupStatus) -> &'static str {
+        if self.controller_lost {
+            return "waiting";
+        }
+        match s.experiment {
+            ExperimentState::Waiting => "main-pending",
+            ExperimentState::Running => "main",
+            ExperimentState::Finished => "complete",
+            _ => match s.calibration {
+                CalibrationState::Waiting => "waiting",
+                CalibrationState::Collecting => "calibrating",
+                CalibrationState::Succeeded => "testing",
+                _ => {
+                    if self.generation == 0 || !self.started {
+                        "idle"
+                    } else if s.input == SetupInput::Controller {
+                        "testing"
+                    } else {
+                        "waiting"
+                    }
+                }
+            },
+        }
+    }
+    fn refresh(&mut self, now: u64) {
+        let s = self.core.snapshot(now);
+        if s.experiment_start_frame.is_some() {
+            self.last_admitted_frame = s.experiment_start_frame;
+        }
+        let semantic = json!([
+            self.generation,
+            self.started,
+            s.input.as_str(),
+            s.calibration.as_str(),
+            s.calibration_generation,
+            s.model_generation,
+            s.failure.map(|f| f.as_str()),
+            s.experiment.as_str(),
+            s.experiment_start_frame,
+            s.playing,
+            s.clock_valid,
+            self.ready(s, now),
+            self.controller_lost
+        ]);
+        if self.semantic != semantic {
+            self.semantic = semantic;
+            self.revision = self.revision.saturating_add(1);
+        }
+    }
+    fn status(&mut self, now: u64) -> Value {
+        self.refresh(now);
+        let s = self.core.snapshot(now);
+        json!({"v":1,"g":self.generation,"r":self.revision,"stage":self.stage(s),"input":s.input.as_str(),"phase":s.phase.as_str(),
+            "position_frames":s.absolute_frame,"cycle_frames":s.cycle_frames,"target_frames":s.calibration_target_frames,
+            "completed_frames":s.calibration_completed_frames,"attempt":s.calibration_generation,
+            "calibration":if s.calibration==CalibrationState::Succeeded {"ready"} else {s.calibration.as_str()},
+            "failure":if self.controller_lost {"controller_stale"} else {s.failure.map_or("",|f|f.as_str())},
+            "ready":self.ready(s,now),"playing":s.playing,"input_phase":self.input_phase(now),"input_volume01":self.input_volume(now),"experiment_elapsed_ms":s.experiment_completed_frames*1000/44100,
+            "main_start_frame":s.experiment_start_frame,"main_started":!self.controller_lost && matches!(s.experiment,ExperimentState::Running|ExperimentState::Finished),"maximum_bias_percent":0})
+    }
+    fn check_command(&mut self, v: &Value, now: u64) -> Result<Option<Value>, &'static str> {
+        if v["op"] == "end-main" {
+            closed(v, &["v", "id", "g", "r", "op", "main_start_frame"])?;
+        } else {
+            closed(v, &["v", "id", "g", "r", "op"])?;
+        }
+        if v["v"] != 1
+            || v["id"].as_str().is_none_or(|id| !is_command_id(id))
+            || v["g"].as_u64().is_none()
+            || v["r"].as_u64().is_none()
+            || !matches!(
+                v["op"].as_str(),
+                Some("start" | "calibrate" | "controller" | "begin-main" | "end-main")
+            )
+        {
+            return Err("command-invalid");
+        }
+        if let Some((prior, receipt)) = self.ledger.iter().find(|(prior, _)| prior["id"] == v["id"])
+        {
+            return if prior == v {
+                Ok(Some(receipt.clone()))
+            } else {
+                Err("command-id-conflict")
+            };
+        }
+        self.refresh(now);
+        if v["g"] != self.generation {
+            return Err("stale-generation");
+        }
+        if v["r"] != self.revision {
+            return Err("stale-revision");
+        }
+        if self.generation == 0 {
+            return Err("clock-unavailable");
+        }
+        let s = self.core.snapshot(now);
+        if v["op"] == "end-main" {
+            if v["main_start_frame"].as_u64().is_none()
+                || v["main_start_frame"].as_u64() != self.last_admitted_frame
+            {
+                return Err("main-frame-mismatch");
+            }
+            if !matches!(
+                s.experiment,
+                ExperimentState::Waiting
+                    | ExperimentState::Running
+                    | ExperimentState::Finished
+                    | ExperimentState::Invalidated
+            ) {
+                return Err("main-not-active");
+            }
+            return Ok(None);
+        }
+        if !s.clock_valid || !s.playing {
+            return Err("clock-stale");
+        }
+        if matches!(
+            s.experiment,
+            ExperimentState::Waiting | ExperimentState::Running | ExperimentState::Finished
+        ) {
+            return Err("experiment-active");
+        }
+        Ok(None)
+    }
+    fn command(&mut self, v: &Value, now: u64) -> Value {
+        if v["op"] == "receipt" {
+            if closed(v, &["v", "id", "op"]).is_err()
+                || v["v"] != 1
+                || v["id"].as_str().is_none_or(|id| !is_command_id(id))
+            {
+                return receipt(v, false, "command-invalid");
+            }
+            return self.ledger.iter().find(|(prior,_)|prior["id"]==v["id"]).map_or_else(||json!({"v":1,"id":v["id"],"state":"outcome_unknown","accepted":false,"reason":"receipt-unavailable"}),|(_,r)|r.clone());
+        }
+        match self.check_command(v, now) {
+            Ok(Some(receipt)) => return receipt,
+            Err(reason) => return receipt(v, false, reason),
+            Ok(None) => {}
+        }
+        self.apply_command(v, now)
+    }
+    fn apply_command(&mut self, v: &Value, now: u64) -> Value {
+        let result = match v["op"].as_str().unwrap_or("") {
+            "start" => {
+                self.started = true;
+                Ok(())
+            }
+            "controller" => {
+                self.controller_seen_ns = None;
+                self.controller_lost = false;
+                self.controller_lost_frames = None;
+                self.controller_resume_deadline_ns = None;
+                self.core.select_controller().map_err(|f| f.as_str())
+            }
+            "calibrate" => {
+                if self.source_binding.is_none_or(|b| b.0 == 0) {
+                    Err("polar-source-unavailable")
+                } else {
+                    self.core
+                        .start_calibration(self.source_reference, now)
+                        .map_err(|f| f.as_str())
+                }
+            }
+            "begin-main" => {
+                if !self.ready(self.core.snapshot(now), now) {
+                    Err("input-not-ready")
+                } else {
+                    self.core.request_experiment(now).map_err(|f| f.as_str())
+                }
+            }
+            "end-main" => {
+                self.core = BreathingSetup::new(self.schedule);
+                self.controller_generation = None;
+                self.controller_seen_ns = None;
+                self.controller_volume01 = None;
+                self.controller_lost = false;
+                self.controller_lost_frames = None;
+                self.controller_resume_deadline_ns = None;
+                self.classified_model = None;
+                self.classified_at = None;
+                self.phase = CommonBreathPhase::Unknown;
+                self.started = false;
+                self.last_admitted_frame = None;
+                if let Some((g, frame, ns, playing)) = self.last_clock {
+                    self.core.observe_clock(g, frame, ns, playing);
+                }
+                Ok(())
+            }
+            _ => Err("command-invalid"),
+        };
+        let accepted = result.is_ok();
+        if accepted {
+            if v["op"] == "calibrate" {
+                // Core calibration retires the model immediately. Retire its
+                // measured phase/raw timestamp too, before a retry can activate
+                // another model at an audio boundary without a new ACC callback.
+                self.classified_model = None;
+                self.classified_at = None;
+                self.phase = CommonBreathPhase::Unknown;
+            }
+            self.revision = self.revision.saturating_add(1);
+            self.refresh(now);
+        }
+        let result = receipt(v, accepted, result.err().unwrap_or("accepted"));
+        if self.ledger.len() == 64 {
+            self.ledger.pop_front();
+        }
+        self.ledger.push_back((v.clone(), result.clone()));
+        result
+    }
+    fn input_phase(&self, now: u64) -> &'static str {
+        match self.output(now) {
+            SetupDriverOutput::Waiting => "unknown",
+            SetupDriverOutput::Automatic { .. } => match self.core.snapshot(now).phase {
+                crate::experiment_breathing_setup::SetupPhase::Inhale => "inhale",
+                crate::experiment_breathing_setup::SetupPhase::Exhale => "exhale",
+                _ => "hold",
+            },
+            SetupDriverOutput::PolarTilt { phase, .. } => phase.as_str(),
+            SetupDriverOutput::Controller => self.phase.as_str(),
+        }
+    }
+    fn input_volume(&self, now: u64) -> Option<f64> {
+        match self.output(now) {
+            SetupDriverOutput::Automatic { volume, .. }
+            | SetupDriverOutput::PolarTilt { volume, .. } => Some(volume),
+            SetupDriverOutput::Controller => self.controller_volume01,
+            SetupDriverOutput::Waiting => None,
+        }
+    }
+    fn tilt_assessment(
+        &self,
+        now: u64,
+    ) -> Option<rusty_quest_breath_contract::assessment::BreathAssessmentObservation> {
+        use rusty_quest_breath_contract::{
+            assessment::{
+                BreathAssessmentFields, BreathAssessmentObservation, BreathTrackingState,
+            },
+            calibration::CalibrationLifecycle,
+            BreathGeneration,
+        };
+        let sample = self.core.driver_sample(now).filter(|s| {
+            s.input == SetupInput::PolarTilt && self.classified_model_matches(s.model_generation)
+        })?;
+        BreathAssessmentObservation::new(BreathAssessmentFields {
+            generation: BreathGeneration::new(sample.model_generation?).ok()?,
+            sequence_id: self.sequence,
+            sampled_at: BreathTimestampMicros::new(self.classified_at? / 1000),
+            observed_at: BreathTimestampMicros::new(
+                self.classified_at?
+                    .saturating_add(now.saturating_sub(sample.source_timestamp_ns))
+                    / 1000,
+            ),
+            volume01: Some(sample.volume),
+            phase: self.phase,
+            calibration: CalibrationLifecycle::Ready,
+            tracking: BreathTrackingState::Valid,
+            quality01: 1.0,
+        })
+        .ok()
+    }
+}
+fn receipt(command: &Value, accepted: bool, reason: &str) -> Value {
+    json!({"v":1,"id":command["id"].as_str().unwrap_or(""),"state":if accepted {"confirmed"} else {"rejected"},"accepted":accepted,"reason":reason})
+}
+
+const SELECTED_LOOP_SHA256: Option<&str> =
+    option_env!("RUSTY_QUEST_NATIVE_RENDERER_BOX_LOOP_SHA256");
+#[cfg(test)]
+static TEST_SELECTED: Mutex<Option<String>> = Mutex::new(None);
+fn selected_digest() -> Option<String> {
+    #[cfg(test)]
+    if let Some(digest) = TEST_SELECTED.lock().unwrap().clone() {
+        return Some(digest);
+    }
+    SELECTED_LOOP_SHA256.map(str::to_owned)
+}
+fn state() -> &'static Mutex<Option<Runtime>> {
+    static STATE: OnceLock<Mutex<Option<Runtime>>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(None))
+}
+fn command_gate() -> &'static Mutex<()> {
+    static GATE: OnceLock<Mutex<()>> = OnceLock::new();
+    GATE.get_or_init(|| Mutex::new(()))
+}
+pub(crate) fn selected() -> bool {
+    selected_digest().is_some_and(|v| is_hex(&v, 64))
+}
+fn empty_status(reason: &str) -> Value {
+    json!({"v":1,"g":0,"r":0,"stage":"idle","input":"automatic","phase":"inhale","input_phase":"unknown","input_volume01":null,"position_frames":0,"cycle_frames":705600,
+        "target_frames":1411200,"completed_frames":0,"attempt":0,"calibration":"idle","failure":reason,"ready":false,"playing":false,"experiment_elapsed_ms":0,"main_start_frame":null,"main_started":false})
+}
+pub(crate) fn configure(json_text: &str, digest: &str) -> Value {
+    let _gate = command_gate().lock().unwrap_or_else(|e| e.into_inner());
+    let schedule = match validate_loop(json_text, digest, selected_digest().as_deref()) {
+        Ok(s) => s,
+        Err(reason) => return json!({"accepted":false,"reason":reason}),
+    };
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(runtime) = guard.as_ref() {
+        return json!({"accepted":runtime.digest==digest,"reason":if runtime.digest==digest {"already-configured"} else {"configuration-retired"}});
+    }
+    *guard = Some(Runtime::new(schedule, digest.to_owned()));
+    drop(guard);
+    crate::polar_input_health::set_setup_required(Some(false));
+    json!({"accepted":true,"reason":"configured"})
+}
+pub(crate) fn observe_clock(g: u64, frame: u64, ns: u64, playing: bool) {
+    if !selected() || g == 0 || ns == 0 {
+        return;
+    }
+    let binding = crate::polar_input_health::source_binding();
+    let required = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return;
+        };
+        r.bind_source(binding);
+        r.observe_clock(g, frame, ns, playing);
+        r.core.snapshot(ns).input == SetupInput::PolarTilt
+    };
+    crate::polar_input_health::set_setup_required(Some(required));
+}
+pub(crate) fn observe_source_clock_pair(nano: u64, elapsed: u64) {
+    if !selected() {
+        return;
+    }
+    if let Some(r) = state().lock().unwrap_or_else(|e| e.into_inner()).as_mut() {
+        r.observe_source_pair(nano, elapsed);
+    }
+}
+pub(crate) fn status_json(now: u64) -> Value {
+    if !selected() {
+        return empty_status("not-selected");
+    }
+    let binding = crate::polar_input_health::source_binding();
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    match guard.as_mut() {
+        Some(r) => {
+            r.bind_source(binding);
+            r.status(now)
+        }
+        None => empty_status("not-configured"),
+    }
+}
+pub(crate) fn command_json(text: &str, now: u64) -> Value {
+    if text.len() > 2048 {
+        return receipt(&Value::Null, false, "command-invalid");
+    }
+    let value: Value = match serde_json::from_str::<Value>(text)
+        .ok()
+        .filter(|_| text.len() <= 2048)
+    {
+        Some(v) => v,
+        None => return receipt(&Value::Null, false, "command-invalid"),
+    };
+    if !selected() {
+        return receipt(&value, false, "not-selected");
+    }
+    let _gate = command_gate().lock().unwrap_or_else(|e| e.into_inner());
+    let binding = crate::polar_input_health::source_binding();
+    {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return receipt(&value, false, "not-configured");
+        };
+        r.bind_source(binding);
+        if value["op"] == "receipt" {
+            return r.command(&value, now);
+        }
+        match r.check_command(&value, now) {
+            Ok(Some(result)) => return result,
+            Err(reason) => return receipt(&value, false, reason),
+            Ok(None) => {}
+        }
+    }
+    // Composition callbacks run without the setup mutex. The closed command gate
+    // serializes mutations; raw acquisition and audio observations remain live.
+    let controller_generation = if value["op"] == "controller" {
+        match crate::breath_composition_runtime::select_setup_controller() {
+            Ok(g) => Some(g),
+            Err(reason) => return receipt(&value, false, reason),
+        }
+    } else {
+        None
+    };
+    let binding = crate::polar_input_health::source_binding();
+    let (result, required) = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return receipt(&value, false, "not-configured");
+        };
+        r.bind_source(binding);
+        if r.generation != value["g"].as_u64().unwrap_or(0) {
+            return receipt(&value, false, "stale-generation");
+        }
+        if let Some(g) = controller_generation {
+            r.controller_generation = Some(g);
+        }
+        let result = r.apply_command(&value, now);
+        (result, r.core.snapshot(now).input == SetupInput::PolarTilt)
+    };
+    crate::polar_input_health::set_setup_required(Some(required));
+    result
+}
