@@ -0,0 +1,71 @@
+param([string]$RepoRoot = '')
+
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+if (!$RepoRoot) { $RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path }
+$scratch = Join-Path ([IO.Path]::GetTempPath()) ('native-manifest-options-' + [guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $scratch | Out-Null
+$resolver = Join-Path $RepoRoot 'tools/Resolve-NativeAppBuild.ps1'
+$spec = Get-Content -Raw -LiteralPath (Join-Path $RepoRoot 'fixtures/native-app-builds/native-openxr-hand-lab.app.json') | ConvertFrom-Json -AsHashtable
+$schema = Join-Path $RepoRoot 'schemas/rusty.quest.native_app_build.v1.schema.json'
+$android = 'http://schemas.android.com/apk/res/android'
+
+function Resolve-Case([string]$Name, [hashtable]$Spec) {
+    $path = Join-Path $scratch "$Name.app.json"
+    $Spec | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $path -Encoding utf8NoBOM
+    $output = Join-Path $scratch $Name
+    $log = @(& pwsh -NoProfile -File $resolver -AppSpec $path -OutputRoot $output -DryRun 2>&1)
+    if ($LASTEXITCODE -ne 0) { throw "Resolver failed: $($log -join [Environment]::NewLine)" }
+    $lockPath = @(Get-ChildItem -LiteralPath $output -Recurse -Filter feature-lock.json)[0].FullName
+    $lock = Get-Content -Raw -LiteralPath $lockPath | ConvertFrom-Json
+    [xml]$manifest = Get-Content -Raw -LiteralPath (Join-Path (Split-Path -Parent $lockPath) 'AndroidManifest.xml')
+    return @{ lock = $lock; manifest = $manifest; spec_path = $path }
+}
+
+# Break caught: ignoring an explicit release selection would emit a debuggable APK.
+$releaseSpec = $spec.Clone()
+$releaseSpec.android_debuggable = $false
+$releaseSpec.experiment_breathing_setup_enabled = $true
+$release = Resolve-Case 'selected' $releaseSpec
+if ($release.manifest.manifest.application.GetAttribute('debuggable', $android) -cne 'false') {
+    throw 'Explicit android_debuggable=false did not reach the resolved manifest.'
+}
+$metadata = @($release.manifest.SelectNodes('/manifest/application/meta-data') | Where-Object {
+    $_.GetAttribute('name', $android) -ceq 'rusty.quest.experiment.breathing_setup.enabled'
+})
+if ($metadata.Count -ne 1 -or $metadata[0].GetAttribute('value', $android) -cne 'true') {
+    throw 'Explicit breathing setup selection did not reach the resolved manifest exactly once.'
+}
+if ($release.lock.android_manifest.debuggable -isnot [bool] -or $release.lock.android_manifest.debuggable -or
+    $release.lock.android_manifest.experiment_breathing_setup_enabled -cne $true) {
+    throw 'The selected manifest options are absent from the feature lock.'
+}
+if (!(Test-Json -Json (Get-Content -Raw -LiteralPath $release.spec_path) -SchemaFile $schema)) {
+    throw 'Selected manifest options do not conform to the app schema.'
+}
+$debugLog = @(& pwsh -NoProfile -File $resolver -AppSpec $release.spec_path -OutputRoot (Join-Path $scratch 'release-debug-operator') -EnableExperimentSessionDebugOperator -DryRun 2>&1)
+if ($LASTEXITCODE -eq 0 -or ($debugLog -join "`n") -notmatch 'non-debuggable app cannot select the experiment debug operator') {
+    throw 'Non-debuggable app admitted the debug-only experiment provider.'
+}
+
+# Break caught: changing defaults would activate setup or release behavior for existing apps.
+$legacy = Resolve-Case 'legacy' $spec
+if ($legacy.manifest.manifest.application.GetAttribute('debuggable', $android) -cne 'true' -or
+    @($legacy.manifest.SelectNodes('/manifest/application/meta-data') | Where-Object {
+        $_.GetAttribute('name', $android) -ceq 'rusty.quest.experiment.breathing_setup.enabled'
+    }).Count -ne 0) { throw 'Omitted manifest options changed legacy behavior.' }
+if ($legacy.lock.resolution_fingerprint -ceq $release.lock.resolution_fingerprint) {
+    throw 'Manifest option selection was not bound into resolution identity.'
+}
+
+foreach ($field in @('android_debuggable', 'experiment_breathing_setup_enabled')) {
+    $invalid = $spec.Clone()
+    $invalid[$field] = 'false'
+    $path = Join-Path $scratch "invalid-$field.app.json"
+    $invalid | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $path -Encoding utf8NoBOM
+    $log = @(& pwsh -NoProfile -File $resolver -AppSpec $path -OutputRoot (Join-Path $scratch "invalid-$field") -DryRun 2>&1)
+    if ($LASTEXITCODE -eq 0 -or ($log -join "`n") -notmatch "$field must be a JSON boolean") {
+        throw "Non-boolean $field was not rejected by its typed boundary."
+    }
+}
+Write-Output "PASS: typed manifest options, defaults, schema and lock identity ($scratch)"
