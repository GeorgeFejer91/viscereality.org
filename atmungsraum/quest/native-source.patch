+fn labelled_participant_shape(pattern: u8, second: f64) -> f64 {
+    let cycle = (second / 16.0) as u64;
+    let t = second % 16.0;
+    if pattern == 0 {
+        // Smooth nonlinear breathing continues moving during both labelled
+        // holds. Labels train the mapping; they do not certify a waveform.
+        return 0.10 * (1.0 - (t * std::f64::consts::PI / 8.0).cos()) / 2.0;
+    }
+    let volume = if t < 4.0 {
+        (t / 4.0).sqrt()
+    } else if t < 8.0 {
+        1.0 - 0.45 * ((t - 4.0) / 4.0)
+    } else if t < 12.0 {
+        0.55 * (1.0 - ((t - 8.0) / 4.0).powi(2))
+    } else {
+        0.08 * ((t - 12.0) * std::f64::consts::PI / 4.0).sin()
+    };
+    if pattern == 1 || cycle == 0 {
+        0.10 * volume
+    } else {
+        // A shallower second breath has a different offset, hold slope and
+        // ramp shape. Neither recurrence nor equal amplitudes are required.
+        let other = if t < 4.0 {
+            (t / 4.0).powi(2)
+        } else if t < 8.0 {
+            1.0 - 0.70 * ((t - 4.0) / 4.0)
+        } else if t < 12.0 {
+            0.30 * (1.0 - ((t - 8.0) / 4.0).sqrt())
+        } else {
+            0.0
+        };
+        0.015 + 0.065 * other
+    }
+}
