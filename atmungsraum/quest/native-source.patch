+    #[test]
+    fn combines_raw_samples_renderer_frames_and_classified_breath_at_their_own_times() {
+        let scratch = Scratch::new();
+        let directory = &scratch.0;
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "haupt-15")).unwrap();
+        let run = ParticipantRun::reserve(directory, plan).unwrap();
+        let anchor = ClockAnchor::new(MonotonicNanos::new(1000), UtcEpochNanos::new(1_700_000_000_000_000_000));
+        fs::write(directory.join("events.jsonl"), "{\"event\":\"official-start\",\"observed_monotonic_ns\":1000}\n").unwrap();
+        let streams = [
+            ("polar-ecg.jsonl", json!({"kind":"polar-ecg","observed_monotonic_ns":5000,"source_sequence":42,"sample_index":0,"source_time_ns":128,"microvolts":-37})),
+            ("polar-acc.jsonl", json!({"kind":"polar-acc","observed_monotonic_ns":2000,"source_sequence":31,"sample_index":1,"source_time_ns":124,"xyz_mg":[11,-23,998]})),
+            ("radius.jsonl", json!({"kind":"effective-radius-snapshot","observed_monotonic_ns":4000,"source_frame":91,"resulting_radius_m":0.75})),
+            ("breath.jsonl", json!({"kind":"breath","observed_monotonic_ns":3000,"unbiased_phase":"inhale","assessment_source":"polar-acc"})),
+        ];
+        for (name, row) in streams {
+            fs::write(directory.join(name), format!("{row}\n")).unwrap();
+        }
+        let csv = run.finalize_csv(directory, anchor, MonotonicNanos::new(6000), true, "finished").unwrap().unwrap();
+        let contents = fs::read_to_string(directory.join(csv["name"].as_str().unwrap())).unwrap();
+        let mut lines = contents.lines();
+        let header: Vec<_> = lines.next().unwrap().split(',').collect();
+        let column = |name| header.iter().position(|field| *field == name).unwrap();
+        let rows: Vec<Vec<_>> = lines.map(|line| line.split(',').collect()).collect();
+        assert!(rows.iter().all(|row| row.len() == header.len()));
+        let values = |field| rows.iter().map(|row| row[column(field)]).collect::<Vec<_>>();
+        assert_eq!(values("record_type"), ["accelerometer", "breath", "radius", "ecg", "end"]);
+        assert_eq!(values("elapsed_us"), ["1", "2", "3", "4", "5"]);
+        assert_eq!(values("sensor_time_ns"), ["124", "", "", "128", ""]);
+        assert_eq!(values("ecg_uv"), ["", "", "", "-37", ""]);
+        assert_eq!(values("acc_y_mg"), ["-23", "", "", "", ""]);
+        assert_eq!(values("radius_m"), ["", "", "0.75", "", ""]);
+        assert_eq!(values("breathing_phase"), ["", "inhale", "", "", ""]);
+        assert_eq!(csv["schema_version"], CSV_SCHEMA_VERSION);
+    }
+
+    #[test]
+    fn projects_native_ecg_pause_phase_and_signal_gaps_to_the_original_csv() {
+        let scratch = Scratch::new();
+        let directory = &scratch.0;
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "haupt-15")).unwrap();
+        let run = ParticipantRun::reserve(directory, plan).unwrap();
+        let start = 1_000_000_000;
+        let epoch = UtcEpochNanos::new(1_700_000_000_000_000_000);
+        let anchor = ClockAnchor::new(MonotonicNanos::new(start), epoch);
+        let event = |at, kind| json!({"event":kind,"observed_monotonic_ns":at}).to_string();
+        fs::write(
+            directory.join("events.jsonl"),
+            [
+                event(start, "official-start"),
+                event(start + 10_000_000, "audio-started"),
+                event(start + 26_010_000_000, "experiment-paused"),
+                event(start + 30_010_000_000, "experiment-resumed"),
+            ]
+            .join("\n"),
+        )
+        .unwrap();
+        let sample = |at, index, value| {
+            json!({"kind":"polar-ecg","observed_monotonic_ns":at,
+            "source_sequence":index,"source_time_ns":at,"sample_index":0,"microvolts":value})
+            .to_string()
+        };
+        for name in ["polar-acc.jsonl", "radius.jsonl", "breath.jsonl"] {
+            fs::write(directory.join(name), "").unwrap();
+        }
+        fs::write(
+            directory.join("polar-ecg.jsonl"),
+            [
+                sample(start - 1, 499, 0),
+                sample(start, 500, -12),
+                sample(start + 27_000_000_000, 501, 230),
+                sample(start + 45_010_000_000, 502, -31),
+            ]
+            .join("\n"),
+        )
+        .unwrap();
+        let end = MonotonicNanos::new(start + 45_010_000_000);
+        let descriptor = run
+            .finalize_csv(directory, anchor, end, false, "save-and-exit")
+            .unwrap()
+            .unwrap();
+        assert_eq!(descriptor["name"], "Tes_30_N_2023-11-14_haupt-15_r1.csv");
+        assert_eq!(descriptor["session_id"], run.uuid);
+        let csv = fs::read_to_string(directory.join("Tes_30_N_2023-11-14_haupt-15_r1.csv")).unwrap();
+        assert_eq!(descriptor["size"], csv.len());
+        assert_eq!(
+            descriptor["sha256"],
+            format!("{:x}", Sha256::digest(csv.as_bytes()))
+        );
+        assert!(csv.starts_with(HEADER));
+        let rows: Vec<Vec<&str>> = csv
+            .split_terminator("\r\n")
+            .skip(1)
+            .map(|row| row.split(',').collect())
+            .collect();
+        assert_eq!(rows.len(), 4);
+        assert!(rows.iter().all(|row| row.len() == HEADER.trim_end().split(',').count()));
+        assert_eq!(&rows[0][5..15], ["ecg", "2023-11-14T22:13:20.000000Z", "0", "0",
+            "waiting", "waiting", "1000000000", "500", "0", "-12"]);
+        assert_eq!(&rows[1][8..11], ["26000000", "paused", "calibration"]);
+        assert_eq!(&rows[2][8..11], ["41000000", "playing", "instruction_2"]);
+        assert_eq!(rows[3][5], "end");
+        assert_eq!(&rows[3][21..], ["aborted", "save-and-exit", ""]);
+        assert!(
+            run.finalize_csv(directory, anchor, end, false, "save-and-exit")
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn an_arm_without_official_start_reserves_an_index_without_a_csv() {
+        let scratch = Scratch::new();
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "probe-5")).unwrap();
+        let run = ParticipantRun::reserve(&scratch.0, plan.clone()).unwrap();
+        fs::write(
+            scratch.0.join("events.jsonl"),
+            r#"{"event":"started","observed_monotonic_ns":1}"#,
+        )
+        .unwrap();
+        let anchor = ClockAnchor::new(MonotonicNanos::new(1), UtcEpochNanos::new(0));
+        assert!(
+            run.finalize_csv(&scratch.0, anchor, MonotonicNanos::new(2), false, "restart")
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(ParticipantRun::reserve(&scratch.0, plan).unwrap().index, 2);
+    }
+}
