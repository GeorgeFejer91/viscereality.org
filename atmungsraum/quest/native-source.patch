new file mode 100644
index 00000000..a6b1d21f
--- /dev/null
+++ b/apps/native-renderer-android/tests/java/io/github/mesmerprism/rustyquest/native_renderer/ExperimentSessionWifiCredentialsTest.java
@@ -0,0 +1,70 @@
+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import javax.crypto.Cipher;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+public final class ExperimentSessionWifiCredentialsTest {
+    private static final String KEY = repeat('c', 64);
+    private static final String BINDING = repeat('b', 32) + "|" + repeat('a', 32) + "|7|8";
+
+    public static void main(String[] args) throws Exception {
+        byte[] challenge = new byte[16];
+        byte[] packet = packet("Pixel-Prüfung", "temporary-password", challenge);
+        ExperimentSessionWifiCredentials credentials =
+            ExperimentSessionWifiCredentials.decrypt(KEY, BINDING, challenge, packet);
+        if (!"Pixel-Prüfung".equals(credentials.ssid) || !"temporary-password".equals(credentials.passphrase))
+            throw new AssertionError("credential readback");
+        byte[] otherPeer = challenge.clone();
+        otherPeer[0] = 1;
+        rejected(() -> ExperimentSessionWifiCredentials.decrypt(KEY, BINDING, otherPeer, packet));
+        rejected(() -> ExperimentSessionWifiCredentials.decrypt(KEY, BINDING + "9", challenge, packet));
+        rejected(() -> ExperimentSessionWifiCredentials.decrypt(repeat('d', 64), BINDING, challenge, packet));
+        byte[] changed = packet.clone();
+        changed[changed.length - 1] ^= 1;
+        rejected(() -> ExperimentSessionWifiCredentials.decrypt(KEY, BINDING, challenge, changed));
+        for (byte[] invalid : new byte[][]{
+                packet("Pixel", "1234567", challenge),
+                packet("Pixel", "bad-password-é", challenge),
+                packet("Pixel\n", "valid-password", challenge),
+                Arrays.copyOf(packet, 37),
+                Arrays.copyOf(packet, 125)}) {
+            rejected(() -> ExperimentSessionWifiCredentials.decrypt(KEY, BINDING, challenge, invalid));
+        }
+        System.out.println("PASS 10 production encrypted Wi-Fi credential checks");
+    }
+
+    private static byte[] packet(String ssid, String passphrase, byte[] challenge) throws Exception {
+        byte[] name = ssid.getBytes(StandardCharsets.UTF_8);
+        byte[] password = passphrase.getBytes(StandardCharsets.UTF_8);
+        byte[] message = new byte[1 + name.length + password.length];
+        message[0] = (byte) name.length;
+        System.arraycopy(name, 0, message, 1, name.length);
+        System.arraycopy(password, 0, message, 1 + name.length, password.length);
+        byte[] key = ExperimentSessionGatewayProtocol.hmacBytes(KEY, "RQG1-WIFI-KEY|" + BINDING);
+        byte[] iv = new byte[12];
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(key, "AES"), new GCMParameterSpec(128, iv));
+        cipher.updateAAD(("RQG1-WIFI|" + BINDING + "|").getBytes(StandardCharsets.UTF_8));
+        cipher.updateAAD(challenge);
+        byte[] encrypted = cipher.doFinal(message);
+        byte[] packet = new byte[iv.length + encrypted.length];
+        System.arraycopy(encrypted, 0, packet, iv.length, encrypted.length);
+        return packet;
+    }
+
+    private static String repeat(char ch, int length) {
+        char[] chars = new char[length];
+        Arrays.fill(chars, ch);
+        return new String(chars);
+    }
+
+    private interface Check { void run() throws Exception; }
+    private static void rejected(Check check) throws Exception {
+        try { check.run(); }
+        catch (SecurityException | javax.crypto.AEADBadTagException expected) { return; }
+        throw new AssertionError("invalid encrypted setup was accepted");
+    }
+}
