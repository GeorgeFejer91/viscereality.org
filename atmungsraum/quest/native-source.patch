+#[test]
+fn old_participant_manifest_recovers_observations_without_guessing_authored_phases() {
+    use crate::session_recording_writer::{SessionRecordingWriter, tests::{config, interrupted_participant_fixture, temp_root}};
+    use std::time::Duration;
