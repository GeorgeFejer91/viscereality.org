+#[cfg(target_os = "android")]
+pub(crate) fn recenter_scope() -> Option<crate::experiment_recenter::Scope> {
+    use crate::experiment_control_mode::{self, ControlMode};
+    use crate::experiment_session::ExperimentControlState;
+
+    let mode = experiment_control_mode::read();
+    if !mode.selected() || mode.mode() != ControlMode::Remote {
+        return None;
+    }
+    let runtime = runtime().ok()?;
+    let owner = runtime.immersive_owner_identity.load(Ordering::Acquire);
+    let projection = runtime.projection.try_read().ok()?;
+    if owner == 0
+        || projection.presentation != PresentationState::ImmersiveActive
+        || !matches!(projection.phase, SessionPhase::Idle | SessionPhase::Active)
+        || matches!(
+            projection.control_state,
+            ExperimentControlState::Arming | ExperimentControlState::Finalizing
+        )
+    {
+        return None;
+    }
+    Some(crate::experiment_recenter::Scope {
+        owner,
+        epoch: runtime.runtime_epoch,
+        generation: projection.generation,
+        mode: mode.packed(),
+    })
+}
