+    #[test]
+    fn an_arm_without_official_start_reserves_an_index_without_a_csv() {
+        let scratch = Scratch::new();
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "probe-5")).unwrap();
+        let run = ParticipantRun::reserve(&scratch.0, plan.clone()).unwrap();
