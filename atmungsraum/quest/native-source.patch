+#[test]
+fn retired_polar_evidence_cannot_recover_from_readback_or_old_confirmation() {
+    use crate::breath_composition_driver::{
+        tests::{settings, setup_frame_with_lineage},
+        BreathCompositionDriver,
+    };
+    for input in [
+        SetupInput::PolarTilt,
+        SetupInput::PolarTiltFixed,
+        SetupInput::PolarTiltAdaptive,
+    ] {
+        for barrier in ["poll-gap", "source-generation", "repeated-stall"] {
+            let (mut r, frame, now) = polar_diagnosis_runtime(input, CommonBreathPhase::Inhale);
+            r.observe_source_pair(now, now);
+            assert!(r.tracking_configuration(1, "test-main").is_ok());
+            let old = r.renderer_lineage(now);
+            let measured = RendererRadius {
+                lineage: old,
+                progress01: 0.7,
+                radius_m: 1.5,
+                frame: 50,
+                observed_ns: now,
+                render_generation: 1,
+                settings_revision: 1,
+            };
+            let mut driver = BreathCompositionDriver::new(settings());
+            setup_frame_with_lineage(&mut driver, r.output(now), old, now, 0.2);
+            let revision = r.confirmation_revision;
+            let mut at = now + 300_000_000;
+            let mut current_frame = frame + 13230;
+            match barrier {
+                "source-generation" => {
+                    r.bind_source((5, 2));
+                    r.refresh(now);
+                }
+                "repeated-stall" => {
+                    current_frame = frame;
+                    for tick in 1..=25 {
+                        r.observe_clock(7, frame, now + tick * 20_000_000, true);
+                    }
+                    at = now + 500_000_000;
+                }
+                _ => r.observe_clock(7, current_frame, at, true),
+            }
+            let retired = r.renderer_lineage(at);
+            for _ in 0..5 {
+                assert_eq!(r.status(at)["ready"], false);
+                assert_eq!(r.confirmation_revision, revision);
+                assert_eq!(
+                    r.renderer_lineage(at),
+                    retired,
+                    "status cannot re-retire or rearm evidence"
+                );
+                assert!(r.last_confirmed_phase.is_none());
+                assert!(r.tilt_assessment(at).is_none());
+                assert_eq!(
+                    r.tracking_configuration(1, "test-main"),
+                    Err("setup-input-not-ready")
+                );
+            }
+            assert!(
+                measured.json(retired, at).is_null(),
+                "old renderer metadata must not be relabeled"
+            );
+            assert_eq!(command(&mut r, 2, "begin-main", at)["accepted"], false);
+            // Forward audio alone is not fresh Polar evidence.
+            for tick in 1..=5 {
+                r.observe_clock(7, current_frame + tick * 882, at + tick * 20_000_000, true);
+                assert_eq!(r.status(at + tick * 20_000_000)["ready"], false);
+                assert!(r.last_confirmed_phase.is_none());
+            }
+            current_frame += 5 * 882;
+            at += 100_000_000;
+            for tick in 1..=100 {
+                let ns = at + tick * 40_000_000;
+                r.observe_clock(7, current_frame + tick * 1764, ns, true);
+                r.observe_source_pair(ns, ns);
+                r.observe_host_aligned_acc(100_000_000_000 + ns, ns, [0.0, 0.0, 1000.0]);
+                if tick == 1 {
+                    if let Some((lineage, phase)) = r.last_confirmed_phase {
+                        assert!(
+                            input.pretrained(),
+                            "retired participant fit cannot classify"
+                        );
+                        assert_eq!(phase, CommonBreathPhase::Hold);
+                        assert!(r.confirmation_revision > revision);
+                        assert_ne!(lineage.driver_epoch, old.driver_epoch);
+                    }
+                }
+            }
+            let end = at + 4_000_000_000;
+            assert_eq!(r.status(end)["input"], input.as_str());
+            if input.pretrained() {
+                assert_eq!(r.status(end)["ready"], true);
+                assert!(r.confirmation_revision > revision);
+                assert!(matches!(
+                    r.output(end),
+                    SetupDriverOutput::PolarTilt {
+                        confirmed_phase: Some(CommonBreathPhase::Hold),
+                        ..
+                    }
+                ));
+                let configuration = r.tracking_configuration(2, "fresh-main").unwrap();
+                assert_eq!(
+                    configuration["model"]["kind"],
+                    "pretrained-paired-controller-tilt-v1"
+                );
+                assert_eq!(configuration["input"], input.as_str());
+                setup_frame_with_lineage(
+                    &mut driver,
+                    r.output(end),
+                    r.renderer_lineage(end),
+                    end,
+                    0.1,
+                );
+                assert!(
+                    (driver.value01() - 0.3).abs() < 0.000001,
+                    "fresh Hold replaces retained Inhale without radius reset"
+                );
+            } else {
+                assert_eq!(r.status(end)["ready"], false);
+                assert_eq!(r.status(end)["calibration"], "failed");
+                assert!(r.core.model().is_none());
+                assert!(r.tilt_assessment(end).is_none());
+                assert_eq!(command(&mut r, 3, "calibrate", end)["accepted"], true);
+                assert_eq!(
+                    r.status(end)["input"],
+                    "automatic",
+                    "explicit retry owns Automatic guidance"
+                );
+                assert_eq!(r.status(end)["calibration"], "waiting");
+            }
+        }
+    }
