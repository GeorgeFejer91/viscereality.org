+            self.finish_recovery(false, "audio-recovery-timeout");
+        } else if self.core.snapshot(now).experiment != ExperimentState::Preparation
+            || self.last_admitted_frame.is_some()
+            || (polar_operation(&recovery.command)
+                && (recovery.source_reference != self.source_reference
+                    || recovery.projection_generation != self.projection_generation))
+            || (recovery.command["op"] == "controller"
+                && recovery.controller_generation != self.controller_generation)
+            || (recovery.target_generation == Some(self.generation)
+                && self
+                    .last_clock
+                    .is_some_and(|(g, _, _, playing)| g == self.generation && !playing))
+        {
+            self.finish_recovery(false, "audio-recovery-retired");
+        }
+    }
+    /// Private Java-owner handshake, never an external setup command.
+    fn recovery_effect(
+        &mut self,
+        id: &str,
+        old: u64,
+        target: u64,
+        action: &str,
+        now: u64,
+    ) -> Value {
+        self.expire_recovery(now);
+        if action == "fault" {
