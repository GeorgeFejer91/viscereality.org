+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.LinkAddress;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.net.wifi.WifiNetworkSpecifier;
+import android.os.Handler;
+import java.net.Inet4Address;
+
+final class ExperimentSessionWifiConnection implements AutoCloseable {
+    private final ConnectivityManager manager;
+    private final Handler main;
+    private Request request;
+
+    ExperimentSessionWifiConnection(Context context, Handler main) {
+        manager = context.getSystemService(ConnectivityManager.class);
+        this.main = main;
+    }
+
+    private final class Request extends ConnectivityManager.NetworkCallback
+            implements ExperimentSessionDiscoveryServer.SetupStatus {
+        volatile String status = "wait";
+
+        @Override public String status() { return status; }
+
+        @Override public void onLinkPropertiesChanged(Network network, LinkProperties properties) {
+            if (request != this) return;
+            status = "wait";
+            for (LinkAddress link : properties.getLinkAddresses()) {
+                if (link.getAddress() instanceof Inet4Address && link.getAddress().isSiteLocalAddress()) {
+                    status = link.getAddress().getHostAddress();
+                    return;
+                }
+            }
+        }
+
+        @Override public void onUnavailable() {
+            if (request != this) return;
+            status = "failed";
+            request = null;
+        }
+
+        @Override public void onLost(Network network) {
+            if (request == this) close();
+        }
+    }
+
+    ExperimentSessionDiscoveryServer.SetupStatus connect(ExperimentSessionWifiCredentials credentials) {
+        if (manager == null || request != null) throw new IllegalStateException("wifi-setup-unavailable");
+        WifiNetworkSpecifier hotspot = new WifiNetworkSpecifier.Builder()
+            .setSsid(credentials.ssid).setWpa2Passphrase(credentials.passphrase).build();
+        NetworkRequest network = new NetworkRequest.Builder()
+            .addTransportType(NetworkCapabilities.TRANSPORT_WIFI)
+            .removeCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+            .setNetworkSpecifier(hotspot).build();
+        Request joining = new Request();
+        request = joining;
+        try {
+            manager.requestNetwork(network, joining, main, 40_000);
+        } catch (RuntimeException failed) {
+            request = null;
+            throw failed;
+        }
+        return joining;
+    }
+
+    @Override public void close() {
+        Request old = request;
+        if (old == null) return;
+        request = null;
+        old.status = "failed";
+        try {
+            manager.unregisterNetworkCallback(old);
+        } catch (IllegalArgumentException alreadyReleased) {
+            // Android may release a timed-out request before its callback runs.
+        }
+    }
+}
