+        public String load(){return data;}
+        public boolean save(String next){if(fail)return false;data=next;return true;}
+    }
+    static JSONObject operation(String id,String op,long revision)throws Exception {
+        return new JSONObject().put("v",1).put("id",id).put("op",op).put("expected_control_revision",revision);
+    }
+    public static void main(String[] args)throws Exception {
+        Store store=new Store();ExperimentTrustedPhones phones=new ExperimentTrustedPhones(store);
+        JSONObject first=phones.add("First phone"),second=phones.add("Second phone");
+        String a=first.getString("controller"),b=second.getString("controller"),key=first.getString("key");
+        check(!a.equals(b)&&!key.equals(second.getString("key")),"independent membership");
+        ExperimentTrustedPhones loaded=new ExperimentTrustedPhones(store);
+        check(loaded.member(a).key.equals(key)&&loaded.size()==2,"persistent independent keys");
+        check(!loaded.list(1000).toString().contains(key),"public member list excludes keys");
+        check(phones.status(a,1000).getString("role").equals("waiting"),"initially unowned");
+        JSONObject claim=operation("1111111111111111","claim",0);
+        JSONObject receipt=phones.control(a,claim,1000);
