+$polar=Join-Path $repo "apps/native-renderer-android/panel-modules/polar/src/main/java/$package"
+$sources+=@((Join-Path $polar 'PolarBleRuntimeSupport.java'),(Join-Path $polar 'PolarSensorPanel.java'),(Join-Path $polar 'PolarSensorRuntime.java'),(Join-Path $panel 'NativeProductPanelActivity.java'))
+$observed=@($sources|ForEach-Object{@{path=$_;sha256=(Get-FileHash -LiteralPath $_).Hash.ToLowerInvariant()}})
