+use super::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+fn loop_json() -> String {
+    json!({"schema":"atmungsraum.box_breathing_loop.v1","sample_rate":44100,
+        "channels":1,"bits_per_sample":16,"cycle_frames":705600,"main_seconds":900,
+        "phases":(["inhale","hold_in","exhale","hold_out"].iter().enumerate().map(|(i,id)|
+            json!({"id":id,"offset_frames":i*176400,"duration_frames":176400,
+                "cue":{"path":format!("audio/{id}.wav"),"sha256":"ab".repeat(32),
+                    "bytes":352844,"frames":176400}})).collect::<Vec<_>>())})
+    .to_string()
+}
+fn digest(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+
+#[test]
+fn only_exact_selected_loop_bytes_and_closed_schedule_are_accepted() {
+    let text = loop_json();
+    let sha = digest(&text);
+    assert_eq!(
+        validate_loop(&text, &sha, Some(&sha)).unwrap().cycle_frames,
+        705600
+    );
+    assert!(validate_loop(&text, &sha, None).is_err());
+    assert!(validate_loop(&(text.clone() + " "), &sha, Some(&sha)).is_err());
+    for key in ["main_seconds", "cycle_frames", "channels", "sample_rate"] {
+        let mut bad: Value = serde_json::from_str(&text).unwrap();
+        bad[key] = json!(2);
+        let bad = bad.to_string();
+        let sha = digest(&bad);
+        assert!(validate_loop(&bad, &sha, Some(&sha)).is_err(), "{key}");
+    }
+    let mut bad: Value = serde_json::from_str(&text).unwrap();
+    bad["extra"] = json!(true);
+    let bad = bad.to_string();
+    let sha = digest(&bad);
+    assert!(validate_loop(&bad, &sha, Some(&sha)).is_err());
+}
+
+fn runtime() -> Runtime {
+    Runtime::new(
+        LoopSchedule::new(44100, [176400; 4]).unwrap(),
+        "ab".repeat(32),
+    )
+}
+fn command(runtime: &mut Runtime, id: u64, op: &str, now: u64) -> Value {
+    let s = runtime.status(now);
+    runtime.command(
+        &json!({"v":1,"id":format!("{id:016x}"),"g":s["g"],"r":s["r"],"op":op}),
+        now,
+    )
+}
+#[test]
+fn audio_frames_do_not_churn_cas_and_start_confirmation_is_replay_safe() {
+    let mut r = runtime();
+    r.observe_clock(7, 0, 1_000_000_000, true);
+    let s = r.status(1_000_000_000);
+    let request = json!({"v":1,"id":"0000000000000001","g":s["g"],"r":s["r"],"op":"start"});
+    for i in 1..=10 {
+        r.observe_clock(7, 882 * i, 1_000_000_000 + 20_000_000 * i, true);
+    }
+    assert_eq!(r.status(1_200_000_000)["r"], s["r"]);
+    let receipt = r.command(&request, 1_200_000_000);
+    assert_eq!(receipt["accepted"], true);
+    assert!(r.status(1_200_000_000)["r"].as_u64().unwrap() > s["r"].as_u64().unwrap());
+    assert_eq!(r.command(&request, 1_200_000_000), receipt);
+    let mut conflict = request.clone();
+    conflict["op"] = json!("controller");
+    assert_eq!(
+        r.command(&conflict, 1_200_000_000)["reason"],
+        "command-id-conflict"
+    );
+    assert_eq!(r.status(1_200_000_000)["position_frames"], 8820);
+    let mut stale = request.clone();
+    stale["id"] = json!("0000000000000002");
+    assert_eq!(r.command(&stale, 1_200_000_000)["reason"], "stale-revision");
