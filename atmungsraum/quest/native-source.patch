diff --git a/apps/native-renderer-android/native/src/experiment_recenter.rs b/apps/native-renderer-android/native/src/experiment_recenter.rs
new file mode 100644
index 00000000..b509cf18
--- /dev/null
+++ b/apps/native-renderer-android/native/src/experiment_recenter.rs
@@ -0,0 +1,295 @@
+use std::time::{Duration, Instant};
+
+const REQUEST_LIFETIME: Duration = Duration::from_secs(3);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Scope {
+    pub(crate) owner: u64,
+    pub(crate) epoch: u64,
+    pub(crate) generation: u64,
+    pub(crate) mode: u64,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum State {
+    Pending,
+    Drawing,
+    Confirmed,
+    Rejected,
+    Unknown,
+}
+
+impl State {
+    fn wire(self) -> &'static str {
+        match self {
+            Self::Pending | Self::Drawing => "pending",
+            Self::Confirmed => "confirmed",
+            Self::Rejected => "rejected",
+            Self::Unknown => "outcome_unknown",
+        }
+    }
+
+    fn unfinished(self) -> bool {
+        matches!(self, Self::Pending | Self::Drawing)
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct RecenterFrame {
+    pub(crate) id: String,
+    scope: Scope,
+}
+
+struct Request {
+    frame: RecenterFrame,
+    expires: Instant,
+    state: State,
+}
+
+#[derive(Default)]
+struct Mailbox(Option<Request>);
+
+impl Mailbox {
+    fn expire(&mut self, now: Instant) {
+        if let Some(request) = &mut self.0 {
+            if now >= request.expires {
+                request.state = match request.state {
+                    State::Pending => State::Rejected,
+                    State::Drawing => State::Unknown,
+                    terminal => terminal,
+                };
+            }
+        }
+    }
+
+    fn request(&mut self, id: &str, scope: Scope, now: Instant) -> &'static str {
+        self.expire(now);
+        if let Some(current) = &self.0 {
+            if current.frame.id == id && current.frame.scope == scope {
+                return current.state.wire();
+            }
+            if current.state.unfinished() {
+                return "rejected";
+            }
+        }
+        self.0 = Some(Request {
+            frame: RecenterFrame {
+                id: id.to_owned(),
+                scope,
+            },
+            expires: now + REQUEST_LIFETIME,
+            state: State::Pending,
+        });
+        "pending"
+    }
+
+    fn status(&mut self, id: &str, scope: Scope, now: Instant) -> &'static str {
+        self.expire(now);
+        self.0
+            .as_ref()
+            .filter(|r| r.frame.id == id && r.frame.scope == scope)
+            .map_or("outcome_unknown", |r| r.state.wire())
+    }
+
+    fn cancel(&mut self, id: &str, scope: Scope, now: Instant) -> &'static str {
+        self.expire(now);
+        let Some(request) = self
+            .0
+            .as_mut()
+            .filter(|r| r.frame.id == id && r.frame.scope == scope)
+        else {
+            return "outcome_unknown";
+        };
+        request.state = match request.state {
+            State::Pending => State::Rejected,
+            State::Drawing => State::Unknown,
+            terminal => terminal,
+        };
+        request.state.wire()
+    }
+
+    fn take(&mut self, scope: Scope, now: Instant) -> Option<RecenterFrame> {
+        self.expire(now);
+        let request = self.0.as_mut().filter(|r| r.state == State::Pending)?;
+        if request.frame.scope != scope {
+            request.state = State::Rejected;
+            return None;
+        }
+        request.state = State::Drawing;
+        Some(request.frame.clone())
+    }
+
+    fn submitted(
+        &mut self,
+        frame: &RecenterFrame,
+        current: Option<Scope>,
+        visible: bool,
+        now: Instant,
+    ) -> bool {
+        self.expire(now);
+        let Some(request) = self
+            .0
+            .as_mut()
+            .filter(|r| r.frame == *frame && r.state == State::Drawing)
+        else {
+            return false;
+        };
+        request.state = if !visible {
+            State::Rejected
+        } else if current == Some(frame.scope) {
+            State::Confirmed
+        } else {
+            State::Unknown
+        };
+        request.state == State::Confirmed
+    }
+}
+
+#[cfg(target_os = "android")]
+pub(crate) use android::{command, submitted, take_for_frame};
+
+#[cfg(target_os = "android")]
+mod android {
+    use super::*;
+    use crate::experiment_session_runtime::recenter_scope;
+    use serde_json::{json, Value};
+    use std::sync::Mutex;
+
+    static REQUESTS: Mutex<Mailbox> = Mutex::new(Mailbox(None));
+
+    pub(crate) fn command(value: &Value) -> String {
+        let status = match fields(value) {
+            Some((operation, id, scope)) => {
+                let now = Instant::now();
+                let mut requests = REQUESTS.lock().unwrap_or_else(|e| e.into_inner());
+                match operation {
+                    "request" if recenter_scope() == Some(scope) => {
+                        requests.request(id, scope, now)
+                    }
+                    "status" => requests.status(id, scope, now),
+                    "cancel" => requests.cancel(id, scope, now),
+                    _ => "rejected",
+                }
+            }
+            None => "rejected",
+        };
+        json!({ "state": status }).to_string()
+    }
+
+    fn fields(value: &Value) -> Option<(&str, &str, Scope)> {
+        let fields = value.as_object().filter(|object| object.len() == 7)?;
+        let id = fields.get("id")?.as_str()?;
+        if id.len() != 16
+            || !id
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return None;
+        }
+        Some((
+            fields.get("operation")?.as_str()?,
+            id,
+            Scope {
+                owner: fields.get("owner")?.as_u64()?,
+                epoch: fields.get("epoch")?.as_u64()?,
+                generation: fields.get("generation")?.as_u64()?,
+                mode: fields.get("mode")?.as_u64()?,
+            },
+        ))
+    }
+
+    pub(crate) fn take_for_frame() -> Option<RecenterFrame> {
+        let mut requests = REQUESTS.try_lock().ok()?;
+        if !requests
+            .0
+            .as_ref()
+            .is_some_and(|r| r.state == State::Pending)
+        {
+            return None;
+        }
+        requests.take(recenter_scope()?, Instant::now())
+    }
+
+    pub(crate) fn submitted(frame: &RecenterFrame, visible: bool) -> bool {
+        let mut requests = REQUESTS.lock().unwrap_or_else(|e| e.into_inner());
+        requests.submitted(frame, recenter_scope(), visible, Instant::now())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scope() -> Scope {
+        Scope {
+            owner: 1,
+            epoch: 7,
+            generation: 3,
+            mode: 30,
+        }
+    }
+
+    #[test]
+    fn confirmation_requires_a_submitted_visible_frame_and_replay_does_not_draw_again() {
+        let now = Instant::now();
+        let mut mailbox = Mailbox::default();
+        let id = "1111111111111111";
+        assert_eq!(mailbox.request(id, scope(), now), "pending");
+        let drawing = mailbox.take(scope(), now).unwrap();
+        assert_eq!(mailbox.status(id, scope(), now), "pending");
+        assert!(mailbox.submitted(&drawing, Some(scope()), true, now));
+        assert_eq!(mailbox.request(id, scope(), now), "confirmed");
+        assert!(mailbox.take(scope(), now).is_none());
+    }
+
+    #[test]
+    fn expired_cancelled_and_replaced_scopes_cannot_apply() {
+        let now = Instant::now();
+        let later = now + Duration::from_secs(4);
+        let mut mailbox = Mailbox::default();
+        let id = "1111111111111111";
+        mailbox.request(id, scope(), now);
+        assert_eq!(mailbox.status(id, scope(), later), "rejected");
+        assert!(mailbox.take(scope(), later).is_none());
+        let other = "2222222222222222";
+        mailbox.request(other, scope(), later);
+        assert!(mailbox
+            .take(
+                Scope {
+                    mode: 46,
+                    ..scope()
+                },
+                later
+            )
+            .is_none());
+        assert_eq!(mailbox.status(other, scope(), later), "rejected");
+        let third = "3333333333333333";
+        mailbox.request(third, scope(), later);
+        assert_eq!(mailbox.cancel(third, scope(), later), "rejected");
+        assert!(mailbox.take(scope(), later).is_none());
+    }
+
+    #[test]
+    fn unrendered_or_revoked_frames_do_not_confirm() {
+        let now = Instant::now();
+        let mut mailbox = Mailbox::default();
+        let id = "1111111111111111";
+        mailbox.request(id, scope(), now);
+        let drawing = mailbox.take(scope(), now).unwrap();
+        assert!(!mailbox.submitted(&drawing, Some(scope()), false, now));
+        assert_eq!(mailbox.status(id, scope(), now), "rejected");
+        let other = "2222222222222222";
+        mailbox.request(other, scope(), now);
+        let drawing = mailbox.take(scope(), now).unwrap();
+        assert!(!mailbox.submitted(
+            &drawing,
+            Some(Scope {
+                epoch: 8,
+                ..scope()
+            }),
+            true,
+            now
+        ));
+        assert_eq!(mailbox.status(other, scope(), now), "outcome_unknown");
+    }
+}
