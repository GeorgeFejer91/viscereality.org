diff --git a/tools/checks/Test-BreathingSetupAudioAndroid.ps1 b/tools/checks/Test-BreathingSetupAudioAndroid.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..1cff2d5801bbb0f0c41db38fc0d78cda758ca66c
--- /dev/null
+++ b/tools/checks/Test-BreathingSetupAudioAndroid.ps1
@@ -0,0 +1,22 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$AndroidJar,
+    [Parameter(Mandatory)][string]$OutputRoot
+)
+$ErrorActionPreference = 'Stop'
+if (Test-Path -LiteralPath $OutputRoot) { throw 'Create-new output required' }
+$null = New-Item -ItemType Directory -Path $OutputRoot
+$repo = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
+$production = Join-Path $repo 'apps/native-renderer-android/panel-modules/condition-audio/src/main/java/io/github/mesmerprism/rustyquest/native_renderer'
+# Match the APK compiler's Android boot class path, rather than JDK --release
+# plus Android on the ordinary class path, which can hide lambda ABI failures.
+& javac -encoding UTF-8 -source 1.8 -target 1.8 -bootclasspath $AndroidJar -d $OutputRoot `
+    (Join-Path $production 'BreathingSetupAudio.java') `
+    (Join-Path $production 'BreathingSetupAudioContract.java')
+if ($LASTEXITCODE -ne 0) { throw 'Selected breathing audio Android compilation failed' }
+@{
+    passed = $true
+    scope = 'Production audio owner and contract against actual Android boot class path; no runtime/device claim'
+    android_jar_sha256 = (Get-FileHash -LiteralPath $AndroidJar).Hash.ToLowerInvariant()
+} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $OutputRoot 'RESULT.json') -Encoding utf8NoBOM
+Write-Output 'PASS selected breathing audio Android boot-class-path compilation'
diff --git a/tools/checks/Test-ExperimentPhonePairing.ps1 b/tools/checks/Test-ExperimentPhonePairing.ps1
