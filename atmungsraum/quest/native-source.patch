+    let waiting = setup.snapshot(time(705_600) + 4_000_000_000);
+    assert_eq!(waiting.experiment, ExperimentState::Waiting);
+    assert_eq!(waiting.experiment_start_frame, Some(1_411_200));
+    assert_eq!(waiting.experiment_completed_frames, 0);
+    // Adapter recovery supplies evidence before the following boundary; no
