+fn run_buffered_calibration(
+    sample_period_ns: u64,
+    missing_packet: Option<u64>,
+) -> (BreathingSetup, u64) {
+    let mut setup = fresh_setup();
+    setup.start_calibration(7, time(0)).unwrap();
+    let mut packet = 1_u64;
+    for tick in 1..=2_425_u64 {
+        let now = 1_000_000_000 + tick * 20_000_000;
+        setup.observe_clock(1, tick * 882, now, true);
+        // Original sample times are fixed; transport alternates 0/20 ms delay.
+        // A 200 Hz packet has forty samples spanning 195 ms before receipt.
+        let packet_end = 1_000_000_000 + packet * 200_000_000;
+        let receipt = packet_end + if packet % 2 == 0 { 20_000_000 } else { 0 };
+        if receipt <= now {
+            if missing_packet != Some(packet) {
+                let first = packet_end - 200_000_000 + sample_period_ns;
+                for acquired in (first..=packet_end).step_by(sample_period_ns as usize) {
+                    let source_frame = (acquired - 1_000_000_000) * 44_100 / 1_000_000_000;
+                    setup.observe_acc(
+                        7,
+                        100_000_000_000 + acquired,
+                        acquired,
+                        guided_vector(source_frame),
+                    );
+                }
+            }
+            packet += 1;
+        }
+        let state = setup.snapshot(now).calibration;
+        if matches!(
+            state,
+            CalibrationState::Succeeded | CalibrationState::Failed
+        ) {
+            return (setup, now);
+        }
+    }
+    (setup, 49_500_000_000)
+}
