+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Verifies and materializes a packaged mono PCM timeline for the native audio owner. */
+final class ScenarioAudioPackage {
+    interface AssetSource {
+        InputStream open(String path) throws IOException;
+    }
+
+    private static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_CATALOG_BYTES = 256 * 1024;
+    private static final int CATALOG_SCHEMA = 1;
+    private final AssetSource source;
+    private final Map<String, FileIdentity> files = new HashMap<>();
+    private final Map<String, JSONObject> scenarios = new HashMap<>();
+    private final Map<String, String> recordingPlans = new HashMap<>();
+    private final int sampleRate;
+    private final FileIdentity library;
+
+    private ScenarioAudioPackage(AssetSource source, JSONObject catalog)
+            throws IOException, JSONException {
+        this.source = source;
+        sampleRate = catalog.getInt("sample_rate");
+        if (catalog.getInt("schema_version") != CATALOG_SCHEMA || sampleRate < 8000 || sampleRate > 48000) {
+            throw new IOException("Invalid scenario audio catalog");
+        }
+        JSONArray inventory = catalog.getJSONArray("files");
+        if (inventory.length() < 1 || inventory.length() > 1024) {
+            throw new IOException("Invalid scenario audio file inventory");
+        }
+        for (int i = 0; i < inventory.length(); i++) {
+            JSONObject row = inventory.getJSONObject(i);
+            FileIdentity identity = new FileIdentity(row);
+            if (files.put(identity.path, identity) != null) {
+                throw new IOException("Duplicate scenario audio file: " + identity.path);
+            }
+        }
+        library = file(catalog.getString("library"));
+        JSONObject profile = json(verified(library));
+        if (profile.getInt("sample_rate") != sampleRate) {
+            throw new IOException("Scenario audio library sample rate differs");
+        }
+        JSONArray available = catalog.getJSONArray("scenarios");
+        if (available.length() < 1 || available.length() > 64) {
+            throw new IOException("Invalid scenario selection inventory");
+        }
+        for (int i = 0; i < available.length(); i++) {
+            JSONObject row = available.getJSONObject(i);
+            String id = row.getString("id");
+            if (!id.matches("[a-z0-9][a-z0-9-]{0,63}") ||
+                    !row.getString("path").equals("audio/scenarios/" + id + ".json") ||
+                    scenarios.put(id, row) != null) {
+                throw new IOException("Invalid scenario selection");
+            }
+        }
+    }
+
+    static ScenarioAudioPackage open(AssetSource source, String expectedCatalogHash)
+            throws IOException, JSONException {
+        if (expectedCatalogHash == null || !expectedCatalogHash.matches("[0-9a-f]{64}")) {
+            throw new IOException("A bound scenario catalog digest is required");
+        }
+        byte[] buffer = new byte[MAX_CATALOG_BYTES];
+        int size = 0;
+        try (InputStream stream = source.open("scenario-catalog.json")) {
+            while (size < buffer.length) {
+                int count = stream.read(buffer, size, buffer.length - size);
+                if (count < 0) break;
+                size += count;
+            }
+            if (stream.read() != -1) throw new IOException("Scenario audio catalog exceeds its limit");
+        }
+        byte[] bytes = java.util.Arrays.copyOf(buffer, size);
+        if (!expectedCatalogHash.equals(sha256(bytes))) {
+            throw new IOException("Scenario audio catalog digest differs");
+        }
+        return new ScenarioAudioPackage(source, json(bytes));
+    }
+
+    void verifyAll() throws IOException, JSONException {
+        for (String scenarioId : scenarios.keySet()) verifyTimeline(scenarioId, null);
+    }
+
+    List<String> ids() {
+        List<String> ids = new ArrayList<>(scenarios.keySet());
+        java.util.Collections.sort(ids);
+        return java.util.Collections.unmodifiableList(ids);
+    }
+
+    String recordingPlan(String scenarioId) {
+        return recordingPlans.get(scenarioId);
+    }
+
+    long writeWave(String scenarioId, OutputStream output) throws IOException, JSONException {
+        if (output == null) throw new IllegalArgumentException("WAV output is required");
+        return verifyTimeline(scenarioId, output);
+    }
+
+    private long verifyTimeline(String scenarioId, OutputStream output) throws IOException, JSONException {
+        JSONObject selected = scenarios.get(scenarioId);
+        if (selected == null) throw new IOException("Scenario is not packaged: " + scenarioId);
+        FileIdentity planFile = file(selected.getString("path"));
+        JSONObject plan = json(verified(planFile));
+        int frames = selected.getInt("total_frames");
+        String cuePrefix = "assets/audio/scenarios/" + scenarioId + "/";
+        if (plan.getInt("schema_version") != CATALOG_SCHEMA ||
+                !plan.getString("scenario_id").equals(scenarioId) ||
+                !plan.getString("library_manifest_sha256").equals(library.sha256) ||
+                !plan.getString("audio_assets_base_directory").equals("../../" + cuePrefix) ||
+                plan.getInt("sample_rate") != sampleRate ||
+                frames < 1 || frames > sampleRate * 1200 || plan.getInt("total_frames") != frames) {
+            throw new IOException("Scenario timing or library binding differs");
+        }
+
+        JSONArray events = plan.getJSONArray("events");
+        if (events.length() < 1 || events.length() > 1000) {
+            throw new IOException("Invalid scenario audio event count");
+        }
+        JSONObject registry = plan.getJSONObject("audio_assets");
+        Map<String, Cue> cues = new HashMap<>();
+        List<Segment> segments = new ArrayList<>();
+        int offset = 0;
+        long retainedBytes = 0;
+        for (int i = 0; i < events.length(); i++) {
+            JSONObject event = events.getJSONObject(i);
+            int duration = event.getInt("duration_frames");
+            if (event.getInt("offset_frames") != offset || duration < 1 || duration > frames - offset ||
+                    !event.has("asset")) {
+                throw new IOException("Scenario audio events must cover consecutive frames");
+            }
+            Cue cue = null;
+            if (!event.isNull("asset")) {
+                String id = event.getString("asset");
+                cue = cues.get(id);
+                if (cue == null) {
+                    JSONObject entry = registry.getJSONObject(id);
+                    String name = entry.getString("file");
+                    if (!name.matches("[0-9]{4}_[0-9]{2}m[0-9]{2}s_[a-z0-9-]+\\.wav") ||
+                            !entry.getString("id").equals(id) || entry.getInt("frames") != duration) {
+                        throw new IOException("Invalid scenario cue identity");
+                    }
+                    FileIdentity identity = file(cuePrefix + name);
+                    if (entry.getInt("bytes") != identity.bytes ||
+                            !entry.getString("sha256").equals(identity.sha256)) {
+                        throw new IOException("Scenario cue binding differs: " + identity.path);
+                    }
+                    retainedBytes += identity.bytes;
+                    if (retainedBytes > MAX_FILE_BYTES) {
+                        throw new IOException("Scenario cue set exceeds its memory bound");
+                    }
+                    cue = decodeCue(verified(identity), duration, entry.getBoolean("placeholder"));
+                    cues.put(id, cue);
+                }
+                if (cue.frames != duration) throw new IOException("Repeated cue length differs");
+            }
+            segments.add(new Segment(cue, duration));
+            offset += duration;
+        }
+        if (offset != frames || cues.size() != registry.length()) {
+            throw new IOException("Scenario cue inventory or total differs");
+        }
+
+        if (output == null) {
+            if (scenarioId.matches("probe-(anleitung|5|10|15)|haupt-15")) {
+                JSONArray phases = new JSONArray();
+                for (int i = 0; i < events.length(); i++) {
+                    JSONObject event = events.getJSONObject(i);
+                    phases.put(new JSONArray().put(event.getInt("offset_frames")).put(event.getString("id")));
+                }
+                recordingPlans.put(scenarioId, new JSONObject().put("scenario_id", scenarioId)
+                    .put("scenario_sha256", planFile.sha256).put("sample_rate", sampleRate)
+                    .put("total_frames", frames).put("phases", phases).toString());
+            }
+            return frames;
+        }
+        writeHeader(output, sampleRate, frames);
+        byte[] silence = new byte[16384];
+        for (Segment segment : segments) {
+            if (segment.cue != null) {
+                output.write(segment.cue.bytes, segment.cue.dataOffset, segment.frames * 2);
+            } else {
+                int remaining = segment.frames * 2;
+                while (remaining > 0) {
+                    int count = Math.min(remaining, silence.length);
+                    output.write(silence, 0, count);
+                    remaining -= count;
+                }
+            }
+        }
+        return frames;
+    }
+
+    private FileIdentity file(String path) throws IOException {
+        FileIdentity identity = files.get(path);
+        if (identity == null) throw new IOException("Scenario file is not in the catalog: " + path);
+        return identity;
+    }
+
+    private byte[] verified(FileIdentity identity) throws IOException {
+        byte[] data = new byte[identity.bytes];
+        try (InputStream stream = source.open(identity.path)) {
+            int offset = 0;
+            while (offset < data.length) {
+                int count = stream.read(data, offset, data.length - offset);
+                if (count < 0) throw new IOException("Scenario file is truncated: " + identity.path);
+                offset += count;
+            }
+            if (stream.read() != -1 || !identity.sha256.equals(sha256(data))) {
+                throw new IOException("Scenario file integrity differs: " + identity.path);
+            }
+        }
+        return data;
+    }
+
+    private Cue decodeCue(byte[] bytes, int frames, boolean placeholder) throws IOException {
+        ByteBuffer wave = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        if (bytes.length < 44 || !tag(bytes, 0, "RIFF") || !tag(bytes, 8, "WAVE") ||
+                wave.getInt(4) != bytes.length - 8) {
+            throw new IOException("Scenario cue is not a complete RIFF/WAVE file");
+        }
+        boolean format = false;
+        int dataOffset = -1;
+        int dataSize = 0;
+        int next = 12;
+        while (next + 8 <= bytes.length) {
+            int offset = next + 8;
+            int size = wave.getInt(next + 4);
+            if (size < 0 || size > bytes.length - offset || size + (size & 1) > bytes.length - offset) {
+                throw new IOException("Scenario WAV chunk is truncated");
+            }
+            if (tag(bytes, next, "fmt ")) {
+                if (format || size < 16 || wave.getShort(offset) != 1 ||
+                        wave.getShort(offset + 2) != 1 || wave.getInt(offset + 4) != sampleRate ||
+                        wave.getInt(offset + 8) != sampleRate * 2 ||
+                        wave.getShort(offset + 12) != 2 || wave.getShort(offset + 14) != 16) {
+                    throw new IOException("Scenario WAV must be mono signed 16-bit PCM");
+                }
+                format = true;
+            } else if (tag(bytes, next, "data")) {
+                if (dataOffset >= 0) throw new IOException("Scenario WAV contains multiple data chunks");
+                dataOffset = offset;
+                dataSize = size;
+            }
+            next = offset + size + (size & 1);
+        }
+        if (!format || dataOffset < 0 || dataSize != frames * 2 || next != bytes.length) {
+            throw new IOException("Scenario WAV duration differs from its slot");
+        }
+        if (placeholder) {
+            for (int i = dataOffset; i < dataOffset + dataSize; i++) {
+                if (bytes[i] != 0) throw new IOException("Scenario WAV placeholder contains sound");
+            }
+        }
+        return new Cue(bytes, dataOffset, frames);
+    }
+
+    private static boolean tag(byte[] bytes, int offset, String expected) {
+        for (int i = 0; i < 4; i++) {
+            if (bytes[offset + i] != expected.charAt(i)) return false;
+        }
+        return true;
+    }
+
+    private static void writeHeader(OutputStream output, int sampleRate, int frames) throws IOException {
+        int bytes = frames * 2;
+        ByteBuffer header = ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN);
+        header.put("RIFF".getBytes(StandardCharsets.US_ASCII)).putInt(36 + bytes);
+        header.put("WAVEfmt ".getBytes(StandardCharsets.US_ASCII)).putInt(16);
+        header.putShort((short) 1).putShort((short) 1).putInt(sampleRate).putInt(2 * sampleRate);
+        header.putShort((short) 2).putShort((short) 16);
+        header.put("data".getBytes(StandardCharsets.US_ASCII)).putInt(bytes);
+        output.write(header.array());
+    }
+
+    private static JSONObject json(byte[] bytes) throws JSONException {
+        return new JSONObject(new String(bytes, StandardCharsets.UTF_8));
+    }
+
+    private static String sha256(byte[] bytes) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(bytes);
+            StringBuilder result = new StringBuilder(64);
+            for (byte part : digest) {
+                result.append(Character.forDigit((part & 255) >>> 4, 16));
+                result.append(Character.forDigit(part & 15, 16));
+            }
+            return result.toString();
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+    private static final class FileIdentity {
+        final String path;
+        final int bytes;
+        final String sha256;
+
+        FileIdentity(JSONObject row) throws IOException, JSONException {
+            path = row.getString("path");
+            bytes = row.getInt("bytes");
+            sha256 = row.getString("sha256");
+            if (!path.matches("[a-z0-9_-]+(?:/[a-z0-9_-][a-z0-9_.-]*)+") ||
+                    bytes < 1 || bytes > MAX_FILE_BYTES || !sha256.matches("[a-f0-9]{64}")) {
+                throw new IOException("Invalid scenario audio file identity");
+            }
+        }
+    }
+
+    private static final class Cue {
+        final byte[] bytes;
+        final int dataOffset;
+        final int frames;
+
+        Cue(byte[] bytes, int dataOffset, int frames) {
+            this.bytes = bytes;
+            this.dataOffset = dataOffset;
+            this.frames = frames;
+        }
+    }
+
+    private static final class Segment {
+        final Cue cue;
+        final int frames;
+
+        Segment(Cue cue, int frames) {
+            this.cue = cue;
+            this.frames = frames;
+        }
+    }
+}
