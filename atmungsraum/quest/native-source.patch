+        if(awaitResume){awaitResume=false;if(attempts>=2)settled=true;}
+        drive(host);postDelivery(host);
+    }
+    public static void paused(Activity host){requireMain();if(owner.get()==host){resumed=false;if(locationPending)locationPaused=true;}}
+    public static void retired(Activity host){
+        requireMain();if(owner.get()!=host)return;finishPrompt(host);owner.clear();generation++;
+        resumed=false;pending=false;settled=false;awaitResume=false;deliveryPending=false;deliveryPosted=false;
+        locationPending=false;locationPaused=false;
+    }
+    /** Discovery may proceed with its own granted subset after the single attended request settles. */
+    public static boolean busy(Activity host){
+        requireMain();return !current(host)||owner.get()!=host||!resumed||pending||locationPending||!settled||deliveryPending||deliveryPosted;
+    }
+    private static List<String> missing(Activity host)throws Exception{
+        Set<String> declared=new HashSet<String>();
+        String[] permissions=host.getPackageManager().getPackageInfo(host.getPackageName(),PackageManager.GET_PERMISSIONS).requestedPermissions;
+        if(permissions!=null)declared.addAll(Arrays.asList(permissions));
+        List<String> missing=new ArrayList<String>();if(Build.VERSION.SDK_INT<23)return missing;
+        for(String permission:new String[]{"android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_ADVERTISE",
+                "android.permission.ACCESS_FINE_LOCATION","android.permission.ACCESS_COARSE_LOCATION","android.permission.NEARBY_WIFI_DEVICES"}){
+            if(permission.startsWith("android.permission.BLUETOOTH_")&&Build.VERSION.SDK_INT<31)continue;
+            if(permission.equals("android.permission.NEARBY_WIFI_DEVICES")&&Build.VERSION.SDK_INT<33)continue;
+            if(declared.contains(permission)&&host.checkSelfPermission(permission)!=PackageManager.PERMISSION_GRANTED)missing.add(permission);
+        }
+        return missing;
+    }
+    private static void drive(Activity host){
+        if(!resumed||pending||settled||awaitResume||owner.get()!=host||!current(host))return;
+        try{
+            List<String> missing=missing(host);
+            if(missing.isEmpty()){settled=true;deliveryPending=true;postDelivery(host);return;}
+            if(attempts>=2){settled=true;deliveryPending=true;postDelivery(host);return;}
+            attempts++;pending=true;promptOwned=true;NativeRendererSelfKioskApplication.beginSystemPrompt(host);
+            android.util.Log.i("RQStartupPermissions","event=runtime-request attempt="+attempts+" count="+missing.size()+" panelRequested=false");
+            host.requestPermissions(missing.toArray(new String[0]),REQUEST);
+        }catch(RuntimeException unavailable){
+            pending=false;settled=true;deliveryPending=true;finishPrompt(host);postDelivery(host);
+        }catch(Exception unavailable){settled=true;deliveryPending=true;postDelivery(host);}
+    }
+    public static boolean result(Activity host,int code,String[] permissions,int[] grants){
+        requireMain();if(code!=REQUEST||!selected(host))return false;
+        if(owner.get()!=host||!current(host)||!pending)return true;
+        pending=false;finishPrompt(host);
+        resultPermissions=permissions==null?new String[0]:permissions.clone();resultGrants=grants==null?new int[0]:grants.clone();
+        boolean cancelled=resultPermissions.length==0||resultGrants.length==0||resultPermissions.length!=resultGrants.length;
+        if(cancelled&&attempts<2){awaitResume=true;return true;}
+        // A denial is final for this actual owner. Only one cancellation can retry on a later resume.
+        settled=true;deliveryPending=true;postDelivery(host);return true;
+    }
+    public static boolean activityResult(Activity host,int code){
+        requireMain();if(code!=LOCATION_SETTINGS||!selected(host))return false;
+        if(owner.get()==host&&current(host)&&locationPending){finishLocation(host);postDelivery(host);}return true;
+    }
+    private static void finishLocation(Activity host){
+        locationPending=false;locationPaused=false;finishPrompt(host);deliveryPending=true;
+    }
+    private static boolean presentLocationPrerequisite(Activity host){
+        if(locationPending)return true;if(locationAsked)return false;
+        try{
+            String[] declared=host.getPackageManager().getPackageInfo(host.getPackageName(),PackageManager.GET_PERMISSIONS).requestedPermissions;
+            if(declared==null||!Arrays.asList(declared).contains("android.permission.BLUETOOTH_SCAN")||!missing(host).isEmpty()
+                    ||!"disabled".equals(PolarBleRuntimeSupport.locationServicesState(host)))return false;
+            // A normal attended OS surface, never a Settings write or app approval panel.
+            locationAsked=true;locationPending=true;promptOwned=true;NativeRendererSelfKioskApplication.beginSystemPrompt(host);
+            host.startActivityForResult(new Intent(android.provider.Settings.ACTION_LOCATION_SOURCE_SETTINGS),LOCATION_SETTINGS);
+            return true;
+        }catch(Exception unavailable){locationPending=false;locationAsked=true;finishPrompt(host);return false;}
+    }
+    private static void finishPrompt(Activity host){
+        if(!promptOwned)return;promptOwned=false;NativeRendererSelfKioskApplication.endSystemPrompt(host);
+    }
+    private static void postDelivery(final Activity host){
+        if(!resumed||!settled||!deliveryPending||deliveryPosted||owner.get()!=host)return;
+        final long captured=generation;deliveryPosted=true;
+        main.post(new Runnable(){public void run(){
+            if(captured!=generation||owner.get()!=host)return;deliveryPosted=false;
+            if(!resumed||!settled||!deliveryPending||!current(host))return;
+            if(presentLocationPrerequisite(host))return;
+            deliveryPending=false;
+            BreathCompositionPanelModule.onSelectedStartupPermissionsSettled(host,resultPermissions.clone(),resultGrants.clone());
+        }});
+    }
+}
