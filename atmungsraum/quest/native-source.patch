+fn sample_time(frame: u64) -> u64 {
+    1_000_000_000 + frame * 1_000_000_000 / 44100
+}
+fn vector(volume: f64) -> [f32; 3] {
+    let a = -0.08 + 0.16 * volume;
+    [(a.sin() * 1000.0) as f32, 0.0, (a.cos() * 1000.0) as f32]
+}
