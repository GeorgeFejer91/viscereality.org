+#[cfg(all(target_os = "android", not(feature = "showcase")))]
+fn operation(op: i32, attempt: u64, cycle: u64, revision: u64) -> bool {
+    let observation = if matches!(op, 1..=5) {
+        crate::experiment_session_runtime::maintenance_owner()
+    } else {
+        None
+    };
+    let mut gate = state().lock().unwrap_or_else(|e| e.into_inner());
+    match op {
+        0 => attempt == 0 && cycle == 0 && revision == 0 && gate.select(),
+        1 => observation.is_some_and(|owner| gate.begin(attempt, cycle, revision, owner)),
+        2 => {
+            gate.exact(attempt, cycle, revision)
+                && gate.matches(attempt)
+                && gate.owner == observation
+                && observation.is_some()
+        }
+        3 => observation.is_some_and(|owner| gate.valid(attempt, cycle, revision, owner)),
+        4 => {
+            gate.exact(attempt, cycle, revision)
+                && observation.is_some_and(|owner| gate.install(attempt, owner))
+        }
+        5 => {
+            observation.is_some()
+                && gate.owner == observation
+                && gate.grant(attempt, cycle, revision)
+        }
+        6 => gate.block(attempt, cycle, revision),
+        // A real externally observed install can only tighten admission. Retirement may have
+        // advanced revision, but cannot erase this same-attempt irreversible observation.
+        7 => {
+            cycle == gate.cycle
+                && revision > 0
+                && revision <= gate.revision
+                && gate.external_install(attempt)
+        }
+        _ => false,
+    }
+}
