+struct SignalReceipts {
+    latest: u64,
+}
+
+impl SignalReceipts {
+    fn new(start: u64) -> Self {
+        Self { latest: start }
+    }
+
+    fn deadline_before(&self, at: u64) -> Option<u64> {
+        let deadline = self.latest.saturating_add(crate::polar_input_health::TIMEOUT.as_nanos() as u64);
+        (at > deadline).then_some(deadline)
+    }
+
+    fn receive(&mut self, at: u64) -> Option<u64> {
+        let missed = self.deadline_before(at);
+        self.latest = self.latest.max(at);
+        missed
+    }
+}
+
+const SIGNAL_EVENTS: [(SessionEventKind, SessionEventKind); 2] = [
+    (SessionEventKind::EcgInterrupted, SessionEventKind::EcgResumed),
+    (SessionEventKind::AccInterrupted, SessionEventKind::AccResumed),
+];
+
+#[cfg(test)]
+mod signal_interruption_tests {
+    use super::*;
+
+    #[test]
+    fn reports_stream_deadline_and_first_receipt_after_the_gap() {
+        let mut watch = SignalReceipts::new(2_000_000_000);
+        assert_eq!(watch.receive(2_250_000_000), None);
+        assert_eq!(watch.receive(2_200_000_000), None);
+        assert_eq!(watch.receive(3_250_000_000), None);
+        assert_eq!(watch.receive(5_000_000_000), Some(4_250_000_000));
+        assert_eq!(watch.receive(5_100_000_000), None);
+        assert_eq!(watch.deadline_before(6_100_000_000), None);
+        assert_eq!(watch.deadline_before(7_000_000_000), Some(6_100_000_000));
+    }
+
+    #[test]
+    fn timestamps_older_than_official_start_cannot_move_the_deadline() {
+        let mut watch = SignalReceipts::new(20_000_000_000);
+        assert_eq!(watch.receive(18_000_000_000), None);
+        assert_eq!(watch.deadline_before(20_500_000_000), None);
+        assert_eq!(watch.receive(22_000_000_000), Some(21_000_000_000));
+    }
+}
