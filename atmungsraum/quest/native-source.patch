+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import javax.crypto.Cipher;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+final class ExperimentSessionWifiCredentials {
+    final String ssid;
+    final String passphrase;
+
+    private ExperimentSessionWifiCredentials(String ssid, String passphrase) {
+        this.ssid = ssid;
+        this.passphrase = passphrase;
+    }
+
+    static ExperimentSessionWifiCredentials decrypt(String key, String binding, byte[] challenge,
+            byte[] packet) throws Exception {
+        if (challenge.length != 16 || packet.length < 38 || packet.length > 124)
+            throw new SecurityException("wifi-setup-packet-length");
+        byte[] secret = ExperimentSessionGatewayProtocol.hmacBytes(key, "RQG1-WIFI-KEY|" + binding);
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(secret, "AES"),
+            new GCMParameterSpec(128, packet, 0, 12));
+        cipher.updateAAD(("RQG1-WIFI|" + binding + "|").getBytes(StandardCharsets.UTF_8));
+        cipher.updateAAD(challenge);
+        byte[] plaintext = cipher.doFinal(packet, 12, packet.length - 12);
+        try {
+            int ssidLength = Byte.toUnsignedInt(plaintext[0]);
+            int passphraseLength = plaintext.length - 1 - ssidLength;
+            if (ssidLength < 1 || ssidLength > 32 || passphraseLength < 8 || passphraseLength > 63)
+                throw new SecurityException("wifi-setup-credential-length");
+            String ssid = StandardCharsets.UTF_8.newDecoder()
+                .decode(ByteBuffer.wrap(plaintext, 1, ssidLength)).toString();
+            for (int i = 0; i < ssid.length(); i++) {
+                if (Character.isISOControl(ssid.charAt(i))) throw new SecurityException("wifi-setup-ssid");
+            }
+            for (int i = 1 + ssidLength; i < plaintext.length; i++) {
+                if (plaintext[i] < 0x20 || plaintext[i] > 0x7e)
+                    throw new SecurityException("wifi-setup-passphrase");
+            }
+            return new ExperimentSessionWifiCredentials(ssid,
+                new String(plaintext, 1 + ssidLength, passphraseLength, StandardCharsets.US_ASCII));
+        } finally {
+            Arrays.fill(plaintext, (byte) 0);
+        }
+    }
+}
