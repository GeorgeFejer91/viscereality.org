+/// Non-blocking publication from the actual renderer's selected slot-0 radius path.
+pub(crate) fn observe_renderer_radius(
+    lineage: Option<SetupRendererLineage>,
+    progress01: f32,
+    radius_m: f32,
+    frame: u64,
+    observed_ns: u64,
+    render_generation: u64,
+    settings_revision: u64,
+) {
+    let Some(lineage) = lineage else {
+        return;
+    };
+    let Ok(mut guard) = state().try_lock() else {
+        return;
+    };
+    let Some(r) = guard.as_mut() else {
+        return;
+    };
+    if lineage != r.renderer_lineage(observed_ns) || render_generation < r.renderer_generation_floor
+    {
+        return;
+    }
+    if r.renderer_radius.is_some_and(|last| {
+        last.render_generation == render_generation
+            && (settings_revision < last.settings_revision
+                || frame < last.frame
+                || observed_ns < last.observed_ns)
+    }) {
+        return;
+    }
+    r.renderer_generation_floor = render_generation;
+    r.renderer_radius = Some(RendererRadius {
+        lineage,
+        progress01,
+        radius_m,
+        frame,
+        observed_ns,
+        render_generation,
+        settings_revision,
+    });
