+            )
+        } else {
+            (300, json!([[0, "instruction"]]))
+        };
+        json!({ "participant_id": id, "scenario_id": scenario, "scenario_sha256": "a".repeat(64),
+            "sample_rate": 44100, "total_frames": seconds * 44100, "phases": phases })
+    }
+
+    #[test]
+    fn validates_participant_identity_and_the_authored_phase_offsets() {
+        let main = ParticipantPlan::parse(&request("Mül_35_F", "haupt-15")).unwrap();
+        assert_eq!(main.completion_threshold_ns(), 900_000_000_000);
+        assert_eq!(main.phase_at(26_000_000_000 - 1), "instruction_1");
+        assert_eq!(main.phase_at(26_000_000_000), "calibration");
+        assert_eq!(main.phase_at(41_000_000_000), "instruction_2");
+        for bad in [
+            "A/ä_35_M",
+            "Mu\u{308}l_35_F",
+            "A\u{0345}l_35_F",
+            "Abc_035_F",
+            "Abc_-1_M",
+            "Abc_35_X",
+            "Abc_9007199254740992_N",
+            "Abc_35_F_x",
+        ] {
+            assert!(
+                ParticipantPlan::parse(&request(bad, "haupt-15")).is_err(),
+                "{bad}"
+            );
+        }
+        assert!(ParticipantPlan::parse(&request("𐐀𐐨𐐨_0_N", "haupt-15")).is_ok());
+        let mut missing = request("Mül_35_F", "haupt-15");
+        missing.as_object_mut().unwrap().remove("scenario_id");
+        missing["unexpected"] = json!(1);
+        assert!(ParticipantPlan::parse(&missing).is_err());
+    }
+
+    #[test]
+    fn reserves_parallel_attempts_durably_per_participant_and_condition() {
+        let scratch = Scratch::new();
+        let plan = ParticipantPlan::parse(&request("Tes_30_N", "haupt-15")).unwrap();
+        let root = &scratch.0;
+        let runs = std::thread::scope(|threads| {
+            let handles: Vec<_> = (0..8)
+                .map(|_| {
+                    let plan = plan.clone();
+                    threads.spawn(move || ParticipantRun::reserve(root, plan).unwrap())
+                })
+                .collect();
+            handles
+                .into_iter()
+                .map(|handle| handle.join().unwrap())
+                .collect::<Vec<_>>()
+        });
+        let mut indices: Vec<_> = runs.iter().map(|run| run.index).collect();
+        indices.sort_unstable();
+        assert_eq!(indices, (1..=8).collect::<Vec<_>>());
+        let unique: std::collections::HashSet<_> = runs.iter().map(|run| &run.uuid).collect();
+        assert_eq!(unique.len(), 8);
+        assert_eq!(runs[0].uuid.as_bytes()[14], b'4');
+        assert_eq!(ParticipantRun::reserve(root, plan).unwrap().index, 9);
+        let probe = ParticipantPlan::parse(&request("Tes_30_N", "probe-5")).unwrap();
+        assert_eq!(ParticipantRun::reserve(root, probe).unwrap().index, 1);
+        let other = ParticipantPlan::parse(&request("Mül_35_F", "haupt-15")).unwrap();
+        assert_eq!(ParticipantRun::reserve(root, other).unwrap().index, 1);
+        assert!(
+            !fs::read_dir(root).unwrap().any(|entry| entry
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .contains("Tes"))
+        );
+    }
+
+    #[test]
+    fn projects_native_ecg_pause_phase_and_signal_gaps_to_the_original_csv() {
