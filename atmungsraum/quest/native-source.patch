+        let anchor = ClockAnchor::new(MonotonicNanos::new(start), epoch);
+        let event = |at, kind| json!({"event":kind,"observed_monotonic_ns":at}).to_string();
+        fs::write(
+            directory.join("events.jsonl"),
+            [
+                event(start, "official-start"),
+                event(start + 10_000_000, "audio-started"),
+                event(start + 26_010_000_000, "experiment-paused"),
+                event(start + 30_010_000_000, "experiment-resumed"),
+            ]
+            .join("\n"),
+        )
+        .unwrap();
+        let sample = |at, index, value| {
+            json!({"kind":"polar-ecg","observed_monotonic_ns":at,
+            "source_sequence":index,"microvolts":value})
+            .to_string()
+        };
+        fs::write(
+            directory.join("polar-ecg.jsonl"),
+            [
+                sample(start - 1, 499, 0),
+                sample(start, 500, -12),
+                sample(start + 27_000_000_000, 501, 230),
+                sample(start + 45_010_000_000, 502, -31),
+            ]
+            .join("\n"),
+        )
+        .unwrap();
+        let end = MonotonicNanos::new(start + 45_010_000_000);
+        let descriptor = run
+            .finalize_csv(directory, anchor, end, false, "save-and-exit")
+            .unwrap()
+            .unwrap();
+        assert_eq!(descriptor["name"], "Tes_30_N_main1.csv");
+        assert_eq!(descriptor["session_id"], run.uuid);
+        let csv = fs::read_to_string(directory.join("Tes_30_N_main1.csv")).unwrap();
+        assert_eq!(descriptor["size"], csv.len());
+        assert_eq!(
+            descriptor["sha256"],
+            format!("{:x}", Sha256::digest(csv.as_bytes()))
+        );
+        assert!(csv.starts_with(HEADER));
+        let rows: Vec<Vec<&str>> = csv
+            .split_terminator("\r\n")
+            .skip(1)
+            .map(|row| row.split(',').collect())
+            .collect();
+        assert_eq!(rows.len(), 5);
+        assert!(
+            rows.iter()
+                .all(|row| row.len() == 28 && row[26..] == ["aborted", "save-and-exit"])
