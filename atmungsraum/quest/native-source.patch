+    with zipfile.ZipFile(apk) as archive, tempfile.TemporaryDirectory(prefix='rq-threshold-dex-') as temp:
+        dumps = []
+        for name in archive.namelist():
+            if re.fullmatch(r'classes\d*\.dex', name):
+                path = Path(temp) / name
+                path.write_bytes(archive.read(name))
+                dumps.append(subprocess.run([str(dexdump), '-d', str(path)], check=True,
+                                            stdout=subprocess.PIPE).stdout.decode('utf-8', 'replace').replace('\r', ''))
+        classes = {}
+        for dump in dumps:
+            for block in re.split(r'(?m)^Class #\d+', dump)[1:]:
+                descriptor = re.search(r"Class descriptor\s*:\s*'([^']+)'", block)
+                if descriptor:
+                    classes[descriptor[1]] = block
