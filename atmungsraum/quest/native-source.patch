+package io.github.mesmerprism.rustyquest.native_renderer;
+
+import org.json.JSONObject;
+
+public final class ExperimentTrustedPhonesTest {
+    static int checks;
+    interface Checked { void run() throws Exception; }
+    static void check(boolean value,String why) { checks++;if(!value)throw new AssertionError(why); }
+    static void deny(Checked action) throws Exception { checks++;try{action.run();}catch(Exception expected){return;}throw new AssertionError("unexpected admission"); }
+    static final class Store implements ExperimentTrustedPhones.Store {
+        String data="";boolean fail;
+        public String load(){return data;}
+        public boolean save(String next){if(fail)return false;data=next;return true;}
+    }
+    static JSONObject operation(String id,String op,long revision)throws Exception {
+        return new JSONObject().put("v",1).put("id",id).put("op",op).put("expected_control_revision",revision);
+    }
+    public static void main(String[] args)throws Exception {
+        Store store=new Store();ExperimentTrustedPhones phones=new ExperimentTrustedPhones(store);
+        JSONObject first=phones.add("First phone"),second=phones.add("Second phone");
+        String a=first.getString("controller"),b=second.getString("controller"),key=first.getString("key");
+        check(!a.equals(b)&&!key.equals(second.getString("key")),"independent membership");
+        ExperimentTrustedPhones loaded=new ExperimentTrustedPhones(store);
+        check(loaded.member(a).key.equals(key)&&loaded.size()==2,"persistent independent keys");
+        check(!loaded.list(1000).toString().contains(key),"public member list excludes keys");
+        check(phones.status(a,1000).getString("role").equals("waiting"),"initially unowned");
+        JSONObject claim=operation("1111111111111111","claim",0);
+        JSONObject receipt=phones.control(a,claim,1000);
+        check(receipt.getString("role").equals("active")&&phones.revision()==1,"first member claims");
+        check(phones.control(a,claim,1001).toString().equals(receipt.toString()),"idempotent claim");
+        deny(()->phones.control(b,operation("2222222222222222","claim",1),1002));
+        deny(()->phones.control(b,operation("3333333333333333","release",1),1002));
+        deny(()->phones.control(a,operation("4444444444444444","release",0),1002));
+        phones.status(b,14000);phones.status(a,15000);
+        check(phones.status(b,20000).getString("role").equals("waiting"),"waiting phone does not steal; owner status renews");
+        phones.requireActive(a,1,29999);
+        deny(()->phones.requireActive(a,1,30000));
+        check(phones.revision()==2,"expiry advances revision");
+        phones.control(b,operation("5555555555555555","claim",2),30000);
+        check(phones.status(b,30001).getString("role").equals("active"),"expired lease reclaimed");
+        deny(()->phones.requireActive(a,1,30002));
+        phones.control(b,operation("6666666666666666","release",3),30003);
+        check(phones.revision()==4&&phones.status(a,30004).getString("active_phone").isEmpty(),"self release");
+        deny(()->phones.control(a,new JSONObject(claim.toString()).put("op","release"),30004));
+        deny(()->phones.control(a,operation("7777777777777777","claim",4).put("extra",true),30004));
+        store.fail=true;deny(()->phones.add("Failed save"));deny(()->phones.remove(a));
+        check(phones.size()==2&&phones.member(a).key.equals(key),"failed persistence leaves live registry unchanged");
+        store.fail=false;check(phones.remove(a)&&phones.member(a)==null&&phones.member(b)!=null,"independent revocation");
+        check(new ExperimentTrustedPhones(store).member(a)==null,"revocation persisted");
+        for(int i=phones.size();i<8;i++)phones.add("Phone "+i);
+        deny(()->phones.add("Ninth phone"));check(phones.size()==8,"capacity is closed");
+        Store migration=new Store();ExperimentTrustedPhones migrated=new ExperimentTrustedPhones(migration);
+        migrated.migrateLegacy(a,key);migrated.migrateLegacy(a,key);
+        check(migrated.size()==1&&new ExperimentTrustedPhones(migration).member(a).key.equals(key),"valid legacy migration once");
+        migrated.add("new");check(migrated.member(a).key.equals(key),"addition never rotates legacy key");
+        Store failed=new Store();failed.fail=true;ExperimentTrustedPhones failure=new ExperimentTrustedPhones(failed);
+        deny(()->failure.migrateLegacy(a,key));check(failure.size()==0,"migration failure remains closed");
+        Store corrupt=new Store();corrupt.data="{\"v\":1,\"members\":[{}]}";deny(()->new ExperimentTrustedPhones(corrupt));
+        ExperimentTrustedPhones named=new ExperimentTrustedPhones(new Store());JSONObject duplicate1=named.add("Smartphone"),duplicate2=named.add("Smartphone");
+        check(named.member(duplicate1.getString("controller")).name.equals("Smartphone")&&named.member(duplicate2.getString("controller")).name.equals("Smartphone (2)"),"duplicate generic names remain distinguishable");
+        String longName=new String(new char[64]).replace('\0','x');named.add(longName);JSONObject duplicateLong=named.add(longName);
+        check(named.member(duplicateLong.getString("controller")).name.length()==64,"disambiguation preserves label bound");
+        Thread foreign=new Thread(()->{try{phones.member(b);throw new AssertionError("foreign thread admitted");}catch(IllegalStateException expected){}});foreign.start();foreign.join();
+        System.out.println("PASS "+checks+" trusted-phone persistence, independent keys, migration, capacity, revocation and single-controller lease checks");
+    }
