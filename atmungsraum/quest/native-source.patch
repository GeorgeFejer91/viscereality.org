+pub(crate) fn command_json(text: &str, now: u64) -> Value {
+    if text.len() > 2048 {
+        return receipt(&Value::Null, false, "command-invalid");
+    }
+    let value: Value = match serde_json::from_str::<Value>(text)
+        .ok()
+        .filter(|_| text.len() <= 2048)
+    {
+        Some(v) => v,
+        None => return receipt(&Value::Null, false, "command-invalid"),
+    };
+    if !selected() {
+        return receipt(&value, false, "not-selected");
+    }
+    let _gate = command_gate().lock().unwrap_or_else(|e| e.into_inner());
+    if value["op"] == "park-after-terminal" {
+        if closed(&value, &["v", "id", "g", "r", "op", "cycle"]).is_err()
+            || value["v"] != 1
+            || value["id"].as_str().is_none_or(|id| !is_command_id(id))
+        {
+            return receipt(&value, false, "command-invalid");
+        }
+        let cycle = crate::meta_update_admission::pending_park_cycle();
+        if cycle.is_none() || value["cycle"].as_str() != cycle.map(|c| c.to_string()).as_deref() {
+            return receipt(&value, false, "terminal-park-unavailable");
+        }
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return receipt(&value, false, "not-configured");
+        };
+        if value["g"] != r.generation || value["r"] != r.revision {
+            return receipt(&value, false, "stale-revision");
+        }
+        if let Err(reason) = r.park_after_terminal(now) {
+            return receipt(&value, false, reason);
+        }
+        if !crate::meta_update_admission::acknowledge_park(cycle.unwrap()) {
+            return receipt(&value, false, "terminal-park-retired");
+        }
+        return receipt(&value, true, "terminal-parked");
+    }
+    let binding = crate::polar_input_health::source_binding();
+    {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return receipt(&value, false, "not-configured");
+        };
+        r.bind_source(binding);
+        if value["op"] == "receipt" {
+            return r.command(&value, now);
+        }
+        match r.check_command(&value, now) {
+            Ok(Some(result)) => return result,
+            Err(reason) => return receipt(&value, false, reason),
+            Ok(None) => {}
+        }
+    }
+    // Terminal cleanup is permitted while the next cycle is waiting for its park acknowledgment.
+    let preparation_reservation = if value["op"] == "end-main" {
+        None
+    } else {
+        match crate::meta_update_admission::reserve_session() {
+            Some(reservation) => Some(reservation),
+            None => return receipt(&value, false, "startup-update-maintenance"),
+        }
+    };
+    // Composition callbacks run without the setup mutex. The closed command gate
+    // serializes mutations; raw acquisition and audio observations remain live.
+    let controller_generation = if value["op"] == "controller" {
+        match crate::breath_composition_runtime::select_setup_controller() {
+            Ok(g) => Some(g),
+            Err(reason) => return receipt(&value, false, reason),
+        }
+    } else {
+        None
+    };
+    let binding = crate::polar_input_health::source_binding();
+    let (result, required) = {
+        let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+        let Some(r) = guard.as_mut() else {
+            return receipt(&value, false, "not-configured");
+        };
+        r.bind_source(binding);
+        if r.generation != value["g"].as_u64().unwrap_or(0) {
+            return receipt(&value, false, "stale-generation");
+        }
+        if let Some(g) = controller_generation {
+            r.controller_generation = Some(g);
+        }
+        if preparation_reservation
+            .as_ref()
+            .is_some_and(|r| !crate::meta_update_admission::valid_session_cycle(r.cycle))
+        {
+            return receipt(&value, false, "startup-update-maintenance");
+        }
+        let result = r.apply_command(&value, now);
+        if result["accepted"] == true {
+            if let Some(reservation) = preparation_reservation.as_ref() {
+                crate::meta_update_admission::admit_session_cycle(reservation.cycle);
+            }
+        }
+        (result, r.core.snapshot(now).input.is_polar())
+    };
+    crate::polar_input_health::set_setup_required(Some(required));
+    result
+}
+
+/// The writer has actually finalized successfully. Serialize invalidation with setup effects;
+/// a pending or active calibration can only be retired here after that terminal outcome.
+pub(crate) fn retire_after_terminal() {
+    let _gate = command_gate().lock().unwrap_or_else(|e| e.into_inner());
+    crate::meta_update_admission::terminal_success();
+    let Some(cycle) = crate::meta_update_admission::pending_park_cycle() else {
+        return;
+    };
+    // Feature-off products have no breathing transport to park. The actual successful
+    // writer outcome is already established; idle native owner checks still apply.
+    if !selected() {
+        crate::meta_update_admission::acknowledge_park(cycle);
+        return;
+    }
+    let mut guard = state().lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(r) = guard.as_mut() {
+        r.core.reset_preparation();
+        r.started = false;
+        r.last_admitted_frame = None;
+        r.recovery = None;
+        r.controller_generation = None;
+        r.controller_seen_ns = None;
+        r.controller_volume01 = None;
+        r.controller_lost = false;
+        r.controller_lost_frames = None;
+        r.controller_resume_deadline_ns = None;
+        r.classified_model = None;
+        r.classified_at = None;
+        r.phase = CommonBreathPhase::Unknown;
+        r.retire_driver_phase();
+        r.revision = r.revision.saturating_add(1);
+    }
+}
+pub(crate) fn maintenance_parked() -> bool {
+    if !selected() {
+        return true;
+    }
+    let Ok(guard) = state().try_lock() else {
+        return false;
+    };
+    let Some(r) = guard.as_ref() else {
+        return false;
+    };
+    let s = r.core.snapshot(r.now_ns());
+    !r.started
+        && r.recovery.is_none()
+        && r.last_admitted_frame.is_none()
+        && s.parked
+        && !s.playing
+        && s.calibration == CalibrationState::Idle
+        && s.experiment == ExperimentState::Preparation
+}
