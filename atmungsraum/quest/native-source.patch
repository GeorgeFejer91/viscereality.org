+fn polar_diagnosis_runtime(input: SetupInput, phase: CommonBreathPhase) -> (Runtime, u64, u64) {
+    polar_diagnosis_runtime_with_binding(input, phase, (5, 1))
+}
+fn polar_diagnosis_runtime_with_binding(
+    input: SetupInput,
+    phase: CommonBreathPhase,
+    binding: (u64, u64),
+) -> (Runtime, u64, u64) {
+    if input == SetupInput::PolarTilt {
+        let (mut r, base_frame, base_ns) = calibrated_inhale_runtime_with_binding(binding);
+        if phase == CommonBreathPhase::Inhale {
+            return (r, base_frame, base_ns);
+        }
+        for tick in 1..=40 {
+            let frame = base_frame + tick * 1764;
+            let now = base_ns + tick * 40_000_000;
+            let v = if phase == CommonBreathPhase::Hold {
+                0.2
+            } else {
+                0.2 - tick as f64 / 200.0
+            };
+            r.observe_clock(7, frame, now, true);
+            r.observe_host_aligned_acc(100_000_000_000 + now, now, vector(v));
+            if r.phase == phase {
+                return (r, frame, now);
+            }
+        }
+    } else {
+        let mut r = runtime();
+        let start = sample_time(0);
+        r.observe_clock(7, 0, start, false);
+        r.bind_source(binding);
+        r.projection_ready = true;
+        let op = if input == SetupInput::PolarTiltFixed {
+            "polar-fixed"
+        } else {
+            "polar-adaptive"
+        };
+        assert_eq!(command(&mut r, 1, op, start)["accepted"], true);
+        r.observe_clock(7, 0, start, true);
+        for tick in 1..=500 {
+            let now = start + tick * 40_000_000;
+            let frame = tick * 1764;
+            let breath = (tick as f64 * std::f64::consts::PI / 50.0).sin();
+            let mg = if phase == CommonBreathPhase::Hold {
+                [0.0, 0.0, 1000.0]
+            } else {
+                [
+                    (-630.0 + 30.0 * breath) as f32,
+                    (80.0 + 10.0 * breath) as f32,
+                    (720.0 + 30.0 * breath) as f32,
+                ]
+            };
+            r.observe_clock(7, frame, now, true);
+            r.observe_source_pair(now, now);
+            r.observe_host_aligned_acc(100_000_000_000 + now, now, mg);
+            if tick > 10 && r.phase == phase && r.ready(r.core.snapshot(now), now) {
+                return (r, frame, now);
+            }
+        }
+    }
+    panic!("real classifier failed to diagnose {input:?} {phase:?}");
+}
