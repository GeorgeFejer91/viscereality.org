+}
+[ordered]@{
+    passed=$true
+    scope='Actual locked non-resolve builder preflight only; intentional existing downstream rejection, no APK/device proof'
+    feature_lock_sha256=(Get-FileHash -LiteralPath $AppBuildLock).Hash.ToLowerInvariant()
+    builder_sha256=(Get-FileHash -LiteralPath $builder).Hash.ToLowerInvariant()
+    panel_selection_sha256=(Get-FileHash -LiteralPath (Join-Path $RepoRoot 'tools/lib/NativeRendererPanelCompositionSelection.psm1')).Hash.ToLowerInvariant()
+    expected_stop='Operator inputs require explicit debug opt-in.'
+    compilation_invoked=$false
+    signing_invoked=$false
+}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $OutputRoot 'RESULT.json') -Encoding utf8NoBOM
+Write-Output "PASS actual locked non-resolve original/controller-only preflight ($OutputRoot)."
