+fn validate_setup_tracking_configuration(value: &Value) -> Result<(), &'static str> {
+    let object = value
+        .as_object()
+        .ok_or("tracking-configuration-object-invalid")?;
+    require_fields(
+        object,
+        &[
+            "schema",
+            "input",
+            "source",
+            "mapping",
+            "controller_projection",
+            "phase_classifier",
+            "sampled_clock",
+            "core_alignment_clock",
+            "raw_sampled_clock",
+            "source_clock_pair",
+            "audio_generation",
+            "controller_generation",
+            "calibration_generation",
+            "model",
+            "loop_sha256",
+            "experiment_generation",
+            "arm_operation_id",
+            "prepared_monotonic_ns",
+            "prepared_monotonic_clock",
+            "acknowledgement",
+            "tracking_claim",
+        ],
+    )?;
+    if value["mapping"] != "state"
+        || value["controller_projection"] != "fixed-orientation"
+        || value["acknowledgement"] != "setup-input-retained"
+        || value["tracking_claim"] != "fresh-input-observed"
+        || value["prepared_monotonic_clock"] != "android-elapsed-realtime"
+        || value["core_alignment_clock"] != "android-elapsed-realtime"
+        || value["prepared_monotonic_ns"].as_u64().is_none()
+        || value["audio_generation"].as_u64().is_none_or(|g| g == 0)
+        || value["experiment_generation"]
+            .as_u64()
+            .is_none_or(|g| g == 0)
+        || value["arm_operation_id"]
+            .as_str()
+            .is_none_or(|s| s.is_empty() || s.len() > 256)
+        || value["loop_sha256"]
+            .as_str()
+            .is_none_or(|s| !is_lower_hex(s, 64) || s.bytes().all(|b| b == b'0'))
+    {
+        return Err("setup-tracking-contract-invalid");
+    }
+    match value["input"].as_str() {
+        Some("controller-state")
+            if value["source"] == "controller"
+                && value["phase_classifier"] == "controller-state"
+                && value["sampled_clock"] == "openxr-time"
+                && value["raw_sampled_clock"] == "openxr-time"
+                && value["source_clock_pair"].is_null()
+                && value["controller_generation"]
+                    .as_u64()
+                    .is_some_and(|g| g > 0)
+                && value["model"].is_null() => {}
+        Some("polar-tilt")
+            if value["source"] == "polar-acc"
+                && value["phase_classifier"] == "common-normalized-tilt"
+                && value["sampled_clock"] == "java-nano-time"
+                && value["raw_sampled_clock"] == "java-nano-time"
+                && value["controller_generation"].is_null() =>
+        {
+            let pair = value["source_clock_pair"]
+                .as_object()
+                .ok_or("setup-source-clock-pair-invalid")?;
+            require_fields(
+                pair,
+                &[
+                    "java_nano_ns",
+                    "android_elapsed_ns",
+                    "maximum_age_ms",
+                    "maximum_sample_distance_ms",
+                ],
+            )?;
+            if value["source_clock_pair"]["java_nano_ns"]
+                .as_u64()
+                .is_none_or(|v| v == 0)
+                || value["source_clock_pair"]["android_elapsed_ns"]
+                    .as_u64()
+                    .is_none_or(|v| v == 0)
+                || value["source_clock_pair"]["maximum_age_ms"] != 250
+                || value["source_clock_pair"]["maximum_sample_distance_ms"] != 250
+            {
+                return Err("setup-source-clock-pair-invalid");
+            }
+            let model = value["model"].as_object().ok_or("setup-model-invalid")?;
+            require_fields(model, &["owner", "generation", "axis", "low", "high"])?;
+            let axis = value["model"]["axis"]
+                .as_array()
+                .filter(|a| a.len() == 3)
+                .ok_or("setup-axis-invalid")?;
+            let norm = axis
+                .iter()
+                .map(|v| v.as_f64().filter(|v| v.is_finite()).map(|v| v * v))
+                .collect::<Option<Vec<_>>>()
+                .ok_or("setup-axis-invalid")?
+                .iter()
+                .sum::<f64>();
+            let low = value["model"]["low"]
+                .as_f64()
+                .filter(|v| v.is_finite())
+                .ok_or("setup-range-invalid")?;
+            let high = value["model"]["high"]
+                .as_f64()
+                .filter(|v| v.is_finite())
+                .ok_or("setup-range-invalid")?;
+            if !(0.999..=1.001).contains(&norm)
+                || high <= low
+                || value["model"]["owner"].as_u64().is_none_or(|v| v == 0)
+                || value["model"]["generation"].as_u64().is_none_or(|v| v == 0)
+                || value["calibration_generation"] != value["model"]["generation"]
+            {
+                return Err("setup-model-invalid");
+            }
+        }
+        _ => return Err("setup-input-invalid"),
+    }
+    Ok(())
+}
