+const HEADER: &str = "schema_version,participant_id,name_prefix,age_years,gender_code,condition,run_index,session_id,scenario_id,scenario_sha256,planned_duration_seconds,session_started_utc,sample_index,elapsed_ms,timestamp_utc,audio_elapsed_ms,playback_state,phase,ecg_value,ecg_unit,signal_source,signal_state,signal_sha256,sample_rate_hz,source_sample_index,source_loop,session_status,end_reason\r\n";
