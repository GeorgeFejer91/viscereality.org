native-source.patch text eol=lf
webrtc-native.patch text eol=lf -whitespace
# The resolver validates the exact bytes of the provider manifest and assets.
build-assets/provider/** -text
build-assets/provider/**/*.json whitespace=cr-at-eol
build-assets/particles/*.glsl text eol=lf
build-assets/particles/*.bin -text
build-assets/arm64-v8a/*.so -text
apks/*.apk -text
