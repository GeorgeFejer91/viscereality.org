+#[test]
+fn older_v4_recovery_keeps_its_original_breath_projection() {
+    use crate::session_recording_participant::live_csv::CONTROLLER_BREATH_FIELD;
+    use crate::session_recording_writer::{SessionRecordingWriter, tests::{config, interrupted_participant_fixture, temp_root}};
+    use std::time::Duration;
+
+    let root = temp_root("participant-checkpoint-older-v4");
+    let (directory, _) = interrupted_participant_fixture(root.clone(), true);
+    let manifest_path = directory.join("manifest.json");
+    let mut manifest: Value = serde_json::from_slice(&fs::read(&manifest_path).unwrap()).unwrap();
+    assert_eq!(manifest["participant_csv_schema"], 4);
+    assert!(manifest.as_object_mut().unwrap().remove(CONTROLLER_BREATH_FIELD).is_some());
+    fs::write(&manifest_path, manifest.to_string()).unwrap();
+    let breath_path = directory.join("breath.jsonl");
+    let original_breath = fs::read(&breath_path).unwrap();
+    assert!(String::from_utf8_lossy(&original_breath).contains("\"assessment_source\":\"controller\""));
+
+    let writer = SessionRecordingWriter::spawn(config(root.clone(), 16, 100)).unwrap();
+    assert!(writer.recover().unwrap().receive().unwrap().sessions[0].error.is_none());
+    writer.shutdown(Duration::from_secs(1)).unwrap();
+    let csv = fs::read_to_string(directory.join(".recovered-Mül_35_F_2023-11-14_haupt-15_r1.csv")).unwrap();
+    assert!(!csv.contains(",breath,"));
+    assert_eq!(fs::read(&breath_path).unwrap(), original_breath);
+    fs::remove_dir_all(root.parent().unwrap()).unwrap();
+}
