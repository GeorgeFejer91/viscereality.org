+        denied(() -> member.commissionWebRtc(copy(frame).put("unexpected", 1), room, 7));
+        denied(() -> member.commissionWebRtc(copy(frame).put("public_key", "abc"), room, 7));
+        JSONObject reply = member.commissionWebRtc(frame, room, 7);
