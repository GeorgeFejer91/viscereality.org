+/** Hosts only bundled signaling and ciphertext transport. The native gateway owns all requests. */
+final class ExperimentSessionWebRtc implements ExperimentSessionCommandGateway.WebRtcRelay {
+    private static final String HOST = "appassets.androidplatform.net";
+    private static final String ASSETS = "atmungsraum-webrtc/";
+    private static final String PAGE = "https://" + HOST + "/" + ASSETS + "index.html";
+    private static final String BRIDGE = "QuestRtcNative";
+    private static final long IDLE_LIFETIME_MS = 90_000;
+    private static final Set<String> FILES = new HashSet<>(Arrays.asList(
+        "index.html", "target.js", "vdoninja-sdk.min.js", "vdo-ninja-transport.js", "brsp.js", "quest-webrtc-channel.js"));
+
+    private final Context context;
+    private final ExperimentSessionCommandGateway gateway;
+    private volatile Session session;
+
+    static void attach(Context context, ExperimentSessionCommandGateway gateway) {
+        if (gateway.hasWebRtcRelay()) return;
+        try {
+            for (String file : FILES) {
+                try (java.io.InputStream asset = context.getAssets().open(ASSETS + file)) {
+                    if (asset.read() == -1) return;
+                }
+            }
+            gateway.bindWebRtcRelay(new ExperimentSessionWebRtc(context, gateway));
+        } catch (IOException absent) {
+            // Packages without the selected WebRTC assets retain their existing routes.
+        }
+    }
+
+    private ExperimentSessionWebRtc(Context context, ExperimentSessionCommandGateway gateway) {
+        this.context = context;
+        this.gateway = gateway;
+    }
+
+    @Override public JSONObject offer() throws Exception {
+        if (session == null || !session.live()) {
+            close();
+            Session next = new Session();
+            session = next;
+            next.view.loadUrl(PAGE);
+        }
+        Session active = session;
+        return new JSONObject().put("r", active.room).put("p", active.password);
+    }
+
+    @Override public boolean accepts(String room) {
+        Session active = session;
+        return active != null && active.room.equals(room) && active.live();
+    }
+
+    @Override public void close() {
+        Session old = session;
+        session = null;
+        if (old != null) old.destroy();
+    }
+
+    private final class Session {
+        final String room = ExperimentSessionBleProtocol.newHex(16);
+        final String password = ExperimentSessionBleProtocol.newHex(32);
+        final WebView view;
+        volatile long lastAuthenticated = SystemClock.elapsedRealtime();
+
+        @SuppressLint("SetJavaScriptEnabled")
+        Session() {
+            view = new WebView(context);
+            view.getSettings().setJavaScriptEnabled(true);
+            view.getSettings().setAllowFileAccess(false);
+            view.getSettings().setAllowContentAccess(false);
+            view.getSettings().setDomStorageEnabled(false);
+            view.getSettings().setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+            view.setWebViewClient(new WebViewClient() {
+                @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                    return true;
+                }
+                @Override public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+                    return intercept(request.getUrl(), request.getMethod());
+                }
+                @Override public boolean onRenderProcessGone(WebView view, RenderProcessGoneDetail detail) {
+                    if (session == Session.this) close();
+                    return true;
+                }
+            });
+            view.addJavascriptInterface(new Bridge(), BRIDGE);
+        }
+
+        boolean live() {
+            return SystemClock.elapsedRealtime() - lastAuthenticated < IDLE_LIFETIME_MS;
+        }
+
+        void destroy() {
+            view.removeJavascriptInterface(BRIDGE);
+            view.stopLoading();
+            view.destroy();
+        }
+
+        private final class Bridge {
+            @JavascriptInterface public String configuration() {
+                if (session != Session.this || !live()) return "";
+                return room + ":" + password;
+            }
+
+            @JavascriptInterface public String exchange(String payload) {
+                if (session != Session.this || !live() || payload == null || payload.length() > 12_000) return "";
+                try {
+                    JSONObject result = gateway.exchangeWebRtc(new JSONObject(payload), room);
+                    if (session != Session.this || !live()) return "";
+                    lastAuthenticated = SystemClock.elapsedRealtime();
+                    return result.toString();
+                } catch (Exception denied) {
+                    return "";
+                }
+            }
+        }
+    }
+
+    private WebResourceResponse intercept(Uri uri, String method) {
+        if ("GET".equals(method) && "https".equals(uri.getScheme()) && uri.getPort() == -1) {
+            String path = uri.getPath();
+            if ("turnservers.vdo.ninja".equals(uri.getHost()) && "/".equals(path)) return null;
+            if (HOST.equals(uri.getHost()) && path != null && path.startsWith("/" + ASSETS)) {
+                String name = path.substring(ASSETS.length() + 1);
+                if (FILES.contains(name)) {
+                    try {
+                        return new WebResourceResponse(name.endsWith(".html") ? "text/html" : "text/javascript",
+                            "UTF-8", context.getAssets().open(ASSETS + name));
+                    } catch (IOException absent) {
+                        // The closure is checked during packaging.
+                    }
+                }
+            }
+        }
+        return new WebResourceResponse("text/plain", "UTF-8", 403, "Forbidden",
+            java.util.Collections.emptyMap(), new ByteArrayInputStream(new byte[0]));
+    }
+}
