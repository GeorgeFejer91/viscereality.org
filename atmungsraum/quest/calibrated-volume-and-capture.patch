+pub(crate) fn smooth_volume(
+    time_us: u64,
+    current: f64,
+    history: Option<(u64, f64)>,
+    stale_after_us: u64,
+    time_constant_us: f64,
+) -> f64 {
+    history.map_or(current, |(before, previous)| {
+        let elapsed = time_us.saturating_sub(before);
+        if elapsed == 0 || elapsed > stale_after_us {
+            return current;
+        }
+        let alpha = -(-(elapsed as f64) / time_constant_us).exp_m1();
+        previous + alpha * (current - previous)
+    })
+}
