+    capture.append(&[ecg(0), ecg(1)]).unwrap();
+    assert!(
+        recover_attempt(&root.0, FIRST).is_err(),
+        "a live capture cannot be recovered"
+    );
+    let directory = root.0.join(STORE).join(FIRST);
+    let partial = directory.join(format!(".{}.partial", chunk_filename(2)));
+    fs::write(&partial, b"{\"incomplete\":").unwrap();
+    drop(capture);
+    let interrupted = recover_attempt(&root.0, FIRST).unwrap();
+    assert_eq!(interrupted.outcome, AttemptOutcome::Interrupted);
+    assert_eq!(interrupted.counts.ecg, 2);
+    assert_eq!(interrupted.dropped_records, None);
+    assert!(!interrupted.raw_window_complete);
+    assert_eq!(fs::read(partial).unwrap(), b"{\"incomplete\":");
+    assert_eq!(recover_attempt(&root.0, FIRST).unwrap(), interrupted);
+}
