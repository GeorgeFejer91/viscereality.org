+use super::*;
+use crate::{
+    experiment_breathing_setup::{BreathingSetup, LoopSchedule},
+    personal_tilt_attempt_capture::{
+        recover_attempt, AttemptReceipt, PolarClockPair, PolarTiming, RecordCounts,
+    },
+};
+
+const PREPARATION: &str = "397f0003-4125-435c-afe6-0cfa45479d78";
+const OTHER_PREPARATION: &str = "397f0003-4125-435c-afe6-0cfa45479d79";
+const FIRST: &str = "949d7553-4725-439c-9c80-c7ae5e479ef4";
+const SECOND: &str = "949d7553-4725-439c-9c80-c7ae5e479ef5";
+const THIRD: &str = "949d7553-4725-439c-9c80-c7ae5e479ef6";
+const TRANSPORT: SetupSensorTransport = SetupSensorTransport {
+    source_token: 4,
+    connection_generation: 8,
+};
+
+struct Scratch(PathBuf);
+impl Scratch {
+    fn new() -> Self {
+        let id = crate::session_recording_participant::new_session_id().unwrap();
+        let path = std::env::temp_dir().join(format!("rq-attempt-owner-{id}"));
+        std::fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+}
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn spec(id: &str, input: &'static str) -> AttemptSpec {
+    AttemptSpec {
+        attempt_id: id.to_owned(),
+        accepted_operation_id: match id {
+            FIRST => "1000000000000001",
+            SECOND => "1000000000000002",
+            _ => "1000000000000003",
+        }
+        .to_owned(),
+        preparation_id: Some(PREPARATION.to_owned()),
+        requested_elapsed_ns: 10,
+        requested_java_ns: 100,
+        polar_connection_generation: TRANSPORT.connection_generation,
+        polar_source_token: TRANSPORT.source_token,
+        sensor_clock_generation: Some(14),
+        audio_generation: 3,
+        loop_sha256: "a".repeat(64),
+        sample_rate_hz: 44_100,
+        input,
+        calibration_target_frames: 1_411_200,
+    }
+}
+
+fn status(generation: u64, calibration: CalibrationState, completed: u64) -> SetupStatus {
+    let mut status = BreathingSetup::new(LoopSchedule::new(44_100, [176_400; 4]).unwrap())
+        .snapshot(2_000_000_000);
+    status.calibration_generation = generation;
+    status.calibration = calibration;
+    status.calibration_start_frame = Some(705_600);
+    status.calibration_completed_frames = completed;
+    status
+}
+
+fn timing(transport: SetupSensorTransport, index: u32) -> PolarTiming {
+    PolarTiming {
+        connection_generation: transport.connection_generation,
+        source_token: transport.source_token,
+        frame_sequence: 5,
+        sample_index: index,
+        sample_count: 73,
+        sensor_time_ns: 200 + u64::from(index),
+        sample_host_time_ns: 300 + u64::from(index),
+        frame_host_receipt_time_ns: 400,
+        jni_submit_time_ns: 500,
+    }
+}
+
+fn wait_for_receipt(root: &Path, id: &str) -> AttemptReceipt {
+    let start = Instant::now();
+    loop {
+        match recover_attempt(root, id) {
+            Ok(receipt) => return receipt,
+            err if start.elapsed() > Duration::from_secs(3) => panic!("{id}: {err:?}"),
+            _ => thread::sleep(Duration::from_millis(20)),
+        }
+    }
+}
+
+#[test]
+fn attempts_keep_retry_interruption_own_raw_lineage_and_exact_fit_association() {
+    let scratch = Scratch::new();
+
+    let mut first = AttemptOwner::begin(&scratch.0, spec(FIRST, "polar-tilt"), 0, 1).unwrap();
+    first.activate();
+    assert!(first
+        .observe(
+            status(1, CalibrationState::Waiting, 0),
+            3,
+            1,
+            Some(TRANSPORT),
+            false,
+            None,
+            20
+        )
+        .is_none());
+    let first_ecg = timing(TRANSPORT, 0);
+    observe_raw(AttemptRecord::Ecg {
+        timing: first_ecg,
+        microvolts: -23,
+    });
+    first.end(
+        AttemptOutcome::Superseded,
+        "calibration-superseded",
+        30,
+        0,
+        None,
+    );
+
+    let mut second = AttemptOwner::begin(&scratch.0, spec(SECOND, "polar-volume"), 1, 1).unwrap();
+    second.activate();
+    assert!(second
+        .observe(
+            status(1, CalibrationState::Waiting, 0),
+            3,
+            1,
+            Some(TRANSPORT),
+            true,
+            None,
+            40
+        )
+        .is_none());
+    assert!(second
+        .observe(
+            status(2, CalibrationState::Collecting, 10),
+            4,
+            1,
+            Some(TRANSPORT),
+            false,
+            None,
+            50
+        )
+        .is_none());
+    let foreign = timing(
+        SetupSensorTransport {
+            connection_generation: 9,
+            ..TRANSPORT
+        },
+        1,
+    );
+    observe_raw(AttemptRecord::Ecg {
+        timing: foreign,
+        microvolts: 111,
+    });
+    let same_generation_wrong_owner = timing(
+        SetupSensorTransport {
+            source_token: 99,
+            ..TRANSPORT
+        },
+        1,
+    );
+    observe_raw(AttemptRecord::Ecg {
+        timing: same_generation_wrong_owner,
+        microvolts: 222,
+    });
+    let prior_preparation = PolarTiming {
+        sample_host_time_ns: 99,
+        ..timing(TRANSPORT, 1)
+    };
+    observe_raw(AttemptRecord::Ecg {
+        timing: prior_preparation,
+        microvolts: 333,
+    });
+    let valid = timing(TRANSPORT, 1);
+    observe_raw(AttemptRecord::Ecg {
+        timing: valid,
+        microvolts: -24,
+    });
+    observe_raw(AttemptRecord::Acc {
+        timing: valid,
+        xyz_mg: [12, 34, 991],
+    });
+    second.clock(
+        100_000_000,
+        AttemptRecord::Audio {
+            generation: 4,
+            absolute_frame: 705_600,
+            observed_elapsed_ns: 100_000_000,
+            playing: true,
+            clock_valid: true,
+            polar_clock_pair: Some(PolarClockPair {
+                java_monotonic_ns: 500,
+                android_elapsed_ns: 600,
+            }),
+        },
+    );
+    let model = TiltModel {
+        source_owner: 1,
+        generation: 9,
+        axis: [0.0, 0.0, 1.0],
+        low: -0.2,
+        high: 0.2,
+    };
+    let mut fitted = status(2, CalibrationState::Succeeded, 1_411_200);
+    fitted.model_generation = Some(9);
+    fitted.accepted_samples = 700;
+    let proof = second
+        .observe(
+            fitted,
+            4,
+            1,
+            Some(TRANSPORT),
+            false,
+            Some(&model),
+            2_000_000_000,
+        )
+        .unwrap();
+    assert_eq!(proof.matches(PREPARATION, 2, 9, 1), Some(SECOND));
+    assert_eq!(proof.matches(OTHER_PREPARATION, 2, 9, 1), None);
+    assert_eq!(proof.matches(PREPARATION, 1, 9, 1), None);
+    assert_eq!(proof.matches(PREPARATION, 2, 8, 1), None);
+    assert_eq!(proof.matches(PREPARATION, 2, 9, 2), None);
+    // A tail ECG packet can arrive after the actual audio-frame fit.
+    observe_raw(AttemptRecord::Ecg {
+        timing: timing(TRANSPORT, 2),
+        microvolts: -25,
+    });
+    let first_result = wait_for_receipt(&scratch.0, FIRST);
+    assert_eq!(first_result.outcome, AttemptOutcome::Superseded);
+    assert_eq!(
+        first_result.counts,
+        RecordCounts {
+            ecg: 1,
+            acc: 0,
+            audio: 0,
+            windows: 1
+        }
+    );
+    assert!(!first_result.raw_window_complete);
+    let second_result = wait_for_receipt(&scratch.0, SECOND);
+    assert_eq!(second_result.outcome, AttemptOutcome::Succeeded);
+    assert_eq!(
+        second_result.counts,
+        RecordCounts {
+            ecg: 2,
+            acc: 1,
+            audio: 1,
+            windows: 1
+        }
+    );
+    assert_eq!(second_result.model_generation, Some(9));
+    assert!(
+        !second_result.raw_window_complete,
+        "a passing fit alone does not prove full raw coverage"
+    );
+
+    let mut third = AttemptOwner::begin(&scratch.0, spec(THIRD, "polar-tilt"), 2, 1).unwrap();
+    third.activate();
+    third.observe(
+        status(3, CalibrationState::Waiting, 0),
+        4,
+        1,
+        Some(TRANSPORT),
+        false,
+        None,
+        40,
+    );
+    third.observe(
+        status(3, CalibrationState::Collecting, 20),
+        4,
+        2,
+        Some(TRANSPORT),
+        false,
+        None,
+        50,
+    );
+    let third_result = wait_for_receipt(&scratch.0, THIRD);
+    assert_eq!(third_result.outcome, AttemptOutcome::Failed);
+    assert_eq!(third_result.reason, "polar-lineage-retired");
+    assert!(!third_result.raw_window_complete);
+}
