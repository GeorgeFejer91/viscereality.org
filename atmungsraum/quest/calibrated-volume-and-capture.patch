+#[test]
+fn full_raw_coverage_requires_continuous_samples_and_a_valid_clock_witness() {
+    let root = Scratch::new();
+    for (id, gap) in [(FIRST, false), (SECOND, true)] {
+        let mut manifest = spec(id, None);
+        manifest.calibration_target_frames = 44_100 * 32;
+        let mut capture = AttemptCapture::begin(&root.0, manifest).unwrap();
+        capture
+            .append(&[
+                AttemptRecord::Window {
+                    audio_generation: 3,
+                    start_frame: 0,
+                },
+                AttemptRecord::Audio {
+                    generation: 3,
+                    absolute_frame: 0,
+                    observed_elapsed_ns: 1_000,
+                    playing: true,
+                    clock_valid: true,
+                    polar_clock_pair: Some(PolarClockPair {
+                        java_monotonic_ns: 200,
+                        android_elapsed_ns: 1_000,
+                    }),
+                },
+            ])
+            .unwrap();
+        let samples: Vec<_> = (0..=3200u64)
+            .filter(|index| !gap || *index != 1600)
+            .flat_map(|index| {
+                let t = 200 + index * 10_000_000;
+                let timing = PolarTiming {
+                    frame_sequence: index + 1,
+                    sample_index: 0,
+                    sample_count: 1,
+                    sensor_time_ns: t,
+                    sample_host_time_ns: t,
+                    frame_host_receipt_time_ns: t,
+                    jni_submit_time_ns: t,
+                    ..timing(0)
+                };
+                [
+                    AttemptRecord::Ecg {
+                        timing,
+                        microvolts: 7,
+                    },
+                    AttemptRecord::Acc {
+                        timing,
+                        xyz_mg: [10, 20, 1000],
+                    },
+                ]
+            })
+            .collect();
+        for batch in samples.chunks(MAX_CHUNK_RECORDS) {
+            capture.append(batch).unwrap();
+        }
+        let mut terminal = end(AttemptOutcome::Succeeded, 0);
+        terminal.ended_elapsed_ns = 32_000_001_000;
+        let result = capture.finish(terminal).unwrap();
+        assert_eq!(result.raw_window_complete, !gap);
+        assert_eq!(recover_attempt(&root.0, id).unwrap(), result);
+    }
+}
