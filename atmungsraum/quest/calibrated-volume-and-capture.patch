+
+
+HARNESS = r'''package io.github.mesmerprism.rustyquest.native_renderer;
+import java.util.Arrays;
+import java.util.List;
+import io.github.mesmerprism.rustyquest.native_renderer.ConditionAudioContract.*;
+
+final class SharedMainAudioCloseoutHarness {
+    private static final Object PRESENTATION_LOCK = new Object();
+    private static long pendingAudioGeneration, appliedAudioControlGeneration, appliedAudioControlRevision;
+    private static String pendingAudioCondition = "", pendingAudioScenario = "", pendingAudioPrepareOperation = "";
+    private static boolean terminalIntentAdmitted, audioImmersiveAdmitted, audioPrepared;
+    private static int outros;
+    private static final ConditionAudioRuntime conditionAudioRuntime = new ConditionAudioRuntime();
+    private static final BreathPhaseAudioAndroidOwner breathPhaseAudioOwner = null;
+    private static void cancelMainOutro() {}
+    private static void scheduleMainOutro(long generation) { outros++; }
+    private static List<String> conditionAudioScenarios() { return Arrays.asList("haupt-15"); }
+    private static void publishConditionAudioControlFailure(long generation, long revision, String reason) {
+        throw new AssertionError(reason);
+    }
+    private static void check(boolean ok, String message) { if (!ok) throw new AssertionError(message); }
+
+    __GENERATED_METHODS__
+
+    public static void main(String[] args) {
+        ConditionAudioRuntime audio = conditionAudioRuntime;
+        check(startConditionAudio(1, "arm-1", "condition-a", "haupt-15"), "initial arm");
+        audio.phase = Phase.PLAYING;
+        audioPrepared = true;
+        applyConditionAudioControlReceipt(1, 2, "armed");
+        applyConditionAudioControlReceipt(2, 3, "shared-main-completed");
+        applyConditionAudioControlReceipt(1, 1, "shared-main-completed");
+        check(audio.stops == 0, "unmatched generation or revision cannot stop the player");
+        applyConditionAudioControlReceipt(1, 3, "shared-main-completed");
+        check(audio.stops == 1 && audio.phase == Phase.STOPPING, "completed generation submits its stop");
+        applyConditionAudioControlReceipt(1, 3, "shared-main-completed");
+        check(audio.stops == 1, "duplicate completion does not stop twice");
+        check(!startConditionAudio(2, "arm-2", "condition-a", "haupt-15"), "second prepare waits for stop");
+        check(audio.prepares == 1, "waiting must preserve the second operation ID");
+        audio.phase = Phase.STOPPED;
+        audio.trackReady = false;
+        check(!startConditionAudio(2, "arm-2", "condition-a", "haupt-15") && audio.prepares == 1,
+            "the next track must be ready after stopping");
+        audio.trackReady = true;
+        check(startConditionAudio(2, "arm-2", "condition-a", "haupt-15"), "same Arm can now prepare");
+        check(startConditionAudio(2, "arm-2", "condition-a", "haupt-15") && audio.prepares == 2,
+            "second preparation is idempotent");
+        applyConditionAudioControlReceipt(1, 4, "shared-main-completed");
+        check(audio.stops == 1 && audio.generation == 2, "late old completion cannot stop the new owner");
+        audio.phase = Phase.SILENT_AFTER_NATURAL_END;
+        applyConditionAudioControlReceipt(2, 5, "main-outro");
+        check(outros == 1 && audio.stops == 2, "authored completion schedules its outro and retires its condition owner");
+        audio.phase = Phase.STOPPED;
+        check(startConditionAudio(3, "arm-3", "condition-a", "haupt-15"), "authored owner also permits the next arm");
+        System.out.println("SharedMainAudioCloseoutHarness PASS");
+    }
+}
+
+final class BreathPhaseAudioAndroidOwner {
+    String readiness() { return "ready"; }
+    void control(long generation, String event) {}
+}
+
+final class ConditionAudioRuntime {
+    Phase phase = Phase.IDLE;
+    long generation;
+    int prepares, stops;
+    boolean trackReady = true;
+
+    TrackReadiness trackReadiness(String condition) {
+        return new TrackReadiness(true, condition, trackReady ? TrackState.READY : TrackState.PENDING, "");
+    }
+    Snapshot snapshot() { return new Snapshot(phase, generation, 0, "", "", 0, ""); }
+
+    Submission submit(Command command) {
+        switch (command.kind) {
+            case PREPARE:
+                prepares++;
+                if (phase != Phase.IDLE && phase != Phase.STOPPED) throw new AssertionError("premature PREPARE");
+                phase = Phase.PREPARING;
+                generation = command.sessionGeneration;
+                break;
+            case STOP:
+                stops++;
+                if (command.sessionGeneration != generation || command.stopReason != StopReason.RESTART_TO_EXPERIMENTER)
+                    throw new AssertionError("stop must target the exact completed owner");
+                phase = Phase.STOPPING;
+                break;
+            default:
+                throw new AssertionError("unexpected command " + command.kind);
+        }
+        return new Submission(true, true, false, "", command.sessionGeneration, command.operationId);
+    }
+}
