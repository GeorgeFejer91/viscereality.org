@@ -0,0 +1,822 @@
+//! App-private storage for one Personal Tilt calibration attempt.
+//! The setup owner will mint the IDs, choose the acquisition window and submit
+//! bounded batches on a persistence worker. This module never admits a
+//! calibration, changes a model, or writes to the experiment session store.
+
+use std::{
+    fs::{self, File, OpenOptions},
+    io::Read,
+    path::{Path, PathBuf},
+};
+
+use serde_json::{json, Value};
+
+use crate::{
+    session_recording_participant::valid_uuid,
+    session_recording_writer::{publish_json_exclusive, sync_directory},
+};
+
+const STORE: &str = "personal-tilt-attempts";
+const MANIFEST: &str = "manifest.json";
+const FINAL: &str = "final.json";
+const LEASE: &str = ".writer-lock";
+const MANIFEST_SCHEMA: &str = "rusty.quest.personal_tilt_attempt.v1";
+const CHUNK_SCHEMA: &str = "rusty.quest.personal_tilt_attempt_chunk.v1";
+const FINAL_SCHEMA: &str = "rusty.quest.personal_tilt_attempt_final.v1";
+pub(crate) const MAX_CHUNK_RECORDS: usize = 256;
+const MAX_ATTEMPT_RECORDS: u64 = 32_768;
+const MAX_ARTIFACT_BYTES: u64 = 512 * 1024;
+
+#[derive(Clone)]
+pub(crate) struct AttemptSpec {
+    pub(crate) attempt_id: String,
+    pub(crate) accepted_operation_id: String,
+    pub(crate) preparation_id: Option<String>,
+    pub(crate) requested_elapsed_ns: u64,
+    pub(crate) requested_java_ns: u64,
+    pub(crate) polar_connection_generation: u64,
+    pub(crate) polar_source_token: u64,
+    pub(crate) sensor_clock_generation: Option<u64>,
+    pub(crate) audio_generation: u64,
+    pub(crate) loop_sha256: String,
+    pub(crate) sample_rate_hz: u32,
+    pub(crate) input: &'static str,
+    pub(crate) calibration_target_frames: u64,
+}
+
+impl AttemptSpec {
+    fn manifest(&self) -> Result<Value, String> {
+        let value = json!({
+            "schema": MANIFEST_SCHEMA,
+            "attempt_id": self.attempt_id,
+            "accepted_operation_id": self.accepted_operation_id,
+            "preparation_id": self.preparation_id,
+            "requested_elapsed_ns": self.requested_elapsed_ns,
+            "requested_java_ns": self.requested_java_ns,
+            "polar_connection_generation": self.polar_connection_generation,
+            "polar_source_token": self.polar_source_token,
+            "sensor_clock_generation": self.sensor_clock_generation,
+            "audio_generation": self.audio_generation,
+            "loop_sha256": self.loop_sha256,
+            "sample_rate_hz": self.sample_rate_hz,
+            "input": self.input,
+            "calibration_target_frames": self.calibration_target_frames,
+        });
+        validate_manifest(&self.attempt_id, &value)?;
+        Ok(value)
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct PolarTiming {
+    pub(crate) connection_generation: u64,
+    pub(crate) source_token: u64,
+    pub(crate) frame_sequence: u64,
+    pub(crate) sample_index: u32,
+    pub(crate) sample_count: u32,
+    pub(crate) sensor_time_ns: u64,
+    pub(crate) sample_host_time_ns: u64,
+    pub(crate) frame_host_receipt_time_ns: u64,
+    pub(crate) jni_submit_time_ns: u64,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct PolarClockPair {
+    pub(crate) java_monotonic_ns: u64,
+    pub(crate) android_elapsed_ns: u64,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum AttemptRecord {
+    Ecg {
+        timing: PolarTiming,
+        microvolts: i32,
+    },
+    Acc {
+        timing: PolarTiming,
+        xyz_mg: [i32; 3],
+    },
+    Window {
+        audio_generation: u64,
+        start_frame: u64,
+    },
+    Audio {
+        generation: u64,
+        absolute_frame: u64,
+        observed_elapsed_ns: u64,
+        playing: bool,
+        clock_valid: bool,
+        polar_clock_pair: Option<PolarClockPair>,
+    },
+}
+
+impl AttemptRecord {
+    fn encoded(self) -> Value {
+        let (timing, kind, reading) = match self {
+            Self::Ecg { timing, microvolts } => (timing, "microvolts", json!(microvolts)),
+            Self::Acc { timing, xyz_mg } => (timing, "xyz_mg", json!(xyz_mg)),
+            Self::Window {
+                audio_generation,
+                start_frame,
+            } => {
+                return json!({"kind": "calibration_window", "generation": audio_generation,
+                    "start_frame": start_frame});
+            }
+            Self::Audio {
+                generation,
+                absolute_frame,
+                observed_elapsed_ns,
+                playing,
+                clock_valid,
+                polar_clock_pair,
+            } => {
+                let polar_clock_pair = polar_clock_pair.map(|pair| {
+                    json!({"java_monotonic_ns": pair.java_monotonic_ns,
+                        "android_elapsed_ns": pair.android_elapsed_ns})
+                });
+                return json!({"kind":"audio", "generation":generation,
+                    "absolute_frame":absolute_frame, "observed_elapsed_ns":observed_elapsed_ns,
+                    "playing":playing, "clock_valid":clock_valid,
+                    "polar_clock_pair": polar_clock_pair});
+            }
+        };
+        let mut value = json!({
+            "kind": if kind == "microvolts" { "ecg" } else { "acc" },
+            "connection_generation": timing.connection_generation,
+            "source_token": timing.source_token,
+            "frame_sequence": timing.frame_sequence,
+            "sample_index": timing.sample_index,
+            "sample_count": timing.sample_count,
+            "sensor_time_ns": timing.sensor_time_ns,
+            "sample_host_time_ns": timing.sample_host_time_ns,
+            "frame_host_receipt_time_ns": timing.frame_host_receipt_time_ns,
+            "jni_submit_time_ns": timing.jni_submit_time_ns,
+        });
+        value[kind] = reading;
+        value
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum AttemptOutcome {
+    Succeeded,
+    Failed,
+    Superseded,
+    Abandoned,
+    Interrupted,
+}
+
+impl AttemptOutcome {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Succeeded => "succeeded",
+            Self::Failed => "failed",
+            Self::Superseded => "superseded",
+            Self::Abandoned => "abandoned",
+            Self::Interrupted => "interrupted",
+        }
+    }
+
+    fn from_terminal(value: &Value) -> Option<Self> {
+        match value.as_str()? {
+            "succeeded" => Some(Self::Succeeded),
+            "failed" => Some(Self::Failed),
+            "superseded" => Some(Self::Superseded),
+            "abandoned" => Some(Self::Abandoned),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct AttemptFit {
+    pub(crate) model_generation: u64,
+    pub(crate) source_owner: u64,
+    pub(crate) accepted_samples: u64,
+    pub(crate) axis: [f64; 3],
+    pub(crate) low: f64,
+    pub(crate) high: f64,
+}
+impl AttemptFit {
+    fn encoded(&self) -> Value {
+        json!({"model_generation": self.model_generation, "source_owner": self.source_owner,
+            "accepted_samples": self.accepted_samples, "axis": self.axis, "low": self.low, "high": self.high})
+    }
+}
+fn fit_generation(value: &Value, outcome: AttemptOutcome) -> Result<Option<u64>, String> {
+    if outcome != AttemptOutcome::Succeeded {
+        return if value.is_null() {
+            Ok(None)
+        } else {
+            Err("attempt-fit-unexpected".into())
+        };
+    }
+    let generation = positive(&value["model_generation"]).ok_or("attempt-fit-invalid")?;
+    let valid_bounds = value["low"]
+        .as_f64()
+        .zip(value["high"].as_f64())
+        .is_some_and(|(low, high)| low.is_finite() && high.is_finite() && low < high);
+    if positive(&value["source_owner"]).is_none()
+        || positive(&value["accepted_samples"]).is_none()
+        || !value["axis"].as_array().is_some_and(|axis| {
+            axis.len() == 3
+                && axis
+                    .iter()
+                    .all(|component| component.as_f64().is_some_and(f64::is_finite))
+        })
+        || !valid_bounds
+    {
+        return Err("attempt-fit-invalid".into());
+    }
+    Ok(Some(generation))
+}
+
+pub(crate) struct AttemptEnd {
+    pub(crate) outcome: AttemptOutcome,
+    pub(crate) reason: String,
+    pub(crate) ended_elapsed_ns: u64,
+    pub(crate) completed_calibration_frames: u64,
+    pub(crate) fit: Option<AttemptFit>,
+    /// The acquisition owner observed the bounded raw window, including tail policy.
+    pub(crate) raw_window_complete: bool,
+    pub(crate) dropped_records: u64,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct RecordCounts {
+    pub(crate) ecg: u64,
+    pub(crate) acc: u64,
+    pub(crate) audio: u64,
+    pub(crate) windows: u64,
+}
+
+impl RecordCounts {
+    fn total(self) -> u64 {
+        self.ecg + self.acc + self.audio + self.windows
+    }
+
+    fn observe(&mut self, rows: &[Value], manifest: &Value) -> Result<(), String> {
+        if rows.is_empty()
+            || rows.len() > MAX_CHUNK_RECORDS
+            || self.total() + rows.len() as u64 > MAX_ATTEMPT_RECORDS
+        {
+            return Err("attempt-chunk-size-invalid".into());
+        }
+        for row in rows {
+            let kind = row["kind"].as_str();
+            if kind == Some("calibration_window") {
+                if self.windows != 0
+                    || !audio_generation_valid(row, manifest)
+                    || row["start_frame"]
+                        .as_u64()
+                        .zip(positive(&manifest["calibration_target_frames"]))
+                        .is_none_or(|(start, target)| start.checked_add(target).is_none())
+                {
+                    return Err("attempt-window-invalid".into());
+                }
+                self.windows += 1;
+                continue;
+            }
+            if kind == Some("audio") {
+                let clock_pair = &row["polar_clock_pair"];
+                if !audio_generation_valid(row, manifest)
+                    || row["absolute_frame"].as_u64().is_none()
+                    || positive(&row["observed_elapsed_ns"]).is_none()
+                    || !row["playing"].is_boolean()
+                    || !row["clock_valid"].is_boolean()
+                    || (!clock_pair.is_null()
+                        && (positive(&clock_pair["java_monotonic_ns"]).is_none()
+                            || positive(&clock_pair["android_elapsed_ns"]).is_none()))
+                {
+                    return Err("attempt-audio-lineage-invalid".into());
+                }
+                self.audio += 1;
+                continue;
+            }
+            let (Some(index), Some(count), Some(sample_host), Some(receipt), Some(submitted)) = (
+                row["sample_index"].as_u64(),
+                positive(&row["sample_count"]),
+                row["sample_host_time_ns"].as_u64(),
+                positive(&row["frame_host_receipt_time_ns"]),
+                positive(&row["jni_submit_time_ns"]),
+            ) else {
+                return Err("attempt-polar-timing-invalid".into());
+            };
+            if index >= count
+                || count > u64::from(u32::MAX)
+                || sample_host < manifest["requested_java_ns"].as_u64().unwrap_or(u64::MAX)
+                || sample_host > receipt
+                || receipt > submitted
+                || positive(&row["frame_sequence"]).is_none()
+                || positive(&row["sensor_time_ns"]).is_none()
+                || row["connection_generation"] != manifest["polar_connection_generation"]
+                || row["source_token"] != manifest["polar_source_token"]
+            {
+                return Err("attempt-polar-lineage-invalid".into());
+            }
+            match kind {
+                Some("ecg") if signed_sample(&row["microvolts"]) => self.ecg += 1,
+                Some("acc")
+                    if row["xyz_mg"]
+                        .as_array()
+                        .is_some_and(|axes| axes.len() == 3 && axes.iter().all(signed_sample)) =>
+                {
+                    self.acc += 1
+                }
+                _ => return Err("attempt-record-invalid".into()),
+            }
+        }
+        Ok(())
+    }
+
+    fn encoded(self) -> Value {
+        json!({"ecg": self.ecg, "acc": self.acc, "audio": self.audio, "windows": self.windows})
+    }
+
+    fn both_streams_with_clock(self) -> bool {
+        self.ecg > 0 && self.acc > 0 && self.audio > 0 && self.windows == 1
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct StreamCoverage {
+    first_sensor: Option<u64>,
+    last_sensor: u64,
+    last_host: u64,
+    last_frame: u64,
+    last_index: u64,
+    last_count: u64,
+    gap: bool,
+}
+
+impl StreamCoverage {
+    fn observe(&mut self, row: &Value) {
+        // The typed row has already passed timing and lineage validation.
+        let sensor = row["sensor_time_ns"].as_u64().unwrap_or(0);
+        let frame = row["frame_sequence"].as_u64().unwrap_or(0);
+        let index = row["sample_index"].as_u64().unwrap_or(0);
+        if self.first_sensor.is_some() {
+            let next_in_frame = frame == self.last_frame && index == self.last_index + 1;
+            let next_frame = frame == self.last_frame.saturating_add(1)
+                && self.last_index + 1 == self.last_count
+                && index == 0;
+            self.gap |= (!next_in_frame && !next_frame)
+                || sensor <= self.last_sensor
+                || sensor - self.last_sensor > 100_000_000;
+        }
+        self.first_sensor.get_or_insert(sensor);
+        self.last_sensor = sensor;
+        self.last_host = row["sample_host_time_ns"].as_u64().unwrap_or(0);
+        self.last_frame = frame;
+        self.last_index = index;
+        self.last_count = row["sample_count"].as_u64().unwrap_or(0);
+    }
+
+    fn spans(self, duration_ns: u64, end_java_ns: u64) -> bool {
+        // Notification batching and the Java/audio pair bound this check to
+        // a conservative start/end tolerance. No packet/index gaps qualify.
+        const END_TOLERANCE_NS: u64 = 750_000_000;
+        self.first_sensor.is_some_and(|first| {
+            let span = self.last_sensor.saturating_sub(first);
+            span > 0
+                && !self.gap
+                && span.saturating_add(END_TOLERANCE_NS) >= duration_ns
+                && self.last_host.saturating_add(END_TOLERANCE_NS) >= end_java_ns
+        })
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct RawCoverage {
+    ecg: StreamCoverage,
+    acc: StreamCoverage,
+    clock_pair: bool,
+}
+
+impl RawCoverage {
+    fn observe(&mut self, rows: &[Value]) {
+        for row in rows {
+            match row["kind"].as_str() {
+                Some("ecg") => self.ecg.observe(row),
+                Some("acc") => self.acc.observe(row),
+                Some("audio") if row["clock_valid"] == true && row["playing"] == true => {
+                    self.clock_pair |= !row["polar_clock_pair"].is_null();
+                }
+                _ => {}
+            }
+        }
+    }
+
+    fn complete(self, manifest: &Value, ended_elapsed: u64) -> bool {
+        let frames = manifest["calibration_target_frames"]
+            .as_u64()
+            .unwrap_or(u64::MAX);
+        let rate = manifest["sample_rate_hz"].as_u64().unwrap_or(1).max(1);
+        let duration_ns = frames.saturating_mul(1_000_000_000) / rate;
+        let requested_elapsed = manifest["requested_elapsed_ns"].as_u64().unwrap_or(0);
+        let requested_java = manifest["requested_java_ns"].as_u64().unwrap_or(0);
+        let end_java =
+            requested_java.saturating_add(ended_elapsed.saturating_sub(requested_elapsed));
+        self.clock_pair
+            && self.ecg.spans(duration_ns, end_java)
+            && self.acc.spans(duration_ns, end_java)
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct AttemptReceipt {
+    pub(crate) outcome: AttemptOutcome,
+    pub(crate) reason: String,
+    pub(crate) ended_elapsed_ns: Option<u64>,
+    pub(crate) completed_calibration_frames: Option<u64>,
+    pub(crate) model_generation: Option<u64>,
+    pub(crate) raw_window_complete: bool,
+    pub(crate) dropped_records: Option<u64>,
+    pub(crate) counts: RecordCounts,
+}
+
+/// Owns the only write lease for this UUID. Call only on a storage worker.
+pub(crate) struct AttemptCapture {
+    directory: PathBuf,
+    manifest: Value,
+    _lease: File,
+    chunks: u64,
+    counts: RecordCounts,
+    coverage: RawCoverage,
+    storage_fault: bool,
+}
+
+impl AttemptCapture {
+    pub(crate) fn begin(app_files: &Path, spec: AttemptSpec) -> Result<Self, String> {
+        let manifest = spec.manifest()?;
+        let store = store_directory(app_files, true)?;
+        let directory = store.join(&spec.attempt_id);
+        fs::create_dir(&directory).map_err(io_error)?;
+        sync_directory(&store)?;
+        let lease = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open(directory.join(LEASE))
+            .map_err(io_error)?;
+        lease.try_lock().map_err(io_error)?;
+        publish_json_exclusive(&directory, MANIFEST, &manifest)?;
+        Ok(Self {
+            directory,
+            manifest,
+            _lease: lease,
+            chunks: 0,
+            counts: RecordCounts::default(),
+            coverage: RawCoverage::default(),
+            storage_fault: false,
+        })
+    }
+
+    pub(crate) fn append(&mut self, records: &[AttemptRecord]) -> Result<(), String> {
+        if self.storage_fault {
+            return Err("attempt-storage-faulted".into());
+        }
+        if records.is_empty() || records.len() > MAX_CHUNK_RECORDS {
+            return Err("attempt-chunk-size-invalid".into());
+        }
+        let rows: Vec<_> = records
+            .iter()
+            .copied()
+            .map(AttemptRecord::encoded)
+            .collect();
+        let mut next_counts = self.counts;
+        next_counts.observe(&rows, &self.manifest)?;
+        let ordinal = self.chunks + 1;
+        let chunk = json!({"schema": CHUNK_SCHEMA, "attempt_id": self.manifest["attempt_id"],
+            "ordinal": ordinal, "records": rows});
+        if let Err(error) =
+            publish_json_exclusive(&self.directory, &chunk_filename(ordinal), &chunk)
+        {
+            self.storage_fault = true;
+            return Err(error);
+        }
+        self.chunks = ordinal;
+        self.counts = next_counts;
+        if let Some(rows) = chunk["records"].as_array() {
+            self.coverage.observe(rows);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn finish(self, end: AttemptEnd) -> Result<AttemptReceipt, String> {
+        if self.storage_fault {
+            return Err("attempt-storage-faulted".into());
+        }
+        if end.outcome == AttemptOutcome::Interrupted
+            || !valid_reason(&end.reason)
+            || !valid_terminal_time(
+                &self.manifest,
+                end.outcome,
+                end.ended_elapsed_ns,
+                end.completed_calibration_frames,
+            )
+        {
+            return Err("attempt-terminal-invalid".into());
+        }
+        let fit = end.fit.as_ref().map_or(Value::Null, AttemptFit::encoded);
+        let model_generation = fit_generation(&fit, end.outcome)?;
+        if model_generation.is_some() && self.counts.windows != 1 {
+            return Err("attempt-window-missing".into());
+        }
+        let result = AttemptReceipt {
+            outcome: end.outcome,
+            reason: end.reason,
+            ended_elapsed_ns: Some(end.ended_elapsed_ns),
+            completed_calibration_frames: Some(end.completed_calibration_frames),
+            model_generation,
+            raw_window_complete: end.raw_window_complete
+                && end.dropped_records == 0
+                && self.counts.both_streams_with_clock()
+                && self.coverage.complete(&self.manifest, end.ended_elapsed_ns),
+            dropped_records: Some(end.dropped_records),
+            counts: self.counts,
+        };
+        publish_json_exclusive(
+            &self.directory,
+            FINAL,
+            &json!({
+                "schema": FINAL_SCHEMA, "attempt_id": self.manifest["attempt_id"], "chunks": self.chunks,
+                "outcome": result.outcome.as_str(), "reason": result.reason,
+                "ended_elapsed_ns": result.ended_elapsed_ns,
+                "completed_calibration_frames": result.completed_calibration_frames,
+                "raw_window_complete": result.raw_window_complete, "dropped_records": result.dropped_records,
+                "fit": fit,
+                "counts": result.counts.encoded(),
+            }),
+        )?;
+        Ok(result)
+    }
+}
+
+/// Recovers only visible immutable chunks. A power/process loss cannot prove
+/// the final raw window or the number of samples buffered in memory. Recovery
+/// derives an interrupted receipt without promoting or rewriting partial files.
+pub(crate) fn recover_attempt(
+    app_files: &Path,
+    attempt_id: &str,
+) -> Result<AttemptReceipt, String> {
+    if !valid_uuid(attempt_id) {
+        return Err("attempt-id-invalid".into());
+    }
+    let directory = store_directory(app_files, false)?.join(attempt_id);
+    require_directory(&directory)?;
+    let lease_path = directory.join(LEASE);
+    require_file(&lease_path)?;
+    let lease = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(lease_path)
+        .map_err(io_error)?;
+    lease.try_lock().map_err(io_error)?;
+
+    let manifest = read_json(&directory.join(MANIFEST))?;
+    validate_manifest(attempt_id, &manifest)?;
+    let mut ordinals = Vec::new();
+    for entry in fs::read_dir(&directory).map_err(io_error)? {
+        let name = entry.map_err(io_error)?.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        let Some(digits) = name
+            .strip_prefix("chunk-")
+            .and_then(|value| value.strip_suffix(".json"))
+        else {
+            continue;
+        };
+        let ordinal: u64 = digits
+            .parse()
+            .map_err(|_| "attempt-chunk-name-invalid".to_owned())?;
+        if ordinal == 0 || ordinal > MAX_ATTEMPT_RECORDS || name != chunk_filename(ordinal) {
+            return Err("attempt-chunk-name-invalid".into());
+        }
+        ordinals.push(ordinal);
+        if ordinals.len() as u64 > MAX_ATTEMPT_RECORDS {
+            return Err("attempt-chunk-size-invalid".into());
+        }
+    }
+    ordinals.sort_unstable();
+    let mut counts = RecordCounts::default();
+    let mut coverage = RawCoverage::default();
+    for (index, ordinal) in ordinals.iter().copied().enumerate() {
+        if ordinal != index as u64 + 1 {
+            return Err("attempt-chunk-order-invalid".into());
+        }
+        let chunk = read_json(&directory.join(chunk_filename(ordinal)))?;
+        if chunk["schema"] != CHUNK_SCHEMA
+            || chunk["attempt_id"] != attempt_id
+            || chunk["ordinal"] != ordinal
+        {
+            return Err("attempt-chunk-identity-invalid".into());
+        }
+        let rows = chunk["records"]
+            .as_array()
+            .ok_or("attempt-records-invalid")?;
+        counts.observe(rows, &manifest)?;
+        coverage.observe(rows);
+    }
+
+    let final_path = directory.join(FINAL);
+    match fs::symlink_metadata(&final_path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(AttemptReceipt {
+            outcome: AttemptOutcome::Interrupted,
+            reason: "missing-terminal-receipt".into(),
+            ended_elapsed_ns: None,
+            completed_calibration_frames: None,
+            model_generation: None,
+            raw_window_complete: false,
+            dropped_records: None,
+            counts,
+        }),
+        Err(error) => Err(io_error(error)),
+        Ok(_) => {
+            let terminal = read_json(&final_path)?;
+            let outcome = AttemptOutcome::from_terminal(&terminal["outcome"])
+                .ok_or("attempt-terminal-invalid")?;
+            let reason = terminal["reason"]
+                .as_str()
+                .filter(|reason| valid_reason(reason))
+                .ok_or("attempt-terminal-invalid")?;
+            let ended = terminal["ended_elapsed_ns"]
+                .as_u64()
+                .ok_or("attempt-terminal-invalid")?;
+            let completed = terminal["completed_calibration_frames"]
+                .as_u64()
+                .ok_or("attempt-terminal-invalid")?;
+            let dropped = terminal["dropped_records"]
+                .as_u64()
+                .ok_or("attempt-terminal-invalid")?;
+            let complete = terminal["raw_window_complete"]
+                .as_bool()
+                .ok_or("attempt-terminal-invalid")?;
+            let model_generation = fit_generation(&terminal["fit"], outcome)?;
+            if (model_generation.is_some() && counts.windows != 1)
+                || terminal["schema"] != FINAL_SCHEMA
+                || terminal["attempt_id"] != attempt_id
+                || terminal["chunks"] != ordinals.len()
+                || terminal["counts"] != counts.encoded()
+                || !valid_terminal_time(&manifest, outcome, ended, completed)
+                || complete
+                    && (dropped > 0
+                        || !counts.both_streams_with_clock()
+                        || !coverage.complete(&manifest, ended))
+            {
+                return Err("attempt-terminal-invalid".into());
+            }
+            Ok(AttemptReceipt {
+                outcome,
+                reason: reason.to_owned(),
+                ended_elapsed_ns: Some(ended),
+                completed_calibration_frames: Some(completed),
+                model_generation,
+                raw_window_complete: complete,
+                dropped_records: Some(dropped),
+                counts,
+            })
+        }
+    }
+}
+
+fn validate_manifest(attempt_id: &str, value: &Value) -> Result<(), String> {
+    if !valid_uuid(attempt_id)
+        || value["attempt_id"] != attempt_id
+        || value["schema"] != MANIFEST_SCHEMA
+        || !value["accepted_operation_id"]
+            .as_str()
+            .is_some_and(|id| valid_hex(id, 16))
+        || !(value["preparation_id"].is_null()
+            || value["preparation_id"].as_str().is_some_and(valid_uuid))
+        || positive(&value["requested_elapsed_ns"]).is_none()
+        || positive(&value["requested_java_ns"]).is_none()
+        || positive(&value["polar_connection_generation"]).is_none()
+        || positive(&value["polar_source_token"]).is_none()
+        || !(value["sensor_clock_generation"].is_null()
+            || positive(&value["sensor_clock_generation"]).is_some())
+        || positive(&value["audio_generation"]).is_none()
+        || !value["loop_sha256"]
+            .as_str()
+            .is_some_and(|hash| valid_hex(hash, 64))
+        || !positive(&value["sample_rate_hz"]).is_some_and(|rate| rate <= u64::from(u32::MAX))
+        || !matches!(value["input"].as_str(), Some("polar-tilt" | "polar-volume"))
+        || positive(&value["calibration_target_frames"]).is_none()
+    {
+        return Err("attempt-manifest-invalid".into());
+    }
+    Ok(())
+}
+
+fn audio_generation_valid(row: &Value, manifest: &Value) -> bool {
+    positive(&row["generation"])
+        .zip(positive(&manifest["audio_generation"]))
+        .is_some_and(|(observed, accepted)| observed >= accepted)
+}
+
+fn valid_terminal_time(
+    manifest: &Value,
+    outcome: AttemptOutcome,
+    ended: u64,
+    completed: u64,
+) -> bool {
+    let target = manifest["calibration_target_frames"].as_u64().unwrap_or(0);
+    ended
+        >= manifest["requested_elapsed_ns"]
+            .as_u64()
+            .unwrap_or(u64::MAX)
+        && completed <= target
+        && (outcome != AttemptOutcome::Succeeded || completed == target)
+}
+
+fn valid_hex(value: &str, digits: usize) -> bool {
+    value.len() == digits
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn valid_reason(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 96
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'-' || byte == b'_'
+        })
+}
+
+fn positive(value: &Value) -> Option<u64> {
+    value.as_u64().filter(|number| *number > 0)
+}
+
+fn signed_sample(value: &Value) -> bool {
+    value
+        .as_i64()
+        .is_some_and(|number| i32::try_from(number).is_ok())
+}
+
+fn store_directory(app_files: &Path, create: bool) -> Result<PathBuf, String> {
+    if !app_files.is_absolute() {
+        return Err("attempt-files-root-invalid".into());
+    }
+    require_directory(app_files)?;
+    let store = app_files.join(STORE);
+    if create {
+        match fs::create_dir(&store) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(io_error(error)),
+        }
+        // A concurrent begin may have created the store without syncing it yet.
+        sync_directory(app_files)?;
+    }
+    require_directory(&store)?;
+    Ok(store)
+}
+
+fn require_directory(path: &Path) -> Result<(), String> {
+    if !fs::symlink_metadata(path)
+        .map_err(io_error)?
+        .file_type()
+        .is_dir()
+    {
+        return Err("attempt-directory-invalid".into());
+    }
+    Ok(())
+}
+
+fn require_file(path: &Path) -> Result<(), String> {
+    if !fs::symlink_metadata(path)
+        .map_err(io_error)?
+        .file_type()
+        .is_file()
+    {
+        return Err("attempt-file-invalid".into());
+    }
+    Ok(())
+}
+
+fn read_json(path: &Path) -> Result<Value, String> {
+    require_file(path)?;
+    let mut bytes = Vec::new();
+    File::open(path)
+        .map_err(io_error)?
+        .take(MAX_ARTIFACT_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(io_error)?;
+    if bytes.len() as u64 > MAX_ARTIFACT_BYTES {
+        return Err("attempt-artifact-too-large".into());
+    }
+    serde_json::from_slice(&bytes).map_err(|_| "attempt-artifact-invalid".into())
+}
+
+fn chunk_filename(ordinal: u64) -> String {
+    format!("chunk-{ordinal:05}.json")
+}
+
+fn io_error(error: impl std::fmt::Display) -> String {
+    format!("attempt-storage:{error}")
+}
