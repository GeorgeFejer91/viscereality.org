@@ -0,0 +1,605 @@
+//! Bounded, off-callback acquisition for one active Personal Tilt attempt.
+//! The Android setup owner alone admits and terminates attempts. Raw ingress
+//! supplies the exact already-admitted GATT lineage and never waits for disk.
+
+use std::{
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        mpsc::{self, Receiver, SyncSender, TrySendError},
+        Arc, Mutex, OnceLock,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+use super::{
+    experiment_breathing_setup::{CalibrationState, SetupStatus, TiltModel},
+    personal_tilt_attempt_capture::{
+        AttemptCapture, AttemptEnd, AttemptFit, AttemptOutcome, AttemptRecord, AttemptSpec,
+        MAX_CHUNK_RECORDS,
+    },
+    polar_composition_adapters::SetupSensorTransport,
+};
+
+const QUEUE_ROWS: usize = 2048;
+const FLUSH_INTERVAL: Duration = Duration::from_millis(150);
+const WORKER_POLL: Duration = Duration::from_millis(25);
+// A normal 130 Hz, 73-sample ECG notification represents roughly 562 ms.
+const SUCCESS_TAIL: Duration = Duration::from_millis(650);
+const MAX_CAPTURE_AGE: Duration = Duration::from_secs(90);
+
+static APP_FILES: OnceLock<PathBuf> = OnceLock::new();
+static RAW_ACTIVE: AtomicBool = AtomicBool::new(false);
+static RAW_DROPS: AtomicU64 = AtomicU64::new(0);
+static RAW_TARGET: Mutex<Option<Arc<Target>>> = Mutex::new(None);
+static LIVE_WORKERS: AtomicU64 = AtomicU64::new(0);
+const MAX_WORKERS: u64 = 4;
+
+#[cfg(target_os = "android")]
+pub(crate) fn initialize_app_files(path: &Path) -> Result<(), String> {
+    let accepted = APP_FILES.get_or_init(|| path.to_owned());
+    if accepted == path {
+        Ok(())
+    } else {
+        Err("calibration-files-root-changed".into())
+    }
+}
+
+pub(crate) fn app_files() -> Option<&'static Path> {
+    APP_FILES.get().map(PathBuf::as_path)
+}
+
+pub(crate) fn operation(value: &serde_json::Value) -> Option<&'static str> {
+    match value["op"].as_str()? {
+        "calibrate" => Some("polar-tilt"),
+        "polar-volume" => Some("polar-volume"),
+        _ => None,
+    }
+}
+
+struct Finish {
+    end: AttemptEnd,
+    deadline: Instant,
+}
+
+#[derive(Default)]
+struct Control {
+    window: Option<AttemptRecord>,
+    finish: Option<Finish>,
+}
+
+struct Target {
+    transport: SetupSensorTransport,
+    source_start_java_ns: u64,
+    sender: SyncSender<AttemptRecord>,
+    control: Mutex<Control>,
+    dropped: AtomicU64,
+    contended_at_start: AtomicU64,
+    published: AtomicBool,
+    closed: AtomicBool,
+}
+
+impl Target {
+    fn offer(&self, record: AttemptRecord) {
+        if self.closed.load(Ordering::Acquire) {
+            return;
+        }
+        if let Err(TrySendError::Full(_)) = self.sender.try_send(record) {
+            self.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    fn end(&self, end: AttemptEnd, deadline: Instant) {
+        let mut control = self.control.lock().unwrap_or_else(|err| err.into_inner());
+        if control.finish.is_none() {
+            control.finish = Some(Finish { end, deadline });
+        }
+    }
+
+    fn active(&self, transport: SetupSensorTransport) -> bool {
+        self.transport == transport && !self.closed.load(Ordering::Acquire)
+    }
+
+    fn publish(self: &Arc<Self>) {
+        let mut raw = RAW_TARGET.lock().unwrap_or_else(|err| err.into_inner());
+        self.contended_at_start
+            .store(RAW_DROPS.load(Ordering::Relaxed), Ordering::Relaxed);
+        self.published.store(true, Ordering::Release);
+        *raw = Some(Arc::clone(self));
+        RAW_ACTIVE.store(true, Ordering::Release);
+    }
+
+    fn close(self: &Arc<Self>) -> bool {
+        let mut raw = RAW_TARGET.lock().unwrap_or_else(|err| err.into_inner());
+        self.closed.store(true, Ordering::Release);
+        let current = raw.as_ref().is_some_and(|target| Arc::ptr_eq(target, self));
+        if current {
+            RAW_ACTIVE.store(false, Ordering::Release);
+            raw.take();
+        }
+        current
+    }
+
+    fn drops(&self) -> u64 {
+        let contended = if self.published.load(Ordering::Acquire) {
+            RAW_DROPS
+                .load(Ordering::Relaxed)
+                .saturating_sub(self.contended_at_start.load(Ordering::Relaxed))
+        } else {
+            0
+        };
+        self.dropped
+            .load(Ordering::Relaxed)
+            .saturating_add(contended)
+    }
+}
+
+#[cfg(any(target_os = "android", test))]
+pub(crate) fn observe_raw(record: AttemptRecord) {
+    let timing = match record {
+        AttemptRecord::Ecg { timing, .. } | AttemptRecord::Acc { timing, .. } => timing,
+        _ => return,
+    };
+    if !RAW_ACTIVE.load(Ordering::Acquire) {
+        return;
+    }
+    let Ok(raw) = RAW_TARGET.try_lock() else {
+        RAW_DROPS.fetch_add(1, Ordering::Relaxed);
+        return;
+    };
+    let transport = SetupSensorTransport {
+        source_token: timing.source_token,
+        connection_generation: timing.connection_generation,
+    };
+    if let Some(target) = raw.as_ref().filter(|target| target.active(transport)) {
+        if timing.sample_host_time_ns < target.source_start_java_ns {
+            return;
+        }
+        if timing.sample_count == 0
+            || timing.sample_index >= timing.sample_count
+            || timing.sensor_time_ns == 0
+            || timing.frame_sequence == 0
+            || timing.frame_host_receipt_time_ns == 0
+            || timing.jni_submit_time_ns == 0
+            || timing.sample_host_time_ns > timing.frame_host_receipt_time_ns
+            || timing.frame_host_receipt_time_ns > timing.jni_submit_time_ns
+        {
+            target.dropped.fetch_add(1, Ordering::Relaxed);
+        } else {
+            target.offer(record);
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct AttemptFitIdentity {
+    attempt_id: String,
+    preparation_id: Option<String>,
+    calibration_generation: u64,
+    model_generation: u64,
+    source_owner: u64,
+}
+
+impl AttemptFitIdentity {
+    pub(crate) fn matches(
+        &self,
+        preparation_id: &str,
+        calibration_generation: u64,
+        model_generation: u64,
+        source_owner: u64,
+    ) -> Option<&str> {
+        (self.preparation_id.as_deref() == Some(preparation_id)
+            && self.calibration_generation == calibration_generation
+            && self.model_generation == model_generation
+            && self.source_owner == source_owner)
+            .then_some(&self.attempt_id)
+    }
+}
+
+pub(crate) struct AttemptOwner {
+    id: String,
+    preparation_id: Option<String>,
+    created_elapsed_ns: u64,
+    original_calibration_generation: u64,
+    calibration_generation: Option<u64>,
+    source_reference: u64,
+    target: Arc<Target>,
+    armed: bool,
+    finished: bool,
+    clock_at_ns: Option<u64>,
+}
+
+impl AttemptOwner {
+    pub(crate) fn begin(
+        app_files: &Path,
+        spec: AttemptSpec,
+        original_calibration_generation: u64,
+        source_reference: u64,
+    ) -> Result<Self, String> {
+        LIVE_WORKERS
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |count| {
+                (count < MAX_WORKERS).then_some(count + 1)
+            })
+            .map_err(|_| "calibration-recording-workers-busy")?;
+        let writer = match AttemptCapture::begin(app_files, spec.clone()) {
+            Ok(writer) => writer,
+            Err(error) => {
+                LIVE_WORKERS.fetch_sub(1, Ordering::AcqRel);
+                return Err(error);
+            }
+        };
+        let (sender, receiver) = mpsc::sync_channel(QUEUE_ROWS);
+        let target = Arc::new(Target {
+            transport: SetupSensorTransport {
+                source_token: spec.polar_source_token,
+                connection_generation: spec.polar_connection_generation,
+            },
+            source_start_java_ns: spec.requested_java_ns,
+            sender,
+            control: Mutex::new(Control::default()),
+            dropped: AtomicU64::new(0),
+            contended_at_start: AtomicU64::new(0),
+            published: AtomicBool::new(false),
+            closed: AtomicBool::new(false),
+        });
+        let worker = Arc::clone(&target);
+        let started = spec.requested_elapsed_ns;
+        if let Err(error) = thread::Builder::new()
+            .name("quest-calibration-recording".into())
+            .spawn(move || {
+                record_attempt(worker, receiver, writer, started);
+                LIVE_WORKERS.fetch_sub(1, Ordering::AcqRel);
+            })
+        {
+            LIVE_WORKERS.fetch_sub(1, Ordering::AcqRel);
+            return Err(format!("calibration-recording-worker:{error}"));
+        }
+        Ok(Self {
+            id: spec.attempt_id,
+            preparation_id: spec.preparation_id,
+            created_elapsed_ns: started,
+            original_calibration_generation,
+            calibration_generation: None,
+            source_reference,
+            target,
+            armed: false,
+            finished: false,
+            clock_at_ns: None,
+        })
+    }
+
+    pub(crate) fn matching_source(
+        &self,
+        reference: u64,
+        transport: Option<SetupSensorTransport>,
+    ) -> bool {
+        reference == self.source_reference
+            && transport.is_some_and(|transport| self.target.active(transport))
+    }
+
+    pub(crate) fn activate(&mut self) {
+        self.armed = true;
+        self.target.publish();
+    }
+
+    pub(crate) fn is_finished(&self) -> bool {
+        self.finished || self.is_closed()
+    }
+
+    pub(crate) fn is_closed(&self) -> bool {
+        self.target.closed.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn retire(&mut self, now: u64, completed: u64) {
+        if !self.finished {
+            self.end(
+                AttemptOutcome::Abandoned,
+                "calibration-preparation-retired",
+                now,
+                completed,
+                None,
+            );
+            return;
+        }
+        let mut control = self
+            .target
+            .control
+            .lock()
+            .unwrap_or_else(|err| err.into_inner());
+        if let Some(finish) = &mut control.finish {
+            finish.end.raw_window_complete = false;
+            finish.deadline = Instant::now();
+        }
+    }
+
+    pub(crate) fn clock(&mut self, ns: u64, record: AttemptRecord) {
+        if self.armed
+            && !self.is_finished()
+            && self
+                .clock_at_ns
+                .is_none_or(|previous| ns.saturating_sub(previous) >= 50_000_000)
+        {
+            self.clock_at_ns = Some(ns);
+            self.target.offer(record);
+        }
+    }
+
+    pub(crate) fn observe(
+        &mut self,
+        status: SetupStatus,
+        audio_generation: u64,
+        source_reference: u64,
+        transport: Option<SetupSensorTransport>,
+        recovering: bool,
+        model: Option<&TiltModel>,
+        now: u64,
+    ) -> Option<AttemptFitIdentity> {
+        if !self.armed || self.is_finished() {
+            return None;
+        }
+        let completed = status.calibration_completed_frames;
+        if source_reference != self.source_reference
+            || transport.is_none_or(|transport| !self.target.active(transport))
+        {
+            self.end(
+                AttemptOutcome::Failed,
+                "polar-lineage-retired",
+                now,
+                completed,
+                None,
+            );
+            return None;
+        }
+        if self.calibration_generation.is_none() {
+            if recovering {
+                return None;
+            }
+            if status.calibration_generation == self.original_calibration_generation
+                || !matches!(
+                    status.calibration,
+                    CalibrationState::Waiting | CalibrationState::Collecting
+                )
+            {
+                self.end(
+                    AttemptOutcome::Failed,
+                    "calibration-start-retired",
+                    now,
+                    0,
+                    None,
+                );
+                return None;
+            }
+            let Some(start_frame) = status.calibration_start_frame else {
+                self.end(
+                    AttemptOutcome::Failed,
+                    "calibration-window-missing",
+                    now,
+                    0,
+                    None,
+                );
+                return None;
+            };
+            self.calibration_generation = Some(status.calibration_generation);
+            self.target
+                .control
+                .lock()
+                .unwrap_or_else(|err| err.into_inner())
+                .window = Some(AttemptRecord::Window {
+                audio_generation,
+                start_frame,
+            });
+        }
+        if self.calibration_generation != Some(status.calibration_generation) {
+            self.end(
+                AttemptOutcome::Superseded,
+                "calibration-superseded",
+                now,
+                0,
+                None,
+            );
+            return None;
+        }
+        match status.calibration {
+            CalibrationState::Succeeded => {
+                let Some(model) =
+                    model.filter(|model| Some(model.generation) == status.model_generation)
+                else {
+                    self.end(
+                        AttemptOutcome::Failed,
+                        "calibration-fit-missing",
+                        now,
+                        completed,
+                        None,
+                    );
+                    return None;
+                };
+                let fit = AttemptFit {
+                    model_generation: model.generation,
+                    source_owner: model.source_owner,
+                    accepted_samples: status.accepted_samples as u64,
+                    axis: model.axis,
+                    low: model.low,
+                    high: model.high,
+                };
+                self.end(
+                    AttemptOutcome::Succeeded,
+                    "calibration-succeeded",
+                    now,
+                    completed,
+                    Some(fit),
+                );
+                Some(AttemptFitIdentity {
+                    attempt_id: self.id.clone(),
+                    preparation_id: self.preparation_id.clone(),
+                    calibration_generation: status.calibration_generation,
+                    model_generation: model.generation,
+                    source_owner: model.source_owner,
+                })
+            }
+            CalibrationState::Failed => {
+                let reason = status
+                    .failure
+                    .map_or("calibration-failed", |failure| failure.as_str());
+                self.end(AttemptOutcome::Failed, reason, now, completed, None);
+                None
+            }
+            CalibrationState::Idle => {
+                self.end(
+                    AttemptOutcome::Abandoned,
+                    "calibration-reset",
+                    now,
+                    completed,
+                    None,
+                );
+                None
+            }
+            CalibrationState::Waiting | CalibrationState::Collecting => None,
+        }
+    }
+
+    pub(crate) fn end(
+        &mut self,
+        outcome: AttemptOutcome,
+        reason: &str,
+        now: u64,
+        completed_calibration_frames: u64,
+        fit: Option<AttemptFit>,
+    ) {
+        if self.finished {
+            return;
+        }
+        self.finished = true;
+        let raw_window_complete = outcome == AttemptOutcome::Succeeded;
+        let deadline = Instant::now()
+            + if raw_window_complete {
+                SUCCESS_TAIL
+            } else {
+                Duration::ZERO
+            };
+        self.target.end(
+            AttemptEnd {
+                outcome,
+                reason: reason.to_owned(),
+                ended_elapsed_ns: now.max(self.created_elapsed_ns),
+                completed_calibration_frames,
+                fit,
+                raw_window_complete,
+                dropped_records: 0,
+            },
+            deadline,
+        );
+    }
+}
+
+impl Drop for AttemptOwner {
+    fn drop(&mut self) {
+        self.end(
+            AttemptOutcome::Abandoned,
+            "calibration-owner-retired",
+            self.created_elapsed_ns,
+            0,
+            None,
+        );
+    }
+}
+
+fn record_attempt(
+    target: Arc<Target>,
+    receiver: Receiver<AttemptRecord>,
+    mut writer: AttemptCapture,
+    started_elapsed_ns: u64,
+) {
+    let began = Instant::now();
+    let mut flushed = began;
+    let mut batch = Vec::with_capacity(MAX_CHUNK_RECORDS);
+    loop {
+        let (window, pending) = {
+            let mut control = target.control.lock().unwrap_or_else(|err| err.into_inner());
+            let pending = if control
+                .finish
+                .as_ref()
+                .is_some_and(|finish| finish.deadline <= Instant::now())
+            {
+                control.finish.take()
+            } else {
+                None
+            };
+            (control.window.take(), pending)
+        };
+        if let Some(window) = window {
+            batch.push(window);
+            if batch.len() == MAX_CHUNK_RECORDS && !flush(&mut writer, &mut batch) {
+                target.close();
+                return;
+            }
+        }
+        let expired = began.elapsed() >= MAX_CAPTURE_AGE;
+        if let Some(mut finish) = pending.or_else(|| {
+            expired.then(|| Finish {
+                deadline: Instant::now(),
+                end: AttemptEnd {
+                    outcome: AttemptOutcome::Abandoned,
+                    reason: "calibration-capture-time-limit".into(),
+                    ended_elapsed_ns: started_elapsed_ns
+                        .saturating_add(MAX_CAPTURE_AGE.as_nanos() as u64),
+                    completed_calibration_frames: 0,
+                    fit: None,
+                    raw_window_complete: false,
+                    dropped_records: 0,
+                },
+            })
+        }) {
+            finish.end.raw_window_complete &= target.close();
+            for record in receiver.try_iter() {
+                batch.push(record);
+                if batch.len() == MAX_CHUNK_RECORDS && !flush(&mut writer, &mut batch) {
+                    return;
+                }
+            }
+            if flush(&mut writer, &mut batch) {
+                finish.end.dropped_records = target.drops();
+                if let Err(error) = writer.finish(finish.end) {
+                    capture_failure("terminal-publish", &error);
+                }
+            }
+            return;
+        }
+        if let Ok(record) = receiver.recv_timeout(WORKER_POLL) {
+            batch.push(record);
+        }
+        if batch.len() == MAX_CHUNK_RECORDS || flushed.elapsed() >= FLUSH_INTERVAL {
+            if !flush(&mut writer, &mut batch) {
+                target.close();
+                return;
+            }
+            flushed = Instant::now();
+        }
+    }
+}
+
+fn flush(writer: &mut AttemptCapture, batch: &mut Vec<AttemptRecord>) -> bool {
+    if batch.is_empty() {
+        return true;
+    }
+    if let Err(error) = writer.append(batch) {
+        capture_failure("raw-append", &error);
+        return false;
+    }
+    batch.clear();
+    true
+}
+
+fn capture_failure(stage: &str, error: &str) {
+    #[cfg(target_os = "android")]
+    crate::marker(
+        "personal-tilt-capture",
+        format!("stage={stage} reason={error}"),
+    );
+    #[cfg(not(target_os = "android"))]
+    let _ = (stage, error);
+}
