+        if tick == 1 { assert!(!crate::polar_input_health::status(true,false).0.usable_fresh, "raw callback is not quality acceptance"); }
+        let guard = state().lock().unwrap(); let r = guard.as_ref().unwrap();
+        assert!(matches!(r.output(at), SetupDriverOutput::PolarUnavailable { .. }));
+        assert_eq!(r.core.snapshot(at).experiment_completed_frames, frozen);
+        assert_eq!(r.core.model().map(|m| (m.source_owner,m.generation,m.axis,m.low,m.high)), original_model);
+    }
+    assert!(crate::polar_input_health::status(true,false).0.usable_fresh, "valid paused signal recovers manual Continue readiness");
