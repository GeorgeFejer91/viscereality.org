+#[test]
+fn running_main_keeps_the_last_diagnosis_and_radius_ramp_through_quality_loss() {
+    use crate::breath_composition_driver::{BreathCompositionDriver, tests::setup_frame};
+    for desired in [
+        CommonBreathPhase::Inhale,
+        CommonBreathPhase::Exhale,
+        CommonBreathPhase::Hold,
+    ] {
+        let (mut r, frame, now) = calibrated_inhale_runtime();
+        assert_eq!(command(&mut r, 20, "begin-main", now)["accepted"], true);
+        for tick in 1..=800 {
+            let at = now + tick * 20_000_000;
+            r.observe_clock(7, frame + tick * 882, at, true);
+            r.observe_host_aligned_acc(100_000_000_000 + at, at, vector(0.5));
+        }
+        let frame = frame + 800 * 882;
+        let now = now + 16_000_000_000;
+        assert_eq!(r.status(now)["stage"], "main");
+        for tick in 1..=30 {
+            let at = now + tick * 40_000_000;
+            let volume = match desired {
+                CommonBreathPhase::Inhale => 0.5 + tick as f64 / 100.0,
+                CommonBreathPhase::Exhale => 0.5 - tick as f64 / 100.0,
+                _ => 0.5,
+            };
+            r.observe_clock(7, frame + tick * 1764, at, true);
+            r.observe_host_aligned_acc(100_000_000_000 + at, at, vector(volume));
+        }
+        assert_eq!(r.phase, desired);
+        let frame = frame + 30 * 1764;
+        let now = now + 1_200_000_000;
+        let mut driver =
+            BreathCompositionDriver::new(crate::breath_composition_driver::tests::settings());
+        setup_frame(&mut driver, r.output(now), now, 0.0);
+        let initial = driver.value01();
+        for tick in 1..=30 {
+            let at = now + tick * 40_000_000;
+            r.observe_clock(7, frame + tick * 1764, at, true);
+            r.observe_host_aligned_acc(100_000_000_000 + at, at, [f32::NAN, 0.0, 1000.0]);
+            assert!(matches!(r.output(at), SetupDriverOutput::PolarTilt {
+                confirmed_phase: Some(p), availability: SetupSampleAvailability::SampleUnavailable, ..
+            } if p == desired));
+            let previous = driver.value01();
+            setup_frame(&mut driver, r.output(at), at, 0.04);
+            match desired {
+                CommonBreathPhase::Inhale => assert!(driver.value01() >= previous),
+                CommonBreathPhase::Exhale => assert!(driver.value01() <= previous),
+                _ => assert_eq!(driver.value01(), previous),
+            }
+            assert_eq!(r.status(at)["stage"], "main");
+        }
+        match desired {
+            CommonBreathPhase::Inhale => assert!(driver.value01() > initial),
+            CommonBreathPhase::Exhale => assert!(driver.value01() < initial),
+            _ => assert_eq!(driver.value01(), initial),
+        }
+    }
+}
