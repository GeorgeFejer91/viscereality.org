+#[test]
+fn raw_packet_admission_retains_all_73_ecg_samples_and_real_writer_csv_rows() {
+    use crate::session_recording_clock::MonotonicNanos;
+    use crate::session_recording_contract::{FinalizationReason, SessionEventKind};
+    use crate::session_recording_writer::{SessionRecordingWriter, OfferOutcome, tests::{config, spec, temp_root}};
+    let (r, now) = raw_packet_main_runtime();
+    let start_ns = now - (r.last_clock.unwrap().1 - r.last_admitted_frame.unwrap()) * 1_000_000_000 / 44_100;
+    let _setup = test_support::install_runtime_for_usable_test(r);
+    let samples: Vec<_> = (0..73).map(|index| raw_packet_ecg(now - (72 - u64::from(index)) * (1_000_000_000 / 130), now, index)).collect();
+    assert!(!recording_sample_admitted(&samples[0]), "missing packet provenance retains legacy 250 ms admission");
+    let mut admitted: Vec<_> = samples.into_iter().filter(raw_packet_admitted).collect();
+    assert_eq!(admitted.len(), 73, "a 562 ms ECG packet is not a stale current breath assessment");
+    for index in 0..36 {
+        use crate::session_recording_contract::{SessionRecord, PolarAccBatch, PolarAccSample};
+        let SessionRecord::PolarEcg(batch) = raw_packet_ecg(now - (35 - u64::from(index)) * 5_000_000, now, index) else { unreachable!() };
+        let sample = &batch.samples[0];
+        let acc = SessionRecord::PolarAcc(PolarAccBatch { frame_sequence: 12, samples: vec![PolarAccSample {
+            source_sequence: sample.source_sequence, sample_index: sample.sample_index, source_time: sample.source_time,
+            received_source: sample.received_source, observed_at: sample.observed_at, xyz_mg: [1.0, 2.0, 1000.0],
+        }].into_boxed_slice() });
+        assert!(raw_packet_admitted(&acc));
+        admitted.push(acc);
+    }
+    let root = temp_root("buffered-raw-ecg-admission");
+    let writer = SessionRecordingWriter::spawn(config(root.clone(), 256, 100)).unwrap();
+    let mut session = spec(1_700_000_000_000_000_000);
+    session.participant = Some(crate::session_recording_participant::ParticipantPlan::parse(&json!({
+        "participant_id":"Tes_30_N", "scenario_id":"haupt-15", "scenario_sha256":"a".repeat(64),
+        "sample_rate":44100, "total_frames":39_690_000, "phases":[[0,"inhale"]]
+    })).unwrap());
+    session.completion_threshold_ns = session.participant.as_ref().unwrap().completion_threshold_ns();
+    let prepared = writer.prepare(1, session).unwrap().receive().unwrap();
+    writer.record_control(1, MonotonicNanos::new(start_ns), SessionEventKind::OfficialStart).unwrap().receive().unwrap();
+    for sample in admitted {
+        assert!(matches!(writer.try_offer(1, sample).outcome, OfferOutcome::Accepted { .. }));
+    }
+    let finalized = writer.try_finalize(1, MonotonicNanos::new(now + 1), FinalizationReason::RestartToExperimenter, false).unwrap().receive().unwrap();
+    assert!(finalized.saved);
+    assert_eq!(finalized.dropped_records, 0);
+    let raw = std::fs::read_to_string(prepared.directory.join("polar-ecg.jsonl")).unwrap();
+    assert_eq!(raw.lines().count(), 73);
+    let final_json: Value = serde_json::from_slice(&std::fs::read(prepared.directory.join("final.json")).unwrap()).unwrap();
+    let csv = std::fs::read_to_string(prepared.directory.join(final_json["participant_csv"]["name"].as_str().unwrap())).unwrap();
+    assert_eq!(csv.lines().filter(|row| row.split(',').nth(5) == Some("ecg")).count(), 73);
+    assert_eq!(csv.lines().filter(|row| row.split(',').nth(5) == Some("accelerometer")).count(), 36);
+    writer.shutdown(std::time::Duration::from_secs(2)).unwrap();
+    std::fs::remove_dir_all(root).unwrap();
+}
