+    let frozen = r.core.snapshot(base).experiment_completed_frames;
+    r.observe_clock(7, frame, base + 20_000_000, false);
+    let _setup = test_support::install_runtime_for_usable_test(r);
+    for tick in 1..=50 {
+        let at = base + 20_000_000 + tick * 40_000_000;
+        observe_clock(7, frame, at, false); observe_source_clock_pair(at, at);
