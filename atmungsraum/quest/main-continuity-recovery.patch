+    use crate::session_recording_contract::{PolarEcgBatch, PolarEcgSample, SessionRecord};
+    SessionRecord::PolarEcg(PolarEcgBatch {
+        frame_sequence: 12,
+        samples: vec![PolarEcgSample {
+            source_sequence: 12, sample_index: index,
+            source_time: SourceTimestamp { clock: SourceClock::PolarSensor, value_ns: sample_elapsed + 100_000_000_000 },
+            received_source: SourceTimestamp { clock: SourceClock::JavaNanoTime, value_ns: sample_elapsed + 900_000_000_000 },
+            observed_at: MonotonicNanos::new(receipt_elapsed), microvolts: -37,
+        }].into_boxed_slice(),
+    })
+}
+
+fn raw_packet_admitted(record: &crate::session_recording_contract::SessionRecord) -> bool {
+    recording_sample_admitted_with_packet_receipt(record, Some(crate::session_recording_clock::SourceTimestamp {
+        clock: crate::source_clock::SourceClock::JavaNanoTime,
+        value_ns: record.observed_at().get() + 900_000_000_000,
+    }))
+}
