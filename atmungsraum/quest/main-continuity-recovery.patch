+#[test]
+fn raw_packet_admission_keeps_start_end_pause_and_receipt_clock_fences() {
+    let (r, now) = raw_packet_main_runtime();
+    let (g, frame, _, _) = r.last_clock.unwrap();
+    let start_ns = now - (frame - r.last_admitted_frame.unwrap()) * 1_000_000_000 / 44_100;
+    let _setup = test_support::install_runtime_for_usable_test(r);
+    assert!(!raw_packet_admitted(&raw_packet_ecg(start_ns - 1, now, 0)), "buffering cannot import pre-main data");
+    assert!(raw_packet_admitted(&raw_packet_ecg(start_ns, now, 1)), "the real main start is inclusive");
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now + 1, now, 2)), "a sample cannot be newer than its receipt");
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now - 1_000_000_001, now, 3)), "raw lookback is bounded independently");
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now - 100_000_000, now - 300_000_000, 4)), "old receipt cannot refresh a sample");
+    let packet_receipt = crate::session_recording_clock::SourceTimestamp {
+        clock: crate::source_clock::SourceClock::JavaNanoTime, value_ns: now + 900_000_000_000,
+    };
+    assert!(recording_sample_admitted_with_packet_receipt(
+        &raw_packet_ecg(now - 500_000_000, now - 10_000_000, 5), Some(packet_receipt)),
+        "independent elapsed bridge estimates need not equal the actual Java packet receipt");
+    assert!(!recording_sample_admitted_with_packet_receipt(
+        &raw_packet_ecg(now + 1, now + 10_000_000, 5), Some(packet_receipt)),
+        "an ahead-of-receipt source sample cannot borrow observation-bridge skew");
+    assert!(!recording_sample_admitted_with_packet_receipt(
+        &raw_packet_ecg(now - 100_000_000, now, 5), Some(crate::session_recording_clock::SourceTimestamp {
+            value_ns: packet_receipt.value_ns + 300_000_000, ..packet_receipt
+        })), "a receipt outside current clock coherence cannot authorize a packet");
+    assert!(!recording_sample_admitted_with_packet_receipt(
+        &raw_packet_ecg(now - 100_000_000, now, 5), Some(crate::session_recording_clock::SourceTimestamp {
+            clock: crate::source_clock::SourceClock::PolarSensor, ..packet_receipt
+        })), "a receipt in another clock cannot authorize Java samples");
+    {
+        let mut guard = state().lock().unwrap();
+        let r = guard.as_mut().unwrap();
+        r.source_clock_pair.as_mut().unwrap().2 = Instant::now() - std::time::Duration::from_millis(251);
+    }
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now - 100_000_000, now, 5)), "a stale source-clock pair is not mapping authority");
+    {
+        let mut guard = state().lock().unwrap();
+        let r = guard.as_mut().unwrap();
+        r.observe_source_pair(now + 900_000_000_000, now);
+        r.observe_clock(g, frame, now + 20_000_000, false);
+    }
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now - 100_000_000, now + 20_000_000, 6)), "no records while audio is paused");
+    let resumed = now + 100_000_000;
+    {
+        let mut guard = state().lock().unwrap();
+        let r = guard.as_mut().unwrap();
+        r.observe_clock(g, frame, resumed, true);
+        r.observe_clock(g, frame + 882, resumed + 20_000_000, true);
+        r.observe_source_pair(resumed + 20_000_000 + 900_000_000_000, resumed + 20_000_000);
+    }
+    assert!(!raw_packet_admitted(&raw_packet_ecg(now - 100_000_000, resumed + 20_000_000, 7)), "a post-resume packet cannot import pre-pause samples");
+    assert!(raw_packet_admitted(&raw_packet_ecg(resumed + 10_000_000, resumed + 20_000_000, 8)));
+    {
+        let mut guard = state().lock().unwrap();
+        let r = guard.as_mut().unwrap();
+        let end_frame = r.last_admitted_frame.unwrap() + 39_690_000;
+        let mut at = resumed + 20_000_000;
+        // Every observation advances the actual head by 20 ms, including
+        // the final boundary; there is no fabricated long poll gap.
+        for next_frame in ((frame + 1764)..=end_frame).step_by(882) {
+            at += 20_000_000;
+            r.core.observe_clock(g, next_frame, at, true);
+        }
+        assert_eq!(r.core.snapshot(at).experiment, ExperimentState::Finished);
+        r.last_clock = Some((g, end_frame, at, true));
+        r.clock_anchor = Some((at, Instant::now()));
+        r.observe_source_pair(at + 900_000_000_000, at);
+    }
+    let end = state().lock().unwrap().as_ref().unwrap().last_clock.unwrap().2;
+    assert!(raw_packet_admitted(&raw_packet_ecg(end - 1, end, 9)), "the final in-window sample is retained");
+    assert!(!raw_packet_admitted(&raw_packet_ecg(end, end, 10)), "main end is exclusive");
+}
+
+#[test]
+fn raw_packet_admission_retires_on_audio_clock_and_source_barriers() {
+    for barrier in ["clock-stale", "audio-generation", "source-retired"] {
+        let (r, now) = raw_packet_main_runtime();
+        let _setup = test_support::install_runtime_for_usable_test(r);
+        assert!(raw_packet_admitted(&raw_packet_ecg(now - 500_000_000, now, 0)));
+        {
+            let mut guard = state().lock().unwrap();
+            let r = guard.as_mut().unwrap();
+            match barrier {
+                "clock-stale" => r.clock_anchor = Some((now, Instant::now() - std::time::Duration::from_millis(251))),
+                "audio-generation" => r.observe_clock(8, 0, now + 20_000_000, true),
+                _ => r.bind_source((0, 0)),
+            }
+        }
+        assert!(!raw_packet_admitted(&raw_packet_ecg(now - 100_000_000, now, 1)), "{barrier}");
+    }
+}
