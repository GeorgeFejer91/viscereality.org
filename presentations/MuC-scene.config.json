{
  "scene_schema_version": 2,
  "profile": "github-pages-1080",
  "asset_policy": {
    "mode": "copy",
    "soft_max_mb": 50,
    "hard_max_mb": 100,
    "transcode_gif": true,
    "transcode_video": true,
    "optimize_static_images": true,
    "webp_quality": 88,
    "video_crf": 24,
    "allow_oversize_assets": false,
    "prune_unreferenced_source_assets": true,
    "transparent_animation": "preserve-alpha"
  },
  "group_policy": {
